forge_check_meta_8() {
  c_id='typescript/prisma/validate'; c_stage=migration; c_tools='prisma'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_8() {
  return 0
}
forge_when_8() { case $1 in prisma/schema.prisma) return 0 ;; esac; return 1; }
forge_check_run_8() {
prisma validate
}

# 9. typescript/typecheck
