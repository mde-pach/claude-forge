state/

===== .forge/ast-grep/rule-tests/typescript-bun-no-fewer-expects-test.yml
id: typescript/bun/no-fewer-expects
valid:
  - |
    import { test } from "bun:test";

    test("a", () => {
      f();
    });
  - |
    import { expect, it } from "vitest";

    it("a", () => {
      expect(f()).toBe(1);
    });
invalid:
  - |
    import { expect, test } from "bun:test";

    test("a", () => {
      expect(f()).toBe(1);
    });

===== .forge/ast-grep/rule-tests/typescript-bun-no-mock-increase-test.yml
id: typescript/bun/no-mock-increase
valid:
  - |
    import { expect, test } from "bun:test";

    test("charges", () => {
      const gateway = new FakeGateway();
      charge(gateway);
      expect(gateway.charged).toBe(1);
    });
invalid:
  - |
    import { mock, test } from "bun:test";

    mock.module("./billing", () => ({ charge: () => true }));
  - |
    import { expect, mock, test } from "bun:test";

    test("charges", () => {
      const pay = mock(() => true);
      charge(pay);
      expect(pay).toHaveBeenCalled();
    });
  - |
    import { spyOn, test } from "bun:test";

    test("logs", () => {
      spyOn(console, "log");
    });
  - |
    import { mock as m, test } from "bun:test";

    m.module("./billing", () => ({ charge: () => true }));

