    import { test } from "bun:test";

    test.todo("refunds");
  - |
    import { describe } from "bun:test";

    describe.if(process.platform !== "win32")("paths", () => {});
  - |
    import { expect, test } from "bun:test";

    test.failing("rounds", () => {
      expect(round(1.5)).toBe(2);
    });
  - |
    import { test } from "bun:test";

    test.skipIf(ci)("slow", () => {});

