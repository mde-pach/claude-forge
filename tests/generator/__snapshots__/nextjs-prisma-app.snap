# Generated by forge from typescript/nextjs/react/no-ssr-false-in-server (mode: forbid).
id: typescript/nextjs/react/no-ssr-false-in-server
language: Tsx
severity: error
message: "forge:typescript/nextjs/react/no-ssr-false-in-server dynamic(..., { ssr: false }) from next/dynamic is used only in a 'use client' file; in a Server Component it is a build error. Wrap it in a Client Component."
