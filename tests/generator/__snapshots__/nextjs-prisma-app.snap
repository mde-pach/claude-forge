===== .forge/ast-grep/rules/typescript/no-stub.yml
# Generated by forge from typescript/no-stub (mode: forbid).
id: typescript/no-stub
language: Tsx
severity: error
message: forge:typescript/no-stub No stub left behind. A throw of "Not implemented" (or "TODO", "unimplemented"), or a named function or method with an empty body, is a stub; overload signatures, interfaces and constructors with parameter properties are not.
ignores:
  - "**/*.d.ts"
rule:
  any:
    - kind: throw_statement
      has:
        stopBy: end
        kind: string_fragment
        regex: (?i)^(not (yet )?implemented|unimplemented|todo)\b
    - all:
        - any:
            - kind: function_declaration
            - kind: method_definition
        - not:
            has:
              field: name
              regex: ^constructor$
        - has:
            field: body
            kind: statement_block
            regex: ^\{\s*((//[^\n]*|/\*(?s:.)*?\*/)\s*)*\}$

===== .forge/ast-grep/rules/typescript/no-swallowed-catch.yml
# Generated by forge from typescript/no-swallowed-catch (mode: forbid).
id: typescript/no-swallowed-catch
language: Tsx
severity: error
message: forge:typescript/no-swallowed-catch A catch block rethrows or uses the error it caught; .catch(() => {}) is not allowed either. Handle the error, log it, or let it propagate.
rule:
  any:
    - kind: catch_clause
      not:
        has:
          field: body
          has:
            stopBy: end
            kind: throw_statement
      any:
        - all:
            - kind: catch_clause
            - not:
                has:
                  field: parameter
                  regex: .
        - all:
            - has:
                field: parameter
                pattern: $ERR
            - not:
                has:
                  field: body
                  has:
                    stopBy: end
                    pattern: $ERR
    - pattern: $P.catch(() => {})
    - pattern: $P.catch(() => undefined)
    - pattern: $P.catch(() => null)

