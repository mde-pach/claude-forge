# Generated by forge from typescript/bun/no-fewer-expects (mode: no-decrease).
id: typescript/bun/no-fewer-expects
language: Tsx
severity: error
message: forge:typescript/bun/no-fewer-expects Assertions are not removed from tests that import from bun:test.
files:
  - "**/*.test.*"
  - "**/*_test.*"
  - "**/*.spec.*"
  - "**/*_spec.*"
ignores:
  - e2e/**
  - tests/e2e/**
rule:
  pattern: expect($$$)
  inside:
    stopBy: end
    kind: program
    has:
      kind: import_statement
      has:
        field: source
        regex: ^["']bun:test["']$

===== .forge/ast-grep/rules/typescript/bun/no-mock-increase.yml
# Generated by forge from typescript/bun/no-mock-increase (mode: no-increase).
id: typescript/bun/no-mock-increase
language: Tsx
severity: error
message: forge:typescript/bun/no-mock-increase A bun:test file may not gain mocks (mock(), mock.module(), spyOn(), jest.fn / vi.fn, also through an import alias such as import { mock as m }); test through the real code or a fake at the boundary.
files:
  - "**/*.test.*"
  - "**/*_test.*"
  - "**/*.spec.*"
  - "**/*_spec.*"
ignores:
  - e2e/**
  - tests/e2e/**
rule:
  kind: call_expression
  inside:
    stopBy: end
    kind: program
    has:
      kind: import_statement
      has:
        field: source
        regex: ^["']bun:test["']$
  any:
    - has:
        field: function
        regex: ^(mock|mock\.module|spyOn|jest\.(fn|mock|spyOn)|vi\.(fn|mock|spyOn))$
    - all:
        - any:
            - has:
                field: function
                kind: identifier
                pattern: $F
            - has:
                field: function
                kind: member_expression
                all:
                  - has:
                      field: object
                      kind: identifier
                      pattern: $F
                  - has:
                      field: property
                      regex: ^module$
        - inside:
            kind: program
            stopBy: end
            has:
              kind: import_statement
              all:
                - has:
                    field: source
                    regex: ^["']bun:test["']$
                - has:
                    stopBy: end
                    kind: import_specifier
                    all:
                      - has:
                          field: name
                          regex: ^(mock|spyOn)$
                      - has:
                          field: alias
                          pattern: $F

