        console.error(e);
      }
    }
  - |
    import { notFound } from "next/navigation";

    export async function load(id: string) {
      try {
        const r = await fetch(`/x/${id}`);
        if (!r.ok) notFound();
        return r.json();
      } catch {
        return null;
      }
    }

===== .forge/ast-grep/rule-tests/typescript-nextjs-no-request-apis-in-use-cache-test.yml
id: typescript/nextjs/no-request-apis-in-use-cache
valid:
  - |
    import { cookies } from "next/headers";

    async function cached(id: string) {
      "use cache";
      return fetch(`/c/${id}`);
    }
    export async function getCart() {
      const id = (await cookies()).get("cart")?.value ?? "";
      return cached(id);
    }
  - |
