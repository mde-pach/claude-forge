# Generated by forge from typescript/vitest/no-mock-increase (mode: no-increase).
id: typescript/vitest/no-mock-increase
language: Tsx
severity: error
message: "forge:typescript/vitest/no-mock-increase A test file may not gain mocks: vi.mock, vi.doMock, vi.spyOn, vi.fn, also through an import alias (import { vi as v }); test through the real code or a fake at the boundary. vi.stubEnv and vi.stubGlobal are not counted: they set configuration for a test, like pytest's monkeypatch."
files:
  - "**/*.{test,spec}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
  - "**/__tests__/**"
ignores:
  - e2e/**
  - tests/e2e/**
rule:
  kind: call_expression
  any:
    - has:
        field: function
        regex: ^vi\.(mock|doMock|spyOn|fn)$
    - all:
        - has:
            field: function
            kind: member_expression
            all:
              - has:
                  field: object
                  kind: identifier
                  pattern: $V
              - has:
                  field: property
                  regex: ^(mock|doMock|spyOn|fn)$
        - inside:
            kind: program
            stopBy: end
            has:
              kind: import_statement
              all:
                - has:
                    field: source
                    regex: ^["']vitest["']$
                - has:
                    stopBy: end
                    kind: import_specifier
                    all:
                      - has:
                          field: name
                          regex: ^vi$
                      - has:
                          field: alias
                          pattern: $V

