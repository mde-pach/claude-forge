===== .forge/ast-grep/rule-tests/typescript-vitest-no-mock-increase-test.yml
id: typescript/vitest/no-mock-increase
valid:
  - |
    import { expect, it } from "vitest";

    it("charges", () => {
      const gateway = new FakeGateway();
      charge(gateway);
      expect(gateway.charged).toBe(1);
    });
  - |
    import { expect, it, vi } from "vitest";

    it("reads the zone", () => {
      vi.stubEnv("TZ", "UTC");
      expect(zone()).toBe("UTC");
    });
  - |
    import { expect, it } from "vitest";
    import { fetcher as v } from "./http";

    it("fetches", async () => {
      expect(await v.fn()).toBe(1);
    });
invalid:
  - |
    import { vi } from "vitest";

    vi.mock("./billing");
  - |
    import { expect, it, vi } from "vitest";

    it("charges", () => {
      const pay = vi.fn();
      charge(pay);
      expect(pay).toHaveBeenCalled();
    });
  - |
    import { expect, it, vi as v } from "vitest";

    it("charges", () => {
      const pay = v.fn();
      charge(pay);
      expect(pay).toHaveBeenCalled();
    });

