            has:
              kind: template_substitution
              not:
                has:
                  pattern: RegExp.escape($$$)
        - pattern: RegExp.escape($$$)

===== .forge/ast-grep/rules/typescript/no-hardcoded-session-secret.yml
# Generated by forge from typescript/no-hardcoded-session-secret (mode: forbid).
id: typescript/no-hardcoded-session-secret
language: Tsx
severity: error
message: forge:typescript/no-hardcoded-session-secret No string literal as a signing secret (express-session, cookie-parser, better-auth, hono/jwt, jsonwebtoken sign/verify, @fastify/cookie, @fastify/session). Read it from the environment or a secret store; a secret in the code signs every session for whoever reads the repository.
ignores:
  - "**/*.test.*"
  - "**/*.spec.*"
  - "**/__tests__/**"
  - e2e/**
rule:
  kind: call_expression
  any:
    - all:
        - has:
            field: function
            pattern: $OPTS
        - has:
            field: arguments
            has:
              nthChild: 1
              matches: literal-secret-option
    - all:
        - has:
            field: function
            kind: member_expression
            has:
              field: property
              regex: ^register$
        - has:
            field: arguments
            all:
              - has:
                  nthChild: 1
                  pattern: $PLUGIN
              - has:
                  nthChild: 2
                  matches: literal-secret-option
    - all:
        - has:
            field: function
            pattern: $JWT
        - has:
            field: arguments
            has:
              nthChild: 2
              matches: literal
    - all:
        - has:
            field: function
            pattern: $COOKIES
        - has:
            field: arguments
            has:
              nthChild: 1
              matches: literal
utils:
  literal:
    any:
      - kind: string
      - kind: template_string
        not:
          has:
            kind: template_substitution
      - kind: array
        has:
          any:
            - kind: string
            - kind: template_string
              not:
                has:
                  kind: template_substitution
  literal-secret-option:
    kind: object
    has:
      kind: pair
      all:
        - has:
            field: key
            regex: ^["']?secret["']?$
        - has:
            field: value
            matches: literal
metadata:
  forge_where:
    OPTS:
      declared:
        - package: express-session
          name: session
        - package: better-auth
          name: betterAuth
        - package: hono
          name: jwt
    PLUGIN:
      declared:
        package:
          - "@fastify/cookie"
          - "@fastify/session"
    JWT:
      declared:
        - package: jsonwebtoken
          name:
            - sign
            - verify
        - package: hono
          name:
            - sign
            - verify
    COOKIES:
      declared:
        package: cookie-parser

===== .forge/ast-grep/rules/typescript/no-html-sinks.yml
# Generated by forge from typescript/no-html-sinks (mode: forbid).
id: typescript/no-html-sinks
language: Tsx
severity: error
message: "forge:typescript/no-html-sinks No HTML built from a value written into the DOM (XSS): no innerHTML or outerHTML assigned anything but a constant string, and no insertAdjacentHTML, document.write, writeln, createContextualFragment or setHTMLUnsafe whose HTML argument is not constant. Set textContent, build elements, or sanitise in one place."
rule:
  any:
    - kind: assignment_expression
      all:
        - has:
            field: left
            kind: member_expression
            all:
              - has:
                  field: property
                  regex: ^(innerHTML|outerHTML)$
              - has:
                  field: object
                  pattern: $E
        - not:
            has:
              field: right
              any:
                - kind: string
                - kind: template_string
                  not:
                    has:
                      kind: template_substitution
    - kind: call_expression
      all:
        - has:
            field: function
            kind: member_expression
            all:
              - has:
                  field: property
                  regex: ^(insertAdjacentHTML|write|writeln|createContextualFragment|setHTMLUnsafe)$
              - has:
                  field: object
                  pattern: $E
        - has:
            field: arguments
            has:
              nthChild:
                position: 1
                reverse: true
              not:
                any:
                  - kind: string
                  - kind: template_string
                    not:
                      has:
                        kind: template_substitution
metadata:
  forge_where:
    E:
      type:
        package: typescript
        name:
          - Element
          - Document
          - Range
          - ShadowRoot

