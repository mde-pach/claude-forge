branch=$(git branch --show-current 2>/dev/null)
[ -n "$branch" ] || branch="(detached $(git rev-parse --short HEAD 2>/dev/null))"
git status --porcelain --untracked-files=all 2>/dev/null | sed -e 's/^...//' -e 's/^.* -> //' > "${TMPDIR:-/tmp}/forge-ss.$$"
n=$(awk 'END { print NR }' "${TMPDIR:-/tmp}/forge-ss.$$")
printf 'forge: branch %s, %s changed files\n' "$branch" "$n"
first_lines 10 < "${TMPDIR:-/tmp}/forge-ss.$$" | sed 's/^/  /'
rm -f "${TMPDIR:-/tmp}/forge-ss.$$"
if git rev-parse --verify -q HEAD >/dev/null; then
  printf 'forge: last commits\n'
  git log -5 --format='%h %s' 2>/dev/null | cut -c 1-72 | sed 's/^/  /'
fi
printf 'forge: packs typescript, typescript/bun, typescript/nextjs, typescript/nextjs/react, typescript/playwright, typescript/prisma, typescript/vitest, typescript/zod\n'

missing=''
for t in $(forge_required_tools); do
  forge_has_tool "$t" || missing="${missing:+$missing, }$t"
done
if ! command -v bunx >/dev/null 2>&1 && ! command -v uvx >/dev/null 2>&1; then
  missing="${missing:+$missing, }bunx or uvx (ast-grep)"
fi
state=.forge/state/missing-tools
if [ -n "$missing" ]; then
  if [ "$missing" != "$(cat "$state" 2>/dev/null)" ]; then
    printf 'forge: missing tools (checks using them are skipped): %s\n' "$missing"
    mkdir -p .forge/state 2>/dev/null && printf '%s\n' "$missing" > "$state"
  fi
else
  rm -f "$state" 2>/dev/null
fi
exit 0

