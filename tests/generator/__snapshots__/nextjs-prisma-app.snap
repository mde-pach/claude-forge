FORGE_FORBID='typescript/nextjs/no-next-router|typescript/nextjs/no-pages-data|typescript/nextjs/proxy-not-middleware|typescript/nextjs/react/client-hooks|typescript/prisma/generated-client-import|typescript/prisma/no-middleware|typescript/vitest/no-test-env-branch'

