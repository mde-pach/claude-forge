  return 1
}
forge_when_6() { return 1; }
forge_check_run_6() {
tsc --noEmit -p tsconfig.json
}

# 7. typescript/vitest/run
forge_check_meta_7() {
  c_id='typescript/vitest/run'; c_stage=test; c_tools='vitest'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=0
}
