#!/bin/sh
# Generated by forge. PostToolUse(Edit|Write): formats the edited file silently,
# lints it and runs the ast-grep forbid rules on it. Findings go back to Claude
# as additionalContext (<= 20 lines). Nothing on success.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
file=$(json_get file_path)
[ -n "$file" ] || exit 0
file=$(rel_path "$file") || exit 0
[ -f "$file" ] || exit 0
case $file in .forge/*|.claude/*|.git/*|node_modules/*|.venv/*) exit 0 ;; esac
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-edit.XXXXXX") || exit 0
trap 'rm -rf "$FORGE_TMP"' EXIT HUP INT TERM

# ---- generated checks
# Project tools used in check commands, resolved through tool().
biome() { forge_exec_tool biome "$@"; }
tsc() { forge_exec_tool tsc "$@"; }
prisma() { forge_exec_tool prisma "$@"; }
vitest() { forge_exec_tool vitest "$@"; }
playwright() { forge_exec_tool playwright "$@"; }
FORGE_NCHECKS=7

# 1. bun/lock-sync
forge_check_meta_1() {
  c_id='bun/lock-sync'; c_stage=lint; c_tools='bun'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_1() {
  return 0
}
forge_when_1() { case $1 in package.json) return 0 ;; esac; return 1; }
forge_check_run_1() {
bun install --frozen-lockfile
}

# 2. playwright/run
forge_check_meta_2() {
  c_id='playwright/run'; c_stage=test; c_tools='playwright'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_2() {
  return 0
}
forge_when_2() { case $1 in e2e/*|playwright.config.*) return 0 ;; esac; return 1; }
forge_check_run_2() {
playwright test --reporter=line
}

# 3. prisma/migration-present
forge_check_meta_3() {
  c_id='prisma/migration-present'; c_stage=migration; c_tools='prisma'
  c_when=1; c_localdb=1; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_3() {
  return 0
}
forge_when_3() { case $1 in prisma/schema.prisma) return 0 ;; esac; return 1; }
forge_check_run_3() {
if ! grep -q shadowDatabaseUrl prisma.config.ts 2>/dev/null; then echo "forge:prisma/migration-present skipped: no shadowDatabaseUrl in prisma.config.ts"; else prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code; fi
}

# 4. prisma/validate
forge_check_meta_4() {
  c_id='prisma/validate'; c_stage=migration; c_tools='prisma'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_4() {
  return 0
}
forge_when_4() { case $1 in prisma/schema.prisma) return 0 ;; esac; return 1; }
forge_check_run_4() {
prisma validate
}

# 5. typescript/format-lint
forge_check_meta_5() {
  c_id='typescript/format-lint'; c_stage=lint; c_tools='biome'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1
}
forge_scope_5() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}
forge_when_5() { return 1; }
forge_check_run_5() {
biome ci .
}
forge_check_changed_5() {
biome check --write --no-errors-on-unmatched $FORGE_FILES
}

# 6. typescript/typecheck
