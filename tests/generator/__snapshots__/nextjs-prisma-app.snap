                kind: expression_statement
                nthChild: 1
                regex: ^["']use client["'];?$

===== .forge/ast-grep/rules/typescript/nextjs/react/server-functions-async.yml
# Generated by forge from typescript/nextjs/react/server-functions-async (mode: forbid).
id: typescript/nextjs/react/server-functions-async
language: Tsx
severity: error
message: "forge:typescript/nextjs/react/server-functions-async A 'use server' file exports only async functions (and types): no sync function, class, or literal value such as export const LIMIT = 10 (a build error). Move constants to another module."
rule:
