if [ -n "$FORGE_FORBID" ] && [ -f .forge/ast-grep/sgconfig.yml ]; then
  astgrep scan -c .forge/ast-grep/sgconfig.yml --filter "^($FORGE_FORBID)\$" --report-style short "$file" 2>/dev/null \
    | grep -E '^[^[:space:]]+:[0-9]+:[0-9]+: ' \
    | sed -E 's/^([^[:space:]]+:[0-9]+:[0-9]+): [a-z]+\[[^]]*\]: forge:([^[:space:]]+) (.*)$/forge:\2 \1 \3/' >> "$FORGE_TMP/report"
fi
[ -s "$FORGE_TMP/report" ] || exit 0
ctx=$(first_lines 20 < "$FORGE_TMP/report" | json_escape)
printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' "$ctx"
exit 0

