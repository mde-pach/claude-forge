# 8. typescript/format-lint
forge_check_meta_8() {
  c_id='typescript/format-lint'; c_stage=lint; c_tools='biome'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1; c_fix=0; c_fmt=1; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_8() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}
forge_when_8() { return 1; }
forge_check_run_8() {
biome ci .
}
