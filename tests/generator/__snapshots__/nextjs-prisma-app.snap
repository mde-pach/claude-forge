utils:
  not-a-server-function:
    any:
      - kind: arrow_function
        not:
          regex: ^async
      - kind: function_expression
        not:
          regex: ^async
      - kind: number
      - kind: string
      - kind: template_string
      - kind: object
      - kind: array
      - kind: "true"
      - kind: "false"
      - kind: "null"
      - kind: regex
      - kind: new_expression
      - kind: class

