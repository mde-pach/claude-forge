===== .claude/skills/forge-project/scripts/session-start.sh
#!/bin/sh
# Generated by forge. SessionStart: <= 20 lines of repository context.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
IFS='
'

# the generated checks and the engine modules they use (forge apply writes them next to this script)
. "$dir/checks.sh"

branch=$(git branch --show-current 2>/dev/null)
[ -n "$branch" ] || branch="(detached $(git rev-parse --short HEAD 2>/dev/null))"
git status --porcelain --untracked-files=all 2>/dev/null | sed -e 's/^...//' -e 's/^.* -> //' > "${TMPDIR:-/tmp}/forge-ss.$$"
n=$(awk 'END { print NR }' "${TMPDIR:-/tmp}/forge-ss.$$")
printf 'forge: branch %s, %s changed files\n' "$branch" "$n"
first_lines 10 < "${TMPDIR:-/tmp}/forge-ss.$$" | sed 's/^/  /'
rm -f "${TMPDIR:-/tmp}/forge-ss.$$"
if git rev-parse --verify -q HEAD >/dev/null; then
  printf 'forge: last commits\n'
  git log -5 --format='%h %s' 2>/dev/null | cut -c 1-72 | sed 's/^/  /'
fi
printf 'forge: packs git, secrets, supply-chain, typescript, typescript/bun, typescript/nextjs, typescript/nextjs/react, typescript/playwright, typescript/prisma, typescript/react, typescript/vitest, typescript/zod\n'

# the types engines the rules use start now, in the background, so the first edit
# does not wait for them (§15.3); this session is registered with them
if [ -n "$FORGE_TYPES_LANGS" ] && forge_state_dir; then
  for _ss_l in $FORGE_TYPES_LANGS; do
    ( forge_types_up "$_ss_l" ) < /dev/null > /dev/null 2>&1 &
  done
fi

missing=$(forge_missing_tools)
state=$FORGE_STATE/missing-tools
if [ -n "$missing" ]; then
  if [ "$missing" != "$(cat "$state" 2>/dev/null)" ]; then
    printf 'forge: missing tools (checks using them are skipped): %s\n' "$missing"
    forge_state_dir && printf '%s\n' "$missing" > "$state"
  fi
else
  rm -f "$state" 2>/dev/null
fi

# what the installed tool versions cannot do (§16.3), once until it changes
report=$(forge_tool_report)
state=$FORGE_STATE/tool-report
if [ -n "$report" ]; then
  if [ "$report" != "$(cat "$state" 2>/dev/null)" ]; then
    printf 'forge: tool versions (what they cannot do is not enforced):\n'
    printf '%s\n' "$report" | first_lines 4 | cut -c 1-400 | sed 's/^/  /'
    forge_state_dir && printf '%s\n' "$report" > "$state"
  fi
else
  rm -f "$state" 2>/dev/null
fi
exit 0

