#!/bin/sh
# Generated by forge. PostToolUse(Edit|Write): formats the edited file silently,
# lints it and runs the ast-grep forbid rules on it. Findings on lines added
# during this turn (or since HEAD, before the first prompt) go back to Claude as
# additionalContext (<= 20 lines). Nothing on success.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
file=$(json_get file_path)
[ -n "$file" ] || exit 0
file=$(rel_path "$file") || exit 0
[ -f "$file" ] || exit 0
case $file in .forge/*|.claude/*|.git/*|node_modules/*|.venv/*) exit 0 ;; esac
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-edit.XXXXXX") || exit 0
trap 'rm -rf "$FORGE_TMP"' EXIT HUP INT TERM

# ---- generated checks
# Project tools used in check commands, resolved through tool().
biome() { forge_exec_tool biome "$@"; }
tsc() { forge_exec_tool tsc "$@"; }
prisma() { forge_exec_tool prisma "$@"; }
vitest() { forge_exec_tool vitest "$@"; }
playwright() { forge_exec_tool playwright "$@"; }
FORGE_NCHECKS=11

# 1. typescript/bun/lock-sync
forge_check_meta_1() {
  c_id='typescript/bun/lock-sync'; c_stage=lint; c_tools='bun'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_1() {
  return 0
}
forge_when_1() { case $1 in package.json) return 0 ;; esac; return 1; }
forge_check_run_1() {
bun install --frozen-lockfile
}

# 2. typescript/format-lint
forge_check_meta_2() {
  c_id='typescript/format-lint'; c_stage=lint; c_tools='biome'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1
}
forge_scope_2() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}
forge_when_2() { return 1; }
forge_check_run_2() {
biome ci .
}
forge_check_changed_2() {
biome check --write --no-errors-on-unmatched $FORGE_FILES
}

# 3. typescript/no-ignore-deprecations
forge_check_meta_3() {
  c_id='typescript/no-ignore-deprecations'; c_stage=lint; c_tools=''
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_3() {
  case $1 in tsconfig*.json|*/tsconfig*.json) ;; *) return 1 ;; esac
  return 0
}
forge_when_3() { case $1 in tsconfig*.json|*/tsconfig*.json) return 0 ;; esac; return 1; }
forge_check_run_3() {
! grep -n '"ignoreDeprecations"' /dev/null $(git ls-files '*tsconfig*.json')
}

# 4. typescript/playwright/run
forge_check_meta_4() {
  c_id='typescript/playwright/run'; c_stage=test; c_tools='playwright'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_4() {
  return 0
}
forge_when_4() { case $1 in e2e/*|playwright.config.*) return 0 ;; esac; return 1; }
forge_check_run_4() {
playwright test --reporter=line
}

# 5. typescript/prisma/client-generator
forge_check_meta_5() {
  c_id='typescript/prisma/client-generator'; c_stage=lint; c_tools=''
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
