# 30. typescript/prisma/destructive-migration
forge_check_meta_30() {
  c_id='typescript/prisma/destructive-migration'; c_stage=migration; c_tools=''
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_30() {
  case $1 in prisma/migrations/migration.sql|prisma/migrations/*/migration.sql) ;; *) return 1 ;; esac
  return 0
}
forge_when_30() { case $1 in prisma/migrations/*) return 0 ;; esac; return 1; }
forge_check_run_30() {
set -f
_dm_files=$FORGE_FILES
[ -n "$_dm_files" ] || _dm_files=$(git ls-files 'prisma/migrations/*/migration.sql' | sort | tail -n 1)
[ -n "$_dm_files" ] || { set +f; return 0; }
# shellcheck disable=SC2086
forge_prisma_drops $_dm_files > "$FORGE_TMP/drops"
set +f
while IFS= read -r _dm_l; do
  [ -f forge.yaml ] && grep -qF -- "$_dm_l" forge.yaml && continue
  printf '%s\n' "$_dm_l"
done < "$FORGE_TMP/drops" > "$FORGE_TMP/drops.open"
[ -s "$FORGE_TMP/drops.open" ] || return 0
cat "$FORGE_TMP/drops.open"
printf 'Drop a column or table only after a deploy in which no code reads it (expand and contract), or have the user accept it in forge.yaml: accept: [{rule: typescript/prisma/destructive-migration, change: '"'"'<line above>'"'"', reason: "..."}]\n'
return 1

}

