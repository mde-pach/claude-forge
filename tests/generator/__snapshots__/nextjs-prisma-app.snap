playwright	test	typescript/playwright/run
prisma	migrations-check	typescript/prisma/migration-present
prisma	validate	typescript/prisma/validate
tsc	typecheck-incremental	typescript/typecheck
vitest	test	typescript/vitest/run
vitest	test-changed	typescript/vitest/run
vitest	test-files	typescript/vitest/run'

