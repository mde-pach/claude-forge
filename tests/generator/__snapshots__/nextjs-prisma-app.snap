===== .forge/ast-grep/rule-tests/typescript-prisma-no-network-in-transaction-test.yml
id: typescript/prisma/no-network-in-transaction
valid:
  - |
    const order = await prisma.$transaction(async (tx) => {
      const created = await tx.order.create({ data });
      await tx.stock.update({ where: { id: data.productId }, data: { count: { decrement: 1 } } });
      return created;
    });
    await fetch("https://hooks.example.com/orders", { method: "POST", body: JSON.stringify(order) });
  - |
    await prisma.$transaction([prisma.audit.create({ data }), prisma.post.delete({ where: { id } })]);
  - |
    await prisma.$transaction(async (tx) => {
      const m = openai.model.toUpperCase();
      await tx.audit.create({ data: { m } });
    });
  - |
    import { got } from "./got-like";

    await prisma.$transaction(async (tx) => {
      await got(tx);
    });
invalid:
  - |
    await prisma.$transaction(async (tx) => {
      const order = await tx.order.create({ data });
      await fetch("https://hooks.example.com/orders", { method: "POST", body: JSON.stringify(order) });
    });
  - |
    import ky from "ky";

    await prisma.$transaction(async (tx) => {
      const order = await tx.order.create({ data });
      await ky.post("https://hooks.example.com/orders", { json: order });
    });
  - |
    import { request as send } from "undici";

    await prisma.$transaction(async (tx) => {
      await tx.order.create({ data });
      await send("https://hooks.example.com/orders");
    });
  - |
    import axios from "axios";

    await db.$transaction(async function (tx) {
      await Promise.all(items.map(async (item) => axios.post(syncUrl, item)));
    });

===== .forge/ast-grep/rule-tests/typescript-prisma-no-query-in-loop-test.yml
id: typescript/prisma/no-query-in-loop
valid: []
invalid:
  - |
    import type { PrismaPromise } from "@prisma/client/runtime/client";

    declare const db: { post: { findMany(args: { where: { authorId: number } }): PrismaPromise<{ id: number }[]> } };

    export async function postsOf(authorIds: number[]): Promise<number> {
      let n = 0;
      for (const authorId of authorIds) {
        const posts = await db.post.findMany({ where: { authorId } });
        n += posts.length;
      }
      return n;
    }
  - |
    import type { PrismaPromise } from "@prisma/client/runtime/client";

    declare const db: { user: { findUnique(args: { where: { id: number } }): PrismaPromise<{ id: number } | null> } };

    export function users(ids: number[]) {
      return Promise.all(ids.map(async (id) => await db.user.findUnique({ where: { id } })));
    }
  - |
    import * as runtime from "@prisma/client/runtime/client";

    // as the generated client declares them
    type PrismaPromise<T> = runtime.Types.Public.PrismaPromise<T>;
    interface Prisma__UserClient<T> extends PrismaPromise<T> {}

    declare const db: { user: { findUnique(args: { where: { id: number } }): Prisma__UserClient<{ id: number } | null> } };

    export async function users(ids: number[]) {
      const out = [];
      for (const id of ids) out.push(await db.user.findUnique({ where: { id } }));
      return out;
    }

