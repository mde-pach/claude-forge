# Generated by forge from typescript/vitest/no-tautological-expect (mode: forbid).
id: typescript/vitest/no-tautological-expect
language: Tsx
severity: error
message: forge:typescript/vitest/no-tautological-expect Assertions test something. No expect() on a literal, such as expect(true).toBe(true).
files:
  - "**/*.test.*"
  - "**/*.spec.*"
  - "**/__tests__/**"
ignores:
  - e2e/**
rule:
  kind: call_expression
  has:
    field: function
    kind: member_expression
    has:
      field: object
      kind: call_expression
      all:
        - has:
            field: function
            regex: ^expect$
        - has:
            field: arguments
            has:
              nthChild: 1
              any:
                - kind: "true"
                - kind: "false"
                - kind: "null"
                - kind: undefined
                - kind: number
                - kind: string

===== .forge/ast-grep/rules/typescript/vitest/no-test-env-branch.yml
# Generated by forge from typescript/vitest/no-test-env-branch (mode: forbid).
