        stopBy: end
        any:
          - kind: arrow_function
          - kind: function_expression
        inside:
          kind: arguments
          inside:
            kind: call_expression
            has:
              field: function
              kind: member_expression
              has:
                field: property
                regex: ^(map|forEach|flatMap)$
metadata:
  forge_where:
    Q:
      type:
        package: "@prisma/client"
        name: PrismaPromise

