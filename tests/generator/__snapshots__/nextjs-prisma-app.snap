#!/bin/sh
# Generated by forge. Stop hook: runs .forge/check.sh --changed unless the
# working tree is unchanged since the last pass; hands over after 3 blocks.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
[ -f .forge/check.sh ] || { printf '{"decision":"block","reason":"forge:forge/integrity .forge/check.sh is missing (run forge apply)"}\n'; exit 0; }
mkdir -p .forge/state 2>/dev/null

forge_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{ print $1 }'
  else openssl dgst -sha256 -r | awk '{ print $1 }'
  fi
}
# Hash of git diff HEAD plus the untracked files (names and contents).
tree_hash() {
  {
    if git rev-parse --verify -q HEAD >/dev/null; then git diff HEAD --binary 2>/dev/null; else git diff --cached --binary 2>/dev/null; fi
    git ls-files --others --exclude-standard 2>/dev/null | while IFS= read -r f; do
      printf '%s ' "$f"; git hash-object -- "$f" 2>/dev/null || printf '\n'
    done
  } | forge_sha256
}

session=$(json_get session_id | tr -c 'A-Za-z0-9_-' '_')
[ -n "$session" ] || session=default
counter=.forge/state/$session
hash=$(tree_hash)
[ "$hash" = "$(cat .forge/state/last-pass 2>/dev/null)" ] && exit 0

count=$(cat "$counter" 2>/dev/null)
case $count in ''|*[!0-9]*) count=0 ;; esac
if [ "$count" -ge 3 ]; then
  rm -f "$counter"
  printf '{"systemMessage":"forge: check failed 3 times. Handing over to you."}\n'
  exit 0
fi

out=$(sh .forge/check.sh --changed 2>&1)
if [ $? -eq 0 ]; then
  tree_hash > .forge/state/last-pass
  rm -f "$counter"
  exit 0
fi
printf '%s\n' "$((count + 1))" > "$counter"
reason=$(printf '%s\n' "$out" | first_lines 20 | json_escape)
printf '{"decision":"block","reason":"%s"}\n' "$reason"
exit 0

