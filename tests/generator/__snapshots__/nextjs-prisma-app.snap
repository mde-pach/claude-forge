FORGE_STATE=$(forge_state_of "$(pwd -P)")


FORGE_FORBID='typescript/bun/no-shell-raw|typescript/cors-credentials-wildcard|typescript/nextjs/cookies-set-in-render|typescript/nextjs/image-remote-patterns-strict|typescript/nextjs/image-unsafe-options|typescript/nextjs/no-ignore-build-errors|typescript/nextjs/no-legacy-image-config|typescript/nextjs/no-next-head-in-app|typescript/nextjs/no-next-router|typescript/nextjs/no-pages-data|typescript/nextjs/no-public-secret-env|typescript/nextjs/no-redirect-in-try|typescript/nextjs/no-request-apis-in-use-cache|typescript/nextjs/proxy-exports|typescript/nextjs/proxy-not-middleware|typescript/nextjs/react/client-env-public-only|typescript/nextjs/react/client-hooks|typescript/nextjs/react/no-server-in-client|typescript/nextjs/react/no-ssr-false-in-server|typescript/nextjs/react/server-functions-async|typescript/nextjs/revalidate-tag-profile|typescript/nextjs/stable-cache-imports|typescript/no-deprecated|typescript/no-double-assertion|typescript/no-hardcoded-session-secret|typescript/no-html-sinks|typescript/no-object-literal-assertion|typescript/no-stub|typescript/no-swallowed-catch|typescript/no-ts-nocheck|typescript/no-unchecked-json|typescript/playwright/locators|typescript/playwright/no-wait-for-timeout|typescript/postmessage-origin|typescript/prisma/generated-client-import|typescript/prisma/no-middleware|typescript/prisma/no-network-in-transaction|typescript/prisma/no-raw-interpolation|typescript/prisma/no-raw-unsafe|typescript/react/act-from-react|typescript/react/no-prop-types|typescript/react/use-action-state|typescript/ts-expect-error-reason|typescript/vitest/no-exit-zero|typescript/vitest/no-matcher-override|typescript/vitest/no-tautological-expect|typescript/vitest/no-test-env-branch|typescript/zod/error-param|typescript/zod/v4-string-formats'
FORGE_NO_INCREASE='typescript/bun/no-mock-increase|typescript/bun/no-new-skip|typescript/playwright/no-new-skip|typescript/vitest/no-mock-increase|typescript/vitest/no-new-skip'
FORGE_NO_DECREASE='typescript/bun/no-fewer-expects|typescript/vitest/no-fewer-expects'


# The change: changed, existing, deleted, base/, inbase and added in $FORGE_TMP.
forge_change_set || exit 1
if [ "$mode" = --all ]; then
  git ls-files -z --cached --others --exclude-standard 2>/dev/null | tr '\000' '\n' | grep -vE "$FORGE_OWN_ERE" | sort -u > "$FORGE_TMP/scope"
  : > "$FORGE_TMP/scope.tmp"
  while read -r f; do [ -f "$f" ] && printf '%s\n' "$f" >> "$FORGE_TMP/scope.tmp"; done < "$FORGE_TMP/scope"
  mv "$FORGE_TMP/scope.tmp" "$FORGE_TMP/scope"
else
  cp "$FORGE_TMP/existing" "$FORGE_TMP/scope"
fi

fail=0
report() { printf 'forge:%s %s\n' "$1" "$2"; fail=1; }

# 1. Integrity: owned files match .forge/manifest.sha256 ("<sha256>  <path>" lines,
# sha256sum format). JSON files are hashed with spaces, tabs and newlines removed,
# helper scripts also without quotes, commas, semicolons and parentheses, so a
# formatter run is not tampering; any other change is.
forge_owned_hash() {
  case $1 in
    # helper scripts: what a formatter changes (layout, quotes, trailing commas,
    # semicolons, parentheses) is left out, so ruff format or Biome rewriting them is not tampering
    .forge/helpers/*) tr -d " \t\r\n,;()'\"\`" < "$1" | forge_sha256 ;;
    *.json) tr -d ' \t\r\n' < "$1" | forge_sha256 ;;
    *) forge_sha256 < "$1" ;;
  esac
}
# forge_sha256_files <file>...: "<hex><2 chars><path>" per file, in one run (sha256sum
# format; openssl's "<hex> *<path>" has the same layout).
forge_sha256_files() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$@"
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$@"
  else openssl dgst -sha256 -r "$@"
  fi
}
forge_integrity() {
  manifest=.forge/manifest.sha256
  [ -f "$manifest" ] || { report forge/integrity "$manifest is missing (run forge apply)"; return; }
  awk '/^[0-9a-f]+  ./ { h = $1; p = substr($0, length(h) + 3); if (p ~ /^[.](forge|claude)\//) print p "\t" h }' "$manifest" > "$FORGE_TMP/owned"
  # "<path><TAB><hash>" lines in $FORGE_TMP/have ("-" for a missing file, none for one
  # that cannot be read): one hashing run for every owned file but JSON and helper scripts
  # (hashed without what a formatter changes: forge_owned_hash)
  : > "$FORGE_TMP/have"; : > "$FORGE_TMP/plain"
  while IFS='	' read -r path hash; do
    [ -n "$path" ] || continue
    [ -f "$path" ] || { printf '%s\t-\n' "$path" >> "$FORGE_TMP/have"; continue; }
    case $path in
      *.json|.forge/helpers/*) printf '%s\t%s\n' "$path" "$(forge_owned_hash "$path")" >> "$FORGE_TMP/have" ;;
      *) printf '%s\n' "$path" >> "$FORGE_TMP/plain" ;;
    esac
  done < "$FORGE_TMP/owned"
  if [ -s "$FORGE_TMP/plain" ]; then
    set -f
    # shellcheck disable=SC2046
    forge_sha256_files $(cat "$FORGE_TMP/plain") 2>/dev/null | awk '{ h = $1; print substr($0, length(h) + 3) "\t" h }' >> "$FORGE_TMP/have"
    set +f
  fi
  # in manifest order: missing, or modified
  awk -F '\t' 'FILENAME == ARGV[1] { have[$1] = $2; next }
    $1 == "" { next }
    have[$1] == "-" { printf "forge:forge/integrity %s is missing (run forge apply)\n", $1; next }
    have[$1] != $2 { printf "forge:forge/integrity %s was modified (run forge diff)\n", $1 }' "$FORGE_TMP/have" "$FORGE_TMP/owned" > "$FORGE_TMP/integrity"
  cut -f 1 "$FORGE_TMP/owned" > "$FORGE_TMP/owned-paths"
  { find .forge .claude/skills/forge-project -type f 2>/dev/null; find .claude/rules -name 'forge-*.md' -type f 2>/dev/null; } \
    | sed 's|^\./||' | awk 'FILENAME == ARGV[1] { owned[$0] = 1; next }
      /^[.]forge\/(state|rules)\// || $0 == ".forge/forge.lock.json" || $0 == ".forge/manifest.sha256" { next }
      !($0 in owned) { printf "forge:forge/integrity %s is not a forge file (remove it or run forge apply)\n", $0 }' "$FORGE_TMP/owned-paths" - >> "$FORGE_TMP/integrity"
  if [ -s "$FORGE_TMP/integrity" ]; then cat "$FORGE_TMP/integrity"; fail=1; fi
}

# forge_base_name: what the change is compared with, for messages.
forge_base_name() {
  case $mode in
    --turn) printf 'the start of the turn' ;;
    --since) printf 'the merge base with %s' "$FORGE_ARG" ;;
    *) printf 'HEAD' ;;
  esac
}

# 2. Tests and counts: no deleted test files; ast-grep and grep counts compared with the base.
forge_tests_integrity() {
  while read -r f; do
    case $f in
      test_*.py|*/test_*.py|*_test.py|*/conftest.py|conftest.py|tests/*|*.test.*|*.spec.*|*/__tests__/*|e2e/*)
        report forge/deleted-test "$f was deleted" ;;
    esac
  done < "$FORGE_TMP/deleted"
  inc=$FORGE_NO_INCREASE
  [ -n "$FORGE_GREP_NO_INCREASE" ] && inc="${inc:+$inc|}$FORGE_GREP_NO_INCREASE"
  dec=$FORGE_NO_DECREASE
  [ -n "$FORGE_GREP_NO_DECREASE" ] && dec="${dec:+$dec|}$FORGE_GREP_NO_DECREASE"
  [ -n "$inc$dec" ] && [ -s "$FORGE_TMP/existing" ] || return
  grep -vxF -f "$FORGE_TMP/deleted" "$FORGE_TMP/inbase" > "$FORGE_TMP/athead"
  : > "$FORGE_TMP/now"; : > "$FORGE_TMP/then"
  ids=$FORGE_NO_INCREASE
  [ -n "$FORGE_NO_DECREASE" ] && ids="${ids:+$ids|}$FORGE_NO_DECREASE"
  if [ -n "$ids" ]; then
    if forge_counts "$FORGE_ROOT" "$ids" "$FORGE_TMP/existing" > "$FORGE_TMP/now" \
      && { [ ! -s "$FORGE_TMP/athead" ] || forge_counts "$FORGE_TMP/base" "$ids" "$FORGE_TMP/athead" > "$FORGE_TMP/then"; }; then :
    else
      printf 'forge:forge/ast-grep skipped: ast-grep unavailable\n'
      : > "$FORGE_TMP/now"; : > "$FORGE_TMP/then"
    fi
  fi
  forge_grep_counts "$FORGE_ROOT" "$FORGE_TMP/existing" >> "$FORGE_TMP/now"
  forge_grep_counts "$FORGE_TMP/base" "$FORGE_TMP/athead" >> "$FORGE_TMP/then"
  awk -F '\t' -v inc="$inc" -v dec="$dec" '
    BEGIN { n = split(inc, a, "|"); for (i = 1; i <= n; i++) if (a[i] != "") mi[a[i]] = 1
            n = split(dec, b, "|"); for (i = 1; i <= n; i++) if (b[i] != "") md[b[i]] = 1 }
    FILENAME == ARGV[1] { then[$1 "\t" $2] = $3; keys[$1 "\t" $2] = 1; next }
    { now[$1 "\t" $2] = $3; keys[$1 "\t" $2] = 1 }
    END {
      for (k in keys) {
        split(k, p, "\t"); t = then[k] + 0; w = now[k] + 0
        if ((p[1] in mi) && w > t) printf "forge:%s %s: %d -> %d\n", p[1], p[2], t, w
        if ((p[1] in md) && w < t) printf "forge:%s %s: %d -> %d\n", p[1], p[2], t, w
      }
    }' "$FORGE_TMP/then" "$FORGE_TMP/now" | sort > "$FORGE_TMP/countfail"
  if [ -s "$FORGE_TMP/countfail" ]; then cat "$FORGE_TMP/countfail"; fail=1; fi
}

# forge_counts <dir> <id-regex> <file-list>: "rule<TAB>file<TAB>count" lines.
forge_counts() {
  set -f
  # shellcheck disable=SC2046
  ( cd "$1" && forge_do ast-grep scan "$FORGE_ROOT/.forge/ast-grep/sgconfig.yml" --filter "^($2)\$" $(cat "$3") ) > "$FORGE_TMP/json"
  rc=$?
  set +f
  [ "$rc" -le 1 ] || return 1
  grep -oE '"(file|ruleId)":"[^"]*"' "$FORGE_TMP/json" \
    | awk -F '"' '$2 == "file" { f = $4 } $2 == "ruleId" { c[$4 "\t" f]++ } END { for (k in c) print k "\t" c[k] }'
}

# 3. Forbid rules (ast-grep and grep): outside --all, only matches on added lines.
forge_forbid() {
  [ -s "$FORGE_TMP/scope" ] || return
  forge_grep_forbid "$FORGE_TMP/scope" > "$FORGE_TMP/forbid.out"
  if [ -n "$FORGE_FORBID" ]; then
    set -f
    # shellcheck disable=SC2046
    forge_do ast-grep scan-meta .forge/ast-grep/sgconfig.yml --filter "^($FORGE_FORBID)\$" $(cat "$FORGE_TMP/scope") > "$FORGE_TMP/forbid"
    rc=$?
    set +f
    if [ "$rc" -gt 1 ]; then printf 'forge:forge/ast-grep skipped: ast-grep unavailable\n'
    else
      # rules with type constraints: only the matches the types engine confirms (§15.1)
      forge_sg_report "$FORGE_TMP/forbid" json > "$FORGE_TMP/forbid.added"
      forge_types_changed $(cat "$FORGE_TMP/changed")
      forge_types_filter "$FORGE_TMP/forbid.added" >> "$FORGE_TMP/forbid.out"
      forge_sg_report "$FORGE_TMP/forbid.added" >> "$FORGE_TMP/forbid.out"
    fi
  fi
  if [ -s "$FORGE_TMP/forbid.out" ]; then cat "$FORGE_TMP/forbid.out"; fail=1; fi
  return 0
}

# forge_end <status>: advice (§10.7) last, after every failing check, then exit.
forge_end() { [ ! -s "$FORGE_TMP/advice.out" ] || cat "$FORGE_TMP/advice.out"; exit "$1"; }
forge_step() { [ "$fail" -eq 0 ] || forge_end "$fail"; "$@"; }

forge_step forge_integrity
forge_step forge_tests_integrity
forge_step forge_forbid
forge_step forge_run_stage format
forge_step forge_run_stage lint
# generated code first: a stale one would only make the typecheck repeat it (§10.1)
forge_step forge_run_stage codegen
forge_step forge_run_stage typecheck
forge_step forge_run_stage migration
forge_step forge_run_stage test
# advice (§10.7) does not stop the steps after it; when it is the only failure, exit 4
[ "$fail" -ne 0 ] || [ "${advised:-0}" -eq 0 ] || fail=4
forge_end "$fail"

