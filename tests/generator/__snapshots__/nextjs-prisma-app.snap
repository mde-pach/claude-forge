          kind: catch_clause
          not:
            has:
              stopBy: end
              kind: call_expression
              has:
                field: function
                regex: ^unstable_rethrow$
    - not:
        inside:
          any:
            - kind: catch_clause
            - kind: finally_clause
          stopBy:
            kind: try_statement
    - inside:
        kind: program
        stopBy: end
        has:
          kind: import_statement
          has:
