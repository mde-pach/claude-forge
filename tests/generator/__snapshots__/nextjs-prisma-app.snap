  - |
    /* @ts-expect-error */
    const y: number = "b";

===== .forge/ast-grep/rule-tests/typescript-vitest-no-fewer-expects-test.yml
id: typescript/vitest/no-fewer-expects
valid:
  - it("a", () => { f(); });
invalid:
  - it("a", () => { expect(f()).toBe(1); });

===== .forge/ast-grep/rule-tests/typescript-vitest-no-mock-increase-test.yml
id: typescript/vitest/no-mock-increase
valid:
  - |
    import { expect, it } from "vitest";

    it("charges", () => {
      const gateway = new FakeGateway();
      charge(gateway);
      expect(gateway.charged).toBe(1);
    });
  - |
    import { expect, it, vi } from "vitest";

    it("reads the zone", () => {
      vi.stubEnv("TZ", "UTC");
      expect(zone()).toBe("UTC");
    });
  - |
    import { expect, it } from "vitest";
    import { fetcher as v } from "./http";

    it("fetches", async () => {
      expect(await v.fn()).toBe(1);
    });
invalid:
  - |
    import { vi } from "vitest";

    vi.mock("./billing");
  - |
    import { expect, it, vi } from "vitest";

    it("charges", () => {
      const pay = vi.fn();
      charge(pay);
      expect(pay).toHaveBeenCalled();
    });
  - |
    import { expect, it, vi as v } from "vitest";

    it("charges", () => {
      const pay = v.fn();
      charge(pay);
      expect(pay).toHaveBeenCalled();
    });

===== .forge/ast-grep/rule-tests/typescript-vitest-no-new-skip-test.yml
id: typescript/vitest/no-new-skip
valid:
  - it("a", () => { expect(1).toBe(1); });
invalid:
  - it.skip("a", () => {});
  - test.todo("later");
  - describe.only("x", () => {});
  - it.skipIf(process.platform === "win32")("a", () => {});
  - describe.runIf(ci)("b", () => {});

===== .forge/ast-grep/rule-tests/typescript-vitest-no-tautological-expect-test.yml
id: typescript/vitest/no-tautological-expect
valid:
  - it("a", () => { expect(sum(1, 1)).toBe(2); });
  - it("b", () => { expect(result).toBe(true); });
invalid:
  - it("a", () => { expect(true).toBe(true); });
  - it("b", () => { expect(1).toEqual(1); });
  - it("c", () => { expect("x").toBeTruthy(); });

===== .forge/ast-grep/rule-tests/typescript-vitest-no-test-env-branch-test.yml
