===== .forge/ast-grep/rules/typescript/prisma/no-network-in-transaction.yml
# Generated by forge from typescript/prisma/no-network-in-transaction (mode: forbid).
id: typescript/prisma/no-network-in-transaction
language: Tsx
severity: error
message: "forge:typescript/prisma/no-network-in-transaction An interactive transaction callback ($transaction(async (tx) => ...)) makes no HTTP calls: the global fetch / $fetch, or a function or method of axios, got, ky, ofetch, node-fetch or undici imported in the file; call them before or after the transaction. SDK clients and the project's own helpers are not recognised."
rule:
  kind: call_expression
  any:
    - has:
        field: function
        regex: ^(fetch|globalThis\.fetch|\$fetch)$
    - all:
        - any:
            - has:
                field: function
                kind: identifier
                pattern: $C
            - has:
                field: function
                kind: member_expression
                has:
                  field: object
                  kind: identifier
                  pattern: $C
        - inside:
            kind: program
            stopBy: end
            has:
              kind: import_statement
              all:
                - has:
                    field: source
                    regex: ^["'](axios|got|ky|ofetch|node-fetch|undici)["']$
                - has:
                    kind: import_clause
                    has:
                      stopBy: end
                      kind: identifier
                      pattern: $C
  inside:
    stopBy: end
    any:
      - kind: arrow_function
      - kind: function_expression
    inside:
      kind: arguments
      inside:
        kind: call_expression
        has:
          field: function
          regex: \.\$transaction$

