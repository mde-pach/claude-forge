===== .forge/ast-grep/rule-tests/python-no-secret-logging-test.yml
id: python/no-secret-logging
valid:
  - |
    def usage(max_tokens: int, has_token: bool) -> None:
        logger.info("budget %s, authenticated %s", max_tokens, has_token)
  - |
    def refresh(token: str) -> None:
        logger.info("refreshing token ending %s", token[-4:])
  - |
    def page(next_page_token: str) -> None:
        logger.debug("next page %s", next_page_token)
  - |
    def reset(user) -> None:
        logger.info("password reset for %s", user.id)
        raise ValueError("password is too short")
  - |
    def store(password_hash: str) -> None:
        logger.debug("stored hash %s", password_hash)
  - |
    def remember(token: str) -> None:
        cache.set("token", token)
invalid:
  - |
    def refresh(token: str) -> None:
        logger.info(f"refreshing with token={token}")
  - |
    def call(api_key: str) -> None:
        log.debug("calling with %s", api_key)
  - |
    def check(request) -> None:
        logging.warning("header %s", request.headers["Authorization"])
  - |
    def connect(password: str) -> None:
        raise ConnectionError("login failed with " + password)
  - |
    def boot() -> None:
        print(f"key: {settings.SECRET_KEY}")
  - |
    def login(user, password: str) -> None:
        log.info("login", user=user.id, password=password)
  - |
    def audit(self, access_token: str) -> None:
        self.logger.error("refused", extra={"access_token": access_token})

