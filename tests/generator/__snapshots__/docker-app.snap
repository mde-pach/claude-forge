# Generated by forge from docker/compose/datastore-loopback (mode: forbid).
id: docker/compose/datastore-loopback
language: Yaml
severity: error
message: "forge:docker/compose/datastore-loopback Published database and broker ports (5432, 3306, 6379, 27017, 9200, 5672, 11211, 1433) bind to 127.0.0.1; Docker-published ports bypass ufw and firewalld. Short syntax only: a long-syntax ports entry is not checked."
files:
  - "**/compose*.yml"
  - "**/compose*.yaml"
  - "**/docker-compose*.yml"
  - "**/docker-compose*.yaml"
rule:
  all:
    - any:
        - kind: string_scalar
        - kind: double_quote_scalar
        - kind: single_quote_scalar
        - kind: integer_scalar
    - regex: (^["']?|:)(5432|3306|6379|27017|9200|5672|11211|1433)(/(tcp|udp))?["']?$
    - not:
        regex: "^[\"']?(127\\.0\\.0\\.1|localhost|\\[::1\\]):"
    - inside:
        stopBy: end
        kind: block_mapping_pair
        has:
          field: key
          regex: ^["']?(ports)["']?$

