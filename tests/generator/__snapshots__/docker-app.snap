    @contextmanager
    def settings(values):
        values["debug"] = True
        yield values
  - |
    def numbers():
        yield 1
        print("after")
invalid:
  - |
    from contextlib import contextmanager


    @contextmanager
    def connection(pool):
        conn = pool.acquire()
        yield conn
        pool.release(conn)
  - |
    import contextlib


    @contextlib.asynccontextmanager
    async def lifespan(app):
        await app.start()
        state = yield
        await app.stop()

