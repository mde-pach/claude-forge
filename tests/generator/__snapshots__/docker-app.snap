# 5. docker/exec-form
forge_check_meta_5() {
  c_id='docker/exec-form'; c_stage=lint; c_tools='uvx'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_dirs=''
}
forge_scope_5() {
  case $1 in Dockerfile|*/Dockerfile|Dockerfile.*|*/Dockerfile.*|*.Dockerfile|*/*.Dockerfile|Containerfile|*/Containerfile) ;; *) return 1 ;; esac
  return 0
}
forge_when_5() { case $1 in Dockerfile|*/Dockerfile|Dockerfile.*|*/Dockerfile.*|*.Dockerfile|*/*.Dockerfile|Containerfile|*/Containerfile) return 0 ;; esac; return 1; }
forge_check_run_5() {
forge_hadolint DL3025
