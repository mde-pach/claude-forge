# Generated by forge from python/no-secret-logging (mode: forbid).
id: python/no-secret-logging
language: Python
severity: error
message: "forge:python/no-secret-logging No secret in a log line, print() or exception message: a variable, attribute or header named like a token, secret, password, API key, private or access key, authorization or credentials, passed to a logger call, print() or a raised exception (directly, in an f-string, with + or as a keyword value) is rejected. Log an id or a masked value instead; a name such as max_tokens, has_token, password_hash or next_page_token is not a secret."
ignores:
  - "**/tests/**"
  - "**/test_*.py"
  - "**/conftest.py"
  - "**/management/commands/**"
  - scripts/**
  - "**/cli.py"
rule:
  matches: secret-name
  any:
    - inside:
        kind: argument_list
        stopBy: neighbor
        inside:
          matches: sink
          stopBy: neighbor
    - inside:
        kind: keyword_argument
        field: value
        stopBy: neighbor
        inside:
          kind: argument_list
          stopBy: neighbor
          inside:
            matches: sink
            stopBy: neighbor
    - inside:
        kind: interpolation
        stopBy: neighbor
        inside:
          kind: string
          stopBy: neighbor
          inside:
            stopBy: end
            kind: argument_list
            inside:
              matches: sink
              stopBy: neighbor
    - inside:
        kind: binary_operator
        stopBy: neighbor
        inside:
          kind: argument_list
          stopBy: neighbor
          inside:
            matches: sink
            stopBy: neighbor
    - inside:
        kind: pair
        field: value
        stopBy: neighbor
        inside:
          kind: dictionary
          stopBy: neighbor
          inside:
            kind: keyword_argument
            stopBy: neighbor
            inside:
              kind: argument_list
              stopBy: neighbor
              inside:
                matches: sink
                stopBy: neighbor
utils:
  secret-name:
    any:
      - kind: identifier
        regex: (?i)(^|_)(token|secret|password|passwd|pwd|api_?key|apikey|secret_?key|private_?key|access_?key|authorization|credentials?)$
      - kind: attribute
        has:
          field: attribute
          regex: (?i)(^|_)(token|secret|password|passwd|pwd|api_?key|apikey|secret_?key|private_?key|access_?key|authorization|credentials?)$
      - kind: subscript
        has:
          field: subscript
          regex: (?i)^["'](x-)?(authorization|api-?key|token|password|secret|cookie|x-api-key)["']$
    not:
      regex: (?i)(^|[._])(has|is|use|should|needs?|num|max|min|count|total|len|page|next|prev|continuation|pagination|cursor|sync|cancel|cancellation|csrf|xsrf)_[a-z_]*$
  sink:
    any:
      - kind: call
        has:
          field: function
          regex: ^print$|(?i)^([A-Za-z_][A-Za-z0-9_]*\.)*_?(log|logger|logging)\.(debug|info|warning|warn|error|exception|critical|fatal|log|msg)$
      - kind: call
        inside:
          kind: raise_statement
          stopBy: neighbor

===== .forge/ast-grep/rules/python/no-stub.yml
# Generated by forge from python/no-stub (mode: forbid).
id: python/no-stub
language: Python
severity: error
message: forge:python/no-stub No stub left behind. A function whose body is only pass or ..., or that raises NotImplementedError, is a stub unless it is abstract, an overload or part of a Protocol (stub files and migrations are exempt).
ignores:
  - "**/*.pyi"
  - "**/alembic/versions/**"
  - "**/migrations/**"
rule:
  all:
    - any:
        - kind: function_definition
          has:
            field: body
            all:
              - has:
                  any:
                    - kind: pass_statement
                    - kind: expression_statement
                      has:
                        kind: ellipsis
              - not:
                  has:
                    not:
                      any:
                        - kind: pass_statement
                        - kind: comment
                        - kind: expression_statement
                          has:
                            any:
                              - kind: ellipsis
                              - kind: string
        - kind: raise_statement
          regex: ^raise\s+NotImplementedError\b
    - not:
        inside:
          stopBy: end
          kind: decorated_definition
          has:
            kind: decorator
            regex: \b(abstractmethod|abstractproperty|overload)\b
    - not:
        inside:
          stopBy: end
          kind: class_definition
          has:
            field: superclasses
            regex: \b(Protocol|ABC)\b

