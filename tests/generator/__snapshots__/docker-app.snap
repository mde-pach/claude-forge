        field: function
        regex: unpack_archive$
  not:
    has:
      field: arguments
      has:
        kind: keyword_argument
        regex: ^filter[[:space:]]*=
metadata:
  forge_where:
    T:
      type:
        module: tarfile
        name: TarFile
    U:
      declared:
        module: shutil
        name: unpack_archive

