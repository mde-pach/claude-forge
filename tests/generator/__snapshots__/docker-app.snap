# Generated by forge from python/hmac-compare (mode: forbid).
id: python/hmac-compare
language: Python
severity: error
message: "forge:python/hmac-compare An HMAC digest is compared with hmac.compare_digest(), never == or !=: == stops at the first differing byte, so its timing lets an attacker forge a webhook signature byte by byte."
rule:
  kind: comparison_operator
  has:
    field: operators
    regex: ^(==|!=)$
  all:
    - has:
        any:
          - pattern: $H.hexdigest()
          - pattern: $H.digest()
          - kind: call
            pattern: $D($$$)
            has:
              field: function
              regex: digest$
metadata:
  forge_where:
    H:
      type:
        module: hmac
        name: HMAC
    D:
      declared:
        module: hmac
        name: digest

===== .forge/ast-grep/rules/python/lazy-log-args.yml
# Generated by forge from python/lazy-log-args (mode: forbid).
id: python/lazy-log-args
language: Python
severity: error
message: "forge:python/lazy-log-args A logging Logger or LoggerAdapter call (debug, info, warning, error, exception, critical, and log's message) passes a constant format string and its arguments (log.info(\"user %s\", uid)), not an f-string, .format() or %-formatted string: the message would be built even when the level is off, and log tools could not group it."
rule:
  kind: call
  any:
    - all:
        - pattern: $L.$M($$$)
        - has:
            field: arguments
            has:
              nthChild: 1
              matches: eager
    - all:
        - pattern: $L.log($$$)
        - has:
            field: arguments
            has:
              nthChild: 2
              matches: eager
constraints:
  M:
    regex: ^(debug|info|warning|error|exception|critical)$
utils:
  eager:
    any:
      - kind: string
        regex: ^[rRbBuU]?[fF]
      - kind: call
        has:
          field: function
          kind: attribute
          regex: \.format$
      - kind: binary_operator
        regex: ^[\s\S]*%[\s\S]*$
        has:
          field: left
          kind: string
metadata:
  forge_where:
    L:
      type:
        module: logging
        name:
          - Logger
          - LoggerAdapter

