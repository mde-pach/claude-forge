id: python/contextmanager-finally
valid:
  - |
    from contextlib import contextmanager


    @contextmanager
    def connection(pool):
        conn = pool.acquire()
        try:
            yield conn
        finally:
            pool.release(conn)
  - |
    from contextlib import contextmanager


    @contextmanager
    def locked(lock):
        with lock:
            yield
