  - "**/tests/**"
  - "**/test_*.py"
  - "**/conftest.py"
  - "**/management/commands/**"
  - scripts/**
  - "**/cli.py"
rule:
  matches: secret-name
  any:
    - inside:
        kind: argument_list
        stopBy: neighbor
        inside:
          matches: sink
          stopBy: neighbor
    - inside:
        kind: keyword_argument
        field: value
        stopBy: neighbor
        inside:
          kind: argument_list
          stopBy: neighbor
          inside:
            matches: sink
            stopBy: neighbor
    - inside:
        kind: interpolation
        stopBy: neighbor
        inside:
          kind: string
          stopBy: neighbor
          inside:
            stopBy: end
            kind: argument_list
            inside:
              matches: sink
              stopBy: neighbor
    - inside:
        kind: binary_operator
        stopBy: neighbor
        inside:
          kind: argument_list
          stopBy: neighbor
          inside:
            matches: sink
            stopBy: neighbor
    - inside:
        kind: pair
        field: value
        stopBy: neighbor
        inside:
          kind: dictionary
          stopBy: neighbor
          inside:
            kind: keyword_argument
            stopBy: neighbor
            inside:
              kind: argument_list
              stopBy: neighbor
              inside:
                matches: sink
                stopBy: neighbor
utils:
  secret-name:
    any:
      - kind: identifier
        regex: (?i)(^|_)(token|secret|password|passwd|pwd|api_?key|apikey|secret_?key|private_?key|access_?key|authorization|credentials?)$
      - kind: attribute
        has:
          field: attribute
          regex: (?i)(^|_)(token|secret|password|passwd|pwd|api_?key|apikey|secret_?key|private_?key|access_?key|authorization|credentials?)$
      - kind: subscript
        has:
          field: subscript
          regex: (?i)^["'](x-)?(authorization|api-?key|token|password|secret|cookie|x-api-key)["']$
    not:
      regex: (?i)(^|[._])(has|is|use|should|needs?|num|max|min|count|total|len|page|next|prev|continuation|pagination|cursor|sync|cancel|cancellation|csrf|xsrf)_[a-z_]*$
  sink:
    any:
      - kind: call
