# Generated by forge from docker/compose/no-inline-secrets (mode: forbid).
id: docker/compose/no-inline-secrets
language: Yaml
severity: error
message: forge:docker/compose/no-inline-secrets Secret-like variables under environment or build args (PASSWORD, SECRET, TOKEN, API_KEY, PRIVATE_KEY, CREDENTIALS) hold a ${VAR} reference or nothing, never a value; *_FILE variables are fine.
files:
  - "**/compose*.yml"
  - "**/compose*.yaml"
  - "**/docker-compose*.yml"
  - "**/docker-compose*.yaml"
rule:
  all:
    - inside:
        stopBy: end
        kind: block_mapping_pair
        has:
          field: key
          regex: ^["']?(environment|args)["']?$
    - any:
        - all:
            - kind: block_mapping_pair
            - has:
                field: key
                regex: (?i)^["']?[A-Z0-9_]*(PASSWORD|SECRET|TOKEN|API_?KEY|PRIVATE_KEY|CREDENTIALS)[A-Z0-9_]*["']?$
            - not:
                has:
                  field: key
                  regex: (?i)_FILE["']?$
            - has:
                field: value
                regex: ^.
                not:
                  regex: ^["']?\$\{[^}]+\}["']?$
        - all:
            - any:
                - kind: string_scalar
                - kind: double_quote_scalar
                - kind: single_quote_scalar
            - regex: (?i)^["']?[A-Z0-9_]*(PASSWORD|SECRET|TOKEN|API_?KEY|PRIVATE_KEY|CREDENTIALS)[A-Z0-9_]*=.
            - not:
                regex: (?i)_FILE=
            - not:
                regex: =\$\{[^}]+\}["']?$

