===== .claude/skills/forge-project/scripts/test-edit.sh
#!/bin/sh
# Generated by forge. Edits to tests that existed at the start of the turn.
# PreToolUse(Edit|Write): when the edit removes a test, or changes what it checks
# (its assertions or parametrization; setup-only changes and new tests are fine),
# asks: the user sees the ask; in an autonomous run an independent reviewer answers
# it, given the user's request for the turn (saved by turn-start.sh). The tests
# asked about are recorded as pending for this tool call.
# PostToolUse(Edit|Write): the call ran, so it was approved: its pending tests are
# recorded in <turn snapshot>/tests-approved, which the Stop check does not block
# on. The edited test file is recorded in <turn snapshot>/touched, so the Stop
# check still runs it when the edit is later reverted.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
[ -d .forge ] || exit 0
file=$(json_get file_path)
[ -n "$file" ] || exit 0
file=$(rel_path "$file") || exit 0
FORGE_ROOT=$(pwd)
snap=$(turn_dir)
key=$(bash_key) || key=''
IFS='
'

# the generated checks and the engine modules they use (forge apply writes them next to this script)
. "$dir/checks.sh"

FORGE_NTESTRULES=0

# forge_test_rule_for <file>: sets t_n, t_id, t_review for the test-edit rule whose
# scope holds <file>; fails when none does.
forge_test_rule_for() {
  _tr_i=1
  while [ "$_tr_i" -le "$FORGE_NTESTRULES" ]; do
    forge_test_rule_"$_tr_i"
    "forge_scope_$t_n" "$1" && return 0
    _tr_i=$((_tr_i + 1))
  done
  return 1
}
forge_test_rule_for "$file" || exit 0

if [ "$(json_get hook_event_name)" = PostToolUse ]; then
  [ -d "$snap" ] || exit 0
  grep -qxF "$file" "$snap/touched" 2>/dev/null || printf '%s\n' "$file" >> "$snap/touched"
  if [ -n "$key" ] && [ -f "$snap/tests-pending/$key" ]; then
    cat "$snap/tests-pending/$key" >> "$snap/tests-approved"
    rm -f "$snap/tests-pending/$key"
  fi
  exit 0
fi

[ -f "$file" ] || exit 0
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-test-edit.XXXXXX") || exit 0
trap 'rm -rf "$FORGE_TMP"' EXIT HUP INT TERM
FORGE_SNAP=''
FORGE_BASE_REV=$(git rev-parse -q --verify HEAD 2>/dev/null)
if [ -f "$snap/head" ]; then FORGE_SNAP=$snap; FORGE_BASE_REV=$(cat "$snap/head"); fi
# the file at the start of the turn, now, and after this edit
base_file "$file" "$FORGE_TMP/v/base/$file" || exit 0
mkdir -p "$FORGE_TMP/v/before/$(dirname "$file")" "$FORGE_TMP/v/after/$(dirname "$file")"
cp "$file" "$FORGE_TMP/v/before/$file"
if [ "$(json_get tool_name)" = Write ]; then
  json_get content > "$FORGE_TMP/v/after/$file"
else
  json_get old_string > "$FORGE_TMP/old"
  json_get new_string > "$FORGE_TMP/new"
  all=0
  case $FORGE_INPUT in *'"replace_all":true'*|*'"replace_all": true'*) all=1 ;; esac
  # the edit applied as Claude Code applies it: the first occurrence, or every one
  awk -v all="$all" 'BEGIN { RS = "\001" }
    FILENAME == ARGV[1] { o = $0; next }
    FILENAME == ARGV[2] { n = $0; next }
    { s = $0 }
    END {
      if (o == "" || !(i = index(s, o))) exit 1
      out = ""
      while (i) {
        out = out substr(s, 1, i - 1) n; s = substr(s, i + length(o))
        i = all ? index(s, o) : 0
      }
      printf "%s", out s
    }' "$FORGE_TMP/old" "$FORGE_TMP/new" "./$file" > "$FORGE_TMP/v/after/$file" || exit 0
fi
printf 'base/%s\nbefore/%s\nafter/%s\n' "$file" "$file" "$file" > "$FORGE_TMP/list"
forge_test_blocks "$FORGE_TMP/v" "$FORGE_TMP/list" > "$FORGE_TMP/blocks" || exit 0
# tests present at the start of the turn and now, removed or whose checks change
awk -F '\t' -v f="$file" '
  { v = $1; sub(/\/.*/, "", v) }
  $2 ~ /^support:/ { next }
  v == "base" { base[$2] = 1; next }
  v == "before" { then[$2] = $4; next }
  v == "after" { now[$2] = $4 }
  END {
    for (k in then) {
      if (!(k in base)) continue
      if (!(k in now)) print f "\t" k "\tremoved"
      else if (now[k] != then[k]) print f "\t" k "\tchanged"
    }
  }' "$FORGE_TMP/blocks" | sort > "$FORGE_TMP/asked"
[ -s "$FORGE_TMP/asked" ] || exit 0

if [ -d "$snap" ] && [ -n "$key" ]; then
  mkdir -p "$snap/tests-pending" && cut -f 1,2 "$FORGE_TMP/asked" > "$snap/tests-pending/$key"
fi
tests=$(awk -F '\t' '{ printf "%s%s \"%s\" (%s)", (NR > 1 ? ", " : ""), $1, $2, $3 }' "$FORGE_TMP/asked")
concern="This edit changes what tests that existed before this turn assert, or removes them: $tests. That is right when the task changes the behaviour they assert; otherwise it weakens the tests to make the code pass."
reason=$(printf 'forge:%s %s' "$t_id" "$concern" | json_escape)
out=$(printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"%s"}}' "$reason")
if forge_review_wanted && [ -f "$dir/review.sh" ]; then
  request=''
  [ -f "$FORGE_STATE/$(session_id).prompt" ] && request=$(head -c 8000 "$FORGE_STATE/$(session_id).prompt")
  reviewed=$(printf '%s' "$FORGE_INPUT" | sh "$dir/review.sh" pre "$t_id" "$concern" "$t_review" "${request:-(not recorded)}")
  [ -n "$reviewed" ] && out=$reviewed
fi
printf '%s\n' "$out"
exit 0

