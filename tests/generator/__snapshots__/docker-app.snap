FORGE_NGREPS=9
FORGE_GREP_NO_INCREASE='github-actions/ci-ratchet|python/no-new-suppressions|supply-chain/audit-ignore-ratchet'
FORGE_GREP_NO_DECREASE=''

# grep 1. git/no-conflict-markers
forge_grep_meta_1() {
  g_id='git/no-conflict-markers'; g_mode=forbid; g_flags=-E
  g_pattern='^(<<<<<<<|>>>>>>>|\|\|\|\|\|\|\|)( |$)'
  g_desc='No added line starts with a merge conflict marker (<<<<<<< , >>>>>>> , ||||||| ), in any file.'
}
forge_grep_scope_1() {
  return 0
}

# grep 2. github-actions/ci-ratchet
forge_grep_meta_2() {
  g_id='github-actions/ci-ratchet'; g_mode=no-increase; g_flags=-E
  g_pattern='continue-on-error:[[:space:]]*(true|\$\{\{[[:space:]]*true[[:space:]]*\}\})|\|\|[[:space:]]*(true|exit[[:space:]]+0|:)([[:space:];)"'\'']|$)|^[[:space:]]*-?[[:space:]]*if:[[:space:]]*(false|\$\{\{[[:space:]]*false[[:space:]]*\}\})[[:space:]]*$|paths-ignore:'
  g_desc='Workflow changes do not switch checks off: a changed workflow may not have more continue-on-error: true, run lines ending in || true / || exit 0 / || :, if: false or paths-ignore than it had. Fix the failing step instead; an accepted change goes through forge.yaml.'
}
forge_grep_scope_2() {
  case $1 in .github/workflows/*.yml|.github/workflows/*.yaml) ;; *) return 1 ;; esac
  return 0
}

# grep 3. python/no-dev-server-in-image
forge_grep_meta_3() {
  g_id='python/no-dev-server-in-image'; g_mode=forbid; g_flags=-E
  g_pattern='^[[:space:]]*(CMD|ENTRYPOINT|[A-Za-z0-9_-]+:).*(--reload([^-A-Za-z]|$)|fastapi["'\'',[:space:]]+dev([^A-Za-z]|$)|flask["'\'',[:space:]]+(.*["'\'',[:space:]])?--debug)'
  g_desc='Dockerfile CMD / ENTRYPOINT and Procfile processes run no development server: no --reload, fastapi dev or flask run --debug (a reloader wastes CPU in production, and Flask'\''s debugger runs code from the browser). Use fastapi run, uvicorn without --reload, flask run without --debug, or gunicorn.'
}
forge_grep_scope_3() {
  case $1 in *.dockerignore|*/*.dockerignore) return 1 ;; esac
  case $1 in Dockerfile|*/Dockerfile|Dockerfile.*|*/Dockerfile.*|*.Dockerfile|*/*.Dockerfile|Containerfile|*/Containerfile|Procfile|Procfile.*) ;; *) return 1 ;; esac
  return 0
}

# grep 4. python/no-new-suppressions
forge_grep_meta_4() {
  g_id='python/no-new-suppressions'; g_mode=no-increase; g_flags=-E
  g_pattern='#[[:space:]]*(noqa|ty:[[:space:]]*ignore|type:[[:space:]]*ignore|pyright:[[:space:]]*ignore|pragma:[[:space:]]*no[[:space:]]+(cover|branch))'
  g_desc='No new suppression comments (# noqa,'
}
forge_grep_scope_4() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}

# grep 5. python/no-placeholder-comment
forge_grep_meta_5() {
  g_id='python/no-placeholder-comment'; g_mode=forbid; g_flags=-iE
  g_pattern='#.*(todo:?[[:space:]]*implement|in a real (implementation|app|application|system|project|world)|in production,? (you|we) would|placeholder (implementation|logic|code|value|for now)|stub(bed)? (implementation|for now)|implement (this|me) (later|properly))'
  g_desc='No placeholder comments on added lines ("TODO implement", "in a real implementation", "placeholder logic"); write the code or say what is missing.'
}
forge_grep_scope_5() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}

# grep 6. python/no-ruff-overlap
forge_grep_meta_6() {
  g_id='python/no-ruff-overlap'; g_mode=forbid; g_flags=-iE
  g_pattern='"(black|isort|flake8|autopep8|pyupgrade|autoflake)([[:space:]]*[]<>=!~;[]|")|repo:[[:space:]]*https://github\.com/(psf/black(-pre-commit-mirror)?|pycqa/(isort|flake8|autoflake)|asottile/pyupgrade|hhatto/autopep8)([.]git)?[[:space:]]*$'
  g_desc='No black, isort, flake8, autopep8, pyupgrade or autoflake as a dependency or pre-commit hook: ruff format and ruff check cover them, and two tools fight over the same lines.'
}
forge_grep_scope_6() {
  case $1 in pyproject.toml|*/pyproject.toml|.pre-commit-config.yaml) ;; *) return 1 ;; esac
  return 0
}

# grep 7. supply-chain/audit-ignore-ratchet
forge_grep_meta_7() {
  g_id='supply-chain/audit-ignore-ratchet'; g_mode=no-increase; g_flags=-E
  g_pattern='(GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}|CVE-[0-9]{4}-[0-9]{4,}|PYSEC-[0-9]{4}-[0-9]+|RUSTSEC-[0-9]{4}-[0-9]{4})'
  g_desc='No new advisory ids (GHSA-…, CVE-…, PYSEC-…, RUSTSEC-…) in vulnerability-audit ignore lists (osv-scanner.toml, pnpm auditConfig, .nsprc, audit-ci, .trivyignore, .grype.yaml, --ignore-vuln in CI); a changed file may not have more than it had. Upgrade the dependency instead; an accepted ignore goes through forge.yaml.'
}
forge_grep_scope_7() {
  case $1 in osv-scanner.toml|*/osv-scanner.toml|pnpm-workspace.yaml|package.json|*/package.json|.nsprc|audit-ci.json|audit-ci.jsonc|.trivyignore|.grype.yaml|.github/workflows/*|.gitlab-ci.yml|Makefile) ;; *) return 1 ;; esac
  return 0
}

# grep 8. supply-chain/no-dependency-confusion
forge_grep_meta_8() {
  g_id='supply-chain/no-dependency-confusion'; g_mode=forbid; g_flags=-E
  g_pattern='--extra-index-url|PIP_EXTRA_INDEX_URL|^[[:space:]]*extra-index-url[[:space:]]*=[[:space:]]*[^[:space:]"'\''[]|(index-strategy[[:space:]]*=[[:space:]]*["'\'']|UV_INDEX_STRATEGY=["'\'']?|--index-strategy[= ])unsafe-(best|first)-match'
  g_desc='No pip --extra-index-url (requirements files, pip.conf / pip.ini, PIP_EXTRA_INDEX_URL, pip install in Dockerfiles, CI and scripts) and no uv index strategy unsafe-best-match or unsafe-first-match: pip merges every index and installs the highest version, so a public package with an internal package'\''s name wins. Use one --index-url that proxies the public index, or uv indexes (first-index by default).'
}
forge_grep_scope_8() {
  case $1 in *.dockerignore|*/*.dockerignore) return 1 ;; esac
  case $1 in requirements*.txt|*/requirements*.txt|constraints*.txt|*/constraints*.txt|pip.conf|*/pip.conf|pip.ini|*/pip.ini|Dockerfile|*/Dockerfile|Dockerfile.*|*/Dockerfile.*|*.Dockerfile|*/*.Dockerfile|Containerfile|*/Containerfile|.github/workflows/*|.gitlab-ci.yml|*.sh|*/*.sh|Makefile|*/Makefile|tox.ini|*/tox.ini|noxfile.py|*/noxfile.py|.env.example|*/.env.example|.env.sample|*/.env.sample|.env.template|*/.env.template|.env.dist|*/.env.dist|pyproject.toml|*/pyproject.toml|uv.toml|*/uv.toml) ;; *) return 1 ;; esac
  return 0
}

# grep 9. supply-chain/no-tls-disable
forge_grep_meta_9() {
  g_id='supply-chain/no-tls-disable'; g_mode=forbid; g_flags=-E
  g_pattern='strict-ssl[[:space:]]*=[[:space:]]*false|enableStrictSsl:[[:space:]]*false|NODE_TLS_REJECT_UNAUTHORIZED["'\'']?[[:space:]]*[:=][[:space:]]*["'\'']?0|PYTHONHTTPSVERIFY["'\'']?[[:space:]]*[:=][[:space:]]*["'\'']?0|sslVerify[[:space:]]*=[[:space:]]*false|GIT_SSL_NO_VERIFY|--trusted-host|^[[:space:]]*trusted-host[[:space:]]*=|allow-insecure-host|UV_INSECURE_HOST'
  g_desc='Committed files never turn TLS verification off: no strict-ssl=false (.npmrc), enableStrictSsl: false (.yarnrc.yml), NODE_TLS_REJECT_UNAUTHORIZED=0, PYTHONHTTPSVERIFY=0, sslVerify = false (git config), GIT_SSL_NO_VERIFY, pip'\''s --trusted-host / trusted-host =, uv'\''s allow-insecure-host / UV_INSECURE_HOST. Install the proxy'\''s CA certificate instead (NODE_EXTRA_CA_CERTS, PIP_CERT, SSL_CERT_FILE).'
}
forge_grep_scope_9() {
  return 0
}

# File roles (§15.4): forge_role <@role> <path>.
forge_role() {
  case ${1#@} in
    alembic-migrations) case $2 in alembic/versions/*|migrations/versions/*) return 0 ;; esac ;;
    build-artifacts) case $2 in node_modules/*|*/node_modules/*|__pycache__/*|*/__pycache__/*|*.pyc|*/*.pyc|.next/*|*/.next/*|.nuxt/*|*/.nuxt/*|.svelte-kit/*|*/.svelte-kit/*|.turbo/*|*/.turbo/*|.coverage|*/.coverage|.DS_Store|*/.DS_Store) return 0 ;; esac ;;
    compose) case $2 in compose*.yaml|*/compose*.yaml|compose*.yml|*/compose*.yml|docker-compose*.yaml|*/docker-compose*.yaml|docker-compose*.yml|*/docker-compose*.yml) return 0 ;; esac ;;
    django-migrations) case $2 in migrations/[0-9]*.py|*/migrations/[0-9]*.py) return 0 ;; esac ;;
    dockerfile) case $2 in *.dockerignore|*/*.dockerignore) return 1 ;; esac; case $2 in Dockerfile|*/Dockerfile|Dockerfile.*|*/Dockerfile.*|*.Dockerfile|*/*.Dockerfile|Containerfile|*/Containerfile) return 0 ;; esac ;;
    env-files) case $2 in .env.example|*/.env.example|.env.sample|*/.env.sample|.env.template|*/.env.template|.env.dist|*/.env.dist) return 1 ;; esac; case $2 in .env|*/.env|.env.*|*/.env.*) return 0 ;; esac ;;
    env-template) case $2 in .env.example|*/.env.example|.env.sample|*/.env.sample|.env.template|*/.env.template|.env.dist|*/.env.dist) return 0 ;; esac ;;
    procfile) case $2 in Procfile|Procfile.*) return 0 ;; esac ;;
  esac
  return 1
}
