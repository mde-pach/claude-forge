        pass
  - |
    def charge(order_id: str) -> None:
        """Charge the order."""
        ...
  - |
    class PaymentService:
        def refund(self, order_id: str) -> None:
            raise NotImplementedError
  - |
    def total(items: list[int]) -> int:
        # TODO
        pass

