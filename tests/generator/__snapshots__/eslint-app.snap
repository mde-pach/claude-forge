===== .forge/check.sh
#!/bin/sh
# Generated by forge. Do not edit: changes are detected by the integrity check.
# Usage: sh .forge/check.sh [--changed | --since <ref> | --all]
#   --changed      uncommitted changes vs HEAD (pre-commit)
#   --since <ref>  everything since git merge-base <ref> HEAD (CI on a pull request)
#   --all          the whole project (CI)
# The Stop hook runs it with --turn <snapshot>: only what changed during the turn.
# Outside --all, forbid rules and lint findings count only on added lines.
usage() { printf 'usage: sh .forge/check.sh [--changed | --since <ref> | --all]\n' >&2; exit 2; }
mode=${1:---all}
case $mode in
  --changed|--all) [ "$#" -le 1 ] || usage ;;
  --since|--turn) [ "$#" -eq 2 ] && [ -n "$2" ] || usage ;;
  *) usage ;;
esac
FORGE_ARG=${2:-}
cd "$(dirname "$0")/.." || exit 2
FORGE_ROOT=$(pwd)
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-check.XXXXXX") || exit 2
trap 'rm -rf "$FORGE_TMP"' EXIT HUP INT TERM

# Generated by forge. Shared helpers for hook scripts. POSIX sh only.
FORGE_AST_GREP_VERSION="0.45.3"

# json_get <key> [raw]: string value of a top-level or tool_input key from the
# JSON in $FORGE_INPUT. With "raw", the value stays JSON-escaped.
json_get() {
  printf '%s' "$FORGE_INPUT" | awk -v key="$1" -v raw="$2" '
    { buf = buf $0 "\n" }
    END {
      if (!match(buf, "\"" key "\"[[:space:]]*:[[:space:]]*\"")) exit
      s = substr(buf, RSTART + RLENGTH); out = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\"") break
        if (c == "\\") {
          i++; d = substr(s, i, 1)
          if (raw != "") { out = out c d; continue }
          if (d == "n") out = out "\n"
          else if (d == "t") out = out "\t"
          else if (d == "r") out = out ""
          else if (d == "u") {
            # \uXXXX: ASCII decoded, anything else kept escaped (UTF-8 arrives unescaped)
            h = tolower(substr(s, i + 1, 4)); v = 0
            for (k = 1; k <= 4; k++) v = v * 16 + index("0123456789abcdef", substr(h, k, 1)) - 1
            if (v > 0 && v < 128) out = out sprintf("%c", v); else out = out "\\u" h
            i += 4
          }
          else out = out d
        } else out = out c
      }
      printf "%s", out
    }'
}

# json_escape: stdin -> JSON string body (no surrounding quotes).
json_escape() {
  awk 'BEGIN { ORS = "" } {
    gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "")
    gsub(/\033/, "\\u001b")
    if (NR > 1) printf "\\n"
    printf "%s", $0
  }'
}

# tool <name>: prints the command that runs the project's own <name>, or nothing if absent.
tool() {
  if [ -f bun.lock ] || [ -f bun.lockb ]; then
    if [ -x "node_modules/.bin/$1" ] && command -v bun >/dev/null 2>&1; then
      printf 'bun run --bun %s' "$1"
    fi
  elif [ -f uv.lock ]; then
    if [ -x ".venv/bin/$1" ]; then printf '.venv/bin/%s' "$1"; fi
  elif [ -x "node_modules/.bin/$1" ]; then
    printf 'node_modules/.bin/%s' "$1"
  elif [ -x ".venv/bin/$1" ]; then
    printf '.venv/bin/%s' "$1"
  fi
}

# astgrep <args>: pinned ast-grep through bunx (bun repos) or uvx.
# Exit status: 0 no finding, 1 findings, other = could not run.
astgrep() {
  if { [ -f bun.lock ] || [ -f bun.lockb ]; } && command -v bunx >/dev/null 2>&1; then
    bunx -p "@ast-grep/cli@$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
  elif command -v uvx >/dev/null 2>&1; then
    uvx -q --from "ast-grep-cli==$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
    _rc=$?
    if [ "$_rc" -gt 1 ]; then
      uvx -q --offline --from "ast-grep-cli==$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
      _rc=$?
    fi
    return "$_rc"
  elif command -v bunx >/dev/null 2>&1; then
    bunx -p "@ast-grep/cli@$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
  else
    return 127
  fi
}

# first_lines <n>: keep the first n lines of stdin.
first_lines() { awk -v n="$1" 'NR <= n'; }

# repo_root: cd to the git repository containing the hook's cwd.
repo_root() {
  _cwd=$(json_get cwd)
  [ -n "$_cwd" ] && cd "$_cwd" 2>/dev/null || return 1
  _top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  cd "$_top" || return 1
}

# rel_path <path>: <path> relative to the current directory (the repository
# root after repo_root), resolving symlinks; fails when outside it.
rel_path() {
  case $1 in /*) _rp_p=$1 ;; *) _rp_p=$(json_get cwd)/$1 ;; esac
  _rp_d=$(cd "$(dirname "$_rp_p")" 2>/dev/null && pwd -P) || return 1
  _rp_root=$(pwd -P)
  case $_rp_d/ in "$_rp_root"/*) ;; *) return 1 ;; esac
  _rp_rel=${_rp_d#"$_rp_root"}
  _rp_rel=${_rp_rel#/}
  printf '%s' "${_rp_rel:+$_rp_rel/}${_rp_p##*/}"
}

# session_id: the hook input's session_id, safe as a file name ("default" if absent).
session_id() {
  _si=$(json_get session_id | tr -c 'A-Za-z0-9_-' '_')
  printf '%s' "${_si:-default}"
}

# forge_sha256: sha256 of stdin, hex.
forge_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{ print $1 }'
  else openssl dgst -sha256 -r | awk '{ print $1 }'
  fi
}

# tree_hash: hash of git diff HEAD plus the untracked files (names and contents).
tree_hash() {
  {
    if git rev-parse --verify -q HEAD >/dev/null; then git diff HEAD --binary 2>/dev/null; else git diff --cached --binary 2>/dev/null; fi
    git ls-files --others --exclude-standard 2>/dev/null | while IFS= read -r _th_f; do
      printf '%s ' "$_th_f"; git hash-object -- "$_th_f" 2>/dev/null || printf '\n'
    done
  } | forge_sha256
}

# status_paths: changed paths (staged, unstaged, untracked; renames as delete + add), one per line.
status_paths() {
  git status --porcelain --no-renames --untracked-files=all 2>/dev/null \
    | sed -e 's/^...//' -e 's/^"\(.*\)"$/\1/'
}

# snapshot <dir>: the working tree at the start of a turn, for the Stop hook:
# head (commit), tree (tree_hash), dirty ("path<TAB>blob hash", "-" when deleted)
# and files/<path> (copies of the dirty files up to 1 MiB, to compute added lines).
snapshot() {
  rm -rf "$1" && mkdir -p "$1/files" || return 1
  git rev-parse -q --verify HEAD > "$1/head" 2>/dev/null || : > "$1/head"
  tree_hash > "$1/tree"
  status_paths | while IFS= read -r _sn_f; do
    if [ -f "$_sn_f" ]; then
      printf '%s\t%s\n' "$_sn_f" "$(git hash-object -- "$_sn_f" 2>/dev/null)"
      if [ "$(wc -c < "$_sn_f")" -le 1048576 ]; then
        mkdir -p "$1/files/$(dirname "$_sn_f")" && cp "$_sn_f" "$1/files/$_sn_f"
      fi
    else
      printf '%s\t-\n' "$_sn_f"
    fi
  done > "$1/dirty"
}

# The base a change is measured against: FORGE_SNAP (a turn snapshot) and/or
# FORGE_BASE_REV (a commit). base_hash <path>: blob hash of <path> in the base, "-" if absent.
base_hash() {
  if [ -n "${FORGE_SNAP:-}" ] && _bh=$(awk -F '\t' -v p="$1" '$1 == p { print $2; f = 1; exit } END { exit !f }' "$FORGE_SNAP/dirty" 2>/dev/null); then
    printf '%s' "$_bh"
  elif [ -n "${FORGE_BASE_REV:-}" ] && _bh=$(git rev-parse -q --verify "$FORGE_BASE_REV:$1" 2>/dev/null); then
    printf '%s' "$_bh"
  else
    printf -- '-'
  fi
}

# now_hash <path>: blob hash of the working-tree file, "-" if absent.
now_hash() {
  if [ -f "$1" ]; then git hash-object -- "$1" 2>/dev/null; else printf -- '-'; fi
}

# base_file <path> <out>: writes <path> as it is in the base to <out>; fails if absent there.
base_file() {
  if [ -n "${FORGE_SNAP:-}" ] && _bf=$(awk -F '\t' -v p="$1" '$1 == p { print $2; f = 1; exit } END { exit !f }' "$FORGE_SNAP/dirty" 2>/dev/null); then
    [ "$_bf" != - ] && [ -f "$FORGE_SNAP/files/$1" ] || return 1
    mkdir -p "$(dirname "$2")" && cp "$FORGE_SNAP/files/$1" "$2"
  elif [ -n "${FORGE_BASE_REV:-}" ] && git cat-file -e "$FORGE_BASE_REV:$1" 2>/dev/null; then
    mkdir -p "$(dirname "$2")" && git cat-file blob "$FORGE_BASE_REV:$1" > "$2" 2>/dev/null
  else
    return 1
  fi
}

# added_lines <path> <base-copy>: "path<TAB>line" for each line added since the base
# (git diff -U0: an edited line counts, moved code counts); "path<TAB>*" when
# <base-copy> does not exist (the file is new).
added_lines() {
  if [ ! -f "$2" ]; then printf '%s\t*\n' "$1"; return 0; fi
  git diff --no-index --no-ext-diff --no-textconv --no-color -U0 -- "$2" "$1" 2>/dev/null \
    | awk -v f="$1" '/^@@ / { split($3, p, ","); s = substr(p[1], 2) + 0; n = (p[2] == "" ? 1 : p[2] + 0); for (i = 0; i < n; i++) print f "\t" (s + i) }'
}

# turn_dir: the turn snapshot of this session (written by turn-start.sh).
turn_dir() { printf '.forge/state/%s.turn' "$(session_id)"; }

# ---- reviews of permission asks nobody can answer (review.sh)

# forge_review_wanted: succeeds when an ask should go to an independent reviewer:
# FORGE_ASK_REVIEW=always, or (auto, the default) a run with nobody to answer
# (CLAUDE_CODE_ENTRYPOINT sdk-cli, sdk-ts, sdk-py or claude-code-github-action:
# claude -p, the Agent SDK, the GitHub Action). Never inside a review, never with
# FORGE_ASK_REVIEW=never, never in dontAsk mode (the user chose to deny asks).
forge_review_wanted() {
  [ -z "${FORGE_REVIEWER:-}" ] || return 1
  case $FORGE_INPUT in *'"permission_mode":"dontAsk"'*|*'"permission_mode": "dontAsk"'*) return 1 ;; esac
  case ${FORGE_ASK_REVIEW:-auto} in
    always) return 0 ;;
    never) return 1 ;;
  esac
  case ${CLAUDE_CODE_ENTRYPOINT:-} in
    sdk-cli|sdk-ts|sdk-py|claude-code-github-action) return 0 ;;
  esac
  return 1
}

# forge_json_object <key>: the JSON value (object or array) of the first <key> in stdin.
forge_json_object() {
  awk -v key="$1" '
    { buf = buf $0 "\n" }
    END {
      if (!match(buf, "\"" key "\"[[:space:]]*:[[:space:]]*[{[]")) exit
      s = substr(buf, RSTART + RLENGTH - 1); n = length(s); depth = 0; str = 0
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (str) { if (c == "\\") i++; else if (c == "\"") str = 0; continue }
        if (c == "\"") str = 1
        else if (c == "{" || c == "[") depth++
        else if (c == "}" || c == "]") { depth--; if (!depth) { print substr(s, 1, i); exit } }
      }
    }'
}

# forge_review <tool> <tool-input-json> [<rule> <concern> <question> [<request>]]: runs
# the reviewer, a fresh `claude -p` that sees only the action (tool, input, the
# repository path) and, for a rule's ask, that rule's concern and the one question
# to answer (and, when given, the user's request for the turn; never the
# conversation). It may read the repository (Read, Grep, Glob, nothing else) and
# runs without hooks, MCP servers or settings. Prints "allow<TAB>reason" or
# "deny<TAB>reason"; fails when claude is missing or gives no verdict (the ask then
# stays unanswered).
forge_review() {
  command -v claude >/dev/null 2>&1 || return 1
  if [ -n "${3:-}" ]; then
    _rv_concern=''
    [ -n "${4:-}" ] && _rv_concern=" The concern of that rule: $4"
    _rv_q=${5:-}
    [ -n "$_rv_q" ] || _rv_q='Is this action, as far as that concern goes, normal work on this repository and safe to run unattended?'
    _rv_req=''
    [ -n "${6:-}" ] && _rv_req="

The user's request for this turn (what the agent was asked to do; not the conversation):
<request>
$6
</request>"
    _rv_task="Forge flagged it with rule $3.$_rv_concern
The question you answer: $_rv_q$_rv_req

Judge only that question. The rest of the action is not under review: other commands or changes in it are covered by their own rules and permissions, and are no reason to deny. Allow when the answer clearly clears the concern; deny when it does not, or when you cannot tell."
  else
    _rv_task="Allow it only if it is clearly within normal work on this repository and safe to run unattended. Deny anything irreversible or destructive (deleting data or history, force pushes, dropping databases), anything that publishes, deploys or pushes outside this machine, anything that reads or sends secrets, installs packages you cannot verify, weakens security, permissions, tests or tool configuration, or runs code fetched from the internet. When in doubt, deny."
  fi
  _rv_prompt="You are reviewing one action that an autonomous coding agent wants to take. Nobody is available to approve it, so you decide in the user's place, as a careful senior developer who sees only this action would.

Repository: $(pwd)
Tool: $1
Input: $2

You do not see the agent's conversation or its reasons, on purpose: judge the action itself. You may read files in the repository to understand it. $_rv_task Give the reason in one sentence."
  _rv_schema='{"type":"object","properties":{"decision":{"type":"string","enum":["allow","deny"]},"reason":{"type":"string"}},"required":["decision","reason"],"additionalProperties":false}'
  _rv_out=$(FORGE_REVIEWER=1 claude -p "$_rv_prompt" --output-format json --json-schema "$_rv_schema" \
    --tools Read,Grep,Glob --allowedTools Read,Grep,Glob --permission-mode dontAsk --max-turns "${FORGE_REVIEW_MAX_TURNS:-12}" \
    --no-session-persistence --strict-mcp-config --setting-sources '' --settings '{"disableAllHooks":true}' \
    ${FORGE_REVIEW_MODEL:+--model "$FORGE_REVIEW_MODEL"} < /dev/null 2>/dev/null) || return 1
  _rv_so=${_rv_out#*'"structured_output":'}
  [ "$_rv_so" != "$_rv_out" ] || return 1
  _rv_d=$(FORGE_INPUT=$_rv_so json_get decision)
  _rv_r=$(FORGE_INPUT=$_rv_so json_get reason | tr '\t\n' '  ')
  case $_rv_d in allow|deny) printf '%s\t%s' "$_rv_d" "${_rv_r:-no reason given}" ;; *) return 1 ;; esac
}

# forge_review_state: where reviews are logged and cached: .forge/state in a Forge
# project, else ~/.claude.
forge_review_state() {
  if _rs_top=$(cd "$(json_get cwd)" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) && [ -d "$_rs_top/.forge" ] \
    && mkdir -p "$_rs_top/.forge/state" 2>/dev/null; then
    printf '%s/.forge/state' "$_rs_top"
  else
    printf '%s/.claude' "$HOME"
  fi
}

# forge_review_log <decision> <tool> <input> <reason>: one line per review in
# .forge/state/reviews.log (in a Forge project) or ~/.claude/forge-reviews.log.
forge_review_log() {
  _rl_f=$(forge_review_state)
  case $_rl_f in */.forge/state) _rl_f=$_rl_f/reviews.log ;; *) _rl_f=$_rl_f/forge-reviews.log ;; esac
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(session_id)" "$1" "$2" "$(printf '%s' "$3" | tr '\t\n' '  ')" "$4" >> "$_rl_f" 2>/dev/null
  return 0
}

# forge_kill_tree <pid>: kills a process and its descendants.
forge_kill_tree() {
  for _fk_c in $(ps -A -o pid= -o ppid= 2>/dev/null | awk -v p="$1" '$2 == p { print $1 }'); do
    forge_kill_tree "$_fk_c"
  done
  kill "$1" 2>/dev/null
}

# ---- files changed by a Bash command (bash-snapshot.sh, post-edit.sh, typecheck.sh)

# bash_state: where Bash-command snapshots live; bash_key: this tool call's id, file-name safe.
bash_state() { printf '.forge/state/bash'; }
bash_key() {
  _bk=$(json_get tool_use_id | tr -c 'A-Za-z0-9_-' '_')
  [ -n "$_bk" ] && printf '%s' "$_bk"
}

# tree_snapshot <seconds>: prints the git tree id of the working tree (tracked and
# untracked files, ignored ones left out) without touching the user's index or
# object store: a copy of .git/index, and new blobs written under bash_state/objects
# (the repository's objects are read as alternates). Fails after <seconds>.
tree_snapshot() {
  _ts_s=$(bash_state)
  mkdir -p "$_ts_s/objects" || return 1
  _ts_objs=$(cd "$_ts_s/objects" && pwd -P) || return 1
  _ts_alt=$(cd "$(git rev-parse --git-path objects 2>/dev/null)" 2>/dev/null && pwd -P) || return 1
  _ts_idx=$(git rev-parse --git-path index 2>/dev/null) || return 1
  _ts_tmp=$(mktemp "${TMPDIR:-/tmp}/forge-index.XXXXXX") || return 1
  if [ -f "$_ts_idx" ]; then cp "$_ts_idx" "$_ts_tmp"; else rm -f "$_ts_tmp"; fi
  (
    export GIT_INDEX_FILE="$_ts_tmp" GIT_OBJECT_DIRECTORY="$_ts_objs" GIT_ALTERNATE_OBJECT_DIRECTORIES="$_ts_alt"
    git add -A . >/dev/null 2>&1 && git write-tree 2>/dev/null
  ) > "$_ts_tmp.out" &
  _ts_pid=$!
  ( sleep "$1"; forge_kill_tree "$_ts_pid" ) >/dev/null 2>&1 &
  _ts_watch=$!
  wait "$_ts_pid" 2>/dev/null
  _ts_rc=$?
  forge_kill_tree "$_ts_watch"
  _ts_tree=$(cat "$_ts_tmp.out" 2>/dev/null)
  rm -f "$_ts_tmp" "$_ts_tmp.out" "$_ts_tmp.lock"
  [ "$_ts_rc" -eq 0 ] && [ -n "$_ts_tree" ] || return 1
  printf '%s\n' "$_ts_tree"
}

# bash_changed_files <before-tree> <after-tree>: added or modified files, one per
# line, outside Forge's, Claude's, git's and dependency directories.
bash_changed_files() {
  _bc_objs=$(cd "$(bash_state)/objects" && pwd -P) || return 1
  _bc_alt=$(cd "$(git rev-parse --git-path objects 2>/dev/null)" 2>/dev/null && pwd -P) || return 1
  GIT_OBJECT_DIRECTORY="$_bc_objs" GIT_ALTERNATE_OBJECT_DIRECTORIES="$_bc_alt" \
    git diff-tree -r --no-renames --name-status "$1" "$2" 2>/dev/null \
    | awk -F '\t' '$1 == "A" || $1 == "M" { print $2 }' \
    | grep -vE '^(\.forge|\.claude|\.git|node_modules|\.venv)/' 
  return 0
}

# bash_cleanup: drops snapshots older than a day or beyond the 50 newest (a denied
# command never reaches PostToolUse), and the snapshot objects once none is pending.
bash_cleanup() {
  _bl_s=$(bash_state)
  [ -d "$_bl_s" ] || return 0
  find "$_bl_s" -type f \( -name '*.tree' -o -name '*.files' \) -mtime +0 -exec rm -f {} + 2>/dev/null
  # shellcheck disable=SC2012
  ls -t "$_bl_s" 2>/dev/null | grep -E '\.(tree|files)$' | sed '1,50d' | while IFS= read -r _bl_f; do rm -f "$_bl_s/$_bl_f"; done
  if [ -z "$(ls "$_bl_s" 2>/dev/null | grep -E '\.tree$')" ]; then rm -rf "$_bl_s/objects"; fi
  return 0
}

# ---- generated checks
# Project tools used in check commands, resolved through tool().
tsc() { forge_exec_tool tsc "$@"; }
FORGE_NCHECKS=3

# 1. typescript/config-ratchet
forge_check_meta_1() {
  c_id='typescript/config-ratchet'; c_stage=lint; c_tools='bun'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0
}
forge_scope_1() {
  case $1 in biome.json|*/biome.json|biome.jsonc|*/biome.jsonc|tsconfig*.json|*/tsconfig*.json|package.json|*/package.json) ;; *) return 1 ;; esac
  return 0
}
forge_when_1() { case $1 in biome.json|*/biome.json|biome.jsonc|*/biome.jsonc|tsconfig*.json|*/tsconfig*.json|package.json|*/package.json) return 0 ;; esac; return 1; }
forge_check_run_1() {
forge_ratchet bun ratchet.mjs
}

# 2. typescript/no-ignore-deprecations
forge_check_meta_2() {
  c_id='typescript/no-ignore-deprecations'; c_stage=lint; c_tools=''
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0
}
forge_scope_2() {
  case $1 in tsconfig*.json|*/tsconfig*.json) ;; *) return 1 ;; esac
  return 0
}
forge_when_2() { case $1 in tsconfig*.json|*/tsconfig*.json) return 0 ;; esac; return 1; }
forge_check_run_2() {
! grep -n '"ignoreDeprecations"' /dev/null $(git ls-files '*tsconfig*.json')
}

# 3. typescript/typecheck
forge_check_meta_3() {
  c_id='typescript/typecheck'; c_stage=typecheck; c_tools='tsc'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0
}
forge_scope_3() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}
forge_when_3() { return 1; }
forge_check_run_3() {
tsc --noEmit -p tsconfig.json
}

FORGE_NGREPS=2
FORGE_GREP_NO_INCREASE='typescript/no-new-suppressions'
FORGE_GREP_NO_DECREASE=''

# grep 1. typescript/no-new-suppressions
forge_grep_meta_1() {
  g_id='typescript/no-new-suppressions'; g_mode=no-increase; g_flags=-E
  g_pattern='biome-ignore|@ts-expect-error'
  g_desc='No new suppression comments (biome-ignore in any form, @ts-expect-error); a changed file may not have more than it had. Fix the finding instead.'
}
forge_grep_scope_1() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}

# grep 2. typescript/no-placeholder-comment
forge_grep_meta_2() {
  g_id='typescript/no-placeholder-comment'; g_mode=forbid; g_flags=-iE
  g_pattern='(//|/\*|^[[:space:]]*\*).*(todo:?[[:space:]]*implement|in a real (implementation|app|application|system|project|world)|in production,? (you|we) would|placeholder (implementation|logic|code|value|for now)|stub(bed)? (implementation|for now)|implement (this|me) (later|properly))'
  g_desc='No placeholder comments on added lines ("TODO implement", "in a real implementation", "placeholder logic"); write the code or say what is missing.'
}
forge_grep_scope_2() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}
# ---- end of generated checks

# Check engine (static part). Expects: IFS = newline, FORGE_TMP, FORGE_NCHECKS,
# forge_check_meta_<n>, forge_scope_<n>, forge_when_<n>, forge_check_run_<n>,
# forge_check_changed_<n>, plus tool() and first_lines() from lib.sh.

# forge_change_set: the files a run is about, for $mode (--changed, --since,
# --turn, --all; $FORGE_ARG is the ref or the snapshot directory). Writes to $FORGE_TMP:
#   changed   changed paths, one per line   existing  those that exist now
#   deleted   those gone since the base     inbase    those that exist in the base
#   base/<p>  each one as it is in the base
#   added     "path<TAB>line" per added line, "path<TAB>*" per new file (empty with --all)
# The base is HEAD (--changed, --all), git merge-base <ref> HEAD (--since) or the
# tree at the start of the turn (--turn: FORGE_SNAP, plus FORGE_BASE_REV for files
# that were clean then).
forge_change_set() {
  FORGE_SNAP=''
  case $mode in
    --turn)
      FORGE_SNAP=$FORGE_ARG
      FORGE_BASE_REV=$(cat "$FORGE_SNAP/head" 2>/dev/null) ;;
    --since)
      FORGE_BASE_REV=$(git merge-base "$FORGE_ARG" HEAD 2>/dev/null) || {
        printf 'forge:forge/since no merge base for %s and HEAD (fetch it: git fetch origin <branch>, or check out with fetch-depth: 0)\n' "$FORGE_ARG"
        return 1
      } ;;
    *) FORGE_BASE_REV=$(git rev-parse -q --verify HEAD 2>/dev/null) ;;
  esac
  case $mode in
    --turn)
      { status_paths; cut -f 1 "$FORGE_SNAP/dirty" 2>/dev/null
        [ -n "$FORGE_BASE_REV" ] && git diff --name-only --no-renames "$FORGE_BASE_REV" HEAD 2>/dev/null
      } | sort -u | while IFS= read -r _cs_f; do
        [ -n "$_cs_f" ] && [ "$(now_hash "$_cs_f")" != "$(base_hash "$_cs_f")" ] && printf '%s\n' "$_cs_f"
      done ;;
    --since)
      { git diff --name-only --no-renames "$FORGE_BASE_REV" 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } | sort -u ;;
    *) status_paths | sort -u ;;
  esac > "$FORGE_TMP/changed"
  : > "$FORGE_TMP/existing"; : > "$FORGE_TMP/deleted"; : > "$FORGE_TMP/inbase"; : > "$FORGE_TMP/added"
  mkdir -p "$FORGE_TMP/base"
  while IFS= read -r _cs_f; do
    if base_file "$_cs_f" "$FORGE_TMP/base/$_cs_f"; then printf '%s\n' "$_cs_f" >> "$FORGE_TMP/inbase"; _cs_b=1; else _cs_b=0; fi
    if [ -f "$_cs_f" ]; then
      printf '%s\n' "$_cs_f" >> "$FORGE_TMP/existing"
      [ "$mode" = --all ] || added_lines "$_cs_f" "$FORGE_TMP/base/$_cs_f" >> "$FORGE_TMP/added"
    elif [ "$_cs_b" = 1 ]; then
      printf '%s\n' "$_cs_f" >> "$FORGE_TMP/deleted"
    fi
  done < "$FORGE_TMP/changed"
  return 0
}

# forge_sg_report <json>: ast-grep --json=stream matches as
# "forge:<rule> path:line:column <description>" (from 1); unless $mode is --all, only
# matches that overlap a line of $FORGE_TMP/added (a match spanning an edited line counts).
forge_sg_report() {
  awk -v all="$([ "$mode" = --all ] && printf 1)" '
    function str(s, key,   i, out, c) {
      i = index(s, "\"" key "\":\""); if (!i) return ""
      s = substr(s, i + length(key) + 4); out = ""
      while (length(s)) {
        c = substr(s, 1, 1)
        if (c == "\"") break
        if (c == "\\") { c = substr(s, 2, 1); if (c == "n") c = " "; s = substr(s, 2) }
        out = out c; s = substr(s, 2)
      }
      return out
    }
    function num(s, key,   i) { i = index(s, key); return i ? substr(s, i + length(key)) + 0 : -1 }
    FILENAME == ARGV[1] { if ($2 == "*") whole[$1] = 1; else ad[$1 "\t" $2] = 1; next }
    {
      r = substr($0, index($0, "\"range\":{"))
      sl = num(r, "\"start\":{\"line\":") + 1; sc = num(r, "\"column\":") + 1
      el = num(substr(r, index(r, "\"end\":{\"line\":")), "\"end\":{\"line\":") + 1
      f = str($0, "file"); m = str($0, "message")
      keep = (all != "" || (f in whole))
      for (l = sl; !keep && l <= el; l++) if ((f "\t" l) in ad) keep = 1
      if (!keep) next
      id = m; sub(/^forge:/, "", id); sub(/ .*$/, "", id)
      d = m; sub(/^[^ ]* ?/, "", d)
      printf "forge:%s %s:%d:%d %s\n", id, f, sl, sc, d
    }' "$FORGE_TMP/added" "$1"
}

# forge_grep_counts <dir> <file-list>: "rule<TAB>file<TAB>count" (matching lines)
# for each grep rule that counts (no-increase, no-decrease), on the listed files under <dir>.
forge_grep_counts() {
  _gc_i=1
  while [ "$_gc_i" -le "$FORGE_NGREPS" ]; do
    forge_grep_meta_"$_gc_i"
    if [ "$g_mode" != forbid ]; then
      while IFS= read -r _gc_f; do
        [ -f "$1/$_gc_f" ] && forge_grep_scope_"$_gc_i" "$_gc_f" || continue
        printf '%s\t%s\t%s\n' "$g_id" "$_gc_f" "$(grep -c "$g_flags" -- "$g_pattern" "$1/$_gc_f")"
      done < "$2"
    fi
    _gc_i=$((_gc_i + 1))
  done
}

# forge_grep_forbid <file-list>: "forge:<rule> path:line <description>" for each
# match of a forbid grep rule; unless $mode is --all, only on lines of $FORGE_TMP/added.
forge_grep_forbid() {
  _gf_i=1
  while [ "$_gf_i" -le "$FORGE_NGREPS" ]; do
    forge_grep_meta_"$_gf_i"
    if [ "$g_mode" = forbid ]; then
      while IFS= read -r _gf_f; do
        [ -f "$_gf_f" ] && forge_grep_scope_"$_gf_i" "$_gf_f" || continue
        grep -n "$g_flags" -- "$g_pattern" "$_gf_f" 2>/dev/null | awk -F: -v f="$_gf_f" -v id="$g_id" -v d="$g_desc" -v all="$([ "$mode" = --all ] && printf 1)" '
          FILENAME == ARGV[1] { split($0, a, "\t"); if (a[2] == "*") whole[a[1]] = 1; else ad[a[1] "\t" a[2]] = 1; next }
          all != "" || (f in whole) || ((f "\t" $1) in ad) { printf "forge:%s %s:%s %s\n", id, f, $1, d }' "$FORGE_TMP/added" -
      done < "$1"
    fi
    _gf_i=$((_gf_i + 1))
  done
}

# forge_ratchet <runtime> <script>: the config ratchet. Runs <script> (embedded in
# check.sh as forge_script_<script>) with the project's runtime on the changed files
# and their base copies; each printed line is a loosened setting, unless forge.yaml
# records it as accepted.
forge_ratchet() {
  _fr_fn=forge_script_$(printf '%s' "$2" | tr -c 'A-Za-z0-9_\n' '_')
  "$_fr_fn" > "$FORGE_TMP/$2" 2>/dev/null || { printf 'forge:%s skipped: %s is not in check.sh (run forge apply)\n' "$c_id" "$2"; return 0; }
  set -f
  # shellcheck disable=SC2046
  "$1" "$FORGE_TMP/$2" "$FORGE_TMP/base" $(cat "$FORGE_TMP/existing") > "$FORGE_TMP/ratchet" 2>&1
  _fr_rc=$?
  set +f
  case $_fr_rc in
    0) return 0 ;;
    1) ;;
    *) printf 'forge:%s %s\n' "$c_id" "$(grep '^skipped:' "$FORGE_TMP/ratchet" | head -n 1 | grep . || printf 'skipped: %s exited with %s' "$1" "$_fr_rc")"; return 0 ;;
  esac
  while IFS= read -r _fr_l; do
    [ -f forge.yaml ] && grep -qF -- "$_fr_l" forge.yaml && continue
    printf '%s\n' "$_fr_l"
  done < "$FORGE_TMP/ratchet" > "$FORGE_TMP/ratchet.open"
  [ -s "$FORGE_TMP/ratchet.open" ] || return 0
  cat "$FORGE_TMP/ratchet.open"
  printf 'Restore the setting, or have the user accept the change in forge.yaml: accept: [{rule: %s, change: "<line above>", reason: "..."}]\n' "$c_id"
  return 1
}

# Test blocks, for forge_test_edits: pytest test functions (with their decorators)
# and classes; Vitest/Playwright test and it calls, and the describe calls around them;
# what a test checks (forge-test-check): assert statements and decorators (pytest
# parametrize), expect statements and .each tables.
FORGE_TEST_BLOCKS='id: forge-test-check
language: Python
rule: {any: [{kind: assert_statement}, {kind: decorator}]}
---
id: forge-test-check
language: Tsx
rule:
  any:
    - {kind: expression_statement, regex: "^(await\\s+)?expect\\b"}
    - {kind: call_expression, regex: "^(test|it)\\b[^(]*[.]each[(]", inside: {kind: call_expression, field: function, stopBy: neighbor}}
---
id: forge-test
language: Python
rule:
  any:
    - kind: decorated_definition
      has: {field: definition, kind: function_definition, has: {field: name, regex: "^test"}}
    - all:
        - kind: function_definition
        - has: {field: name, regex: "^test"}
        - not: {inside: {kind: decorated_definition, stopBy: neighbor}}
---
id: forge-test-scope
language: Python
rule: {kind: class_definition}
---
id: forge-test
language: Tsx
rule: {pattern: "$F($NAME, $$$REST)"}
constraints:
  F: {all: [{regex: "^(test|it)([.(]|$)"}, {not: {regex: "^test[.](describe|step|use|extend|info|beforeEach|afterEach|beforeAll|afterAll)"}}]}
  NAME: {any: [{kind: string}, {kind: template_string}]}
---
id: forge-test-scope
language: Tsx
rule: {pattern: "$F($NAME, $$$REST)"}
constraints:
  F: {regex: "^(describe|suite|test[.]describe)([.(]|$)"}
  NAME: {any: [{kind: string}, {kind: template_string}]}'

# forge_test_blocks <dir> <file-list>: "file<TAB>key<TAB>body<TAB>checks" per test of
# the listed files under <dir>; key = enclosing classes or describe names, then the
# test name (" #2" for a repeated one); body = the test's text without whitespace;
# checks = its assertions and parametrization (forge-test-check), without whitespace.
forge_test_blocks() {
  set -f
  # shellcheck disable=SC2046
  ( cd "$1" && astgrep scan -c "$FORGE_ROOT/.forge/ast-grep/sgconfig.yml" --inline-rules "$FORGE_TEST_BLOCKS" --filter '^forge-test' --json=stream $(cat "$2") ) > "$FORGE_TMP/blocks.json"
  _tb_rc=$?
  set +f
  [ "$_tb_rc" -le 1 ] || return 1
  awk '
    function str(s, key,   i, out, c) {
      i = index(s, "\"" key "\":\""); if (!i) return ""
      s = substr(s, i + length(key) + 4); out = ""
      while (length(s)) {
        c = substr(s, 1, 1)
        if (c == "\"") break
        if (c == "\\") { c = substr(s, 2, 1); if (c == "n" || c == "t" || c == "r") c = " "; s = substr(s, 2) }
        out = out c; s = substr(s, 2)
      }
      return out
    }
    {
      rid = str($0, "ruleId"); if (rid !~ /^forge-test/) next
      r = substr($0, index($0, "\"byteOffset\":{\"start\":") + 22)
      n++; F[n] = str($0, "file"); R[n] = rid; S[n] = r + 0; E[n] = substr(r, index(r, "\"end\":") + 6) + 0
      t = str($0, "text"); k = index($0, "\"NAME\":{"); nm = k ? str(substr($0, k), "text") : ""
      if (nm == "" && match(t, /(def|class)[ ]+[A-Za-z_][A-Za-z0-9_]*/)) { nm = substr(t, RSTART, RLENGTH); sub(/^(def|class)[ ]+/, "", nm) }
      if (nm ~ /^["\047`]/) nm = substr(nm, 2, length(nm) - 2)
      N[n] = nm; gsub(/[[:space:]]/, "", t); T[n] = t
    }
    END {
      for (a = 1; a <= n; a++) {
        if (R[a] != "forge-test") continue
        m = 0
        for (b = 1; b <= n; b++)
          if (R[b] == "forge-test-scope" && F[b] == F[a] && S[b] <= S[a] && E[a] <= E[b]) {
            m++; cs[m] = S[b]; cn[m] = N[b]
            for (j = m; j > 1 && cs[j - 1] > cs[j]; j--) { x = cs[j]; cs[j] = cs[j - 1]; cs[j - 1] = x; x = cn[j]; cn[j] = cn[j - 1]; cn[j - 1] = x }
          }
        key = ""
        for (j = 1; j <= m; j++) key = key cn[j] " > "
        key = key N[a]
        if (++seen[F[a] "\t" key] > 1) key = key " #" seen[F[a] "\t" key]
        sig = ""
        for (b = 1; b <= n; b++) {
          if (R[b] != "forge-test-check" || F[b] != F[a] || S[b] < S[a] || E[b] > E[a]) continue
          inner = 1
          for (c = 1; c <= n; c++)
            if (c != a && R[c] == "forge-test" && F[c] == F[a] && S[c] <= S[b] && E[b] <= E[c] && S[a] <= S[c] && E[c] <= E[a] && E[c] - S[c] < E[a] - S[a]) { inner = 0; break }
          if (inner) sig = sig T[b] "|"
        }
        print F[a] "\t" key "\t" T[a] "\t" sig
      }
    }' "$FORGE_TMP/blocks.json"
}

# forge_test_edits: Stop only (--turn). Each test of the in-scope files ($FORGE_FILES)
# that existed at the start of the turn must keep its assertions and parametrization
# (whitespace aside) and still be present, unless an Edit or Write changing it was
# approved during the turn (<snapshot>/tests-approved, written by test-edit.sh); new
# tests and setup-only changes are fine.
forge_test_edits() {
  [ "$mode" = --turn ] || return 0
  printf '%s\n' "$FORGE_FILES" | grep -xF -f "$FORGE_TMP/inbase" > "$FORGE_TMP/tests.files"
  [ -s "$FORGE_TMP/tests.files" ] || return 0
  if ! forge_test_blocks "$FORGE_TMP/base" "$FORGE_TMP/tests.files" > "$FORGE_TMP/tests.then" \
    || ! forge_test_blocks "$FORGE_ROOT" "$FORGE_TMP/tests.files" > "$FORGE_TMP/tests.now"; then
    printf 'forge:%s skipped: ast-grep unavailable\n' "$c_id"
    return 0
  fi
  _te_ok=$FORGE_ARG/tests-approved
  [ -f "$_te_ok" ] || _te_ok=/dev/null
  awk -F '\t' '
    FILENAME == ARGV[1] { ok[$1 "\t" $2] = 1; next }
    FILENAME == ARGV[2] { then[$1 "\t" $2] = $4; next }
    { now[$1 "\t" $2] = $4 }
    END {
      for (k in then) {
        if (k in ok) continue
        split(k, p, "\t")
        if (!(k in now)) print p[1] ": test \"" p[2] "\" was removed"
        else if (now[k] != then[k]) print p[1] ": test \"" p[2] "\" was changed"
      }
    }' "$_te_ok" "$FORGE_TMP/tests.then" "$FORGE_TMP/tests.now" | sort > "$FORGE_TMP/tests.edits"
  [ -s "$FORGE_TMP/tests.edits" ] || return 0
  cat "$FORGE_TMP/tests.edits"
  printf 'These tests existed before this turn and their assertions changed without approval. Restore them. If the task requires the change (it changes the behaviour they assert), make it with Edit or Write: Forge then asks for approval (the user, or a reviewer given the request).\n'
  return 1
}

# forge_toml_get <file> <section> <key>: the value of <key> in [<section>] ("" for
# the top level), quotes and comments removed; nothing when absent. One-line values only.
forge_toml_get() {
  awk -v want="$2" -v key="$3" '
    /^[[:space:]]*\[/ { s = $0; sub(/^[[:space:]]*\[[[:space:]]*/, "", s); sub(/[[:space:]]*\].*$/, "", s); next }
    s == want {
      line = $0; sub(/^[[:space:]]*/, "", line)
      if (substr(line, 1, length(key)) != key) next
      rest = substr(line, length(key) + 1)
      if (rest !~ /^[[:space:]]*=/) next
      sub(/^[[:space:]]*=[[:space:]]*/, "", rest)
      if (rest ~ /^"/) { sub(/^"/, "", rest); sub(/".*$/, "", rest) }
      else if (rest ~ /^\047/) { sub(/^\047/, "", rest); sub(/\047.*$/, "", rest) }
      else sub(/[[:space:]]*(#.*)?$/, "", rest)
      print rest; exit
    }' "$1" 2>/dev/null
}

# forge_duration_seconds <text>: a relative duration ("7 days", "1 week", "72 hours",
# P7D, P1W, PT72H) in seconds; nothing when it is not one.
forge_duration_seconds() {
  printf '%s\n' "$1" | awk '{
    v = tolower($0)
    if (v ~ /^p[0-9]+w$/) print substr(v, 2) * 604800
    else if (v ~ /^p[0-9]+d$/) print substr(v, 2) * 86400
    else if (v ~ /^pt[0-9]+h$/) print substr(v, 3) * 3600
    else if (v ~ /^[0-9]+[[:space:]]*(weeks?|days?|hours?)$/) {
      n = v + 0; u = v; sub(/^[0-9]+[[:space:]]*/, "", u)
      print n * (u ~ /^w/ ? 604800 : u ~ /^d/ ? 86400 : 3600)
    }
  }'
}

# forge_version_ge <a> <b>: succeeds when version a >= b (numeric dot-separated parts).
forge_version_ge() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, ".")
    for (i = 1; i <= (na > nb ? na : nb); i++) { p = x[i] + 0; q = y[i] + 0; if (p > q) exit 0; if (p < q) exit 1 }
    exit 0 }'
}

# forge_bun_cooldown: bunfig.toml [install] minimumReleaseAge is at least 3 days (259200 s).
forge_bun_cooldown() {
  _bc_v=$(forge_toml_get bunfig.toml install minimumReleaseAge)
  case $_bc_v in ''|*[!0-9]*) ;; *) [ "$_bc_v" -ge 259200 ] && return 0 ;; esac
  printf 'bunfig.toml: [install] minimumReleaseAge is %s; set it to at least 259200 (3 days, in seconds) so a freshly published (possibly compromised) version is not installed. Packages you must update sooner go in minimumReleaseAgeExcludes.\n' "${_bc_v:-unset}"
  return 1
}

# forge_uv_cooldown: [tool.uv] (or uv.toml) exclude-newer is a relative duration of at
# least 3 days, and required-version asks for uv >= 0.9.17 (older uv ignores relative values).
forge_uv_cooldown() {
  if [ -f uv.toml ]; then _uc_f=uv.toml; _uc_s=''; else _uc_f=pyproject.toml; _uc_s=tool.uv; fi
  _uc_rc=0
  _uc_v=$(forge_toml_get "$_uc_f" "$_uc_s" exclude-newer)
  _uc_n=$(forge_duration_seconds "$_uc_v")
  if [ -z "$_uc_n" ] || [ "$_uc_n" -lt 259200 ]; then
    printf '%s: [%s] exclude-newer is %s; set a relative duration of at least 3 days, e.g. exclude-newer = "7 days", so a freshly published (possibly compromised) version is not resolved.\n' "$_uc_f" "${_uc_s:-top level}" "${_uc_v:-unset}"
    _uc_rc=1
  fi
  _uc_r=$(forge_toml_get "$_uc_f" "$_uc_s" required-version)
  _uc_min=$(printf '%s' "$_uc_r" | sed -n -E 's/^[[:space:]]*(>=|==|~=|>)[[:space:]]*([0-9][0-9.]*).*$/\2/p')
  if [ -z "$_uc_min" ] || ! forge_version_ge "$_uc_min" 0.9.17; then
    printf '%s: [%s] required-version is %s; set required-version = ">=0.9.17" (older uv ignores a relative exclude-newer).\n' "$_uc_f" "${_uc_s:-top level}" "${_uc_r:-unset}"
    _uc_rc=1
  fi
  return "$_uc_rc"
}

# forge_trusted_deps: no package.json gains trustedDependencies entries (each one
# lets that package run install scripts); compared with the base, with bun.
forge_trusted_deps() {
  _td_rc=0
  while IFS= read -r _td_f; do
    case $_td_f in package.json|*/package.json) ;; *) continue ;; esac
    _td_new=$(bun -e '
      const fs = require("fs");
      const read = (p) => { try { const v = JSON.parse(fs.readFileSync(p, "utf8")).trustedDependencies; return Array.isArray(v) ? v : []; } catch { return []; } };
      const before = new Set(read(process.argv[1]));
      console.log(read(process.argv[2]).filter((d) => !before.has(d)).join(" "));' "$FORGE_TMP/base/$_td_f" "$_td_f") || continue
    if [ -n "$_td_new" ]; then
      printf '%s: trustedDependencies adds %s (its install scripts would run); the user adds trusted packages, not Claude\n' "$_td_f" "$_td_new"
      _td_rc=1
    fi
  done < "$FORGE_TMP/existing"
  return "$_td_rc"
}

# GitHub Actions workflows: pinned zizmor (through uvx), offline audits only, inline
# ignore comments and ignore rules not honoured (disabling goes through forge.yaml).
FORGE_ZIZMOR_VERSION="1.30.1"

# forge_zizmor <audit>...: zizmor on $FORGE_FILES (else every tracked workflow and
# action); prints "path:line audit message" for the findings of the named audits.
forge_zizmor() {
  if [ -n "$FORGE_FILES" ]; then set -f; set -- "$@" -- $FORGE_FILES; set +f
  else
    set -f
    # shellcheck disable=SC2046
    set -- "$@" -- $(git ls-files -- '.github/workflows/*.yml' '.github/workflows/*.yaml' '.github/actions/*action.yml' '.github/actions/*action.yaml' 'action.yml' 'action.yaml')
    set +f
  fi
  _fz_audits=''
  while [ "$1" != -- ]; do _fz_audits="$_fz_audits|$1"; shift; done
  shift
  [ "$#" -gt 0 ] || return 0
  command -v uvx >/dev/null 2>&1 || { printf 'forge:%s skipped: uvx is needed to run zizmor\n' "$c_id"; return 0; }
  uvx -q "zizmor@$FORGE_ZIZMOR_VERSION" --offline --no-progress --no-ignores --format github "$@" > "$FORGE_TMP/zizmor" 2> "$FORGE_TMP/zizmor.err"
  _fz_rc=$?
  if [ "$_fz_rc" -ne 0 ] && [ "$_fz_rc" -lt 10 ]; then
    printf 'forge:%s skipped: zizmor could not run (%s)\n' "$c_id" "$(grep -v '^[[:space:]]*$' "$FORGE_TMP/zizmor.err" | tail -n 1)"
    return 0
  fi
  awk -v audits="${_fz_audits#|}" '
    BEGIN { n = split(audits, a, "|"); for (i = 1; i <= n; i++) want[a[i]] = 1 }
    /^::(error|warning|notice) / {
      meta = $0; sub(/^::[a-z]+ /, "", meta); msg = meta; sub(/^[^:]*::/, "", msg); sub(/::.*$/, "", meta)
      file = meta; sub(/^.*file=/, "", file); sub(/,.*$/, "", file)
      line = meta; sub(/^.*line=/, "", line); sub(/,.*$/, "", line)
      title = meta; sub(/^.*title=/, "", title); sub(/,.*$/, "", title)
      sub(/^[^:]*:[0-9]+: /, "", msg)
      if (title in want) { print file ":" line " " title ": " msg; bad = 1 }
    }
    END { exit bad }' "$FORGE_TMP/zizmor"
}

# Dockerfiles: pinned hadolint (hadolint-bin through uvx; its binary must match the
# upstream release's sha256), run once per check.sh run and shared by the rules.
FORGE_HADOLINT_VERSION="2.15.1"
FORGE_HADOLINT_SHA256='Linux-x86_64 c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507
Linux-aarch64 f6198ef8090f404dbb771abfee086eb8c48ac177f30da7fd3510aca35b344b5d
Linux-arm64 f6198ef8090f404dbb771abfee086eb8c48ac177f30da7fd3510aca35b344b5d
Darwin-arm64 5c09f3213f8e40406abe048233d985eebef336d4a6a20021be47fadb6cf480a2
Darwin-x86_64 ffe9bb18b23d5ed1eae50237aecdbb523d016e96da0bd4e7aa432040acfc3fde'

# forge_dockerfiles: the Dockerfiles / Containerfiles of $FORGE_FILES, else every tracked one.
forge_dockerfiles() {
  if [ -n "$FORGE_FILES" ]; then printf '%s\n' "$FORGE_FILES"; else git ls-files 2>/dev/null; fi \
    | grep -E '(^|/)(Dockerfile(\.[^/]*)?|[^/]*\.Dockerfile|Containerfile)$' | grep -v '\.dockerignore$'
}

# forge_hadolint <code>...: "path:line CODE: message" for the named hadolint codes.
forge_hadolint() {
  forge_dockerfiles > "$FORGE_TMP/dockerfiles"
  [ -s "$FORGE_TMP/dockerfiles" ] || return 0
  if ! cmp -s "$FORGE_TMP/dockerfiles" "$FORGE_TMP/hadolint.files" 2>/dev/null; then
    cp "$FORGE_TMP/dockerfiles" "$FORGE_TMP/hadolint.files"
    : > "$FORGE_TMP/hadolint.out"
    if ! command -v uvx >/dev/null 2>&1; then
      printf 'skipped: uvx is needed to run hadolint\n' > "$FORGE_TMP/hadolint.skip"
    elif ! _fh_bin=$(uvx -q --from "hadolint-bin==$FORGE_HADOLINT_VERSION" python -c 'import shutil; print(shutil.which("hadolint") or "")' 2>/dev/null) || [ -z "$_fh_bin" ]; then
      printf 'skipped: hadolint could not be installed (offline?)\n' > "$FORGE_TMP/hadolint.skip"
    else
      _fh_plat=$(uname -s)-$(uname -m)
      _fh_want=$(printf '%s\n' "$FORGE_HADOLINT_SHA256" | awk -v p="$_fh_plat" '$1 == p { print $2 }')
      _fh_have=$(forge_sha256 < "$_fh_bin")
      if [ -z "$_fh_want" ]; then
        printf 'skipped: no upstream hadolint checksum for %s\n' "$_fh_plat" > "$FORGE_TMP/hadolint.skip"
      elif [ "$_fh_have" != "$_fh_want" ]; then
        printf 'skipped: the hadolint-bin %s binary does not match the upstream release (sha256 %s)\n' "$FORGE_HADOLINT_VERSION" "$_fh_have" > "$FORGE_TMP/hadolint.skip"
      else
        rm -f "$FORGE_TMP/hadolint.skip"
        printf 'ignored: []\n' > "$FORGE_TMP/hadolint.yaml"
        set -f
        # shellcheck disable=SC2046
        "$_fh_bin" -c "$FORGE_TMP/hadolint.yaml" --disable-ignore-pragma --no-fail --no-color -f tty $(cat "$FORGE_TMP/dockerfiles") > "$FORGE_TMP/hadolint.out" 2>&1
        set +f
      fi
    fi
  fi
  if [ -f "$FORGE_TMP/hadolint.skip" ]; then printf 'forge:%s %s\n' "$c_id" "$(cat "$FORGE_TMP/hadolint.skip")"; return 0; fi
  _fh_codes=' '
  for _fh_c in "$@"; do _fh_codes="$_fh_codes$_fh_c "; done
  awk -v codes="$_fh_codes" '
    match($0, /^[^[:space:]]+:[0-9]+ [A-Z]+[0-9]+ [a-z]+: /) {
      split($0, w, " "); if (index(codes, " " w[2] " ") == 0) next
      msg = $0; sub(/^[^[:space:]]+ [^[:space:]]+ [a-z]+: /, "", msg)
      print w[1] " " w[2] ": " msg; bad = 1
    }
    END { exit bad }' "$FORGE_TMP/hadolint.out"
}

# forge_dockerfile_records <file>: one "line<TAB>instruction" per instruction,
# continuation lines joined, comments dropped.
forge_dockerfile_records() {
  awk '
    function flush() { if (cur != "") print start "\t" cur; cur = "" }
    {
      line = $0; sub(/\r$/, "", line)
      if (cur == "") { if (line ~ /^[[:space:]]*(#|$)/) next; start = NR }
      else if (line ~ /^[[:space:]]*#/) next
      if (match(line, /\\[[:space:]]*$/)) { cur = cur substr(line, 1, RSTART - 1) " "; next }
      cur = cur line; flush()
    }
    END { flush() }' "$1"
}

# forge_docker_nonroot: the final stage of each Dockerfile runs as a non-root USER,
# set in that stage or inherited from the named stage it builds on; images that run
# non-root by default (cgr.dev/, dhi.io/, *nonroot*, *unprivileged*, *rootless*) are exempt.
forge_docker_nonroot() {
  _dn_rc=0
  forge_dockerfiles > "$FORGE_TMP/dockerfiles"
  while IFS= read -r _dn_f; do
    [ -f "$_dn_f" ] || continue
    forge_dockerfile_records "$_dn_f" | awk -F '\t' -v f="$_dn_f" '
      {
        args = $2; sub(/^[[:space:]]*[A-Za-z]+[[:space:]]*/, "", args); instr = toupper($2); sub(/[[:space:]].*$/, "", instr)
        if (instr == "FROM") {
          n++; split(args, w, /[[:space:]]+/); i = 1; while (w[i] ~ /^--/) i++
          img[n] = w[i]; name[n] = ""; user[n] = ""
          if (tolower(w[i + 1]) == "as") name[n] = tolower(w[i + 2])
        } else if (instr == "USER" && n) { split(args, w, /[[:space:]]+/); user[n] = w[1] }
      }
      END {
        if (!n) exit 0
        s = n; u = user[s]; b = img[s]
        for (guard = 0; u == "" && guard < 50; guard++) {
          k = 0; for (j = 1; j < s; j++) if (name[j] != "" && name[j] == tolower(b)) k = j
          if (!k) break
          s = k; u = user[k]; b = img[k]
        }
        if (u == "") {
          if (b ~ /^(cgr\.dev|dhi\.io)\// || tolower(b) ~ /nonroot|unprivileged|rootless/) exit 0
          print f ":0 the final stage has no USER (it runs as root); add a non-root USER"; exit 1
        }
        if (u ~ /^(root|0)(:.*)?$/) { print f ":0 the final stage runs as USER " u "; use a non-root user"; exit 1 }
      }' || _dn_rc=1
  done < "$FORGE_TMP/dockerfiles"
  return "$_dn_rc"
}

# forge_docker_secrets: no ARG or ENV named like a secret (PASSWORD, SECRET, TOKEN,
# API_KEY, PRIVATE_KEY, CREDENTIALS); *_FILE names are fine.
forge_docker_secrets() {
  _ds_rc=0
  forge_dockerfiles > "$FORGE_TMP/dockerfiles"
  while IFS= read -r _ds_f; do
    [ -f "$_ds_f" ] || continue
    forge_dockerfile_records "$_ds_f" | awk -F '\t' -v f="$_ds_f" '
      {
        instr = toupper($2); sub(/[[:space:]].*$/, "", instr)
        if (instr != "ARG" && instr != "ENV") next
        args = $2; sub(/^[[:space:]]*[A-Za-z]+[[:space:]]*/, "", args)
        n = split(args, w, /[[:space:]]+/)
        for (i = 1; i <= n; i++) {
          name = w[i]; sub(/=.*$/, "", name)
          if (instr == "ENV" && i > 1 && w[1] !~ /=/) break
          if (toupper(name) ~ /(PASSWORD|SECRET|TOKEN|API_?KEY|PRIVATE_KEY|CREDENTIALS)/ && toupper(name) !~ /_FILE$/) {
            print f ":" $1 " " instr " " name " puts a secret in the image or its history; use RUN --mount=type=secret,id=..."; bad = 1
          }
          if (instr == "ARG") break
        }
      }
      END { exit bad }' || _ds_rc=1
  done < "$FORGE_TMP/dockerfiles"
  return "$_ds_rc"
}

# forge_docker_locked: RUN installs from the lock file (npm ci, bun install
# --frozen-lockfile, uv sync --locked or --frozen, pnpm install --frozen-lockfile,
# yarn --immutable or --frozen-lockfile) and never adds packages (bun add, uv add).
forge_docker_locked() {
  _dl_rc=0
  forge_dockerfiles > "$FORGE_TMP/dockerfiles"
  while IFS= read -r _dl_f; do
    [ -f "$_dl_f" ] || continue
    forge_dockerfile_records "$_dl_f" | awk -F '\t' -v f="$_dl_f" '
      function why(c,   t) {
        t = " " c " "
        if (c ~ /^npm (install|i|add)( |$)/ && t !~ / (-g|--global) /) return "use npm ci"
        if (c ~ /^bun (install|i)( |$)/ && t !~ / --frozen-lockfile /) return "add --frozen-lockfile"
        if (c ~ /^bun add( |$)/) return "add dependencies to package.json and bun.lock, not in the image"
        if (c ~ /^uv sync( |$)/ && t !~ / (--locked|--frozen) /) return "add --locked (or --frozen)"
        if (c ~ /^uv add( |$)/) return "add dependencies to pyproject.toml and uv.lock, not in the image"
        if (c ~ /^pnpm (install|i)( |$)/ && t !~ / --frozen-lockfile /) return "add --frozen-lockfile"
        if (c ~ /^yarn( install)?( -[^ ]*)*$/ && t !~ / (--immutable|--frozen-lockfile) /) return "add --immutable (Yarn 2+) or --frozen-lockfile"
        return ""
      }
      {
        instr = toupper($2); sub(/[[:space:]].*$/, "", instr)
        if (instr != "RUN") next
        args = $2; sub(/^[[:space:]]*[A-Za-z]+[[:space:]]*/, "", args)
        while (args ~ /^--[^[:space:]]+[[:space:]]/) sub(/^--[^[:space:]]+[[:space:]]+/, "", args)
        n = split(args, cmds, /&&|\|\||;/)
        for (i = 1; i <= n; i++) {
          c = cmds[i]; gsub(/[[:space:]]+/, " ", c); sub(/^ /, "", c); sub(/ $/, "", c)
          while (c ~ /^([A-Za-z_][A-Za-z0-9_]*=[^ ]* |sudo )/) sub(/^[^ ]+ /, "", c)
          r = why(c)
          if (r != "") { print f ":" $1 " " c ": " r; bad = 1 }
        }
      }
      END { exit bad }' || _dl_rc=1
  done < "$FORGE_TMP/dockerfiles"
  return "$_dl_rc"
}

# forge_docker_ignore: each Dockerfile has a .dockerignore (<Dockerfile>.dockerignore,
# the one in its directory, or the one at the repository root) that excludes .env files.
forge_docker_ignore() {
  _di_rc=0
  forge_dockerfiles > "$FORGE_TMP/dockerfiles"
  while IFS= read -r _di_f; do
    [ -f "$_di_f" ] || continue
    _di_d=$(dirname "$_di_f")
    _di_ig=''
    [ "$_di_d" = . ] && _di_d='' || _di_d="$_di_d/"
    for _di_c in "$_di_f.dockerignore" "$_di_d.dockerignore" .dockerignore; do
      [ -f "$_di_c" ] && { _di_ig=$_di_c; break; }
    done
    if [ -z "$_di_ig" ]; then
      printf '%s:0 has no .dockerignore (next to it or at the root); add one that excludes .env files\n' "$_di_f"; _di_rc=1
    elif ! grep -qE '^[[:space:]]*((\*\*/)?\.env(\*|\.\*)?|\*\.env|\*|\*\*)[[:space:]]*$' "$_di_ig"; then
      printf '%s:0 %s does not exclude .env files; add .env* to it\n' "$_di_f" "$_di_ig"; _di_rc=1
    fi
  done < "$FORGE_TMP/dockerfiles"
  return "$_di_rc"
}

# forge_exec_tool <name> <args>: runs the project's own <name>; 127 when absent.
forge_exec_tool() {
  _fx_cmd=$(tool "$1")
  [ -n "$_fx_cmd" ] || { printf 'forge: %s not installed\n' "$1" >&2; return 127; }
  shift
  _fx_ifs=$IFS
  IFS=' '
  # shellcheck disable=SC2086
  set -- $_fx_cmd "$@"
  IFS=$_fx_ifs
  "$@"
}

# forge_has_tool <name>: system runtimes (uv, bun) via PATH, others via tool().
forge_has_tool() {
  case $1 in
    uv|uvx|bun|docker) command -v "$1" >/dev/null 2>&1 ;;
    *) [ -n "$(tool "$1")" ] ;;
  esac
}

# forge_missing_tool: prints the first tool of $c_tools that is absent.
forge_missing_tool() {
  _fm_ifs=$IFS
  IFS=' '
  for _fm_t in $c_tools; do
    if ! forge_has_tool "$_fm_t"; then IFS=$_fm_ifs; printf '%s' "$_fm_t"; return 0; fi
  done
  IFS=$_fm_ifs
  return 1
}

# forge_filter <predicate>: lines of stdin for which <predicate> <line> succeeds.
forge_filter() {
  while read -r _ff_line; do
    [ -n "$_ff_line" ] && "$1" "$_ff_line" && printf '%s\n' "$_ff_line"
  done
  return 0
}

# forge_db_url: DATABASE_URL from the environment, then .env, then alembic.ini.
forge_db_url() {
  if [ -n "${DATABASE_URL:-}" ]; then printf '%s' "$DATABASE_URL"; return 0; fi
  if [ -f .env ]; then
    _fd_url=$(sed -n 's/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}DATABASE_URL[[:space:]]*=[[:space:]]*//p' .env \
      | tail -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/")
    if [ -n "$_fd_url" ]; then printf '%s' "$_fd_url"; return 0; fi
  fi
  if [ -f alembic.ini ]; then
    sed -n 's/^[[:space:]]*sqlalchemy\.url[[:space:]]*=[[:space:]]*//p' alembic.ini | head -n 1 | sed 's/[[:space:]]*$//'
  fi
}

# forge_local_db: succeeds when the configured database is on this machine
# (localhost, 127.0.0.1, ::1, empty host or a Unix socket).
forge_local_db() {
  _fl_url=$(forge_db_url)
  [ -n "$_fl_url" ] || return 1
  case $_fl_url in *host=/*|*host=%2[Ff]*) return 0 ;; esac
  _fl_host=$(printf '%s' "$_fl_url" | sed -e 's|^[A-Za-z][A-Za-z0-9+.-]*://||' -e 's|[/?].*$||' -e 's|^.*@||')
  case $_fl_host in
    \[*) _fl_host=$(printf '%s' "$_fl_host" | sed 's|^\[\([^]]*\)\].*$|\1|') ;;
    *) _fl_host=$(printf '%s' "$_fl_host" | sed 's|:.*$||') ;;
  esac
  case $_fl_host in ''|localhost|127.0.0.1|::1|%2[Ff]*) return 0 ;; esac
  return 1
}

# Migration linting with Squawk: only the changes that break the running version of
# the application during a deploy fail (renames, type changes, new required columns,
# DROP DATABASE); Squawk's other advice is not enforced.
FORGE_SQUAWK_VERSION="2.70.0"
FORGE_SQUAWK_BLOCKING='renaming-column|renaming-table|changing-column-type|adding-required-field|adding-not-nullable-field|ban-drop-database'

# forge_squawk <args>: the pinned Squawk through bunx or uvx; gcc-style output in
# $FORGE_TMP/squawk. Exit status 0 when Squawk ran (with or without findings).
forge_squawk() {
  if command -v bunx >/dev/null 2>&1; then
    bunx -p "squawk-cli@$FORGE_SQUAWK_VERSION" squawk --reporter gcc "$@" > "$FORGE_TMP/squawk" 2>&1
  elif command -v uvx >/dev/null 2>&1; then
    uvx -q --from "squawk-cli==$FORGE_SQUAWK_VERSION" squawk --reporter gcc "$@" > "$FORGE_TMP/squawk" 2>&1
  else
    printf 'bunx or uvx is needed\n' > "$FORGE_TMP/squawk"
    return 2
  fi
  _sq_rc=$?
  # Squawk exits 1 whenever it warns, which is almost always
  [ "$_sq_rc" -eq 0 ] || grep -qE ':[0-9]+:[0-9]+: (warning|error): ' "$FORGE_TMP/squawk"
}

# forge_squawk_blocking: prints the blocking findings of the last forge_squawk run
# (Squawk counts lines and columns from 0; printed from 1); fails if any.
forge_squawk_blocking() {
  grep -E ": (warning|error): ($FORGE_SQUAWK_BLOCKING) " "$FORGE_TMP/squawk" \
    | sed -E 's/^(.*):([0-9]+):([0-9]+): /\1 \2 \3 /' \
    | awk '{ f = $1; l = $2 + 1; c = $3 + 1; $1 = $2 = $3 = ""; sub(/^ +/, ""); print f ":" l ":" c ": " $0 }' > "$FORGE_TMP/squawk.found"
  cat "$FORGE_TMP/squawk.found"
  [ ! -s "$FORGE_TMP/squawk.found" ]
}

# forge_squawk_skipped: reports, as a forge: line of the current check, that Squawk could not run.
forge_squawk_skipped() {
  printf 'forge:%s skipped: squawk could not run (%s)\n' "$c_id" "$(grep -v '^[[:space:]]*$' "$FORGE_TMP/squawk" | tail -n 1)"
}

# forge_squawk_files <sql files>: lints migration SQL files.
forge_squawk_files() {
  [ "$#" -gt 0 ] || return 0
  forge_squawk "$@" || { forge_squawk_skipped; return 0; }
  forge_squawk_blocking
}

# forge_alembic_files: Alembic revision ids on stdin (as printed by `alembic heads`)
# -> the revision files under alembic/versions that define them.
forge_alembic_files() {
  awk '{ print $1 }' | while read -r _fa_id; do
    [ -n "$_fa_id" ] && find alembic/versions -name '*.py' -exec grep -lE "^revision[^=]*=[[:space:]]*['\"]$_fa_id['\"]" {} + 2>/dev/null
  done
}

# forge_squawk_alembic <revision files>: lints the SQL each revision's upgrade emits
# (`alembic upgrade <down_revision>:<revision> --sql`, offline: no database needed).
# Merge revisions are skipped; when Alembic cannot render SQL, the revision is reported skipped.
forge_squawk_alembic() {
  _fs_rc=0
  for _fs_f in "$@"; do
    _fs_rev=$(sed -n "s/^revision[^=]*=[[:space:]]*['\"]\([^'\"]*\)['\"].*/\1/p" "$_fs_f" | head -n 1)
    _fs_down=$(sed -n 's/^down_revision[^=]*=[[:space:]]*//p' "$_fs_f" | head -n 1)
    [ -n "$_fs_rev" ] || continue
    case $_fs_down in
      \(*|\[*) continue ;;
      None*|'') _fs_range=$_fs_rev ;;
      *) _fs_range="$(printf '%s' "$_fs_down" | sed "s/^['\"]\([^'\"]*\)['\"].*/\1/"):$_fs_rev" ;;
    esac
    if ! alembic upgrade "$_fs_range" --sql > "$FORGE_TMP/alembic.sql" 2> "$FORGE_TMP/alembic.err"; then
      printf 'forge:%s skipped: alembic upgrade %s --sql failed for %s (%s)\n' "$c_id" "$_fs_range" "$_fs_f" "$(grep -v '^[[:space:]]*$' "$FORGE_TMP/alembic.err" | tail -n 1)"
      continue
    fi
    if ! forge_squawk --stdin-filepath "$_fs_f" < "$FORGE_TMP/alembic.sql"; then forge_squawk_skipped; return 0; fi
    if ! forge_squawk_blocking > "$FORGE_TMP/squawk.block"; then
      printf 'SQL of alembic upgrade %s --sql (line numbers are in that SQL):\n' "$_fs_range"
      cat "$FORGE_TMP/squawk.block"
      _fs_rc=1
    fi
  done
  return "$_fs_rc"
}

# forge_related_py_tests <files>: changed test files plus tests/**/test_<module>.py
# for each changed module, one per line.
forge_related_py_tests() {
  for _fr_f in "$@"; do
    case $_fr_f in
      *.py) ;;
      *) continue ;;
    esac
    _fr_b=${_fr_f##*/}
    case $_fr_b in
      test_*.py|*_test.py) [ -f "$_fr_f" ] && printf '%s\n' "$_fr_f" ;;
      __init__.py|conftest.py) ;;
      *) [ -d tests ] && find tests -type f -name "test_${_fr_b%.py}.py" 2>/dev/null ;;
    esac
  done | sort -u
}

# forge_exec_check <fn> <timeout>: runs <fn> with output in $FORGE_TMP/out.
forge_exec_check() {
  set -f
  if [ -n "$2" ]; then
    "$1" > "$FORGE_TMP/out" 2>&1 &
    _fe_pid=$!
    ( sleep "$2"; printf 'forge: timed out after %ss\n' "$2" >> "$FORGE_TMP/out"; forge_kill_tree "$_fe_pid" ) >/dev/null 2>&1 &
    _fe_watch=$!
    wait "$_fe_pid" 2>/dev/null
    _fe_rc=$?
    forge_kill_tree "$_fe_watch"
  else
    ( "$1" ) > "$FORGE_TMP/out" 2>&1 < /dev/null
    _fe_rc=$?
  fi
  set +f
  return "$_fe_rc"
}

# forge_diagnostics <output> <file|line> [print]: sorts the error diagnostics of a
# failed run by what they name (tsc "path(l,c)", "path:l:c" from Python and JS
# linters, "--> path:l:c"; "Would reformat: path" and Biome's "path format" name a
# file only; absolute paths under the repository are made relative; warning-only
# lines are ignored). A diagnostic counts when it names a file of $FORGE_TMP/changed
# ("file"), or an added line of $FORGE_TMP/added ("line"; one naming only a file, or
# line 0, counts when that file changed). Prints "changed" when one counts, "other" when
# they name only other files or lines, "none" when no line names a file. With
# "print", prints the lines that count instead. ANSI colour sequences are ignored, so a
# tool that colours its output (tsc with "pretty": true) is attributed the same way.
forge_diagnostics() {
  awk -v r1="$(pwd)" -v r2="$(pwd -P)" -v level="$2" -v mode="$3" '
    BEGIN { ansi = sprintf("%c", 27) "\\[[0-9;]*[A-Za-z]" }
    FILENAME == ARGV[1] { ch[$0] = 1; next }
    FILENAME == ARGV[2] { if ($2 == "*") whole[$1] = 1; else ad[$1 "\t" $2] = 1; next }
    {
      line = $0
      gsub(ansi, "", line)
      if (line ~ /[Ww]arning/ && line !~ /[Ee]rror/) next
      sub(/^[[:space:]]*(-->[[:space:]]*)?/, "", line)
      ln = ""
      if (match(line, /^[^[:space:]:(]+([(][0-9]+,[0-9]+[)]|:[0-9]+(:[0-9]+)?)/)) {
        p = substr(line, 1, RLENGTH)
        loc = p; sub(/^[^[:space:]:(]+[(:]/, "", loc); ln = loc + 0
        sub(/([(][0-9]+,[0-9]+[)]|:[0-9]+(:[0-9]+)?)$/, "", p)
      } else if (match(line, /^Would reformat: [^[:space:]]+/)) p = substr(line, 18, RLENGTH - 17)
      else if (match(line, /^[^[:space:]:(]+ format /)) { p = line; sub(/ format .*$/, "", p) }
      else next
      if (index(p, r1 "/") == 1) p = substr(p, length(r1) + 2)
      else if (index(p, r2 "/") == 1) p = substr(p, length(r2) + 2)
      sub(/^\.\//, "", p)
      named = 1
      if (level == "line") counts = (p in whole) || (ln == "" || ln == 0 ? (p in ch) : ((p "\t" ln) in ad))
      else counts = (p in ch)
      if (counts) { hit = 1; if (mode == "print") print $0 }
    }
    END { if (mode != "print") print (hit ? "changed" : named ? "other" : "none") }' "$FORGE_TMP/changed" "$FORGE_TMP/added" "$1"
}

# forge_attribute_level <stage> <whole-project run: 1|0>: how a failed check's
# diagnostics are attributed outside --all: lint by added line, typecheck and a
# whole-project format run by changed file; anything else is not attributed.
forge_attribute_level() {
  case $1 in
    lint) printf 'line' ;;
    typecheck) printf 'file' ;;
    format) [ "$2" = 1 ] && printf 'file' ;;
  esac
}

# forge_run_check <n>: one check under check.sh ($mode and forge_change_set's files).
# --changed and --turn run the {files} form on the changed files when there is one;
# --since and --all run the whole-project form (read-only, as CI should).
forge_run_check() {
  forge_check_meta_"$1"
  FORGE_FILES=''
  if [ "$mode" != --all ]; then
    if [ "$c_when" = 1 ]; then
      [ -n "$(forge_filter "forge_when_$1" < "$FORGE_TMP/changed")" ] || return 0
    fi
    FORGE_FILES=$(forge_filter "forge_scope_$1" < "$FORGE_TMP/existing")
    [ "$c_when" = 1 ] || [ -n "$FORGE_FILES" ] || return 0
  fi
  if _fc_missing=$(forge_missing_tool); then
    printf 'forge:%s skipped: %s not installed\n' "$c_id" "$_fc_missing"
    return 0
  fi
  if [ "$c_localdb" = 1 ] && ! forge_local_db; then
    printf 'forge:%s skipped: no local database\n' "$c_id"
    return 0
  fi
  _fc_fn=forge_check_run_$1
  _fc_whole=1
  case $mode in --changed|--turn)
    if [ "$c_changed" = 1 ] && [ -n "$FORGE_FILES" ]; then _fc_fn=forge_check_changed_$1; _fc_whole=0; fi ;;
  esac
  if forge_exec_check "$_fc_fn" "$c_timeout"; then
    grep '^forge:' "$FORGE_TMP/out"
    return 0
  fi
  # outside --all, only errors in the change count (§10.1 step 5)
  _fc_level=$(forge_attribute_level "$c_stage" "$_fc_whole")
  if [ "$mode" != --all ] && [ -n "$_fc_level" ]; then
    case $(forge_diagnostics "$FORGE_TMP/out" "$_fc_level") in
      other)
        if [ "$_fc_level" = line ]; then
          printf 'forge:%s ok for the added lines (findings remain on lines this change did not add: sh .forge/check.sh --all)\n' "$c_id"
        else
          printf 'forge:%s ok for the changed files (errors remain in unchanged files: sh .forge/check.sh --all)\n' "$c_id"
        fi
        return 0 ;;
      changed)
        printf 'forge:%s failed\n' "$c_id"
        forge_diagnostics "$FORGE_TMP/out" "$_fc_level" print | first_lines 15
        return 1 ;;
    esac
  fi
  printf 'forge:%s failed\n' "$c_id"
  first_lines 15 < "$FORGE_TMP/out"
  return 1
}

# forge_run_stage <stage>: every check of <stage>; fails if one fails.
forge_run_stage() {
  _fs_i=1
  _fs_rc=0
  while [ "$_fs_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fs_i"
    if [ "$c_stage" = "$1" ]; then
      forge_run_check "$_fs_i" || _fs_rc=1
    fi
    _fs_i=$((_fs_i + 1))
  done
  [ "$_fs_rc" -eq 0 ] || fail=1
  return "$_fs_rc"
}

# forge_file_stage <stage> <file>: the {files} form of each in-scope check of
# <stage>, on one file (PostToolUse). Prints failures; lint findings only on the
# lines of $FORGE_TMP/added; absent tools are skipped.
forge_file_stage() {
  _fp_i=1
  _fp_rc=0
  FORGE_FILES=$2
  while [ "$_fp_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fp_i"
    if [ "$c_stage" = "$1" ] && [ "$c_files" = 1 ] && forge_scope_"$_fp_i" "$2" && ! forge_missing_tool >/dev/null; then
      if ! forge_exec_check "forge_check_changed_$_fp_i" "$c_timeout"; then
        _fp_level=$(forge_attribute_level "$1" 0)
        _fp_what=none
        [ -n "$_fp_level" ] && _fp_what=$(forge_diagnostics "$FORGE_TMP/out" "$_fp_level")
        case $_fp_what in
          other) ;;
          changed)
            printf 'forge:%s\n' "$c_id"
            forge_diagnostics "$FORGE_TMP/out" "$_fp_level" print | first_lines 15
            _fp_rc=1 ;;
          *)
            printf 'forge:%s\n' "$c_id"
            first_lines 15 < "$FORGE_TMP/out"
            _fp_rc=1 ;;
        esac
      fi
    fi
    _fp_i=$((_fp_i + 1))
  done
  return "$_fp_rc"
}

# forge_file_fixes <file>: the safe fixes (fix_run) of each in-scope lint check, on
# one file. When they changed it, prints "forge: auto-fixed <codes> in <file>" (codes
# from ruff's --show-fixes summary), so Claude knows its view of the file is stale.
forge_file_fixes() {
  _fx_i=1
  _fx_codes=''
  _fx_before=$(git hash-object -- "$1" 2>/dev/null)
  FORGE_FILES=$1
  while [ "$_fx_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fx_i"
    if [ "$c_stage" = lint ] && [ "$c_fix" = 1 ] && forge_scope_"$_fx_i" "$1" && ! forge_missing_tool >/dev/null; then
      forge_exec_check "forge_check_fix_$_fx_i" "$c_timeout"
      _fx_codes="$_fx_codes $(awk '/^Fixed [0-9]+ error/ { on = 1; next } on && /^ +[0-9]+ / && match($0, /[A-Z]+[0-9]+ \(/) { printf "%s ", substr($0, RSTART, RLENGTH - 2) } /^$/ { on = 0 }' "$FORGE_TMP/out")"
    fi
    _fx_i=$((_fx_i + 1))
  done
  [ "$(git hash-object -- "$1" 2>/dev/null)" != "$_fx_before" ] || return 0
  _fx_codes=$(printf '%s' "$_fx_codes" | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//; s/ /, /g')
  printf 'forge: auto-fixed %s in %s; re-read it before editing it again\n' "${_fx_codes:-safe lint fixes}" "$1"
}

# forge_typecheck <file>: the full run of each typecheck check whose scope covers <file>;
# only errors in files of $FORGE_TMP/changed count ($FORGE_TMP/added must exist).
forge_typecheck() {
  _ft_i=1
  _ft_rc=0
  while [ "$_ft_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_ft_i"
    if [ "$c_stage" = typecheck ] && forge_scope_"$_ft_i" "$1" && ! forge_missing_tool >/dev/null; then
      if ! forge_exec_check "forge_check_run_$_ft_i" "$c_timeout"; then
        # only errors in changed files wake Claude
        case $(forge_diagnostics "$FORGE_TMP/out" file) in
          other) ;;
          changed)
            printf 'forge:%s\n' "$c_id"
            forge_diagnostics "$FORGE_TMP/out" file print | first_lines 19
            _ft_rc=1 ;;
          *)
            printf 'forge:%s\n' "$c_id"
            first_lines 19 < "$FORGE_TMP/out"
            _ft_rc=1 ;;
        esac
      fi
    fi
    _ft_i=$((_ft_i + 1))
  done
  return "$_ft_rc"
}

# forge_missing_tools: the tools the checks need that are not here, comma-separated
# (also what forge status prints: one source of truth).
forge_missing_tools() {
  _mt=''
  for _mt_t in $(forge_required_tools); do
    forge_has_tool "$_mt_t" || _mt="${_mt:+$_mt, }$_mt_t"
  done
  if ! command -v bunx >/dev/null 2>&1 && ! command -v uvx >/dev/null 2>&1; then
    _mt="${_mt:+$_mt, }bunx or uvx (ast-grep)"
  fi
  printf '%s' "$_mt"
}

# forge_required_tools: every tool the checks use, one per line.
forge_required_tools() {
  _fq_i=1
  while [ "$_fq_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fq_i"
    printf '%s\n' "$c_tools" | tr ' ' '\n'
    _fq_i=$((_fq_i + 1))
  done | awk 'NF && !seen[$0]++'
}

# Scripts that checks run with the project's own runtime (Python, bun).
forge_script_ratchet_mjs() {
cat <<'FORGE_SCRIPT_END'
// Generated by forge. Config ratchet for JavaScript tool configs (run by
// .forge/check.sh with bun): compares each changed file with its copy in the base
// and prints one line per loosened setting. Usage:
//   bun ratchet.mjs <base-dir> <path>...
// Exit 0: nothing loosened; 1: findings printed; 3: cannot run ("skipped: …" printed).
import { readFileSync } from "node:fs";

const findings = [];
const out = (path, what) => findings.push(`${path}: ${what}`);
const show = (v) => (v === undefined || v === null ? "unset" : Array.isArray(v) ? `[${v.map(show).join(", ")}]` : typeof v === "object" ? "{…}" : String(v).replace(/["\\]/g, ""));
const list = (v) => (v === undefined || v === null ? [] : Array.isArray(v) ? v : [v]);
const obj = (v) => (v && typeof v === "object" && !Array.isArray(v) ? v : {});

/** JSON with comments and trailing commas -> value. */
function parseJsonc(text) {
  let s = "";
  for (let i = 0, str = false; i < text.length; i++) {
    const c = text[i];
    if (str) {
      s += c;
      if (c === "\\") s += text[++i] ?? "";
      else if (c === '"') str = false;
    } else if (c === '"') {
      str = true;
      s += c;
    } else if (text.startsWith("//", i)) {
      while (i < text.length && text[i] !== "\n") i++;
      s += "\n";
    } else if (text.startsWith("/*", i)) {
      const end = text.indexOf("*/", i + 2);
      i = end < 0 ? text.length : end + 1;
    } else s += c;
  }
  return JSON.parse(s.replace(/,(\s*[}\]])/g, "$1"));
}

// ---- Biome

const LEVEL = { off: 0, info: 1, warn: 2, error: 3, on: 2 };
const level = (v) => (typeof v === "string" ? v : obj(v).level);

function biome(path, b, a) {
  const lb = obj(b.linter), la = obj(a.linter);
  if (lb.enabled !== false && la.enabled === false) out(path, "linter.enabled true -> false");
  if (obj(b.formatter).enabled !== false && obj(a.formatter).enabled === false) out(path, "formatter.enabled true -> false");
  const rb = obj(lb.rules), ra = obj(la.rules);
  if (rb.recommended !== false && ra.recommended === false) out(path, `linter.rules.recommended ${show(rb.recommended ?? true)} -> false`);
  for (const [group, gb] of Object.entries(rb)) {
    if (group === "recommended") continue;
    const ga = ra[group];
    if (typeof gb === "string") {
      const now = typeof ga === "string" ? ga : undefined;
      if ((LEVEL[gb] ?? 0) > (LEVEL[now] ?? -1) && now !== undefined) out(path, `linter.rules.${group} ${gb} -> ${now}`);
      else if (now === undefined && (LEVEL[gb] ?? 0) > 0 && typeof ga !== "object") out(path, `linter.rules.${group} ${gb} -> unset`);
      continue;
    }
    for (const [name, vb] of Object.entries(obj(gb))) {
      const before = level(vb);
      const after = typeof ga === "string" ? ga : level(obj(ga)[name]);
      if (before === undefined || !(before in LEVEL)) continue;
      if (after === undefined) {
        if (LEVEL[before] > 0) out(path, `linter.rules.${group}.${name} ${before} -> unset`);
      } else if ((LEVEL[after] ?? 0) < LEVEL[before]) out(path, `linter.rules.${group}.${name} ${before} -> ${after}`);
    }
  }
  const negated = (cfg) => list(cfg.includes).filter((g) => typeof g === "string" && g.startsWith("!"));
  for (const [where, cb, ca] of [["files", obj(b.files), obj(a.files)], ["linter", lb, la]]) {
    for (const g of negated(ca)) if (!negated(cb).includes(g)) out(path, `${where}.includes adds ${g}`);
    for (const g of list(ca.ignore)) if (!list(cb.ignore).includes(g)) out(path, `${where}.ignore adds ${g}`);
  }
  if (JSON.stringify(b.overrides ?? []) !== JSON.stringify(a.overrides ?? [])) {
    const before = new Set(list(b.overrides).map((o) => JSON.stringify(o)));
    for (const o of list(a.overrides)) if (!before.has(JSON.stringify(o))) out(path, `overrides adds or changes an entry for ${show(list(obj(o).includes ?? obj(o).include).join(" "))}`);
  }
}

// ---- tsconfig

const STRICT = [
  "strict", "noImplicitAny", "strictNullChecks", "strictFunctionTypes", "strictBindCallApply", "strictPropertyInitialization",
  "strictBuiltinIteratorReturn", "noImplicitThis", "useUnknownInCatchVariables", "alwaysStrict", "noUncheckedIndexedAccess",
  "exactOptionalPropertyTypes", "noImplicitReturns", "noFallthroughCasesInSwitch", "noImplicitOverride",
  "noPropertyAccessFromIndexSignature", "noUnusedLocals", "noUnusedParameters", "checkJs",
];

function tsconfig(path, b, a) {
  const cb = obj(b.compilerOptions), ca = obj(a.compilerOptions);
  for (const k of STRICT) if (cb[k] === true && ca[k] !== true) out(path, `compilerOptions.${k} true -> ${show(ca[k])}`);
  if (cb.skipLibCheck !== true && ca.skipLibCheck === true) out(path, `compilerOptions.skipLibCheck ${show(cb.skipLibCheck)} -> true`);
  if (!("ignoreDeprecations" in cb) && "ignoreDeprecations" in ca) out(path, `compilerOptions.ignoreDeprecations unset -> ${show(ca.ignoreDeprecations)}`);
  for (const x of list(a.exclude)) if (!list(b.exclude).includes(x)) out(path, `exclude adds ${show(x)}`);
  for (const x of list(b.include)) if (!list(a.include).includes(x)) out(path, `include no longer has ${show(x)}`);
  if (JSON.stringify(b.extends) !== JSON.stringify(a.extends)) out(path, `extends ${show(b.extends)} -> ${show(a.extends)}`);
}

// ---- package.json scripts

const CHECK_SCRIPT = /test|check|lint|type|e2e|ci|verify/i;
const LOOSE = [/--passWithNoTests\b/, /--pass-with-no-tests\b/, /\|\|\s*(true|exit 0|:)\b/, /--no-errors-on-unmatched\b/, /--testPathIgnorePatterns\b/, /--exclude\b/, /--ignore\b/, /--grep-invert\b/, /--skip\b/, /--diagnostic-level[= ](info|warn)\b/, /--max-warnings[= ]\d+/, /--bail[= ]0\b/, /--silent\b/];

function scripts(path, b, a) {
  const sb = obj(b.scripts), sa = obj(a.scripts);
  for (const [name, cmd] of Object.entries(sb)) {
    if (!CHECK_SCRIPT.test(name)) continue;
    if (!(name in sa)) { out(path, `scripts.${name} removed`); continue; }
    for (const re of LOOSE) {
      const m = re.exec(String(sa[name]));
      if (m && !re.test(String(cmd))) out(path, `scripts.${name} adds ${show(m[0].trim())}`);
    }
  }
}

const [base, ...paths] = process.argv.slice(2);
try {
for (const path of paths) {
  const name = path.split("/").pop();
  const kind = name === "biome.json" || name === "biome.jsonc" ? biome : /^tsconfig.*\.json$/.test(name) ? tsconfig : name === "package.json" ? scripts : undefined;
  if (!kind) continue;
  let before;
  try {
    before = parseJsonc(readFileSync(`${base}/${path}`, "utf8"));
  } catch {
    continue;
  }
  let after;
  try {
    after = parseJsonc(readFileSync(path, "utf8"));
  } catch (e) {
    out(path, `cannot be parsed (${String(e.message).split("\n")[0]})`);
    continue;
  }
  kind(path, obj(before), obj(after));
}
} catch (e) {
  // never report a crash as a loosened setting
  console.log(`skipped: the ratchet could not run (${String(e && e.message).split("\n")[0]})`);
  process.exit(3);
}
for (const f of findings) console.log(f);
process.exit(findings.length ? 1 : 0);
FORGE_SCRIPT_END
}

FORGE_FORBID='typescript/no-double-assertion|typescript/no-eval|typescript/no-explicit-any|typescript/no-focused-tests|typescript/no-non-null-assertion|typescript/no-stub|typescript/no-swallowed-catch|typescript/no-ts-ignore|typescript/no-ts-nocheck|typescript/ts-expect-error-reason'
FORGE_NO_INCREASE=''
FORGE_NO_DECREASE=''


# The change: changed, existing, deleted, base/, inbase and added in $FORGE_TMP.
forge_change_set || exit 1
if [ "$mode" = --all ]; then
  git ls-files --cached --others --exclude-standard 2>/dev/null | sort -u > "$FORGE_TMP/scope"
  : > "$FORGE_TMP/scope.tmp"
  while read -r f; do [ -f "$f" ] && printf '%s\n' "$f" >> "$FORGE_TMP/scope.tmp"; done < "$FORGE_TMP/scope"
  mv "$FORGE_TMP/scope.tmp" "$FORGE_TMP/scope"
else
  cp "$FORGE_TMP/existing" "$FORGE_TMP/scope"
fi

fail=0
report() { printf 'forge:%s %s\n' "$1" "$2"; fail=1; }

# 1. Integrity: owned files match .forge/manifest.sha256 ("<sha256>  <path>" lines,
# sha256sum format). JSON files are hashed with spaces, tabs and newlines removed,
# so a formatter run is not tampering; any other change is.
forge_owned_hash() {
  case $1 in
    *.json) tr -d ' \t\r\n' < "$1" | forge_sha256 ;;
    *) forge_sha256 < "$1" ;;
  esac
}
forge_integrity() {
  manifest=.forge/manifest.sha256
  [ -f "$manifest" ] || { report forge/integrity "$manifest is missing (run forge apply)"; return; }
  awk '/^[0-9a-f]+  ./ { h = $1; p = substr($0, length(h) + 3); print p "\t" h }' "$manifest" > "$FORGE_TMP/owned"
  while IFS='	' read -r path hash; do
    [ -n "$path" ] || continue
    case $path in .forge/*|.claude/*) ;; *) continue ;; esac
    if [ ! -f "$path" ]; then report forge/integrity "$path is missing (run forge apply)"
    elif [ "$(forge_owned_hash "$path")" != "$hash" ]; then report forge/integrity "$path was modified (run forge diff)"
    fi
  done < "$FORGE_TMP/owned"
  cut -f 1 "$FORGE_TMP/owned" > "$FORGE_TMP/owned-paths"
  { find .forge .claude/skills/forge-project -type f 2>/dev/null; find .claude/rules -name 'forge-*.md' -type f 2>/dev/null; } \
    | sed 's|^\./||' | while read -r path; do
      case $path in .forge/state/*|.forge/rules/*|.forge/forge.lock.json|.forge/manifest.sha256) continue ;; esac
      grep -qxF "$path" "$FORGE_TMP/owned-paths" || printf 'forge:forge/integrity %s is not a forge file (remove it or run forge apply)\n' "$path"
    done > "$FORGE_TMP/extra"
  if [ -s "$FORGE_TMP/extra" ]; then cat "$FORGE_TMP/extra"; fail=1; fi
}

# 2. Applied migrations (in the base) are never modified or deleted.
forge_applied_migrations() {
  while read -r f; do
    case $f in
      prisma/migrations/migration_lock.toml) ;;
      alembic/versions/*|prisma/migrations/*)
        report forge/applied-migration "$f exists at $(forge_base_name) and was modified or deleted; write a new migration instead" ;;
    esac
  done < "$FORGE_TMP/inbase"
}

# forge_base_name: what the change is compared with, for messages.
forge_base_name() {
  case $mode in
    --turn) printf 'the start of the turn' ;;
    --since) printf 'the merge base with %s' "$FORGE_ARG" ;;
    *) printf 'HEAD' ;;
  esac
}

# 3. Tests and counts: no deleted test files; ast-grep and grep counts compared with the base.
forge_tests_integrity() {
  while read -r f; do
    case $f in
      test_*.py|*/test_*.py|*_test.py|*/conftest.py|conftest.py|tests/*|*.test.*|*.spec.*|*/__tests__/*|e2e/*)
        report forge/deleted-test "$f was deleted" ;;
    esac
  done < "$FORGE_TMP/deleted"
  inc=$FORGE_NO_INCREASE
  [ -n "$FORGE_GREP_NO_INCREASE" ] && inc="${inc:+$inc|}$FORGE_GREP_NO_INCREASE"
  dec=$FORGE_NO_DECREASE
  [ -n "$FORGE_GREP_NO_DECREASE" ] && dec="${dec:+$dec|}$FORGE_GREP_NO_DECREASE"
  [ -n "$inc$dec" ] && [ -s "$FORGE_TMP/existing" ] || return
  grep -vxF -f "$FORGE_TMP/deleted" "$FORGE_TMP/inbase" > "$FORGE_TMP/athead"
  : > "$FORGE_TMP/now"; : > "$FORGE_TMP/then"
  ids=$FORGE_NO_INCREASE
  [ -n "$FORGE_NO_DECREASE" ] && ids="${ids:+$ids|}$FORGE_NO_DECREASE"
  if [ -n "$ids" ]; then
    if forge_counts "$FORGE_ROOT" "$ids" "$FORGE_TMP/existing" > "$FORGE_TMP/now" \
      && { [ ! -s "$FORGE_TMP/athead" ] || forge_counts "$FORGE_TMP/base" "$ids" "$FORGE_TMP/athead" > "$FORGE_TMP/then"; }; then :
    else
      printf 'forge:forge/ast-grep skipped: ast-grep unavailable\n'
      : > "$FORGE_TMP/now"; : > "$FORGE_TMP/then"
    fi
  fi
  forge_grep_counts "$FORGE_ROOT" "$FORGE_TMP/existing" >> "$FORGE_TMP/now"
  forge_grep_counts "$FORGE_TMP/base" "$FORGE_TMP/athead" >> "$FORGE_TMP/then"
  awk -F '\t' -v inc="$inc" -v dec="$dec" '
    BEGIN { n = split(inc, a, "|"); for (i = 1; i <= n; i++) if (a[i] != "") mi[a[i]] = 1
            n = split(dec, b, "|"); for (i = 1; i <= n; i++) if (b[i] != "") md[b[i]] = 1 }
    FILENAME == ARGV[1] { then[$1 "\t" $2] = $3; keys[$1 "\t" $2] = 1; next }
    { now[$1 "\t" $2] = $3; keys[$1 "\t" $2] = 1 }
    END {
      for (k in keys) {
        split(k, p, "\t"); t = then[k] + 0; w = now[k] + 0
        if ((p[1] in mi) && w > t) printf "forge:%s %s: %d -> %d\n", p[1], p[2], t, w
        if ((p[1] in md) && w < t) printf "forge:%s %s: %d -> %d\n", p[1], p[2], t, w
      }
    }' "$FORGE_TMP/then" "$FORGE_TMP/now" | sort > "$FORGE_TMP/countfail"
  if [ -s "$FORGE_TMP/countfail" ]; then cat "$FORGE_TMP/countfail"; fail=1; fi
}

# forge_counts <dir> <id-regex> <file-list>: "rule<TAB>file<TAB>count" lines.
forge_counts() {
  set -f
  # shellcheck disable=SC2046
  ( cd "$1" && astgrep scan -c "$FORGE_ROOT/.forge/ast-grep/sgconfig.yml" --filter "^($2)\$" --json=stream $(cat "$3") ) > "$FORGE_TMP/json"
  rc=$?
  set +f
  [ "$rc" -le 1 ] || return 1
  grep -oE '"(file|ruleId)":"[^"]*"' "$FORGE_TMP/json" \
    | awk -F '"' '$2 == "file" { f = $4 } $2 == "ruleId" { c[$4 "\t" f]++ } END { for (k in c) print k "\t" c[k] }'
}

# 4. Forbid rules (ast-grep and grep): outside --all, only matches on added lines.
forge_forbid() {
  [ -s "$FORGE_TMP/scope" ] || return
  forge_grep_forbid "$FORGE_TMP/scope" > "$FORGE_TMP/forbid.out"
  if [ -n "$FORGE_FORBID" ]; then
    set -f
    # shellcheck disable=SC2046
    astgrep scan -c .forge/ast-grep/sgconfig.yml --filter "^($FORGE_FORBID)\$" --json=stream $(cat "$FORGE_TMP/scope") > "$FORGE_TMP/forbid"
    rc=$?
    set +f
    if [ "$rc" -gt 1 ]; then printf 'forge:forge/ast-grep skipped: ast-grep unavailable\n'
    else forge_sg_report "$FORGE_TMP/forbid" >> "$FORGE_TMP/forbid.out"
    fi
  fi
  if [ -s "$FORGE_TMP/forbid.out" ]; then cat "$FORGE_TMP/forbid.out"; fail=1; fi
  return 0
}

forge_step() { [ "$fail" -eq 0 ] || exit 1; "$@"; }

forge_step forge_integrity
forge_step forge_applied_migrations
forge_step forge_tests_integrity
forge_step forge_forbid
forge_step forge_run_stage format
forge_step forge_run_stage lint
forge_step forge_run_stage typecheck
forge_step forge_run_stage migration
forge_step forge_run_stage test
exit "$fail"

===== .forge/forge.lock.json
