}

# 3. typescript/lockfile-updated
forge_check_meta_3() {
  c_id='typescript/lockfile-updated'; c_stage=lint; c_tools=''
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_dirs=''
}
forge_scope_3() {
  return 0
}
forge_when_3() { case $1 in package.json|*/package.json) return 0 ;; esac; return 1; }
forge_check_run_3() {
forge_lockfile_updated
}

# 4. typescript/no-ignore-deprecations
forge_check_meta_4() {
  c_id='typescript/no-ignore-deprecations'; c_stage=lint; c_tools=''
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_dirs=''
}
forge_scope_4() {
  case $1 in tsconfig*.json|*/tsconfig*.json) ;; *) return 1 ;; esac
  return 0
}
forge_when_4() { case $1 in tsconfig*.json|*/tsconfig*.json) return 0 ;; esac; return 1; }
forge_check_run_4() {
! grep -n '"ignoreDeprecations"' /dev/null $(git ls-files '*tsconfig*.json')
}

# 5. typescript/typecheck
forge_check_meta_5() {
  c_id='typescript/typecheck'; c_stage=typecheck; c_tools='tsc'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_dirs=''
}
forge_scope_5() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}
forge_when_5() { return 1; }
forge_check_run_5() {
