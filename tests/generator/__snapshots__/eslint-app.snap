===== .forge/ast-grep/rules/typescript/no-latch-before-optional-call.yml
# Generated by forge from typescript/no-latch-before-optional-call (mode: forbid).
id: typescript/no-latch-before-optional-call
language: Tsx
severity: error
message: "forge:typescript/no-latch-before-optional-call A once-flag is set before an optional call in its guard (if (!warned) { warned = true; logger?.warn(…) }): the flag is consumed even when the receiver is absent, so the call never happens once it is there. Check the receiver first (if (!warned && logger)), or use the project's existing warn-once helper."
rule:
  all:
    - kind: expression_statement
    - has:
        pattern: $F = true
        stopBy: neighbor
    - precedes:
        stopBy: end
        has:
          pattern: $X?.$M($$$)
          stopBy: end
    - any:
        - inside:
            kind: statement_block
            stopBy: neighbor
            inside:
              kind: if_statement
              stopBy: neighbor
              has:
                field: condition
                pattern: (!$F)
        - follows:
            stopBy: end
            all:
              - kind: if_statement
              - has:
                  field: condition
                  pattern: ($F)
              - has:
                  field: consequence
                  regex: ^(\{\s*)?return\b

