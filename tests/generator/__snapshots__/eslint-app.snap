id: typescript/no-secret-logging
valid:
  - |
    export function usage(maxTokens: number, hasToken: boolean): void {
      console.log(`budget ${maxTokens}, authenticated ${hasToken}`);
    }
  - |
    export function refresh(token: string): void {
      logger.info({ tokenLength: token.length }, "refreshing");
    }
  - |
    export function page(nextPageToken: string): void {
      logger.debug({ nextPageToken }, "next page");
    }
  - |
    export function reset(userId: string): never {
      console.info("password reset for", userId);
      throw new Error("password is too short");
    }
  - |
    export function store(passwordHash: string, cacheKey: string): void {
      logger.debug({ passwordHash, cacheKey }, "stored");
    }
invalid:
  - |
    export function refresh(token: string): void {
      console.log(`refreshing with token=${token}`);
    }
  - |
    export function call(apiKey: string): void {
      logger.info({ apiKey }, "calling the API");
    }
  - |
    export function check(req: Request): void {
      log.warn("header " + req.headers.get("x") + req.headers.authorization);
    }
  - |
    export function connect(accessToken: string): never {
      throw new Error(`login failed with ${accessToken}`);
    }
  - |
    console.log(process.env.STRIPE_SECRET_KEY);

===== .forge/ast-grep/rule-tests/typescript-no-ssrf-test.yml
id: typescript/no-ssrf
valid:
  - |
    export async function GET(req: NextRequest) {
      const q = req.nextUrl.searchParams.get("q");
      const a = await fetch(`https://api.example.com/search?q=${q}`);
      const b = await fetch(`${process.env.SEARCH_URL}/search?q=${q}`);
      return Response.json({ a: await a.json(), b: await b.json() });
    }
  - |
    const ALLOWED_HOSTS = new Set(["images.example.com"]);

    export async function POST(request: Request) {
      const { url } = await request.json();
      if (!ALLOWED_HOSTS.has(new URL(url).host)) return new Response(null, { status: 400 });
      return new Response((await fetch(url)).body);
    }
  - |
    export async function getStatus(url: string) {
      const res = await fetch(url);
      return res.status;
    }
invalid:
  - |
    export async function GET(req: NextRequest) {
      const url = req.nextUrl.searchParams.get("url");
      const res = await fetch(url!);
      return new Response(res.body);
    }
  - |
    export async function POST(request: Request) {
      const { callbackUrl } = await request.json();
      await fetch(callbackUrl, { method: "POST" });
      return Response.json({ ok: true });
    }
  - |
    "use server";

    export async function importFeed(feedUrl: string) {
      const res = await fetch(feedUrl);
      return res.text();
    }
  - |
    app.get("/proxy", async (req, res) => {
      const upstream = await axios.get(req.query.url as string);
      res.send(upstream.data);
    });

