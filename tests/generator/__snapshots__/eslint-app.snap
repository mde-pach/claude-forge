          regex: (?i)(^|_)(token|secret|password|passwd|pwd|api_?key|apikey|secret_?key|private_?key|access_?key|authorization|credentials?)$|(Token|Secret|Password|ApiKey|SecretKey|PrivateKey|AccessKey|Authorization|Credentials?)$
