    export function load(): Config {
      try {
        return read();
      } catch (e) {
        throw new ConfigError("cannot read config", { cause: e });
      }
    }
  - |
    export function load(): Config | null {
      try {
        return read();
      } catch (error) {
        logger.error({ error }, "config unreadable");
        return null;
      }
    }
  - |
    export async function sync() {
      await push().catch((e) => report(e));
    }
invalid:
