===== .forge/ast-grep/rules/typescript/no-secret-logging.yml
# Generated by forge from typescript/no-secret-logging (mode: forbid).
id: typescript/no-secret-logging
language: Tsx
severity: error
message: "forge:typescript/no-secret-logging No secret in a log line or thrown error: a variable, property or header named like a token, secret, password, API key, private or access key, authorization or credentials, passed to console.*, a logger's methods or a thrown error (directly, in a template literal, with +, or as an object property) is rejected. Log an id or a masked value instead; a name such as maxTokens, hasToken, passwordHash or nextPageToken is not a secret."
ignores:
  - "**/*.test.*"
  - "**/*.spec.*"
  - "**/__tests__/**"
  - e2e/**
  - scripts/**
rule:
  matches: secret-name
  any:
    - inside:
        kind: arguments
        stopBy: neighbor
        inside:
          matches: sink
          stopBy: neighbor
    - inside:
        kind: template_substitution
        stopBy: neighbor
        inside:
          kind: template_string
          stopBy: neighbor
          inside:
            kind: arguments
            stopBy: neighbor
            inside:
              matches: sink
