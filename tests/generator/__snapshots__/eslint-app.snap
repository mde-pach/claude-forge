===== .claude/skills/forge-project/scripts/bash-snapshot.sh
#!/bin/sh
# Generated by forge. PreToolUse(Bash): snapshots the working tree as a git tree
# (.forge/state/bash/<tool_use_id>.tree) so that post-edit.sh and typecheck.sh can
# check the files the command changes. The user's index and object store are not
# touched. Prints nothing; never blocks the command.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
[ -d .forge ] || exit 0
key=$(bash_key) || exit 0
mkdir -p "$(bash_state)" 2>/dev/null || exit 0
bash_cleanup
if tree=$(tree_snapshot "${FORGE_SNAPSHOT_TIMEOUT:-5}"); then
  printf '%s\n' "$tree" > "$(bash_state)/$key.tree"
else
  # too large or too slow: the Stop check still covers the change
  printf 'skipped\n' > "$(bash_state)/$key.tree"
fi
exit 0

