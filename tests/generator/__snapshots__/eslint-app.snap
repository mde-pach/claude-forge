===== .forge/ast-grep/rule-tests/typescript-no-latch-before-optional-call-test.yml
id: typescript/no-latch-before-optional-call
valid:
  - |
    let hasWarnedSubSecond = false;

    export function clamp(ms: number, logger?: Logger): number {
      if (!hasWarnedSubSecond && logger) {
        hasWarnedSubSecond = true;
        logger.warn({ ms }, "durations under 1s round up to 1s");
      }
      return Math.max(ms, 1000);
    }
  - |
    let hasWarnedSubSecond = false;

    export function clamp(ms: number, logger?: Logger): number {
      if (!hasWarnedSubSecond) {
        hasWarnedSubSecond = true;
        console.warn("durations under 1s round up to 1s");
      }
      return Math.max(ms, 1000);
    }
  - |
    export function clamp(ms: number, logger?: Logger): number {
      if (logger) {
        warnOnce(logger, "sub-second", { ms }, "durations under 1s round up to 1s");
      }
      return Math.max(ms, 1000);
    }
  - |
    let started = false;

    export function start(onStart?: () => void): void {
      if (started) return;
      started = true;
      run();
    }
invalid:
  - |
    let hasWarnedSubSecond = false;

    export function clamp(ms: number, logger?: Logger): number {
      if (ms > 0 && ms < 1000) {
        if (!hasWarnedSubSecond) {
          hasWarnedSubSecond = true;
          logger?.warn({ ms }, "durations under 1s round up to 1s");
        }
        return 1000;
      }
      return ms;
    }
  - |
    export class Client {
      private warned = false;

      constructor(private readonly logger?: Logger) {}

      deprecated(): void {
        if (this.warned) return;
        this.warned = true;
        this.logger?.warn("deprecated() will be removed in v5");
      }
    }

