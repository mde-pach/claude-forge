}
forge_scope_3() {
  return 0
}
forge_when_3() { case $1 in package.json|*/package.json) return 0 ;; esac; return 1; }
forge_check_run_3() {
forge_lockfile_updated
}

# 4. typescript/no-ignore-deprecations
forge_check_meta_4() {
  c_id='typescript/no-ignore-deprecations'; c_stage=lint; c_tools=''
