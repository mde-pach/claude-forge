  case $1 in packages/core/*.ts|packages/core/*/*.ts|packages/core/*.tsx|packages/core/*/*.tsx|packages/core/*.mts|packages/core/*/*.mts|packages/core/*.cts|packages/core/*/*.cts|packages/core/*.js|packages/core/*/*.js|packages/core/*.jsx|packages/core/*/*.jsx|packages/core/*.mjs|packages/core/*/*.mjs|packages/core/*.cjs|packages/core/*/*.cjs|packages/core/*.vue|packages/core/*/*.vue|packages/core/*.svelte|packages/core/*/*.svelte|packages/core/*.astro|packages/core/*/*.astro|packages/core/*.html|packages/core/*/*.html) ;; *) return 1 ;; esac
  return 0
}
