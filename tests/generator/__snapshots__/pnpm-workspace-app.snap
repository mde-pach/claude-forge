===== .forge/ast-grep/rule-tests/typescript-cors-credentials-wildcard-test.yml
id: typescript/cors-credentials-wildcard
valid: []
invalid:
  - |
    import { Hono } from "hono";
    import { cors } from "hono/cors";

    const app = new Hono();
    app.use("/api/*", cors({ origin: "*", credentials: true }));
  - |
    import cors from "cors";

    export const middleware = cors({ origin: true, credentials: true });
  - |
    import { cors as allow } from "hono/cors";

    export const middleware = allow({ origin: (origin) => origin ?? "", credentials: true });
  - |
    import Fastify from "fastify";
    import fastifyCors from "@fastify/cors";

    const app = Fastify();
    app.register(fastifyCors, { origin: (o, cb) => cb(null, true), credentials: true, ...{} });
    app.register(fastifyCors, { origin: true, credentials: true });
  - |
    import type { INestApplication } from "@nestjs/common";

    export function setup(app: INestApplication) {
      app.enableCors({ origin: true, credentials: true });
    }
  - |
    import { NestFactory } from "@nestjs/core";

    class AppModule {}

    export const app = NestFactory.create(AppModule, { cors: { origin: true, credentials: true } });

