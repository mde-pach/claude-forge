}
forge_check_fmt_13() {
  for _ff_d in 'packages/core'; do
    case $FORGE_FILE in "$_ff_d"/*)
      ( FORGE_WS_ROOT=$(pwd); cd "$_ff_d" || exit 1; FORGE_FILE=${FORGE_FILE#"$_ff_d"/}
biome format --stdin-file-path="$FORGE_FILE"
      )
      return ;;
    esac
  done
biome format --stdin-file-path="$FORGE_FILE"
}

