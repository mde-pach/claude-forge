    export function load(): Config | null {
      try {
        return read();
      } catch (e) {
        return null;
      }
    }
  - |
    export function load(): Config | null {
      try {
        return read();
      } catch {
        return null;
      }
    }
  - |
    export async function sync() {
      await push().catch(() => {});
    }

