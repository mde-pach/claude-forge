===== .claude/skills/forge-project/scripts/guard.sh
#!/bin/sh
# Generated by forge. PreToolUse(Bash) tripwire: matches guard.rules patterns
# (POSIX ERE) against the JSON-escaped command. First deny wins, else first ask.
# A rule with a check (column 5) is a candidate only: its pattern pre-filters, and
# the named guard_check_* function below decides on the parsed command.
# The sandbox and permissions are the protection boundary; this is a tripwire.
# An ask nobody can answer (an autonomous run) goes to review.sh instead.
dir=$(dirname "$0")
input=$(cat)

# guard_check_ephemeral_exec: succeeds, printing why, when the command runs a package
# launcher (npx, bunx, bun x, npm exec, pnpm dlx, pnpx, yarn dlx, uvx, uv tool run,
# pipx run, deno run npm:/jsr:/URL, and the create / init forms that run an
# initializer package) on something it would fetch from a registry: always for
# pnpm/yarn dlx and create, and pipx run; for the others, a package option
# (--package, --from, --with, ...), a version or URL spec, or a command not installed
# where it runs (node_modules/.bin or .venv/bin, from that directory up to the
# repository root). Only options before the command name belong to the launcher (npx
# tsc -p tsconfig.json is tsc's -p); a package manager's options before its
# subcommand (npm --yes exec) and a wrapper's options with their arguments (nice -n
# 5, sudo -u bob, timeout -s KILL 5) are skipped. Compound commands are split on ;,
# &&, ||, |, &, newlines and subshells; cd is followed; heredoc bodies and quoted
# text are not commands; sh -c '...', eval, env -S and find -exec are parsed; a
# command name expanded at run time ($N) is flagged, since it cannot be followed.
guard_check_ephemeral_exec() {
  _ge_found=$(printf '%s' "$input" | awk -v home="${HOME:-}" '
    function jstr(buf, key,   s, n, i, c, d, out, h, v, k) {
      if (!match(buf, "\"" key "\"[[:space:]]*:[[:space:]]*\"")) return ""
      s = substr(buf, RSTART + RLENGTH); n = length(s); out = ""
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\"") break
        if (c != "\\") { out = out c; continue }
        i++; d = substr(s, i, 1)
        if (d == "n") out = out "\n"
        else if (d == "t") out = out "\t"
        else if (d == "r") out = out ""
        else if (d == "u") {
          h = tolower(substr(s, i + 1, 4)); v = 0
          for (k = 1; k <= 4; k++) v = v * 16 + index("0123456789abcdef", substr(h, k, 1)) - 1
          out = out ((v > 0 && v < 128) ? sprintf("%c", v) : "?"); i += 4
        } else out = out d
      }
      return out
    }
    function norm(p,   n, a, i, m, st, out) {
      n = split(p, a, "/"); m = 0
      for (i = 1; i <= n; i++) {
        if (a[i] == "" || a[i] == ".") continue
        if (a[i] == "..") { if (m) m--; continue }
        st[++m] = a[i]
      }
      out = ""
      for (i = 1; i <= m; i++) out = out "/" st[i]
      return out == "" ? "/" : out
    }
    function chdir(t) { return chdirb(D, t) }
    function chdirb(base, t) {
      if (base == "?") return "?"
      if (t == "" || t == "~") return home == "" ? "?" : home
      if (t == "-" || t ~ /[$`*?]/) return "?"
      if (t ~ /^~\//) { if (home == "") return "?"; t = home substr(t, 2) }
      if (t !~ /^\//) t = base "/" t
      return norm(t)
    }
    function endword() {
      if (inw) { if (skipnext) skipnext = 0; else W[++nw] = w }
      w = ""; inw = 0
    }
    function endseg() { endword(); if (nw) seg(); nw = 0; skipnext = 0 }
    # parse <s>: splits a command line into simple commands, each handled by seg()
    function parse(s,   n, i, c, nx, hds, k, ent, st, dl, rest, line, q) {
      n = length(s); q = ""; hds = ""
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1); nx = substr(s, i + 1, 1)
        if (q == "\047") { if (c == "\047") q = ""; else w = w c; continue }
        if (q == "\"") {
          if (c == "\\" && nx ~ /[$`"\\]/) { w = w nx; i++; continue }
          if (c == "\"") q = ""; else w = w c
          continue
        }
        if (c == "\\") { if (nx != "\n") { w = w nx; inw = 1 }; i++; continue }
        if (c == "\047" || c == "\"") { q = c; inw = 1; continue }
        if (c == " " || c == "\t") { endword(); continue }
        if (c == "#" && !inw) { k = index(substr(s, i), "\n"); if (!k) break; i += k - 2; continue }
        if (c == "\n") {
          endseg()
          while (hds != "") {
            k = index(hds, "\n"); ent = substr(hds, 1, k - 1); hds = substr(hds, k + 1)
            st = substr(ent, 1, 1); dl = substr(ent, 2)
            while (i < n) {
              rest = substr(s, i + 1); k = index(rest, "\n")
              line = k ? substr(rest, 1, k - 1) : rest
              i += k ? k : length(rest)
              if (st == "1") sub(/^\t+/, "", line)
              if (line == dl) break
            }
          }
          continue
        }
        if (c == "&" && nx == ">") { endword(); i++; if (substr(s, i + 1, 1) == ">") i++; skipnext = 1; continue }
        if (c ~ /[;&|()`]/) { endseg(); if ((c == "&" || c == "|") && nx == c) i++; continue }
        if (c == "$" && nx == "(") { endseg(); i++; continue }
        if (c == "<" || c == ">") {
          if (inw && w ~ /^[0-9]+$/) { w = ""; inw = 0 } else endword()
          if (c == "<" && nx == "(") { endseg(); i++; continue }
          if (c == "<" && nx == "<") {
            if (substr(s, i + 2, 1) == "<") { i += 2; skipnext = 1; continue }
            i += 2; st = 0
            if (substr(s, i, 1) == "-") { st = 1; i++ }
            while (substr(s, i, 1) ~ /[ \t]/) i++
            dl = ""
            for (; i <= n; i++) {
              c = substr(s, i, 1)
              if (c ~ /[ \t\n;&|<>()]/) break
              if (c != "\047" && c != "\"" && c != "\\") dl = dl c
            }
            i--
            if (dl != "") hds = hds st dl "\n"
            continue
          }
          if (nx == ">" || nx == "|") { i++; nx = substr(s, i + 1, 1) }
          if (nx == "&") { i++; while (substr(s, i + 1, 1) ~ /[0-9-]/) i++; continue }
          skipnext = 1
          continue
        }
        w = w c; inw = 1
      }
      endseg()
    }
    # words <from> <to>: W[from..to] joined with spaces (what eval runs)
    function words(a, b,   out) {
      out = ""
      for (; a <= b; a++) out = out (out == "" ? "" : " ") W[a]
      return out
    }
    # wrapopt <wrapper> <option>: 1 when the wrapper option takes the next word as
    # its argument, 2 when that argument is a directory the command then runs in
    function wrapopt(b, o) {
      if (b == "sudo") return o ~ /^(-D|--chdir)$/ ? 2 : o ~ /^(-[ugpCrtUhRT]|--(user|group|prompt|close-from|role|type|other-user|host|command-timeout))$/
      if (b == "doas") return o ~ /^-[uC]$/
      if (b == "env") return o ~ /^(-C|--chdir)$/ ? 2 : o ~ /^(-u|--unset|-P)$/
      if (b == "nice") return o ~ /^(-n|--adjustment)$/
      if (b == "ionice") return o ~ /^-[cnp]$/
      if (b == "timeout") return o ~ /^(-s|--signal|-k|--kill-after)$/
      if (b == "time") return o ~ /^(-f|--format|-o|--output)$/
      if (b == "exec") return o == "-a"
      if (b == "xargs") return o ~ /^(-[IiLnPsdEeaJR]|--(arg-file|max-args|max-procs|max-chars|delimiter|eof|replace|max-lines))$/
      if (b == "stdbuf") return o ~ /^-[ioe]$/
      return 0
    }
    # pmopt <manager> <option>: as wrapopt, for a package manager option before its subcommand
    function pmopt(b, o) {
      if (b == "npm") return o == "--prefix" ? 2 : o ~ /^(-w|--workspace|--registry|--cache|--userconfig|--globalconfig|--loglevel)$/
      if (b == "pnpm") return o ~ /^(-C|--dir)$/ ? 2 : o ~ /^(-F|--filter|--reporter|--loglevel|--workspace-concurrency)$/
      if (b == "yarn") return o == "--cwd" ? 2 : 0
      if (b == "bun") return o == "--cwd" ? 2 : o ~ /^(-c|--config|--env-file|-r|--preload)$/
      return 0
    }
    # seg: one simple command, in W[1..nw]; LD is the directory it runs in
    function seg(   k, x, b, j, o, t, sub_s, saved) {
      k = 1; LD = D
      while (k <= nw) {
        x = W[k]
        if (x ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { k++; continue }
        b = x; sub(/.*\//, "", b)
        if (b !~ /^(sudo|doas|env|time|nohup|nice|ionice|exec|command|builtin|xargs|stdbuf|timeout)$/) break
        for (k++; k <= nw && W[k] ~ /^-./; k++) {
          o = W[k]
          if (o == "--") { k++; break }
          # env -S "<command>" splits its argument into a command
          if (b == "env" && (o == "-S" || o == "--split-string")) { sub_s = words(k + 1, nw); nw = 0; parse(sub_s); return }
          if (b == "env" && o ~ /^(-S.|--split-string=)/) { sub(/^(-S|--split-string=)/, "", o); sub_s = o " " words(k + 1, nw); nw = 0; parse(sub_s); return }
          t = wrapopt(b, o)
          if (t == 2) LD = chdirb(LD, W[k + 1])
          else if ((b == "sudo" && o ~ /^(-D.|--chdir=)/) || (b == "env" && o ~ /^(-C.|--chdir=)/)) { sub(/^(-D|-C|--chdir=)/, "", o); LD = chdirb(LD, o) }
          if (t) k++
        }
        if (b == "timeout") k++
      }
      if (k > nw) return
      b = W[k]
      # a command name expanded when the command runs (N=npx; $N cowsay) cannot be followed
      if (b ~ /[$`]/) { print "remote\tthe command name " b " is expanded when the command runs, so Forge cannot check what it runs"; return }
      sub(/.*\//, "", b)
      if (b == "cd" || b == "pushd") { D = chdir(k < nw ? W[k + 1] : ""); return }
      if (b == "eval") { sub_s = words(k + 1, nw); nw = 0; parse(sub_s); return }
      if (b ~ /^(sh|bash|zsh|dash|ksh)$/) {
        for (j = k + 1; j < nw; j++)
          if (W[j] ~ /^-[a-z]*c[a-z]*$/) { sub_s = W[j + 1]; saved = D; nw = 0; parse(sub_s); D = saved; return }
        return
      }
      if (b == "find") {
        # each -exec / -execdir / -ok / -okdir runs a command, up to ; or +
        sub_s = ""
        for (j = k + 1; j <= nw; j++) {
          if (W[j] !~ /^-(exec|execdir|ok|okdir)$/) continue
          for (o = j + 1; o <= nw && W[o] != ";" && W[o] != "+"; o++) ;
          sub_s = sub_s words(j + 1, o - 1) "\n"; j = o
        }
        saved = D; nw = 0; parse(sub_s); D = saved
        return
      }
      if (b == "npx" || b == "bunx") { launcher(k + 1, b, "node"); return }
      if (b == "pnpx") { launcher(k + 1, b, "dlx"); return }
      if (b == "uvx") { launcher(k + 1, b, "uv"); return }
      if (b == "uv" && W[k + 1] == "tool" && W[k + 2] == "run") { launcher(k + 3, "uv tool run", "uv"); return }
      if (b == "pipx" && W[k + 1] == "run") { launcher(k + 2, "pipx run", "dlx"); return }
      if (b == "deno") { deno(k + 1); return }
      if (b !~ /^(npm|pnpm|yarn|bun)$/) return
      # options of the package manager itself come before its subcommand (npm --yes exec, bun --bun x)
      for (j = k + 1; j <= nw && W[j] ~ /^-./; j++) {
        t = pmopt(b, W[j])
        if (t == 2) LD = chdirb(LD, W[j + 1])
        else if (W[j] ~ /^--(prefix|dir|cwd)=/) { o = W[j]; sub(/^[^=]*=/, "", o); LD = chdirb(LD, o) }
        if (t) j++
      }
      x = W[j]
      if (b == "npm" && (x == "exec" || x == "x")) launcher(j + 1, "npm exec", "npm")
      else if (b == "bun" && x == "x") launcher(j + 1, "bun x", "node")
      else if ((b == "pnpm" || b == "yarn") && x == "dlx") launcher(j + 1, b " dlx", "dlx")
      # create / init forms run the initializer package create-<name>: npm and bun
      # through their exec launcher (installed copy first), pnpm and yarn through dlx
      else if (x == "create" || (b == "npm" && (x == "init" || x == "innit"))) initializer(j + 1, b " " x, b)
    }
    # initializer <j> <name> <manager>: <manager> create|init <initializer> (npm init
    # without one only writes package.json)
    function initializer(j, name, pm,   o, x, v) {
      for (; j <= nw; j++) {
        o = W[j]
        if (o == "--") { j++; break }
        if (o !~ /^-./) break
        if (o ~ /^(-w|--workspace|--scope|--init-module)$/) j++
      }
      if (j > nw) return
      x = W[j]
      if (pm == "bun" && x ~ /^[.\/~]/) return
      if (pm == "bun" && x ~ /^[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+$/) { print "remote\t" name " " x " fetches the template from GitHub and runs it"; return }
      v = ""
      if (match(x, /.@/)) { v = substr(x, RSTART + 1); x = substr(x, 1, RSTART) }
      if (x ~ /^@[^\/]+$/) x = x "/create"
      else if (x ~ /^@[^\/]+\//) { o = x; sub(/\/.*/, "", o); sub(/^@[^\/]+\//, "", x); x = o "/create-" x }
      else x = "create-" x
      if (pm == "pnpm" || pm == "yarn") { print "remote\t" name " fetches " x " from a registry and runs it"; return }
      classify(x v, name, "node")
    }
    # deno <j>: deno run|x|serve with an npm:, jsr: or URL module fetches it
    function deno(j,   o) {
      if (W[j] != "run" && W[j] != "x" && W[j] != "serve") return
      for (j++; j <= nw; j++) {
        o = W[j]
        if (o == "--") { j++; break }
        if (o !~ /^-./) break
        if (o ~ /^(-c|--config|--import-map|--lock|--cert|--location|--seed|--ext|--env-file|--inspect|--watch)$/ && W[j + 1] !~ /^-/) j++
      }
      if (j <= nw && W[j] ~ /^(npm:|jsr:|https?:)/) print "remote\tdeno " W[j] " fetches the module from a registry and runs it"
    }
    # launcher: the options before the command name belong to the launcher (npm exec
    # also parses its own options after the name, up to --, unless -- comes first)
    function launcher(j, name, kind,   o, pkg, dd, cmd) {
      pkg = ""; dd = 0
      for (; j <= nw; j++) {
        o = W[j]
        if (o == "--") { dd = 1; j++; break }
        if (o !~ /^-/ || o == "-") break
        if (kind == "uv") {
          if (o ~ /^(--from|--with|--with-editable|--with-requirements|-w|--index|--index-url|--default-index|--extra-index-url|-i|-f|--find-links)$/) { pkg = o; j++ }
          else if (o ~ /^(--from|--with|--with-editable|--with-requirements|--index|--index-url|--default-index|--extra-index-url|--find-links)=/) pkg = o
          else if (o ~ /^(-p|--python|-C|--config-setting|--directory|--project|--cache-dir|--config-file|--color|--resolution|--prerelease|--exclude-newer|--index-strategy|--keyring-provider|--link-mode|--constraints|-c|--overrides|--build-constraints|--env-file|--python-preference)$/) j++
        } else {
          if (o ~ /^(-p|--package|-c|--call)$/) { pkg = o; j++ }
          else if (o ~ /^(--package|--call)=/) pkg = o
          else if (o ~ /^(-w|--workspace|--prefix|--registry|--cache|--userconfig|--allow-scripts|--loglevel)$/) j++
        }
      }
      cmd = j <= nw ? W[j] : ""
      if (kind == "npm" && !dd)
        for (o = j + 1; o <= nw && W[o] != "--"; o++) if (W[o] ~ /^(-p|--package|-c|--call)(=|$)/) pkg = W[o]
      if (kind == "dlx") { print "remote\t" name " fetches " (cmd == "" ? "a package" : cmd) " from a registry and runs it"; return }
      if (pkg != "") { sub(/=.*/, "", pkg); print "remote\t" name " " pkg " fetches a package from a registry and runs it"; return }
      if (cmd == "") return
      classify(cmd, name, kind)
    }
    # classify <spec> <launcher> <kind>: a bare name is looked up where the command
    # runs (LD); a version, URL or repository spec is fetched
    function classify(cmd, name, kind) {
      if (kind == "uv") {
        if (cmd ~ /^[A-Za-z0-9._-]+$/) print "py\t" LD "\t" cmd "\t" name
        else print "remote\t" name " " cmd " names a version or source that is fetched from a registry"
        return
      }
      if (cmd ~ /^[.\/~]/) return
      if (cmd ~ /^@[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+$/ || cmd ~ /^[A-Za-z0-9._-]+$/) print "node\t" LD "\t" cmd "\t" name
      else print "remote\t" name " " cmd " names a version, URL or repository that is fetched from a registry"
    }
    { buf = buf $0 "\n" }
    END {
      D = jstr(buf, "cwd"); D = D ~ /^\// ? norm(D) : "?"
      parse(jstr(buf, "command"))
    }')
  while IFS='	' read -r _ge_kind _ge_a _ge_b _ge_c; do
    case $_ge_kind in
      remote) printf '%s' "$_ge_a"; return 0 ;;
      node|py)
        if [ "$_ge_a" = '?' ]; then
          printf '%s %s runs in a directory Forge cannot follow, so it cannot check that %s is installed there' "$_ge_c" "$_ge_b" "$_ge_b"
          return 0
        fi
        guard_installed "$_ge_kind" "$_ge_a" "$_ge_b" && continue
        if [ "$_ge_kind" = node ]; then _ge_w=node_modules/.bin; else _ge_w=.venv/bin; fi
        printf '%s is not installed where the command runs: no %s/%s from %s up to the repository root, so %s would fetch it from a registry and run it' "$_ge_b" "$_ge_w" "$_ge_b" "$_ge_a" "$_ge_c"
        return 0 ;;
    esac
  done <<EOF
$_ge_found
EOF
  return 1
}

# guard_installed <node|py> <dir> <name>: <name> is installed in <dir> or a parent,
# up to the repository root (a directory holding .git).
guard_installed() {
  _gi_d=$2
  while :; do
    if [ "$1" = node ]; then
      { [ -e "$_gi_d/node_modules/.bin/$3" ] || [ -f "$_gi_d/node_modules/$3/package.json" ]; } && return 0
    else
      [ -x "$_gi_d/.venv/bin/$3" ] && return 0
    fi
    { [ -e "$_gi_d/.git" ] || [ "$_gi_d" = / ] || [ -z "$_gi_d" ]; } && return 1
    _gi_d=$(dirname "$_gi_d")
  done
}

# the matching rules in guard.rules order (denies first), "decision<TAB>id<TAB>check<TAB>review<TAB>description",
# up to the first one without a check: nothing after it can win
hits=$(printf '%s' "$input" | awk -F '\t' -v rules="$dir/guard.rules" '
  { buf = buf $0 " " }
  END {
    if (!match(buf, /"command"[[:space:]]*:[[:space:]]*"/)) exit 0
    s = substr(buf, RSTART + RLENGTH); n = length(s); cmd = ""
    for (i = 1; i <= n; i++) {
      c = substr(s, i, 1)
      if (c == "\"") break
      if (c == "\\") { cmd = cmd c substr(s, i + 1, 1); i++; continue }
      cmd = cmd c
    }
    while ((getline line < rules) > 0) {
      if (line ~ /^#/ || line == "") continue
      split(line, f, "\t")
      if ((f[2] != "deny" && f[2] != "ask") || cmd !~ f[3]) continue
      d = f[4]; gsub(/\\/, "\\\\", d); gsub(/"/, "\\\"", d)
      printf "%s\t%s\t%s\t%s\t%s\n", f[2], f[1], (f[5] == "" ? "-" : f[5]), (f[6] == "" ? "-" : f[6]), d
      if (f[5] == "") exit 0
    }
  }
') || exit 1
[ -n "$hits" ] || exit 0
out=''
while IFS='	' read -r decision id check question desc; do
  finding=''
  if [ "$check" != - ]; then
    finding=$(guard_check_"$(printf '%s' "$check" | tr '-' '_')") || continue
    finding=$(printf '%s' "$finding" | tr -d '\n\r\t')
  fi
  detail=$(printf '%s' "$finding" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  out=$(printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s","permissionDecisionReason":"forge:%s %s%s"}}' "$decision" "$id" "$desc" "${detail:+ Here: $detail.}")
  break
done <<EOF
$hits
EOF
case $out in
  *'"permissionDecision":"ask"'*)
    if [ -z "${FORGE_REVIEWER:-}" ] && [ "${FORGE_ASK_REVIEW:-auto}" != never ] && [ -f "$dir/review.sh" ]; then
      # the reviewer answers this rule's concern only: its description (JSON-escaped in
      # guard.rules), the check's finding, and its review question
      concern=$(printf '%s' "$desc" | sed -e 's/\\"/"/g' -e 's/\\\\/\\/g')${finding:+ Here: $finding.}
      [ "$question" = - ] && question=''
      reviewed=$(printf '%s' "$input" | sh "$dir/review.sh" pre "$id" "$concern" "$question")
      [ -n "$reviewed" ] && out=$reviewed
    fi ;;
esac
[ -z "$out" ] || printf '%s\n' "$out"

===== .claude/skills/forge-project/scripts/lib.sh
# Generated by forge. Shared helpers for hook scripts. POSIX sh only.
FORGE_AST_GREP_VERSION="0.45.3"

# json_get <key> [raw]: string value of a top-level or tool_input key from the
# JSON in $FORGE_INPUT. With "raw", the value stays JSON-escaped.
json_get() {
  printf '%s' "$FORGE_INPUT" | awk -v key="$1" -v raw="$2" '
    { buf = buf $0 "\n" }
    END {
      if (!match(buf, "\"" key "\"[[:space:]]*:[[:space:]]*\"")) exit
      s = substr(buf, RSTART + RLENGTH); out = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\"") break
        if (c == "\\") {
          i++; d = substr(s, i, 1)
          if (raw != "") { out = out c d; continue }
          if (d == "n") out = out "\n"
          else if (d == "t") out = out "\t"
          else if (d == "r") out = out ""
          else if (d == "u") {
            # \uXXXX: ASCII decoded, anything else kept escaped (UTF-8 arrives unescaped)
            h = tolower(substr(s, i + 1, 4)); v = 0
            for (k = 1; k <= 4; k++) v = v * 16 + index("0123456789abcdef", substr(h, k, 1)) - 1
            if (v > 0 && v < 128) out = out sprintf("%c", v); else out = out "\\u" h
            i += 4
          }
          else out = out d
        } else out = out c
      }
      printf "%s", out
    }'
}

# json_escape: stdin -> JSON string body (no surrounding quotes). Carriage returns
# are dropped; every other control character is escaped (\t, \n, \u00XX): one
# left raw makes the whole JSON invalid.
json_escape() {
  awk 'BEGIN {
    ORS = ""
    for (c = 1; c < 32; c++) if (c != 9 && c != 10 && c != 13) { ch = sprintf("%c", c); ctl[ch] = sprintf("\\u%04x", c); re = re ch }
    re = "[" re "]"
  }
  {
    gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "")
    if ($0 ~ re) {
      s = ""; n = length($0)
      for (i = 1; i <= n; i++) { ch = substr($0, i, 1); s = s ((ch in ctl) ? ctl[ch] : ch) }
      $0 = s
    }
    if (NR > 1) printf "\\n"
    printf "%s", $0
  }'
}

# tool <name>: prints the command that runs the project's own <name>, or nothing if absent.
tool() {
  if [ -f bun.lock ] || [ -f bun.lockb ]; then
    if [ -x "node_modules/.bin/$1" ] && command -v bun >/dev/null 2>&1; then
      printf 'bun run --bun %s' "$1"
    fi
  elif [ -f uv.lock ]; then
    if [ -x ".venv/bin/$1" ]; then printf '.venv/bin/%s' "$1"; fi
  elif [ -x "node_modules/.bin/$1" ]; then
    printf 'node_modules/.bin/%s' "$1"
  elif [ -x ".venv/bin/$1" ]; then
    printf '.venv/bin/%s' "$1"
  elif [ -n "${FORGE_WS_ROOT:-}" ] && [ "$FORGE_WS_ROOT" != "$(pwd)" ]; then
    # in a workspace package: the root's install (hoisted by bun, npm and Yarn; uv's .venv)
    _tw=$(cd "$FORGE_WS_ROOT" && FORGE_WS_ROOT='' tool "$1")
    case $_tw in ''|bun\ *) printf '%s' "$_tw" ;; *) printf '%s/%s' "$FORGE_WS_ROOT" "$_tw" ;; esac
  fi
}

# astgrep <args>: pinned ast-grep through bunx (bun repos) or uvx.
# Exit status: 0 no finding, 1 findings, other = could not run.
astgrep() {
  if { [ -f bun.lock ] || [ -f bun.lockb ]; } && command -v bunx >/dev/null 2>&1; then
    astgrep_bunx "$@"
  elif command -v uvx >/dev/null 2>&1; then
    uvx -q --from "ast-grep-cli==$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
    _rc=$?
    if [ "$_rc" -gt 1 ]; then
      uvx -q --offline --from "ast-grep-cli==$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
      _rc=$?
    fi
    return "$_rc"
  elif command -v bunx >/dev/null 2>&1; then
    astgrep_bunx "$@"
  else
    return 127
  fi
}

# astgrep_bunx <args>: `bunx -p <package> <bin>` installs the package again at every
# run (about a second); with --no-install it runs the copy in bunx's cache, which is
# installed first when it is not there (once per shell).
astgrep_bunx() {
  if [ -z "${_ag_bunx:-}" ]; then
    bunx --no-install -p "@ast-grep/cli@$FORGE_AST_GREP_VERSION" ast-grep --version >/dev/null 2>&1 \
      || bunx -p "@ast-grep/cli@$FORGE_AST_GREP_VERSION" ast-grep --version >/dev/null 2>&1
    _ag_bunx=1
  fi
  bunx --no-install -p "@ast-grep/cli@$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
}

# first_lines <n>: keep the first n lines of stdin.
first_lines() { awk -v n="$1" 'NR <= n'; }

# repo_root: cd to the git repository containing the hook's cwd; sets FORGE_STATE.
repo_root() {
  _cwd=$(json_get cwd)
  [ -n "$_cwd" ] && cd "$_cwd" 2>/dev/null || return 1
  _top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  cd "$_top" || return 1
  FORGE_STATE=$(forge_state_of "$(pwd -P)")
}

# forge_state_of <repository root>: where the hooks keep this repository's state
# (turn snapshots, Stop results, the saved prompt, review verdicts, Bash snapshots):
# outside the repository, so that the agent's own Bash commands (sandboxed to the
# repository) cannot forge it: $FORGE_STATE_HOME (default ~/.claude/forge-state)
# /<first 16 hex of the sha256 of the root's physical path>.
forge_state_of() {
  printf '%s/%s' "${FORGE_STATE_HOME:-$HOME/.claude/forge-state}" "$(printf '%s' "$1" | forge_sha256 | cut -c 1-16)"
}

# forge_state_dir: creates $FORGE_STATE (readable by the user only); fails when it cannot.
forge_state_dir() {
  [ -n "${FORGE_STATE:-}" ] || return 1
  [ -d "$FORGE_STATE" ] || (umask 077 && mkdir -p "$FORGE_STATE") 2>/dev/null
}

# rel_path <path>: <path> relative to the current directory (the repository
# root after repo_root), resolving symlinks; fails when outside it.
rel_path() {
  case $1 in /*) _rp_p=$1 ;; *) _rp_p=$(json_get cwd)/$1 ;; esac
  _rp_d=$(cd "$(dirname "$_rp_p")" 2>/dev/null && pwd -P) || return 1
  _rp_root=$(pwd -P)
  case $_rp_d/ in "$_rp_root"/*) ;; *) return 1 ;; esac
  _rp_rel=${_rp_d#"$_rp_root"}
  _rp_rel=${_rp_rel#/}
  printf '%s' "${_rp_rel:+$_rp_rel/}${_rp_p##*/}"
}

# session_id: the hook input's session_id, safe as a file name ("default" if absent).
session_id() {
  _si=$(json_get session_id | tr -c 'A-Za-z0-9_-' '_')
  printf '%s' "${_si:-default}"
}

# forge_sha256: sha256 of stdin, hex.
forge_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{ print $1 }'
  else openssl dgst -sha256 -r | awk '{ print $1 }'
  fi
}

# tree_hash: hash of git diff HEAD plus the untracked files (names and contents).
tree_hash() {
  {
    if git rev-parse --verify -q HEAD >/dev/null; then git diff HEAD --binary 2>/dev/null; else git diff --cached --binary 2>/dev/null; fi
    git ls-files -z --others --exclude-standard 2>/dev/null | tr '\000' '\n' | while IFS= read -r _th_f; do
      printf '%s ' "$_th_f"; git hash-object -- "$_th_f" 2>/dev/null || printf '\n'
    done
  } | forge_sha256
}

# status_paths: changed paths (staged, unstaged, untracked; renames as delete + add),
# one per line, as they are (-z: git quotes non-ASCII names otherwise).
status_paths() {
  git status --porcelain -z --no-renames --untracked-files=all 2>/dev/null | tr '\000' '\n' | sed 's/^...//'
}

# snapshot <dir>: the working tree at the start of a turn, for the Stop hook:
# head (commit), tree (tree_hash), dirty ("path<TAB>blob hash", "-" when deleted)
# and files/<path> (copies of the dirty files up to 1 MiB, to compute added lines).
snapshot() {
  rm -rf "$1" && mkdir -p "$1/files" || return 1
  git rev-parse -q --verify HEAD > "$1/head" 2>/dev/null || : > "$1/head"
  tree_hash > "$1/tree"
  status_paths | while IFS= read -r _sn_f; do
    if [ -f "$_sn_f" ]; then
      printf '%s\t%s\n' "$_sn_f" "$(git hash-object -- "$_sn_f" 2>/dev/null)"
      if [ "$(wc -c < "$_sn_f")" -le 1048576 ]; then
        mkdir -p "$1/files/$(dirname "$_sn_f")" && cp "$_sn_f" "$1/files/$_sn_f"
      fi
    else
      printf '%s\t-\n' "$_sn_f"
    fi
  done > "$1/dirty"
}

# The base a change is measured against: FORGE_SNAP (a turn snapshot) and/or
# FORGE_BASE_REV (a commit). base_hash <path>: blob hash of <path> in the base, "-" if absent.
base_hash() {
  if [ -n "${FORGE_SNAP:-}" ] && _bh=$(awk -F '\t' -v p="$1" '$1 == p { print $2; f = 1; exit } END { exit !f }' "$FORGE_SNAP/dirty" 2>/dev/null); then
    printf '%s' "$_bh"
  elif [ -n "${FORGE_BASE_REV:-}" ] && _bh=$(git rev-parse -q --verify "$FORGE_BASE_REV:$1" 2>/dev/null); then
    printf '%s' "$_bh"
  else
    printf -- '-'
  fi
}

# now_hash <path>: blob hash of the working-tree file, "-" if absent.
now_hash() {
  if [ -f "$1" ]; then git hash-object -- "$1" 2>/dev/null; else printf -- '-'; fi
}

# base_file <path> <out>: writes <path> as it is in the base to <out>; fails if absent there.
# _bf_inrev=0 says <path> is not in FORGE_BASE_REV's tree (the caller looked it up).
base_file() {
  if [ -n "${FORGE_SNAP:-}" ] && _bf=$(awk -F '\t' -v p="$1" '$1 == p { print $2; f = 1; exit } END { exit !f }' "$FORGE_SNAP/dirty" 2>/dev/null); then
    [ "$_bf" != - ] && [ -f "$FORGE_SNAP/files/$1" ] || return 1
    mkdir -p "$(dirname "$2")" && cp "$FORGE_SNAP/files/$1" "$2"
  elif [ -n "${FORGE_BASE_REV:-}" ] && [ "${_bf_inrev:-1}" != 0 ] && git cat-file -e "$FORGE_BASE_REV:$1" 2>/dev/null; then
    mkdir -p "$(dirname "$2")" && git cat-file blob "$FORGE_BASE_REV:$1" > "$2" 2>/dev/null
  else
    return 1
  fi
}

# added_lines <path> <base-copy>: "path<TAB>line" for each line added since the base
# (git diff -U0: an edited line counts, moved code counts); "path<TAB>*" when
# <base-copy> does not exist (the file is new).
added_lines() {
  if [ ! -f "$2" ]; then printf '%s\t*\n' "$1"; return 0; fi
  git diff --no-index --no-ext-diff --no-textconv --no-color -U0 -- "$2" "$1" 2>/dev/null \
    | awk -v f="$1" '/^@@ / { split($3, p, ","); s = substr(p[1], 2) + 0; n = (p[2] == "" ? 1 : p[2] + 0); for (i = 0; i < n; i++) print f "\t" (s + i) }'
}

# turn_dir: the turn snapshot of this session (written by turn-start.sh).
turn_dir() { printf '%s/%s.turn' "$FORGE_STATE" "$(session_id)"; }

# ---- reviews of permission asks nobody can answer (review.sh)

# forge_review_wanted: succeeds when an ask should go to an independent reviewer:
# FORGE_ASK_REVIEW=always, or (auto, the default) a run with nobody to answer
# (CLAUDE_CODE_ENTRYPOINT sdk-cli, sdk-ts, sdk-py or claude-code-github-action:
# claude -p, the Agent SDK, the GitHub Action). Never inside a review, never with
# FORGE_ASK_REVIEW=never, never in dontAsk mode (the user chose to deny asks).
forge_review_wanted() {
  [ -z "${FORGE_REVIEWER:-}" ] || return 1
  case $FORGE_INPUT in *'"permission_mode":"dontAsk"'*|*'"permission_mode": "dontAsk"'*) return 1 ;; esac
  case ${FORGE_ASK_REVIEW:-auto} in
    always) return 0 ;;
    never) return 1 ;;
  esac
  case ${CLAUDE_CODE_ENTRYPOINT:-} in
    sdk-cli|sdk-ts|sdk-py|claude-code-github-action) return 0 ;;
  esac
  return 1
}

# forge_json_object <key>: the JSON value (object or array) of the first <key> in stdin.
forge_json_object() {
  awk -v key="$1" '
    { buf = buf $0 "\n" }
    END {
      if (!match(buf, "\"" key "\"[[:space:]]*:[[:space:]]*[{[]")) exit
      s = substr(buf, RSTART + RLENGTH - 1); n = length(s); depth = 0; str = 0
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (str) { if (c == "\\") i++; else if (c == "\"") str = 0; continue }
        if (c == "\"") str = 1
        else if (c == "{" || c == "[") depth++
        else if (c == "}" || c == "]") { depth--; if (!depth) { print substr(s, 1, i); exit } }
      }
    }'
}

# forge_review <tool> <tool-input-json> [<rule> <concern> <question> [<request>]]: runs
# the reviewer, a fresh `claude -p` that sees only the action (tool, input, the
# repository path) and, for a rule's ask, that rule's concern and the one question
# to answer (and, when given, the user's request for the turn; never the
# conversation). It may read the repository (Read, Grep, Glob, nothing else) and
# runs without hooks, MCP servers or settings. Prints "allow<TAB>reason" or
# "deny<TAB>reason"; fails when claude is missing or gives no verdict (the ask then
# stays unanswered).
forge_review() {
  command -v claude >/dev/null 2>&1 || return 1
  if [ -n "${3:-}" ]; then
    _rv_concern=''
    [ -n "${4:-}" ] && _rv_concern=" The concern of that rule: $4"
    _rv_q=${5:-}
    [ -n "$_rv_q" ] || _rv_q='Is this action, as far as that concern goes, normal work on this repository and safe to run unattended?'
    _rv_req=''
    [ -n "${6:-}" ] && _rv_req="

The user's request for this turn (what the agent was asked to do; not the conversation):
<request>
$6
</request>"
    _rv_task="Forge flagged it with rule $3.$_rv_concern
The question you answer: $_rv_q$_rv_req

Judge only that question. The rest of the action is not under review: other commands or changes in it are covered by their own rules and permissions, and are no reason to deny. Allow when the answer clearly clears the concern; deny when it does not, or when you cannot tell."
  else
    _rv_task="Allow it only if it is clearly within normal work on this repository and safe to run unattended. Deny anything irreversible or destructive (deleting data or history, force pushes, dropping databases), anything that publishes, deploys or pushes outside this machine, anything that reads or sends secrets, installs packages you cannot verify, weakens security, permissions, tests or tool configuration, or runs code fetched from the internet. When in doubt, deny."
  fi
  _rv_prompt="You are reviewing one action that an autonomous coding agent wants to take. Nobody is available to approve it, so you decide in the user's place, as a careful senior developer who sees only this action would.

Repository: $(pwd)
Tool: $1
Input: $2

You do not see the agent's conversation or its reasons, on purpose: judge the action itself. You may read files in the repository to understand it. $_rv_task Give the reason in one sentence."
  _rv_schema='{"type":"object","properties":{"decision":{"type":"string","enum":["allow","deny"]},"reason":{"type":"string"}},"required":["decision","reason"],"additionalProperties":false}'
  _rv_out=$(FORGE_REVIEWER=1 claude -p "$_rv_prompt" --output-format json --json-schema "$_rv_schema" \
    --tools Read,Grep,Glob --allowedTools Read,Grep,Glob --permission-mode dontAsk --max-turns "${FORGE_REVIEW_MAX_TURNS:-12}" \
    --no-session-persistence --strict-mcp-config --setting-sources '' --settings '{"disableAllHooks":true}' \
    ${FORGE_REVIEW_MODEL:+--model "$FORGE_REVIEW_MODEL"} < /dev/null 2>/dev/null) || return 1
  _rv_so=${_rv_out#*'"structured_output":'}
  [ "$_rv_so" != "$_rv_out" ] || return 1
  _rv_d=$(FORGE_INPUT=$_rv_so json_get decision)
  _rv_r=$(FORGE_INPUT=$_rv_so json_get reason | tr '\t\n' '  ')
  case $_rv_d in allow|deny) printf '%s\t%s' "$_rv_d" "${_rv_r:-no reason given}" ;; *) return 1 ;; esac
}

# forge_review_state: where reviews are logged and cached: the repository's state
# directory (forge_state_of) in a Forge project, else ~/.claude.
forge_review_state() {
  if _rs_top=$(cd "$(json_get cwd)" 2>/dev/null && cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null && pwd -P) \
    && [ -d "$_rs_top/.forge" ] && FORGE_STATE=$(forge_state_of "$_rs_top") && forge_state_dir; then
    printf '%s' "$FORGE_STATE"
  else
    printf '%s/.claude' "$HOME"
  fi
}

# forge_review_log <decision> <tool> <input> <reason>: one line per review in
# reviews.log in the state directory (in a Forge project) or ~/.claude/forge-reviews.log.
forge_review_log() {
  _rl_f=$(forge_review_state)
  case $_rl_f in "$HOME/.claude") _rl_f=$_rl_f/forge-reviews.log ;; *) _rl_f=$_rl_f/reviews.log ;; esac
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(session_id)" "$1" "$2" "$(printf '%s' "$3" | tr '\t\n' '  ')" "$4" >> "$_rl_f" 2>/dev/null
  return 0
}

# forge_kill_tree <pid>: kills a process and its descendants.
# It is stopped first, so it cannot start a new child while its children are killed.
forge_kill_tree() {
  kill -STOP "$1" 2>/dev/null
  for _fk_c in $(ps -A -o pid= -o ppid= 2>/dev/null | awk -v p="$1" '$2 == p { print $1 }'); do
    forge_kill_tree "$_fk_c"
  done
  kill "$1" 2>/dev/null
  kill -CONT "$1" 2>/dev/null
}

# forge_kill_watch <pid>: stops a timeout watcher, "( sleep <n>; ... ) &" started by
# this shell, and its sleep.
# SIGKILL: a SIGTERM that reaches the subshell before it has dropped its parent's traps
# can be lost, and a watcher left alive holds the parent's saved descriptors (a hook's
# $(...) pipe) until its sleep ends. Stopped first, so it starts nothing meanwhile.
forge_kill_watch() {
  kill -STOP "$1" 2>/dev/null
  _kw_c=$(ps -A -o pid= -o ppid= 2>/dev/null | awk -v p="$1" '$2 == p { print $1 }')
  # shellcheck disable=SC2086
  kill -9 "$1" $_kw_c 2>/dev/null
  # reaped here, so the shell does not report it ("Killed: 9") when it reaps a later job
  wait "$1" 2>/dev/null
  return 0
}

# ---- files changed by a Bash command (bash-snapshot.sh, post-edit.sh, typecheck.sh)

# bash_state: where Bash-command snapshots live; bash_key: this tool call's id, file-name safe.
bash_state() { printf '%s/bash' "$FORGE_STATE"; }
bash_key() {
  _bk=$(json_get tool_use_id | tr -c 'A-Za-z0-9_-' '_')
  [ -n "$_bk" ] && printf '%s' "$_bk"
}

# tree_snapshot <seconds>: prints the git tree id of the working tree (tracked and
# untracked files, ignored ones left out) without touching the user's index or
# object store: a copy of .git/index, and new blobs written under bash_state/objects
# (the repository's objects are read as alternates). Fails after <seconds>.
tree_snapshot() {
  _ts_s=$(bash_state)
  mkdir -p "$_ts_s/objects" || return 1
  _ts_objs=$(cd "$_ts_s/objects" && pwd -P) || return 1
  _ts_alt=$(cd "$(git rev-parse --git-path objects 2>/dev/null)" 2>/dev/null && pwd -P) || return 1
  _ts_idx=$(git rev-parse --git-path index 2>/dev/null) || return 1
  _ts_tmp=$(mktemp "${TMPDIR:-/tmp}/forge-index.XXXXXX") || return 1
  if [ -f "$_ts_idx" ]; then cp "$_ts_idx" "$_ts_tmp"; else rm -f "$_ts_tmp"; fi
  (
    export GIT_INDEX_FILE="$_ts_tmp" GIT_OBJECT_DIRECTORY="$_ts_objs" GIT_ALTERNATE_OBJECT_DIRECTORIES="$_ts_alt"
    git add -A . >/dev/null 2>&1 && git write-tree 2>/dev/null
  ) > "$_ts_tmp.out" &
  _ts_pid=$!
  ( sleep "$1"; forge_kill_tree "$_ts_pid" ) >/dev/null 2>&1 &
  _ts_watch=$!
  wait "$_ts_pid" 2>/dev/null
  _ts_rc=$?
  forge_kill_watch "$_ts_watch"
  _ts_tree=$(cat "$_ts_tmp.out" 2>/dev/null)
  rm -f "$_ts_tmp" "$_ts_tmp.out" "$_ts_tmp.lock"
  [ "$_ts_rc" -eq 0 ] && [ -n "$_ts_tree" ] || return 1
  printf '%s\n' "$_ts_tree"
}

# bash_changed_files <before-tree> <after-tree>: added or modified files, one per
# line, outside Forge's, Claude's, git's and dependency directories.
bash_changed_files() {
  _bc_objs=$(cd "$(bash_state)/objects" && pwd -P) || return 1
  _bc_alt=$(cd "$(git rev-parse --git-path objects 2>/dev/null)" 2>/dev/null && pwd -P) || return 1
  GIT_OBJECT_DIRECTORY="$_bc_objs" GIT_ALTERNATE_OBJECT_DIRECTORIES="$_bc_alt" \
    git diff-tree -r --no-renames --name-status "$1" "$2" 2>/dev/null \
    | awk -F '\t' '$1 == "A" || $1 == "M" { print $2 }' \
    | grep -vE '^(\.forge|\.claude|\.git|node_modules|\.venv)/' 
  return 0
}

# bash_cleanup: drops snapshots older than a day or beyond the 50 newest (a denied
# command never reaches PostToolUse), and the snapshot objects once none is pending.
bash_cleanup() {
  _bl_s=$(bash_state)
  [ -d "$_bl_s" ] || return 0
  find "$_bl_s" -type f \( -name '*.tree' -o -name '*.files' \) -mtime +0 -exec rm -f {} + 2>/dev/null
  # shellcheck disable=SC2012
  ls -t "$_bl_s" 2>/dev/null | grep -E '\.(tree|files)$' | sed '1,50d' | while IFS= read -r _bl_f; do rm -f "$_bl_s/$_bl_f"; done
  if [ -z "$(ls "$_bl_s" 2>/dev/null | grep -E '\.tree$')" ]; then rm -rf "$_bl_s/objects"; fi
  return 0
}

# ---- engine capabilities (SPECS §15): the types engine, one daemon per language and
# repository in $FORGE_STATE/types/<lang>/ (in: the request FIFO; pid, ready, want,
# log; sessions/ holds one file per Claude Code session using it).

# forge_types_alive <lang>: its daemon is running.
forge_types_alive() {
  [ -p "$FORGE_STATE/types/$1/in" ] && [ -f "$FORGE_STATE/types/$1/ready" ] \
    && kill -0 "$(cat "$FORGE_STATE/types/$1/pid" 2>/dev/null)" 2>/dev/null
}

# forge_types_line <lang> <line>: writes one line (shorter than PIPE_BUF, so writers
# never mix) to the daemon's FIFO. Opened read-write, so it never blocks.
forge_types_line() { printf '%s\n' "$2" 1<>"$FORGE_STATE/types/$1/in"; }

# forge_types_ask <lang> <dir> [stop]: asks the daemon the question in <dir>/req and
# prints its answer (without the final "end"); with "stop", asks it to stop and waits
# until it has (its language server ended). Fails when no answer comes within
# FORGE_TYPES_TIMEOUT seconds (20). The reply FIFO is opened read-write before the
# question is sent, so the daemon's non-blocking open always finds a reader.
forge_types_ask() {
  mkfifo "$2/reply" || return 1
  exec 8<>"$2/reply"
  forge_types_line "$1" "${3:+$3	}$2"
  { sleep "${FORGE_TYPES_TIMEOUT:-20}" & printf '%s\n' "$!" > "$2/sleep"; wait "$!"
    printf 'error\tno answer within %ss\nend\n' "${FORGE_TYPES_TIMEOUT:-20}" 1<>"$2/reply"; } >/dev/null 2>&1 &
  _ta_w=$!
  _ta_rc=1
  while IFS= read -r _ta_l <&8; do
    [ "$_ta_l" = end ] && { _ta_rc=0; break; }
    printf '%s\n' "$_ta_l"
  done
  forge_types_unwatch "$_ta_w" "$2/sleep"
  exec 8<&-
  return "$_ta_rc"
}

# forge_types_unwatch <watchdog pid> <file with its sleep's pid>: ends a watchdog by
# its sleep, so the watchdog ends on its own (killing it would make some shells print
# "Terminated"); its late line goes to a FIFO nobody reads any more.
forge_types_unwatch() {
  _tw_n=0
  while [ ! -s "$2" ] && [ "$_tw_n" -lt 100 ]; do _tw_n=$((_tw_n + 1)); done
  if [ -s "$2" ] && read -r _tw_p < "$2"; then kill "$_tw_p" 2>/dev/null; else kill "$1" 2>/dev/null; fi
  wait "$1" 2>/dev/null
  return 0
}

# forge_types_changed <path>...: tells the running daemons that files changed on disk
# (they resync them). A dependency or configuration change restarts them instead: the
# next question starts them again on the new environment.
forge_types_changed() {
  [ -d "$FORGE_STATE/types" ] || return 0
  for _tc_lang in python typescript; do
    forge_types_alive "$_tc_lang" || continue
    for _tc_f in "$@"; do
      case $_tc_f in
        uv.lock|*/uv.lock|pyproject.toml|*/pyproject.toml|ty.toml|bun.lock|bun.lockb|package-lock.json|pnpm-lock.yaml|yarn.lock|package.json|*/package.json|tsconfig*.json|*/tsconfig*.json)
          forge_types_line "$_tc_lang" restart; break ;;
        *) forge_types_line "$_tc_lang" "changed	$_tc_f" ;;
      esac
    done
  done
}

# forge_types_stop <lang>: stops the language's daemon and waits until it and its
# language server have exited (at most FORGE_TYPES_TIMEOUT seconds).
forge_types_stop() {
  forge_types_alive "$1" || return 0
  _tp_r=$(mktemp -d "${TMPDIR:-/tmp}/forge-types-stop.XXXXXX") || return 1
  forge_types_ask "$1" "$_tp_r" stop > /dev/null
  rm -rf "$_tp_r"
  return 0
}

# forge_types_session <start|end>: registers this Claude Code session with the running
# daemons, or unregisters it; the last session to end stops them.
forge_types_session() {
  for _tx_lang in python typescript; do
    _tx_d=$FORGE_STATE/types/$_tx_lang
    [ -d "$_tx_d" ] || continue
    if [ "$1" = start ]; then mkdir -p "$_tx_d/sessions" && : > "$_tx_d/sessions/$(session_id)"
    else
      rm -f "$_tx_d/sessions/$(session_id)"
      [ -n "$(ls "$_tx_d/sessions" 2>/dev/null)" ] || forge_types_stop "$_tx_lang"
    fi
  done
  return 0
}

===== .claude/skills/forge-project/scripts/post-edit.sh
#!/bin/sh
# Generated by forge. PostToolUse(Edit|Write|Bash) and PostToolUseFailure(Bash), a
# failed or interrupted command having possibly changed files: formats the changed files
# silently, applies the lint checks' safe fixes (saying so when a file changed),
# lints them and runs the forbid rules on them, each tool once for all the files and
# within FORGE_EDIT_BUDGET (45 s; past it, what was found so far). Edit and Write: the
# edited file. Bash: the files the command added or modified, found by comparing
# the working tree with the snapshot bash-snapshot.sh took before it (at most 20
# files). Findings on lines added during this turn (or since HEAD, before the
# first prompt) go back to Claude as additionalContext (<= 20 lines). Nothing on success.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-edit.XXXXXX") || exit 0
trap 'rm -rf "$FORGE_TMP"' EXIT; trap 'exit 143' HUP INT TERM
: > "$FORGE_TMP/report"

if [ "$(json_get tool_name)" = Bash ]; then
  key=$(bash_key) || exit 0
  state=$(bash_state)
  [ -f "$state/$key.tree" ] || exit 0
  before=$(cat "$state/$key.tree")
  if [ "$before" = skipped ] || ! after=$(tree_snapshot "${FORGE_SNAPSHOT_TIMEOUT:-5}"); then
    : > "$state/$key.files"
    if [ ! -f "$state/snapshot-skipped" ]; then
      : > "$state/snapshot-skipped"
      printf 'forge: files changed by Bash commands are not checked here (the working tree is too large to snapshot within %ss); the Stop check still covers them.\n' "${FORGE_SNAPSHOT_TIMEOUT:-5}" > "$FORGE_TMP/report"
    fi
  else
    bash_changed_files "$before" "$after" > "$state/$key.files.tmp"
    mv "$state/$key.files.tmp" "$state/$key.files"
    while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done < "$state/$key.files" > "$FORGE_TMP/changed"
    if [ "$(awk 'END { print NR }' "$FORGE_TMP/changed")" -gt 20 ]; then
      printf 'forge: the command changed %s files; checking the first 20 (the Stop check covers the rest).\n' "$(awk 'END { print NR }' "$FORGE_TMP/changed")" > "$FORGE_TMP/report"
      first_lines 20 < "$FORGE_TMP/changed" > "$FORGE_TMP/changed.20" && mv "$FORGE_TMP/changed.20" "$FORGE_TMP/changed"
    fi
  fi
  rm -f "$state/$key.tree"
  bash_cleanup
else
  file=$(json_get file_path)
  [ -n "$file" ] || exit 0
  file=$(rel_path "$file") || exit 0
  [ -f "$file" ] || exit 0
  case $file in .forge/*|.claude/*|.git/*|node_modules/*|.venv/*) exit 0 ;; esac
  printf '%s\n' "$file" > "$FORGE_TMP/changed"
fi
[ -s "$FORGE_TMP/changed" ] || { [ -s "$FORGE_TMP/report" ] || exit 0; }

# ---- generated checks
# Project tools used in check commands, resolved through tool().
biome() { forge_exec_tool biome "$@"; }
tsc() { forge_exec_tool tsc "$@"; }
vitest() { forge_exec_tool vitest "$@"; }
FORGE_NCHECKS=20

