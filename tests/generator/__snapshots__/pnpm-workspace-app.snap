    export const y = 2;

===== .forge/ast-grep/rule-tests/typescript-no-unchecked-json-test.yml
id: typescript/no-unchecked-json
valid: []
invalid:
  - |
    type Config = { port: number };

    export function load(text: string): Config {
      return JSON.parse(text) as Config;
    }
  - |
    type Config = { port: number };

    export function load(text: string): number {
      const config: Config = JSON.parse(text);
      return config.port;
    }
  - |
    type User = { id: number };

    export async function user(): Promise<User> {
      const res = await fetch("https://api.example.com/me");
      return (await res.json()) as User;
    }
  - |
    type User = { id: number };

    export async function user(): Promise<number> {
      const res = await fetch("https://api.example.com/me");
      const me: User = await res.json();
      return me.id;
    }

