===== .forge/ast-grep/rule-tests/typescript-no-swallowed-catch-test.yml
id: typescript/no-swallowed-catch
valid:
  - |
    export function load(): Config {
      try {
        return read();
      } catch (e) {
        throw new ConfigError("cannot read config", { cause: e });
      }
    }
  - |
    export function load(): Config | null {
      try {
        return read();
      } catch (error) {
        logger.error({ error }, "config unreadable");
        return null;
      }
    }
  - |
    export async function sync() {
      await push().catch((e) => report(e));
    }
invalid:
  - |
    export function load(): Config | null {
      try {
        return read();
      } catch (e) {
        return null;
      }
    }
  - |
    export function load(): Config | null {
      try {
        return read();
      } catch {
        return null;
      }
    }
  - |
    export async function sync() {
      await push().catch(() => {});
    }

===== .forge/ast-grep/rule-tests/typescript-no-ts-nocheck-test.yml
id: typescript/no-ts-nocheck
valid:
  - |
    // regular comment
    export const x = 1;
  - |
    // we never use ts-nocheck here
    export const y = 2;
invalid:
