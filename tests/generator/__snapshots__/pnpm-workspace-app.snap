===== .forge/ast-grep/rules/typescript/cors-credentials-wildcard.yml
# Generated by forge from typescript/cors-credentials-wildcard (mode: forbid).
id: typescript/cors-credentials-wildcard
language: Tsx
severity: error
message: forge:typescript/cors-credentials-wildcard CORS with credentials true names its allowed origins. origin "*" is refused by browsers with credentials; origin true, or a function that returns the origin it is given (alone or with a ?? / || fallback, as an expression or a return), lets any site make credentialed requests. Covers cors (Express), hono/cors, @fastify/cors and Nest's enableCors.
files:
  - packages/core/**
rule:
  kind: call_expression
  any:
    - all:
        - has:
            field: function
            kind: member_expression
            has:
              field: property
              regex: ^register$
        - has:
            field: arguments
            all:
              - has:
                  nthChild: 1
                  pattern: $PLUGIN
              - has:
                  nthChild: 2
                  matches: any-origin-with-credentials
    - all:
        - has:
            field: function
            kind: member_expression
            all:
              - has:
                  field: object
                  pattern: $APP
              - has:
                  field: property
                  regex: ^enableCors$
        - has:
            field: arguments
            has:
              nthChild: 1
              matches: any-origin-with-credentials
    - all:
        - has:
            field: function
            kind: member_expression
            all:
              - has:
                  field: object
                  pattern: $NEST
              - has:
                  field: property
                  regex: ^create$
        - has:
            field: arguments
            has:
              nthChild: 2
              kind: object
              has:
                kind: pair
                all:
                  - has:
                      field: key
                      regex: ^["']?cors["']?$
                  - has:
                      field: value
                      matches: any-origin-with-credentials
    - all:
        - has:
            field: function
            pattern: $CORS
        - has:
            field: arguments
            has:
              nthChild: 1
              matches: any-origin-with-credentials
utils:
  any-origin-with-credentials:
    kind: object
    all:
      - has:
          kind: pair
          all:
            - has:
                field: key
                regex: ^["']?credentials["']?$
            - has:
                field: value
                kind: "true"
      - has:
          kind: pair
          all:
            - has:
                field: key
                regex: ^["']?origin["']?$
            - has:
                field: value
                any:
                  - regex: ^["']\*["']$
                  - kind: "true"
                  - all:
                      - any:
                          - kind: arrow_function
                          - kind: function_expression
                      - any:
                          - has:
                              field: parameter
                              pattern: $O
                          - has:
                              field: parameters
                              has:
                                nthChild: 1
                                has:
                                  field: pattern
                                  pattern: $O
                      - any:
                          - has:
                              field: body
                              any:
                                - pattern: $O
                                - pattern: $O ?? $D
                                - pattern: $O || $D
                                - pattern: ($O)
                          - has:
                              field: body
                              kind: statement_block
                              has:
                                stopBy: end
                                kind: return_statement
                                has:
                                  any:
                                    - pattern: $O
                                    - pattern: $O ?? $D
                                    - pattern: $O || $D
metadata:
  forge_where:
    CORS:
      declared:
        - package: cors
        - package: hono
          name: cors
    PLUGIN:
      declared:
        package: "@fastify/cors"
    APP:
      type:
        package: "@nestjs/common"
        name: INestApplication
    NEST:
      declared:
        package: "@nestjs/core"
        name: NestFactory

===== .forge/ast-grep/rules/typescript/no-deprecated.yml
# Generated by forge from typescript/no-deprecated (mode: forbid).
id: typescript/no-deprecated
language: Tsx
severity: error
message: "forge:typescript/no-deprecated No use of a declaration marked @deprecated (the project's, a library's, @types/node's): a call, construction, property, type or import TypeScript reports as deprecated (for an overloaded function, the signature the call resolves to), or an object literal key whose property is deprecated. Use the replacement the deprecation names."
files:
  - packages/core/**
rule:
  any:
    - kind: identifier
      pattern: $N
    - kind: property_identifier
      pattern: $N
    - kind: type_identifier
      pattern: $N
    - kind: shorthand_property_identifier
      pattern: $N
metadata:
  forge_where:
    N:
      deprecated: true

