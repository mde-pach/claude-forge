# 22. typescript/pnpm/settings-location
forge_check_meta_22() {
  c_id='typescript/pnpm/settings-location'; c_stage=lint; c_tools='bun'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_22() {
  case $1 in package.json|*/package.json|.npmrc|*/.npmrc) ;; *) return 1 ;; esac
  return 0
}
forge_when_22() { return 1; }
forge_check_run_22() {
_pf=''
for _f in ${FORGE_FILES:-$(git ls-files -- package.json '*/package.json' .npmrc '*/.npmrc')}; do
  [ -f "$_f" ] || continue
  case $_f in
    .npmrc|*/.npmrc)
      _pf="$_pf$(grep -nE '^[[:space:]]*(minimum-release-age|minimum-release-age-exclude|only-built-dependencies|only-built-dependencies-file|never-built-dependencies|ignored-built-dependencies|allow-builds|strict-dep-builds|dangerously-allow-all-builds|node-linker|shamefully-hoist|hoist|hoist-pattern|public-hoist-pattern|auto-install-peers|strict-peer-dependencies|dedupe-peer-dependents|resolve-peers-from-workspace-root|link-workspace-packages|prefer-workspace-packages|save-workspace-protocol|shared-workspace-lockfile|inject-workspace-packages|catalog-mode|resolution-mode|package-import-method|virtual-store-dir|modules-dir|store-dir|side-effects-cache|enable-pre-post-scripts)[[:space:]]*=' "$_f" | sed "s|^\([0-9]*\):[[:space:]]*\([^=[:space:]]*\).*|$_f:\1 \2 is a pnpm setting: pnpm 11 reads it only from pnpm-workspace.yaml (camelCase), .npmrc keeps registry and auth|")
" ;;
    *)
      _pf="$_pf$(bun --no-install -e '
        const f = process.argv[1], t = require("fs").readFileSync(f, "utf8");
        let d = 0, line = 1;
        for (let i = 0; i < t.length; i++) {
          const c = t[i];
          if (c === "\n") line++;
          else if (c === "{" || c === "[") d++;
          else if (c === "}" || c === "]") d--;
          else if (c === "\"") {
            let j = i + 1;
            while (j < t.length && t[j] !== "\"") j += t[j] === "\\" ? 2 : 1;
            if (d === 1 && t.slice(i + 1, j) === "pnpm" && /^\s*:/.test(t.slice(j + 1))) console.log(`${f}:${line} the pnpm field is not read by pnpm 11: move its settings (overrides, patchedDependencies, allowBuilds, …) to pnpm-workspace.yaml`);
            i = j;
          }
        }' "$_f")
" ;;
  esac
done
_pf=$(printf '%s' "$_pf" | grep .)
[ -z "$_pf" ] || { printf '%s\n' "$_pf"; false; }

}

