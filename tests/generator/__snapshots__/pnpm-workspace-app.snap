  - "const u = (req as unknown as { user: User }).user;"
  - const n = s as any as number;

===== .forge/ast-grep/rule-tests/typescript-no-dynamic-regexp-test.yml
id: typescript/no-dynamic-regexp
valid:
  - |
    export const slug = new RegExp("^[a-z0-9-]+$");
  - |
    export function finder(term: string): RegExp {
      return new RegExp(RegExp.escape(term), "i");
    }
  - |
    export function exact(word: string): RegExp {
      return new RegExp(`^${RegExp.escape(word)}$`);
    }
invalid:
  - |
    export function finder(term: string): RegExp {
      return new RegExp(term, "i");
    }
  - |
    export function exact(word: string): RegExp {
      return RegExp(`^${word}$`);
    }

===== .forge/ast-grep/rule-tests/typescript-no-hardcoded-session-secret-test.yml
id: typescript/no-hardcoded-session-secret
valid: []
invalid:
  - |
    import session from "express-session";

    export const sessions = session({ secret: "keyboard cat", resave: false, saveUninitialized: false });
  - |
    import cookieParser from "cookie-parser";

    export const cookies = cookieParser(`my-super-secret-session-key-2024`);
  - |
    import jwt from "jsonwebtoken";

    export const token = (id: string) => jwt.sign({ sub: id }, "0123456789abcdef0123456789abcdef");
  - |
    import { sign as signJwt } from "hono/jwt";

    export const token = (id: string) => signJwt({ sub: id }, "dev-secret");
  - |
    import { betterAuth } from "better-auth";

    export const auth = betterAuth({ secret: "change-me" });
  - |
    import Fastify from "fastify";
    import fastifyCookie from "@fastify/cookie";

    const app = Fastify();
    app.register(fastifyCookie, { secret: "cookie-secret" });

===== .forge/ast-grep/rule-tests/typescript-no-html-sinks-test.yml
id: typescript/no-html-sinks
valid: []
invalid:
  - |
    export function show(el: HTMLDivElement, msg: string) {
      el.innerHTML = msg;
    }
  - |
    export function show(msg: string) {
      document.body.insertAdjacentHTML("beforeend", `<p>${msg}</p>`);
    }
  - |
    export function frag(r: Range, s: string) {
      return r.createContextualFragment(s);
    }
  - |
    export function render(root: ShadowRoot | null, html: string) {
      if (root) root.innerHTML = html;
      document.write(html);
    }

