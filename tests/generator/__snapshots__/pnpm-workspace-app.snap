    export const users = [{ id: 1, name: "a" }] as User[];
  - |
    export const totals = {} as Record<string, number>;

===== .forge/ast-grep/rule-tests/typescript-no-stub-test.yml
id: typescript/no-stub
valid:
  - |
    export function parse(x: string): number;
    export function parse(x: number): number;
    export function parse(x: string | number): number {
      return Number(x);
    }
  - |
    export interface Gateway {
      charge(orderId: string): Promise<void>;
    }
  - |
    export class Billing {
      constructor(private readonly gateway: Gateway) {}
    }
  - |
    export const noop = () => {};
  - |
    export function refund(orderId: string): void {
      throw new Error(`Order ${orderId} cannot be refunded`);
    }
invalid:
  - |
    export function refund(orderId: string): void {
      throw new Error("Not implemented");
    }
  - |
