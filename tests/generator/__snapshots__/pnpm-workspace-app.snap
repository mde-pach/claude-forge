    type User = { id: number; name: string };
    export const admin: User = { id: 1, name: "a" };
  - |
    type User = { id: number; name: string };
    export const admin = { id: 1, name: "a" } satisfies User;
  - |
    export const roles = ["admin", "editor"] as const;
  - |
    export const ids = [] as number[];
