===== .claude/skills/forge-project/scripts/post-edit.sh
#!/bin/sh
# Generated by forge. PostToolUse(Edit|Write|Bash) and PostToolUseFailure(Bash), a
# failed or interrupted command having possibly changed files: formats the changed files
# silently, applies the lint checks' safe fixes (saying so when a file changed),
# lints them and runs the forbid rules on them, each tool once for all the files and
# within FORGE_EDIT_BUDGET (45 s; past it, what was found so far). Edit and Write: the
# edited file. Bash: the files the command added or modified, found by comparing
# the working tree with the snapshot bash-snapshot.sh took before it (at most 20
# files). Findings on lines added during this turn (or since HEAD, before the
# first prompt) go back to Claude as additionalContext (<= 20 lines). Nothing on success.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-edit.XXXXXX") || exit 0
trap 'rm -rf "$FORGE_TMP"' EXIT; trap 'exit 143' HUP INT TERM
: > "$FORGE_TMP/report"

if [ "$(json_get tool_name)" = Bash ]; then
  key=$(bash_key) || exit 0
  state=$(bash_state)
  [ -f "$state/$key.tree" ] || exit 0
  before=$(cat "$state/$key.tree")
  if [ "$before" = skipped ] || ! after=$(tree_snapshot "${FORGE_SNAPSHOT_TIMEOUT:-5}"); then
    : > "$state/$key.files"
    if [ ! -f "$state/snapshot-skipped" ]; then
      : > "$state/snapshot-skipped"
      printf 'forge: files changed by Bash commands are not checked here (the working tree is too large to snapshot within %ss); the Stop check still covers them.\n' "${FORGE_SNAPSHOT_TIMEOUT:-5}" > "$FORGE_TMP/report"
    fi
  else
    bash_changed_files "$before" "$after" > "$state/$key.files.tmp"
    mv "$state/$key.files.tmp" "$state/$key.files"
    while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done < "$state/$key.files" > "$FORGE_TMP/changed"
    if [ "$(awk 'END { print NR }' "$FORGE_TMP/changed")" -gt 20 ]; then
      printf 'forge: the command changed %s files; checking the first 20 (the Stop check covers the rest).\n' "$(awk 'END { print NR }' "$FORGE_TMP/changed")" > "$FORGE_TMP/report"
      first_lines 20 < "$FORGE_TMP/changed" > "$FORGE_TMP/changed.20" && mv "$FORGE_TMP/changed.20" "$FORGE_TMP/changed"
    fi
  fi
  rm -f "$state/$key.tree"
  bash_cleanup
else
  file=$(json_get file_path)
  [ -n "$file" ] || exit 0
  file=$(rel_path "$file") || exit 0
  [ -f "$file" ] || exit 0
  case $file in .forge/*|.claude/*|.git/*|node_modules/*|.venv/*) exit 0 ;; esac
  printf '%s\n' "$file" > "$FORGE_TMP/changed"
fi
[ -s "$FORGE_TMP/changed" ] || { [ -s "$FORGE_TMP/report" ] || exit 0; }

# the generated checks and the engine modules they use (forge apply writes them next to this script)
. "$dir/checks.sh"

FORGE_FORBID='typescript/cors-credentials-wildcard|typescript/no-deprecated|typescript/no-double-assertion|typescript/no-hardcoded-session-secret|typescript/no-html-sinks|typescript/no-object-literal-assertion|typescript/no-stub|typescript/no-swallowed-catch|typescript/no-ts-nocheck|typescript/no-unchecked-json|typescript/postmessage-origin|typescript/ts-expect-error-reason|typescript/vitest/no-exit-zero|typescript/vitest/no-matcher-override|typescript/vitest/no-tautological-expect|typescript/vitest/no-test-env-branch|typescript/no-dynamic-regexp'

# the lines added to each file during the turn (base: the turn snapshot, else HEAD)
mode=--changed
FORGE_SNAP=''
FORGE_BASE_REV=$(git rev-parse -q --verify HEAD 2>/dev/null)
snap=$(turn_dir)
if [ -f "$snap/head" ]; then FORGE_SNAP=$snap; FORGE_BASE_REV=$(cat "$snap/head"); fi

# Each tool runs once on all the files; what is found is appended to the report as
# it comes, so a run cut short by the time budget still returns what it has.
forge_edit_checks() {
  # the types engine resyncs the changed files before any question (§15.3)
  forge_types_changed $(cat "$FORGE_TMP/changed")
  forge_file_stage format "$FORGE_TMP/changed" > /dev/null 2>&1
  # safe fixes first (sorted imports, pyupgrade), then lint: a lint run may write too
  # (Biome's check --write applies its safe fixes and formats), so copies are kept to
  # tell its fixes from formatting
  : > "$FORGE_TMP/noted"
  forge_file_fixes "$FORGE_TMP/changed" >> "$FORGE_TMP/report" 2>/dev/null
  while IFS= read -r file; do
    mkdir -p "$FORGE_TMP/pre/$(dirname "$file")" && cp "$file" "$FORGE_TMP/pre/$file"
  done < "$FORGE_TMP/changed"
  forge_file_run lint "$FORGE_TMP/changed" 2>/dev/null
  forge_lint_fixes "$FORGE_TMP/changed" "$FORGE_TMP/pre" >> "$FORGE_TMP/report" 2>/dev/null
  # added lines, on the files as the checks left them
  : > "$FORGE_TMP/added"
  while IFS= read -r file; do
    rm -f "$FORGE_TMP/base"
    base_file "$file" "$FORGE_TMP/base"
    forge_added_lines "$file" "$FORGE_TMP/base" >> "$FORGE_TMP/added"
  done < "$FORGE_TMP/changed"
  forge_file_report lint >> "$FORGE_TMP/report" 2>&1
  [ -s "$FORGE_TMP/changed" ] && forge_grep_forbid "$FORGE_TMP/changed" advise >> "$FORGE_TMP/report"
  if [ -s "$FORGE_TMP/changed" ] && [ -n "$FORGE_FORBID" ] && [ -f .forge/ast-grep/sgconfig.yml ]; then
    set -f
    # shellcheck disable=SC2046
    astgrep scan -c .forge/ast-grep/sgconfig.yml --filter "^($FORGE_FORBID)\$" --json=stream --include-metadata $(cat "$FORGE_TMP/changed") > "$FORGE_TMP/forbid" 2>/dev/null
    set +f
    # matches on added lines; those of rules with type constraints only when the
    # types engine confirms them (§15.1)
    forge_sg_report "$FORGE_TMP/forbid" json > "$FORGE_TMP/forbid.added"
    FORGE_TYPES_EDIT=1 forge_types_filter "$FORGE_TMP/forbid.added" >> "$FORGE_TMP/report"
    forge_sg_report "$FORGE_TMP/forbid.added" >> "$FORGE_TMP/report"
  fi
  return 0
}

# within FORGE_EDIT_BUDGET seconds (the hook's timeout is 60 s): past it, the checks
# still running are stopped and Claude gets what was found, with a note
if [ -s "$FORGE_TMP/changed" ]; then
  forge_edit_checks &
  _pe_pid=$!
  ( sleep "${FORGE_EDIT_BUDGET:-45}"; : > "$FORGE_TMP/over"; forge_kill_tree "$_pe_pid" ) >/dev/null 2>&1 &
  _pe_watch=$!
  wait "$_pe_pid" 2>/dev/null
  forge_kill_watch "$_pe_watch"
  if [ -f "$FORGE_TMP/over" ]; then
    { printf 'forge: the checks after this edit stopped after %ss; findings so far are below, and the Stop check covers the rest.\n' "${FORGE_EDIT_BUDGET:-45}"
      cat "$FORGE_TMP/report"; } > "$FORGE_TMP/report.over"
    mv "$FORGE_TMP/report.over" "$FORGE_TMP/report"
  fi
fi
[ -s "$FORGE_TMP/report" ] || exit 0
ctx=$(first_lines 20 < "$FORGE_TMP/report" | json_escape)
event=PostToolUse
[ "$(json_get hook_event_name)" = PostToolUseFailure ] && event=PostToolUseFailure
printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$event" "$ctx"
exit 0

