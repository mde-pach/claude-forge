        - pattern: $APP
        - has:
            field: arguments
            has:
              kind: keyword_argument
              regex: ^root_path[[:space:]]*=
metadata:
  forge_where:
    F:
      declared:
        package: fastapi
        name:
          - Query
          - Path
          - Header
          - Cookie
          - Body
          - Form
          - File
    APP:
      type:
        package: fastapi
        name: FastAPI

