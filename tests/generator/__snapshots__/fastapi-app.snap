===== .forge/ast-grep/rules/python/no-stub.yml
# Generated by forge from python/no-stub (mode: forbid).
id: python/no-stub
language: Python
severity: error
message: forge:python/no-stub No stub left behind. A function whose body is only pass or ..., or that raises NotImplementedError, is a stub unless it is abstract, an overload or part of a Protocol (stub files and migrations are exempt).
ignores:
  - "**/*.pyi"
  - alembic/versions/**
  - "**/migrations/[0-9]*.py"
rule:
  all:
    - any:
        - kind: function_definition
          has:
            field: body
            all:
              - has:
                  any:
                    - kind: pass_statement
                    - kind: expression_statement
                      has:
                        kind: ellipsis
              - not:
                  has:
                    not:
                      any:
                        - kind: pass_statement
                        - kind: comment
                        - kind: expression_statement
                          has:
                            any:
                              - kind: ellipsis
                              - kind: string
        - kind: raise_statement
          regex: ^raise\s+NotImplementedError\b
    - not:
        inside:
          stopBy: end
          kind: decorated_definition
          has:
            kind: decorator
            regex: \b(abstractmethod|abstractproperty|overload)\b
    - not:
        inside:
          stopBy: end
          kind: class_definition
          has:
            field: superclasses
            regex: \b(Protocol|ABC)\b

===== .forge/ast-grep/rules/python/no-swallowed-cancel.yml
# Generated by forge from python/no-swallowed-cancel (mode: forbid).
id: python/no-swallowed-cancel
language: Python
severity: error
message: "forge:python/no-swallowed-cancel An except handler that catches asyncio.CancelledError (alone or in a tuple) re-raises it: swallowing it breaks cancellation, timeouts and task group shutdown."
rule:
  kind: except_clause
  has:
    field: value
    any:
      - regex: ^asyncio\.CancelledError(\s+as\s+\w+)?$
      - kind: tuple
        has:
          regex: ^asyncio\.CancelledError$
      - kind: as_pattern
        has:
          kind: tuple
          has:
            regex: ^asyncio\.CancelledError$
      - all:
          - any:
              - regex: ^CancelledError(\s+as\s+\w+)?$
              - kind: tuple
                has:
                  regex: ^CancelledError$
              - kind: as_pattern
                has:
                  kind: tuple
                  has:
                    regex: ^CancelledError$
          - inside:
              kind: module
              stopBy: end
              has:
                kind: import_from_statement
                regex: ^from\s+asyncio\s+import\s[^;]*\bCancelledError\s*(,|\)|$)
  not:
    has:
      kind: raise_statement
      stopBy:
        any:
          - kind: function_definition
          - kind: lambda
          - kind: class_definition

