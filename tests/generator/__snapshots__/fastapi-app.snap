  "roles": {
    "alembic-migrations": [
      "alembic/versions/**"
    ],
    "build-artifacts": [
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/.next/**",
      "**/.nuxt/**",
      "**/.svelte-kit/**",
      "**/.turbo/**",
      "**/.coverage",
      "**/.DS_Store"
    ],
    "django-migrations": [
      "**/migrations/[0-9]*.py"
    ],
    "dockerfile": [
      "**/Dockerfile",
      "**/Dockerfile.*",
      "**/*.Dockerfile",
      "**/Containerfile",
      "!**/*.dockerignore"
    ],
    "env-files": [
      "**/.env",
      "**/.env.*",
      "!**/.env.example",
      "!**/.env.sample",
      "!**/.env.template",
      "!**/.env.dist"
    ],
    "env-template": [
      "**/.env.example",
      "**/.env.sample",
      "**/.env.template",
      "**/.env.dist"
    ],
    "procfile": [
      "Procfile",
      "Procfile.*"
    ],
    "python-tests": [
      "**/test_*.py",
      "**/*_test.py",
      "**/conftest.py"
    ]
  }
}

