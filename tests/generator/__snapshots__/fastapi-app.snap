id: python/sqlalchemy/no-text-fstring
valid:
  - |
    text("SELECT * FROM u WHERE id=:id").bindparams(id=uid)
  - |
    select(User).where(User.id == uid)
  - |
    text("SELECT 1")
invalid:
  - |
    text(f"SELECT * FROM u WHERE id={uid}")
  - |
    text("SELECT * FROM u WHERE id={}".format(uid))
  - |
    sa.text("SELECT * FROM u WHERE id=%s" % uid)

