#!/bin/sh
# Generated by forge. SessionStart: <= 20 lines of repository context.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
IFS='
'

