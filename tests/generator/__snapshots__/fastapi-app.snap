[ ! -f pyproject.toml ] || [ -n "$(forge_toml_get pyproject.toml project requires-python)" ] || { printf 'pyproject.toml: no [project] requires-python; declare the project in a PEP 621 [project] table (name, version, requires-python, dependencies)\n'; false; }
}

