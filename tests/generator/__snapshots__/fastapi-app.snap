# Columns (tab-separated): id, decision, pattern (POSIX ERE on the JSON-escaped command), description.
# Sources: packs/python/sqlalchemy/alembic/rules/downgrade.yaml, packs/python/sqlalchemy/alembic/rules/no-downgrade-base.yaml, packs/python/uv/rules/no-pip.yaml
