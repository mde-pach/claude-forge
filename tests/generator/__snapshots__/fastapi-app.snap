  return 1
}
forge_when_4() { case $1 in models/*|*/models/*|models.py|*/models.py|alembic/versions/*) return 0 ;; esac; return 1; }
forge_check_run_4() {
alembic check
}

# 5. python/sqlalchemy/alembic/migration-lint
forge_check_meta_5() {
  c_id='python/sqlalchemy/alembic/migration-lint'; c_stage=migration; c_tools='alembic'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1
}
forge_scope_5() {
  case $1 in alembic/versions/*) ;; *) return 1 ;; esac
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_5() { case $1 in alembic/versions/*) return 0 ;; esac; return 1; }
forge_check_run_5() {
forge_squawk_alembic $(alembic heads | forge_alembic_files)
