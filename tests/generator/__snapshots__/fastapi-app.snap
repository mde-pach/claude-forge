# 8. python/project-table
forge_check_meta_8() {
  c_id='python/project-table'; c_stage=lint; c_tools=''
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_8() {
  case $1 in pyproject.toml) ;; *) return 1 ;; esac
  return 0
