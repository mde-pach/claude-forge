# ---- end of generated checks

# Check engine (static part). Expects: IFS = newline, FORGE_TMP, FORGE_NCHECKS,
# forge_check_meta_<n>, forge_scope_<n>, forge_when_<n>, forge_check_run_<n>,
# forge_check_changed_<n>, plus tool() and first_lines() from lib.sh.

# forge_exec_tool <name> <args>: runs the project's own <name>; 127 when absent.
forge_exec_tool() {
  _fx_cmd=$(tool "$1")
  [ -n "$_fx_cmd" ] || { printf 'forge: %s not installed\n' "$1" >&2; return 127; }
  shift
  _fx_ifs=$IFS
  IFS=' '
  # shellcheck disable=SC2086
  set -- $_fx_cmd "$@"
  IFS=$_fx_ifs
  "$@"
}

# forge_has_tool <name>: system runtimes (uv, bun) via PATH, others via tool().
forge_has_tool() {
  case $1 in
    uv|bun) command -v "$1" >/dev/null 2>&1 ;;
    *) [ -n "$(tool "$1")" ] ;;
  esac
}

# forge_missing_tool: prints the first tool of $c_tools that is absent.
forge_missing_tool() {
  _fm_ifs=$IFS
  IFS=' '
  for _fm_t in $c_tools; do
    if ! forge_has_tool "$_fm_t"; then IFS=$_fm_ifs; printf '%s' "$_fm_t"; return 0; fi
  done
  IFS=$_fm_ifs
  return 1
}

# forge_filter <predicate>: lines of stdin for which <predicate> <line> succeeds.
forge_filter() {
  while read -r _ff_line; do
    [ -n "$_ff_line" ] && "$1" "$_ff_line" && printf '%s\n' "$_ff_line"
  done
  return 0
}

# forge_db_url: DATABASE_URL from the environment, then .env, then alembic.ini.
forge_db_url() {
  if [ -n "${DATABASE_URL:-}" ]; then printf '%s' "$DATABASE_URL"; return 0; fi
  if [ -f .env ]; then
    _fd_url=$(sed -n 's/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}DATABASE_URL[[:space:]]*=[[:space:]]*//p' .env \
      | tail -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/")
    if [ -n "$_fd_url" ]; then printf '%s' "$_fd_url"; return 0; fi
  fi
  if [ -f alembic.ini ]; then
    sed -n 's/^[[:space:]]*sqlalchemy\.url[[:space:]]*=[[:space:]]*//p' alembic.ini | head -n 1 | sed 's/[[:space:]]*$//'
  fi
}

# forge_local_db: succeeds when the configured database is on this machine
# (localhost, 127.0.0.1, ::1, empty host or a Unix socket).
forge_local_db() {
  _fl_url=$(forge_db_url)
  [ -n "$_fl_url" ] || return 1
  case $_fl_url in *host=/*|*host=%2[Ff]*) return 0 ;; esac
  _fl_host=$(printf '%s' "$_fl_url" | sed -e 's|^[A-Za-z][A-Za-z0-9+.-]*://||' -e 's|[/?].*$||' -e 's|^.*@||')
  case $_fl_host in
    \[*) _fl_host=$(printf '%s' "$_fl_host" | sed 's|^\[\([^]]*\)\].*$|\1|') ;;
    *) _fl_host=$(printf '%s' "$_fl_host" | sed 's|:.*$||') ;;
  esac
  case $_fl_host in ''|localhost|127.0.0.1|::1|%2[Ff]*) return 0 ;; esac
  return 1
}

# forge_related_py_tests <files>: changed test files plus tests/**/test_<module>.py
# for each changed module, one per line.
forge_related_py_tests() {
  for _fr_f in "$@"; do
    case $_fr_f in
      *.py) ;;
      *) continue ;;
    esac
    _fr_b=${_fr_f##*/}
    case $_fr_b in
      test_*.py|*_test.py) [ -f "$_fr_f" ] && printf '%s\n' "$_fr_f" ;;
      __init__.py|conftest.py) ;;
      *) [ -d tests ] && find tests -type f -name "test_${_fr_b%.py}.py" 2>/dev/null ;;
    esac
  done | sort -u
}

# forge_kill_tree <pid>: kills a process and its descendants.
forge_kill_tree() {
  for _fk_c in $(ps -A -o pid= -o ppid= 2>/dev/null | awk -v p="$1" '$2 == p { print $1 }'); do
    forge_kill_tree "$_fk_c"
  done
  kill "$1" 2>/dev/null
}

# forge_exec_check <fn> <timeout>: runs <fn> with output in $FORGE_TMP/out.
forge_exec_check() {
  set -f
  if [ -n "$2" ]; then
    "$1" > "$FORGE_TMP/out" 2>&1 &
    _fe_pid=$!
    ( sleep "$2"; printf 'forge: timed out after %ss\n' "$2" >> "$FORGE_TMP/out"; forge_kill_tree "$_fe_pid" ) >/dev/null 2>&1 &
    _fe_watch=$!
    wait "$_fe_pid" 2>/dev/null
    _fe_rc=$?
    forge_kill_tree "$_fe_watch"
  else
    "$1" > "$FORGE_TMP/out" 2>&1 < /dev/null
    _fe_rc=$?
  fi
  set +f
  return "$_fe_rc"
}

# forge_run_check <n>: one check under check.sh ($mode, $FORGE_TMP/changed, $FORGE_TMP/existing).
forge_run_check() {
  forge_check_meta_"$1"
  FORGE_FILES=''
  if [ "$mode" = --changed ]; then
    if [ "$c_when" = 1 ]; then
      [ -n "$(forge_filter "forge_when_$1" < "$FORGE_TMP/changed")" ] || return 0
    fi
    FORGE_FILES=$(forge_filter "forge_scope_$1" < "$FORGE_TMP/existing")
    [ "$c_when" = 1 ] || [ -n "$FORGE_FILES" ] || return 0
  fi
  if _fc_missing=$(forge_missing_tool); then
    printf 'forge:%s skipped: %s not installed\n' "$c_id" "$_fc_missing"
    return 0
  fi
  if [ "$c_localdb" = 1 ] && ! forge_local_db; then
    printf 'forge:%s skipped: no local database\n' "$c_id"
    return 0
  fi
  _fc_fn=forge_check_run_$1
  if [ "$mode" = --changed ] && [ "$c_changed" = 1 ] && [ -n "$FORGE_FILES" ]; then _fc_fn=forge_check_changed_$1; fi
  if forge_exec_check "$_fc_fn" "$c_timeout"; then
    grep '^forge:' "$FORGE_TMP/out"
    return 0
  fi
  printf 'forge:%s failed\n' "$c_id"
  first_lines 15 < "$FORGE_TMP/out"
  return 1
}

# forge_run_stage <stage>: every check of <stage>; fails if one fails.
forge_run_stage() {
  _fs_i=1
  _fs_rc=0
  while [ "$_fs_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fs_i"
    if [ "$c_stage" = "$1" ]; then
      forge_run_check "$_fs_i" || _fs_rc=1
    fi
    _fs_i=$((_fs_i + 1))
  done
  [ "$_fs_rc" -eq 0 ] || fail=1
  return "$_fs_rc"
}

# forge_file_stage <stage> <file>: the {files} form of each in-scope check of
# <stage>, on one file (PostToolUse). Prints failures; absent tools are skipped.
forge_file_stage() {
  _fp_i=1
  _fp_rc=0
  FORGE_FILES=$2
  while [ "$_fp_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fp_i"
    if [ "$c_stage" = "$1" ] && [ "$c_files" = 1 ] && forge_scope_"$_fp_i" "$2" && ! forge_missing_tool >/dev/null; then
      if ! forge_exec_check "forge_check_changed_$_fp_i" "$c_timeout"; then
        printf 'forge:%s\n' "$c_id"
        first_lines 15 < "$FORGE_TMP/out"
        _fp_rc=1
      fi
    fi
    _fp_i=$((_fp_i + 1))
  done
  return "$_fp_rc"
}

# forge_typecheck <file>: the full run of each typecheck check whose scope covers <file>.
forge_typecheck() {
  _ft_i=1
  _ft_rc=0
  while [ "$_ft_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_ft_i"
    if [ "$c_stage" = typecheck ] && forge_scope_"$_ft_i" "$1" && ! forge_missing_tool >/dev/null; then
      if ! forge_exec_check "forge_check_run_$_ft_i" "$c_timeout"; then
        printf 'forge:%s\n' "$c_id"
        first_lines 19 < "$FORGE_TMP/out"
        _ft_rc=1
      fi
    fi
    _ft_i=$((_ft_i + 1))
  done
  return "$_ft_rc"
}

# forge_required_tools: every tool the checks use, one per line.
forge_required_tools() {
  _fq_i=1
  while [ "$_fq_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fq_i"
    printf '%s\n' "$c_tools" | tr ' ' '\n'
    _fq_i=$((_fq_i + 1))
  done | awk 'NF && !seen[$0]++'
}

FORGE_FORBID='python/fastapi/no-on-event|python/pydantic/v2-api|python/pytest/no-test-env-branch|python/sqlalchemy/mapped-column|python/sqlalchemy/no-backref|python/sqlalchemy/no-declarative-base|python/sqlalchemy/no-query-api|python/sqlalchemy/no-raw-execute'
FORGE_NO_INCREASE='python/pytest/no-new-skip'
FORGE_NO_DECREASE='python/pytest/no-fewer-asserts'

forge_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{ print $1 }'
  else openssl dgst -sha256 -r | awk '{ print $1 }'
  fi
}

# Changed files (staged, unstaged, untracked), one per line; renames give the new path.
git status --porcelain --untracked-files=all 2>/dev/null \
  | sed -e 's/^...//' -e 's/^.* -> //' -e 's/^"\(.*\)"$/\1/' | sort -u > "$FORGE_TMP/changed"
: > "$FORGE_TMP/existing"
while read -r f; do [ -f "$f" ] && printf '%s\n' "$f" >> "$FORGE_TMP/existing"; done < "$FORGE_TMP/changed"
if [ "$mode" = --all ]; then
  git ls-files --cached --others --exclude-standard 2>/dev/null | sort -u > "$FORGE_TMP/scope"
  : > "$FORGE_TMP/scope.tmp"
  while read -r f; do [ -f "$f" ] && printf '%s\n' "$f" >> "$FORGE_TMP/scope.tmp"; done < "$FORGE_TMP/scope"
  mv "$FORGE_TMP/scope.tmp" "$FORGE_TMP/scope"
else
  cp "$FORGE_TMP/existing" "$FORGE_TMP/scope"
fi

fail=0
report() { printf 'forge:%s %s\n' "$1" "$2"; fail=1; }

# 1. Integrity: owned files match .forge/forge.lock.json.
forge_integrity() {
  lock=.forge/forge.lock.json
  [ -f "$lock" ] || { report forge/integrity "$lock is missing"; return; }
  awk '/^  "files": \{/ { f = 1; next } f && /^  \}/ { exit }
       f { line = $0; sub(/^[[:space:]]*"/, "", line); split(line, a, "\": \""); h = a[2]; sub(/".*/, "", h); print a[1] "\t" h }' "$lock" \
    > "$FORGE_TMP/owned"
  while IFS='	' read -r path hash; do
    [ -n "$path" ] || continue
    case $path in .forge/*|.claude/*) ;; *) continue ;; esac
    if [ ! -f "$path" ]; then report forge/integrity "$path is missing (run forge apply)"
    elif [ "$(forge_sha256 < "$path")" != "$hash" ]; then report forge/integrity "$path was modified (run forge diff)"
    fi
  done < "$FORGE_TMP/owned"
  { find .forge .claude/skills/forge-project -type f 2>/dev/null; find .claude/rules -name 'forge-*.md' -type f 2>/dev/null; } \
    | sed 's|^\./||' | while read -r path; do
      case $path in .forge/state/*|.forge/rules/*|.forge/forge.lock.json) continue ;; esac
      grep -q "^$path	" "$FORGE_TMP/owned" || printf 'forge:forge/integrity %s is not a forge file (remove it or run forge apply)\n' "$path"
    done > "$FORGE_TMP/extra"
  if [ -s "$FORGE_TMP/extra" ]; then cat "$FORGE_TMP/extra"; fail=1; fi
}

# 2. Applied migrations are never modified or deleted.
forge_applied_migrations() {
  git rev-parse --verify -q HEAD >/dev/null || return
  git diff --name-only --diff-filter=MD HEAD -- alembic/versions prisma/migrations 2>/dev/null > "$FORGE_TMP/mig"
  while read -r f; do
    case $f in prisma/migrations/migration_lock.toml) continue ;; esac
    report forge/applied-migration "$f exists at HEAD and was modified or deleted; write a new migration instead"
  done < "$FORGE_TMP/mig"
}

# 3. Tests: no deleted test files; ast-grep counts compared with HEAD.
forge_tests_integrity() {
  git rev-parse --verify -q HEAD >/dev/null || return
  git diff --name-only --diff-filter=D HEAD 2>/dev/null > "$FORGE_TMP/deleted"
  while read -r f; do
    case $f in
      test_*.py|*/test_*.py|*_test.py|*/conftest.py|conftest.py|tests/*|*.test.*|*.spec.*|*/__tests__/*|e2e/*)
        report forge/deleted-test "$f was deleted" ;;
    esac
  done < "$FORGE_TMP/deleted"
  ids=$FORGE_NO_INCREASE
  [ -n "$FORGE_NO_DECREASE" ] && ids="${ids:+$ids|}$FORGE_NO_DECREASE"
  [ -n "$ids" ] && [ -s "$FORGE_TMP/existing" ] || return
  mkdir -p "$FORGE_TMP/head"
  : > "$FORGE_TMP/athead"
  while read -r f; do
    git cat-file -e "HEAD:$f" 2>/dev/null || continue
    mkdir -p "$FORGE_TMP/head/$(dirname "$f")"
    git show "HEAD:$f" > "$FORGE_TMP/head/$f" 2>/dev/null && printf '%s\n' "$f" >> "$FORGE_TMP/athead"
  done < "$FORGE_TMP/existing"
  forge_counts "$FORGE_ROOT" "$ids" "$FORGE_TMP/existing" > "$FORGE_TMP/now" || return
  if [ -s "$FORGE_TMP/athead" ]; then
    forge_counts "$FORGE_TMP/head" "$ids" "$FORGE_TMP/athead" > "$FORGE_TMP/then" || return
  else
    : > "$FORGE_TMP/then"
  fi
  awk -F '\t' -v inc="$FORGE_NO_INCREASE" -v dec="$FORGE_NO_DECREASE" '
    BEGIN { n = split(inc, a, "|"); for (i = 1; i <= n; i++) if (a[i] != "") mi[a[i]] = 1
            n = split(dec, b, "|"); for (i = 1; i <= n; i++) if (b[i] != "") md[b[i]] = 1 }
    FILENAME == ARGV[1] { then[$1 "\t" $2] = $3; keys[$1 "\t" $2] = 1; next }
    { now[$1 "\t" $2] = $3; keys[$1 "\t" $2] = 1 }
    END {
      for (k in keys) {
        split(k, p, "\t"); t = then[k] + 0; w = now[k] + 0
        if ((p[1] in mi) && w > t) printf "forge:%s %s: %d -> %d\n", p[1], p[2], t, w
        if ((p[1] in md) && w < t) printf "forge:%s %s: %d -> %d\n", p[1], p[2], t, w
      }
    }' "$FORGE_TMP/then" "$FORGE_TMP/now" | sort > "$FORGE_TMP/countfail"
  if [ -s "$FORGE_TMP/countfail" ]; then cat "$FORGE_TMP/countfail"; fail=1; fi
}

# forge_counts <dir> <id-regex> <file-list>: "rule<TAB>file<TAB>count" lines.
forge_counts() {
  set -f
  # shellcheck disable=SC2046
  ( cd "$1" && astgrep scan -c "$FORGE_ROOT/.forge/ast-grep/sgconfig.yml" --filter "^($2)\$" --json=stream $(cat "$3") ) > "$FORGE_TMP/json"
  rc=$?
  set +f
  if [ "$rc" -gt 1 ]; then printf 'forge:forge/ast-grep skipped: ast-grep unavailable\n'; return 1; fi
  grep -oE '"(file|ruleId)":"[^"]*"' "$FORGE_TMP/json" \
    | awk -F '"' '$2 == "file" { f = $4 } $2 == "ruleId" { c[$4 "\t" f]++ } END { for (k in c) print k "\t" c[k] }'
}

# 4. ast-grep forbid rules.
forge_forbid() {
  [ -n "$FORGE_FORBID" ] && [ -s "$FORGE_TMP/scope" ] || return
  set -f
  # shellcheck disable=SC2046
  astgrep scan -c .forge/ast-grep/sgconfig.yml --filter "^($FORGE_FORBID)\$" --report-style short $(cat "$FORGE_TMP/scope") > "$FORGE_TMP/forbid"
  rc=$?
  set +f
  if [ "$rc" -gt 1 ]; then printf 'forge:forge/ast-grep skipped: ast-grep unavailable\n'; return; fi
  grep -E '^[^[:space:]]+:[0-9]+:[0-9]+: ' "$FORGE_TMP/forbid" \
    | sed -E 's/^([^[:space:]]+:[0-9]+:[0-9]+): [a-z]+\[[^]]*\]: forge:([^[:space:]]+) (.*)$/forge:\2 \1 \3/' > "$FORGE_TMP/forbid.out"
  if [ -s "$FORGE_TMP/forbid.out" ]; then cat "$FORGE_TMP/forbid.out"; fail=1; fi
}

forge_step() { [ "$fail" -eq 0 ] || exit 1; "$@"; }

forge_step forge_integrity
forge_step forge_applied_migrations
forge_step forge_tests_integrity
forge_step forge_forbid
forge_step forge_run_stage format
forge_step forge_run_stage lint
forge_step forge_run_stage typecheck
forge_step forge_run_stage migration
forge_step forge_run_stage test
exit "$fail"

===== .forge/forge.lock.json
{
  "forge_version": "0.5.0",
  "claude_code_min": "2.1.295",
  "rules": {
    "python/fastapi/no-on-event": "b271f0c2fcd5a098e169a20049f3734d1e74c555ef94815f85965c0f89dd13b7",
    "python/format": "fd46e92c06dbf81851e83e9d40480ad52de712639efe6da2b3d4fe8ced623f17",
    "python/lint": "0255bf33a2439c3da26ea8d866731f8661045ca212d5e4037d16367be2d2ecfe",
    "python/no-bare-except": "1ea911085040c162828227d499b90871d6a395de928351c6bd4b1843c31b26ca",
    "python/no-explicit-any": "937b83f85a06043eec64d4a4aa2c8f237dac489a974924875b80daacd5a1c292",
    "python/pydantic/v2-api": "530f46e310f2bd30f6347d75b3a2243922cb5aeef921df69c2314e399473e4eb",
