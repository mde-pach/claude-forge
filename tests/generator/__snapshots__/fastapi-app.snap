===== .forge/ast-grep/rules/python/archive-extract.yml
# Generated by forge from python/archive-extract (mode: forbid).
id: python/archive-extract
language: Python
severity: error
message: 'forge:python/archive-extract TarFile.extractall() / extract() and shutil.unpack_archive() pass filter= (normally "data"): without it a crafted archive writes outside the target directory (absolute paths, .., links). zipfile sanitises its paths itself.'
rule:
  kind: call
  any:
    - pattern: $T.extractall($$$)
    - pattern: $T.extract($$$)
    - pattern: $U($$$)
      has:
        field: function
        regex: unpack_archive$
  not:
    has:
      field: arguments
      has:
        kind: keyword_argument
        regex: ^filter[[:space:]]*=
metadata:
  forge_where:
    T:
      type:
        module: tarfile
        name: TarFile
    U:
      declared:
        module: shutil
        name: unpack_archive

===== .forge/ast-grep/rules/python/contextmanager-finally.yml
# Generated by forge from python/contextmanager-finally (mode: forbid).
id: python/contextmanager-finally
language: Python
severity: error
message: "forge:python/contextmanager-finally In a @contextmanager / @asynccontextmanager function, a yield followed by cleanup sits in try/finally (or inside a with): otherwise an exception in the with body skips the cleanup."
rule:
  kind: expression_statement
  any:
    - has:
        kind: yield
    - has:
        kind: assignment
        has:
          field: right
          kind: yield
  precedes:
    not:
      kind: comment
    stopBy: neighbor
  inside:
    kind: block
    stopBy: neighbor
    inside:
      kind: function_definition
      stopBy: neighbor
      inside:
        kind: decorated_definition
        stopBy: neighbor
        has:
          kind: decorator
          regex: ^@(contextlib\.)?(async)?contextmanager$

===== .forge/ast-grep/rules/python/fastapi/basic-auth-compare-digest.yml
# Generated by forge from python/fastapi/basic-auth-compare-digest (mode: forbid).
id: python/fastapi/basic-auth-compare-digest
language: Python
severity: error
message: forge:python/fastapi/basic-auth-compare-digest HTTP Basic credentials (HTTPBasicCredentials.username / .password) are compared with secrets.compare_digest, never == or !=, which leak through timing how much of the value matched.
