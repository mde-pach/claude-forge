#!/bin/sh
# Generated by forge. PostToolUse(Edit|Write): formats the edited file silently,
# lints it and runs the ast-grep forbid rules on it. Findings go back to Claude
# as additionalContext (<= 20 lines). Nothing on success.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
file=$(json_get file_path)
[ -n "$file" ] || exit 0
file=$(rel_path "$file") || exit 0
[ -f "$file" ] || exit 0
case $file in .forge/*|.claude/*|.git/*|node_modules/*|.venv/*) exit 0 ;; esac
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-edit.XXXXXX") || exit 0
trap 'rm -rf "$FORGE_TMP"' EXIT HUP INT TERM

# ---- generated checks
# Project tools used in check commands, resolved through tool().
ruff() { forge_exec_tool ruff "$@"; }
basedpyright() { forge_exec_tool basedpyright "$@"; }
alembic() { forge_exec_tool alembic "$@"; }
pytest() { forge_exec_tool pytest "$@"; }
FORGE_NCHECKS=8

# 1. python/format
forge_check_meta_1() {
  c_id='python/format'; c_stage=format; c_tools='ruff'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1
}
forge_scope_1() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_1() { return 1; }
forge_check_run_1() {
ruff format --check .
}
forge_check_changed_1() {
ruff format $FORGE_FILES
}

# 2. python/lint
forge_check_meta_2() {
  c_id='python/lint'; c_stage=lint; c_tools='ruff'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1
}
forge_scope_2() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_2() { return 1; }
forge_check_run_2() {
ruff check .
}
forge_check_changed_2() {
ruff check --output-format concise $FORGE_FILES
}

# 3. python/pytest/run
forge_check_meta_3() {
  c_id='python/pytest/run'; c_stage=test; c_tools='pytest'
  c_when=0; c_localdb=0; c_timeout=300
  c_changed=1; c_files=1
}
forge_scope_3() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_3() { return 1; }
forge_check_run_3() {
pytest -q
}
forge_check_changed_3() {
if grep -qi "pytest-testmon" pyproject.toml uv.lock 2>/dev/null; then pytest -q --testmon; else set -- $(forge_related_py_tests $FORGE_FILES); [ "$#" -eq 0 ] || pytest -q "$@"; fi
}

# 4. python/sqlalchemy/alembic/check
forge_check_meta_4() {
  c_id='python/sqlalchemy/alembic/check'; c_stage=migration; c_tools='alembic'
  c_when=1; c_localdb=1; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_4() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_4() { case $1 in models/*|*/models/*|models.py|*/models.py|alembic/versions/*) return 0 ;; esac; return 1; }
forge_check_run_4() {
alembic check
}

# 5. python/sqlalchemy/alembic/migration-lint
forge_check_meta_5() {
  c_id='python/sqlalchemy/alembic/migration-lint'; c_stage=migration; c_tools='alembic'
