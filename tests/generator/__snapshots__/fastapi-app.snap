#!/bin/sh
# Generated by forge. PostToolUse(Edit|Write): formats the edited file silently,
# lints it and runs the ast-grep forbid rules on it. Findings on lines added
# during this turn (or since HEAD, before the first prompt) go back to Claude as
# additionalContext (<= 20 lines). Nothing on success.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
file=$(json_get file_path)
[ -n "$file" ] || exit 0
file=$(rel_path "$file") || exit 0
[ -f "$file" ] || exit 0
case $file in .forge/*|.claude/*|.git/*|node_modules/*|.venv/*) exit 0 ;; esac
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-edit.XXXXXX") || exit 0
trap 'rm -rf "$FORGE_TMP"' EXIT HUP INT TERM

# ---- generated checks
# Project tools used in check commands, resolved through tool().
ruff() { forge_exec_tool ruff "$@"; }
basedpyright() { forge_exec_tool basedpyright "$@"; }
alembic() { forge_exec_tool alembic "$@"; }
pytest() { forge_exec_tool pytest "$@"; }
python() { forge_exec_tool python "$@"; }
FORGE_NCHECKS=11

