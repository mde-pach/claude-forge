#!/bin/sh
# Generated by forge. PostToolUse(Edit|Write|Bash) and PostToolUseFailure(Bash),
# asyncRewake: project typecheck,
# when the edited file (or, for Bash, a file the command changed, as listed by
# post-edit.sh) is in a typecheck's scope.
# Errors in files changed during the turn: exit 2 with <= 20 lines on stderr;
# errors only in other files are not Claude's and stay silent. Skips if a typecheck is already
# running (lock directory in .forge/state/, taken over when its pid is gone).
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
if [ "$(json_get tool_name)" = Bash ]; then
  # post-edit.sh (run alongside) writes the files the command changed
  key=$(bash_key) || exit 0
  list=$(bash_state)/$key.files
  _tc_w=0
  while [ ! -f "$list" ] && [ -f "$(bash_state)/$key.tree" ] && [ "$_tc_w" -lt 60 ]; do sleep 1; _tc_w=$((_tc_w + 1)); done
  [ -f "$list" ] || exit 0
  files=$(cat "$list")
  rm -f "$list"
else
  files=$(json_get file_path)
  [ -n "$files" ] || exit 0
  files=$(rel_path "$files") || exit 0
  case $files in .forge/*|.claude/*|.git/*|node_modules/*|.venv/*) exit 0 ;; esac
fi
IFS='
'

# ---- generated checks
# Project tools used in check commands, resolved through tool().
ruff() { forge_exec_tool ruff "$@"; }
basedpyright() { forge_exec_tool basedpyright "$@"; }
alembic() { forge_exec_tool alembic "$@"; }
pytest() { forge_exec_tool pytest "$@"; }
python() { forge_exec_tool python "$@"; }
FORGE_NCHECKS=16

# 1. python/config-ratchet
forge_check_meta_1() {
  c_id='python/config-ratchet'; c_stage=lint; c_tools='python'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0
}
forge_scope_1() {
  case $1 in pyproject.toml|*/pyproject.toml|ruff.toml|*/ruff.toml|.ruff.toml|*/.ruff.toml|pyrightconfig.json|*/pyrightconfig.json) ;; *) return 1 ;; esac
  return 0
}
forge_when_1() { case $1 in pyproject.toml|*/pyproject.toml|ruff.toml|*/ruff.toml|.ruff.toml|*/.ruff.toml|pyrightconfig.json|*/pyrightconfig.json) return 0 ;; esac; return 1; }
forge_check_run_1() {
forge_ratchet python ratchet.py
}

# 2. python/env-example
forge_check_meta_2() {
  c_id='python/env-example'; c_stage=lint; c_tools=''
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0
}
forge_scope_2() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_2() { return 1; }
forge_check_run_2() {
forge_env_example py
}

# 3. python/format
forge_check_meta_3() {
  c_id='python/format'; c_stage=format; c_tools='ruff'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1; c_fix=0
}
forge_scope_3() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_3() { return 1; }
forge_check_run_3() {
ruff format --check .
}
forge_check_changed_3() {
ruff format $FORGE_FILES
}

# 4. python/lint
forge_check_meta_4() {
  c_id='python/lint'; c_stage=lint; c_tools='ruff'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1; c_fix=1
}
forge_scope_4() {
  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_4() { return 1; }
forge_check_run_4() {
ruff check .
}
forge_check_changed_4() {
ruff check --output-format concise $FORGE_FILES
}
forge_check_fix_4() {
ruff check --fix --fixable I,UP --exit-zero --show-fixes --output-format concise $FORGE_FILES
}

# 5. python/pytest/no-test-edits
