===== .forge/ast-grep/rules/python/contextmanager-finally.yml
# Generated by forge from python/contextmanager-finally (mode: forbid).
id: python/contextmanager-finally
language: Python
severity: error
message: "forge:python/contextmanager-finally In a @contextmanager / @asynccontextmanager function, a yield followed by cleanup sits in try/finally (or inside a with): otherwise an exception in the with body skips the cleanup."
rule:
  kind: expression_statement
  any:
    - has:
        kind: yield
    - has:
        kind: assignment
        has:
          field: right
          kind: yield
  precedes:
    not:
      kind: comment
    stopBy: neighbor
  inside:
    kind: block
    stopBy: neighbor
    inside:
      kind: function_definition
      stopBy: neighbor
      inside:
        kind: decorated_definition
        stopBy: neighbor
        has:
          kind: decorator
          regex: ^@(contextlib\.)?(async)?contextmanager$

===== .forge/ast-grep/rules/python/fastapi/basic-auth-compare-digest.yml
# Generated by forge from python/fastapi/basic-auth-compare-digest (mode: forbid).
id: python/fastapi/basic-auth-compare-digest
language: Python
severity: error
message: forge:python/fastapi/basic-auth-compare-digest HTTP Basic credentials (HTTPBasicCredentials.username / .password) are compared with secrets.compare_digest, never == or !=, which leak through timing how much of the value matched.
rule:
  kind: comparison_operator
  regex: (==|!=)
  has:
    any:
      - pattern: $C.password
      - pattern: $C.username
metadata:
  forge_where:
    C:
      type:
        package: fastapi
        name: HTTPBasicCredentials

===== .forge/ast-grep/rules/python/fastapi/cors-credentials-wildcard.yml
# Generated by forge from python/fastapi/cors-credentials-wildcard (mode: forbid).
id: python/fastapi/cors-credentials-wildcard
language: Python
severity: error
message: forge:python/fastapi/cors-credentials-wildcard CORS never combines allow_origins=["*"] with allow_credentials=True. List the allowed origins.
rule:
  pattern: $APP.add_middleware(CORSMiddleware, $$$)
  all:
    - has:
        stopBy: end
        kind: keyword_argument
        regex: ^allow_origins[[:space:]]*=[[:space:]]*\[[[:space:]]*["']\*["'][[:space:]]*,?[[:space:]]*\]$
    - has:
        stopBy: end
        kind: keyword_argument
        regex: ^allow_credentials[[:space:]]*=[[:space:]]*True$

===== .forge/ast-grep/rules/python/fastapi/deprecated-params.yml
# Generated by forge from python/fastapi/deprecated-params (mode: forbid).
id: python/fastapi/deprecated-params
language: Python
severity: error
message: forge:python/fastapi/deprecated-params No FastAPI parameters deprecated only at run time. Query/Path/Header/Cookie/Body/Form/File take pattern= (not regex=) and examples= or openapi_examples= (not example=); FastAPI() takes no root_path= (pass --root-path to fastapi run or uvicorn).
rule:
  kind: call
  any:
    - all:
        - pattern: $F($$$)
        - has:
            field: arguments
            has:
              kind: keyword_argument
              regex: ^(regex|example)[[:space:]]*=
    - all:
        - pattern: $APP
        - has:
            field: arguments
            has:
              kind: keyword_argument
              regex: ^root_path[[:space:]]*=
metadata:
  forge_where:
    F:
      declared:
        package: fastapi
        name:
          - Query
          - Path
          - Header
          - Cookie
          - Body
          - Form
          - File
    APP:
      type:
        package: fastapi
        name: FastAPI

