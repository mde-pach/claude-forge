# 23. python/sqlalchemy/asyncio-extra
forge_check_meta_23() {
  c_id='python/sqlalchemy/asyncio-extra'; c_stage=lint; c_tools='uv'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_23() {
  return 0
}
forge_when_23() { case $1 in pyproject.toml|*/pyproject.toml|requirements*.txt|*/requirements*.txt|*.py|*/*.py) return 0 ;; esac; return 1; }
forge_check_run_23() {
git grep -q --untracked -E '^[[:space:]]*(from[[:space:]]+sqlalchemy\.ext\.asyncio[[:space:]]|import[[:space:]]+sqlalchemy\.ext\.asyncio|from[[:space:]]+sqlalchemy\.ext[[:space:]]+import[[:space:]].*asyncio)' -- '*.py' || return 0
git ls-files -z --cached --others --exclude-standard -- pyproject.toml '*/pyproject.toml' 'requirements*.txt' '*/requirements*.txt' | xargs -0 grep -qiE 'sqlalchemy[[:space:]]*\[[^]]*asyncio|(^|["'"'"'[:space:]])greenlet([^A-Za-z0-9_.-]|$)' /dev/null && return 0
echo 'sqlalchemy.ext.asyncio is imported but no pyproject.toml or requirements*.txt declares sqlalchemy[asyncio] (or greenlet): uv add "sqlalchemy[asyncio]"'
return 1

}

