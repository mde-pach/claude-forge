  case $1 in *.py|*.pyi) return 0 ;; esac
  return 1
}
forge_when_5() { case $1 in alembic/versions/*) return 0 ;; esac; return 1; }
forge_check_run_5() {
forge_squawk_alembic $(alembic heads | forge_alembic_files)
}
forge_check_changed_5() {
