# Generated by forge from python/fastapi/cors-credentials-wildcard (mode: forbid).
id: python/fastapi/cors-credentials-wildcard
language: Python
severity: error
message: forge:python/fastapi/cors-credentials-wildcard CORS never combines allow_origins=["*"] with allow_credentials=True. List the allowed origins.
rule:
  pattern: $APP.add_middleware(CORSMiddleware, $$$)
  all:
    - has:
        stopBy: end
        kind: keyword_argument
        regex: ^allow_origins[[:space:]]*=[[:space:]]*\[[[:space:]]*["']\*["'][[:space:]]*,?[[:space:]]*\]$
    - has:
        stopBy: end
        kind: keyword_argument
        regex: ^allow_credentials[[:space:]]*=[[:space:]]*True$

