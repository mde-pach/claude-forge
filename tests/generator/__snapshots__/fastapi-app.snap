===== .forge/ast-grep/rule-tests/python-pytest-no-mock-increase-test.yml
id: python/pytest/no-mock-increase
valid:
  - |
    def test_update(client) -> None:
        r = client.patch("/items/1", json={"name": "x"})
        assert r.status_code == 200
  - |
    def test_env(monkeypatch) -> None:
        monkeypatch.setenv("TZ", "UTC")
        assert tz() == "UTC"
  - |
    def test_charge(fake_gateway) -> None:
        charge(gateway=fake_gateway)
        assert fake_gateway.charged == 1
  - |
    def test_debug(monkeypatch) -> None:
        monkeypatch.setattr(settings, "DEBUG", True)
        monkeypatch.setitem(app.config, "TESTING", True)
        assert debug_page().status_code == 200
  - |
    from requests import Session as S


    def test_session() -> None:
        s = S()
        assert s.patch is not None
invalid:
  - |
    from unittest.mock import patch


    @patch("app.billing.stripe")
    def test_charge(stripe) -> None:
        charge()
  - |
    from unittest.mock import AsyncMock


    async def test_send() -> None:
        client = AsyncMock()
        await send(client)
  - |
    def test_charge(mocker) -> None:
        mocker.patch.object(Billing, "pay")
        charge()
  - |
    from unittest.mock import patch as p


    def test_charge() -> None:
        with p("app.billing.stripe"):
            charge()
  - |
    import unittest.mock as um


    def test_charge() -> None:
        with um.patch.object(Billing, "pay"):
            charge()
  - |
    from unittest import mock as m


    def test_charge() -> None:
        gateway = m.MagicMock()
        charge(gateway)
  - |
    from unittest.mock import create_autospec


    def test_charge() -> None:
        gateway = create_autospec(Gateway)
        charge(gateway)
  - |
    from unittest.mock import patch


    def test_charge() -> None:
        with patch.multiple("app.billing", pay=None, refund=None):
            charge()
  - |
    def test_charge(mocker) -> None:
        spy = mocker.spy(billing, "pay")
        charge()
        assert spy.call_count == 1

