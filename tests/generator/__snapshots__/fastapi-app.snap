===== .forge/helpers/fk_index.py
# Generated by forge. Foreign key columns a change adds to SQLAlchemy models get an
# index that leads with them (run by .forge/check.sh with the project's own Python,
# as advice). Usage:
#   python fk_index.py <forge-tmp>
# For each changed .py file: the foreign key columns of each declarative class
# (mapped_column(...) / Column(...) with a ForeignKey(...) argument, or a
# ForeignKeyConstraint in __table_args__) and each Table(...) call that were not in
# the base copy, and that no index leads with: index=True or unique=True on the
# column, primary_key=True when it is the table's first primary key column, or an
# Index / UniqueConstraint / PrimaryKeyConstraint whose first column it is.
# Exit 0: nothing found; 1: findings printed ("path:line message").
import ast
import os
import sys

TMP = sys.argv[1]


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def lines(name):
    return [l for l in (read(os.path.join(TMP, name)) or "").splitlines() if l]


def parse(text):
    try:
        return ast.parse(text or "")
    except (SyntaxError, ValueError):
        return None


def last(node):
    if isinstance(node, ast.Attribute):
        return node.attr
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Call):
        return last(node.func)
    return ""


def col_ref(node):
    """A column named by a string, a Name or an attribute (Post.author_id, author_id)."""
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value.split(".")[-1]
    if isinstance(node, (ast.Name, ast.Attribute)):
        return last(node)
    return None


def kw(call, name):
    return any(k.arg == name and isinstance(k.value, ast.Constant) and k.value.value is True for k in call.keywords)


def has_fk(call):
    return any(isinstance(a, ast.Call) and last(a.func) == "ForeignKey" for a in call.args)


class Table:
    def __init__(self, name, line):
        self.name, self.line = name, line
        self.fks = {}  # column -> line
        self.leading = set()
        self.pks = []

    def column(self, name, call):
        if has_fk(call) and name not in self.fks:
            self.fks[name] = call.lineno
        if kw(call, "index") or kw(call, "unique"):
            self.leading.add(name)
        if kw(call, "primary_key"):
            self.pks.append(name)

    def constraint(self, call):
        kind = last(call.func)
        args = call.args[1:] if kind == "Index" else call.args
        if kind == "ForeignKeyConstraint":
            if call.args and isinstance(call.args[0], (ast.List, ast.Tuple)) and call.args[0].elts:
                name = col_ref(call.args[0].elts[0])
                if name and name not in self.fks:
                    self.fks[name] = call.lineno
            return
        if kind in ("Index", "UniqueConstraint", "PrimaryKeyConstraint") and args:
            name = col_ref(args[0])
            if name:
                self.leading.add(name)

    def unindexed(self):
        lead = set(self.leading)
        if self.pks:
            lead.add(self.pks[0])
        return {c: l for c, l in self.fks.items() if c not in lead}


def tables(tree):
    out = {}
    for node in ast.walk(tree):
        if isinstance(node, ast.ClassDef):
            t = Table(node.name, node.lineno)
            for stmt in node.body:
                targets, value = [], None
                if isinstance(stmt, ast.Assign):
                    targets, value = stmt.targets, stmt.value
                elif isinstance(stmt, ast.AnnAssign):
                    targets, value = [stmt.target], stmt.value
                for target in targets:
                    if not isinstance(target, ast.Name) or value is None:
                        continue
                    if target.id == "__table_args__":
                        for sub in ast.walk(value):
                            if isinstance(sub, ast.Call):
                                t.constraint(sub)
                    elif isinstance(value, ast.Call) and last(value.func) in ("mapped_column", "Column"):
                        named = value.args[0] if value.args and isinstance(value.args[0], ast.Constant) and isinstance(value.args[0].value, str) else None
                        t.column(named.value if named else target.id, value)
            if t.fks:
                out["class " + node.name] = t
        elif isinstance(node, ast.Call) and last(node.func) == "Table" and node.args:
            name = col_ref(node.args[0]) or "?"
            t = Table(name, node.lineno)
            for a in node.args[1:]:
                if isinstance(a, ast.Call) and last(a.func) == "Column" and a.args and isinstance(a.args[0], ast.Constant):
                    t.column(a.args[0].value, a)
                elif isinstance(a, ast.Call):
                    t.constraint(a)
            if t.fks:
                out["table " + name] = t
    return out


def main():
    found = []
    inbase = set(lines("inbase"))
    for path in lines("changed"):
        if not path.endswith(".py") or "/versions/" in path:
            continue
        tree = parse(read(path))
        if tree is None:
            continue
        base = {}
        if path in inbase:
            bt = parse(read(os.path.join(TMP, "base", path)))
            base = tables(bt) if bt is not None else {}
        for key, t in tables(tree).items():
            old = base.get(key)
            for col, line in sorted(t.unindexed().items(), key=lambda x: x[1]):
                if old is not None and col in old.fks:
                    continue
                found.append(f"{path}:{line} foreign key column {col} has no index that leads with it; PostgreSQL and SQLite do not index referencing columns, so joins on it and deletes of the referenced rows scan the table. If it is queried or the parent rows are deleted, add index=True (or an Index whose first column it is); otherwise say why not.")
    for f in found:
        print(f)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())

===== .forge/helpers/ratchet.py
# Generated by forge. Config ratchet for Python tool configs (run by .forge/check.sh
# with the project's own Python, 3.11+): compares each changed file with its copy in
# the base and prints one line per loosened setting. Usage:
#   python ratchet.py <base-dir> <path>...
# Exit 0: nothing loosened; 1: findings printed; 3: cannot run ("skipped: …" printed).
import json
import re
import sys

try:
    import tomllib
except ImportError:
    print("skipped: tomllib needs Python 3.11+")
    sys.exit(3)

findings = []


def out(path, what):
    findings.append(f"{path}: {what}")


def show(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if v is None:
        return "unset"
    if isinstance(v, (list, tuple)):
        return "[" + ", ".join(show(x) for x in v) + "]"
    return str(v).replace('"', "").replace("\\", "/")


def as_list(v):
    if v is None:
        return []
    return list(v) if isinstance(v, (list, tuple)) else [v]


def strip_jsonc(text):
    """JSON with comments and trailing commas -> JSON."""
    out_, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out_.append(c)
            if c == "\\" and i + 1 < n:
                out_.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out_.append(c)
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            i = n if end < 0 else end + 2
            continue
        else:
            out_.append(c)
        i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out_))


# ---- ruff

def covered(code, selectors):
    return any(s == "ALL" or code.startswith(s) for s in selectors)


def ruff(path, before, after, prefix=""):
    def lint(cfg):
        return {**{k: v for k, v in cfg.items() if k != "lint"}, **(cfg.get("lint") or {})}

    b, a = lint(before), lint(after)
    for key in ("select", "extend-select"):
        new = as_list(a.get("select")) + as_list(a.get("extend-select"))
        for code in as_list(b.get(key)):
            if not covered(code, new):
                out(path, f"{prefix}lint.{key} no longer selects {code}")
    for key in ("ignore", "extend-ignore"):
        for code in as_list(a.get(key)):
            if code not in as_list(b.get(key)):
                out(path, f"{prefix}lint.{key} adds {code}")
    for key in ("per-file-ignores", "extend-per-file-ignores"):
        bb, aa = b.get(key) or {}, a.get(key) or {}
        for glob, codes in aa.items():
            for code in as_list(codes):
                if code not in as_list(bb.get(glob)):
                    out(path, f"{prefix}lint.{key} adds {code} for {glob}")
    for key in ("exclude", "extend-exclude"):
        for x in as_list(after.get(key)):
            if x not in as_list(before.get(key)):
                out(path, f"{prefix}{key} adds {x}")
        for x in as_list((after.get("lint") or {}).get(key)):
            if x not in as_list((before.get("lint") or {}).get(key)):
                out(path, f"{prefix}lint.{key} adds {x}")


# ---- ty

TY_LEVELS = {"ignore": 0, "warn": 1, "error": 2}


def ty(path, b, a, prefix=""):
    rb, ra = b.get("rules") or {}, a.get("rules") or {}
    for key, vb in rb.items():
        if vb not in TY_LEVELS:
            continue
        va = ra.get(key)
        if va is None and TY_LEVELS[vb] > 0:
            out(path, f"{prefix}rules.{key} {show(vb)} -> unset")
        elif va in TY_LEVELS and TY_LEVELS[va] < TY_LEVELS[vb]:
            out(path, f"{prefix}rules.{key} {show(vb)} -> {show(va)}")
    tb, ta = b.get("terminal") or {}, a.get("terminal") or {}
    if tb.get("error-on-warning") is True and ta.get("error-on-warning") is not True:
        out(path, f"{prefix}terminal.error-on-warning true -> {show(ta.get('error-on-warning'))}")
    sb, sa = b.get("src") or {}, a.get("src") or {}
    for x in as_list(sa.get("exclude")):
        if x not in as_list(sb.get("exclude")):
            out(path, f"{prefix}src.exclude adds {x}")
    if len(as_list(a.get("overrides"))) > len(as_list(b.get("overrides"))):
        out(path, f"{prefix}overrides adds an entry")


# ---- pytest

LOOSE_OPTS = re.compile(r"^(--ignore(-glob)?|--deselect|-k|-m|--continue-on-collection-errors|--lf|--last-failed|--sw|--stepwise)(=|$)")


def pytest(path, b, a, prefix):
    tb = str(b.get("addopts", "")).split() if not isinstance(b.get("addopts"), list) else b.get("addopts")
    ta = str(a.get("addopts", "")).split() if not isinstance(a.get("addopts"), list) else a.get("addopts")
    for t in ta:
        if LOOSE_OPTS.match(t) and t not in tb:
            out(path, f"{prefix}addopts adds {t}")
    for x in as_list(b.get("testpaths")):
        if x not in as_list(a.get("testpaths")):
            out(path, f"{prefix}testpaths no longer has {x}")
    for x in as_list(a.get("norecursedirs")):
        if x not in as_list(b.get("norecursedirs")):
            out(path, f"{prefix}norecursedirs adds {x}")
    if b.get("xfail_strict") is True and a.get("xfail_strict") is not True:
        out(path, f"{prefix}xfail_strict true -> {show(a.get('xfail_strict'))}")


# ---- coverage

def coverage(path, b, a, prefix):
    rb, ra = b.get("report") or {}, a.get("report") or {}
    fb, fa = rb.get("fail_under"), ra.get("fail_under")
    if isinstance(fb, (int, float)) and (not isinstance(fa, (int, float)) or fa < fb):
        out(path, f"{prefix}report.fail_under {show(fb)} -> {show(fa)}")
    for sect, key in (("run", "omit"), ("report", "omit"), ("report", "exclude_lines"), ("report", "exclude_also")):
        for x in as_list((a.get(sect) or {}).get(key)):
            if x not in as_list((b.get(sect) or {}).get(key)):
                out(path, f"{prefix}{sect}.{key} adds {x}")


def load(text, path):
    if path.endswith(".json"):
        return json.loads(strip_jsonc(text))
    return tomllib.loads(text)


def main():
    base = sys.argv[1]
    for path in sys.argv[2:]:
        name = path.rsplit("/", 1)[-1]
        if name not in ("pyproject.toml", "ruff.toml", ".ruff.toml", "ty.toml"):
            continue
        try:
            with open(f"{base}/{path}", encoding="utf-8") as f:
                before = load(f.read(), path)
        except FileNotFoundError:
            continue
        except (ValueError, tomllib.TOMLDecodeError):
            continue
        try:
            with open(path, encoding="utf-8") as f:
                after = load(f.read(), path)
        except (ValueError, tomllib.TOMLDecodeError) as e:
            out(path, f"cannot be parsed ({str(e).splitlines()[0]})")
            continue
        if name == "pyproject.toml":
            tb, ta = before.get("tool") or {}, after.get("tool") or {}
            ruff(path, tb.get("ruff") or {}, ta.get("ruff") or {}, "tool.ruff.")
            ty(path, tb.get("ty") or {}, ta.get("ty") or {}, "tool.ty.")
            pytest(path, (tb.get("pytest") or {}).get("ini_options") or {}, (ta.get("pytest") or {}).get("ini_options") or {}, "tool.pytest.ini_options.")
            coverage(path, tb.get("coverage") or {}, ta.get("coverage") or {}, "tool.coverage.")
        elif name == "ty.toml":
            ty(path, before, after)
        else:
            ruff(path, before, after)
    for f in findings:
        print(f)
    sys.exit(1 if findings else 0)


try:
    main()
except SystemExit:
    raise
except Exception as e:  # never report a crash as a loosened setting
    print(f"skipped: the ratchet could not run ({type(e).__name__}: {e})")
    sys.exit(3)

===== .forge/helpers/types_python.py
# Generated by forge. The types engine for Python (SPECS §15): a daemon that keeps ty's
# language server running for one repository and answers the hooks' type questions
# through a FIFO. Started by forge_types_up as
#   uvx --python <py> --from ty==<pin> python types_python.py <root> <state-dir>
# so ty is the pinned one next to this interpreter. It detaches (its own session, so
# the hook that started it can end), then writes "ready <server> <version>" (or
# "failed <reason>") to the FIFO <state-dir>/started.
#
# <state-dir>/in is a FIFO of lines (each shorter than PIPE_BUF, so writers never mix):
#   changed<TAB><path>   a file changed on disk (relative to the root): resynced
#   restart | stop       the daemon exits (restart: the dependencies changed; the next
#                        use starts it again); "stop<TAB><dir>" answers "end" in the FIFO
#                        <dir>/reply once its language server has exited
#   <absolute dir>       a question: <dir>/req holds ast-grep --json=stream matches whose
#                        metadata has forge_where (a type or a declared name per
#                        metavariable, SPECS §15.1, §15.6); the answer goes to the FIFO <dir>/reply:
#                        the matches whose forge_where holds (verbatim), "error<TAB>..."
#                        lines, then "end"
# The daemon exits after FORGE_TYPES_IDLE seconds (1800) without a line, and when its
# state directory or the repository is gone or another daemon took the state directory
# over (checked every 10 seconds).
import ast
import json
import os
import re
import select
import subprocess
import sys
import threading
import time
from urllib.parse import quote, unquote

ROOT = os.path.realpath(sys.argv[1])
STATE = sys.argv[2]
IDLE = int(os.environ.get("FORGE_TYPES_IDLE", "1800"))
TY = os.path.join(os.path.dirname(sys.executable), "ty")
LOG = open(os.path.join(STATE, "log"), "a", buffering=1)


def log(*a):
    LOG.write(time.strftime("%H:%M:%S ") + " ".join(str(x) for x in a) + "\n")


def uri(path):
    return "file://" + quote(os.path.realpath(path))


def path_of(u):
    return unquote(u[len("file://"):]) if u.startswith("file://") else u


def u16(s):
    return len(s.encode("utf-16-le")) // 2


def position(text, index):
    """The LSP position (UTF-16 columns) of a str index."""
    line = text.count("\n", 0, index)
    start = text.rfind("\n", 0, index) + 1
    return {"line": line, "character": u16(text[start:index])}


def index_of(text, pos):
    """The str index of an LSP position."""
    i = 0
    for _ in range(pos["line"]):
        i = text.index("\n", i) + 1
    col, j = 0, i
    while col < pos["character"] and j < len(text) and text[j] != "\n":
        col += 2 if ord(text[j]) > 0xFFFF else 1
        j += 1
    return j


# ---------------------------------------------------------------- the language server


class Slot:
    """A request waiting for its response."""

    def __init__(self):
        self.done = threading.Event()
        self.response = {}


class Server:
    def __init__(self):
        self.proc = subprocess.Popen([TY, "server"], cwd=ROOT, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=LOG)
        assert self.proc.stdin is not None and self.proc.stdout is not None
        self.stdin, self.stdout = self.proc.stdin, self.proc.stdout
        self.next = 0
        self.lock = threading.Lock()
        self.waiting = {}
        self.versions = {}
        self.texts = {}
        self.stopping = False
        threading.Thread(target=self.read, daemon=True).start()

    def send(self, msg):
        body = json.dumps(msg).encode()
        with self.lock:
            self.stdin.write(b"Content-Length: %d\r\n\r\n" % len(body) + body)
            self.stdin.flush()

    def read(self):
        try:
            self.read_messages()
        except Exception as e:  # noqa: BLE001 - a broken stream is the server ending
            if not self.stopping:
                log("server stream broken:", repr(e))
                os._exit(3)

    def read_messages(self):
        out = self.stdout
        while True:
            length = None
            while True:
                line = out.readline()
                if not line:
                    if self.stopping:
                        return
                    log("server exited")
                    os._exit(3)
                if line in (b"\r\n", b"\n"):
                    break
                if line.lower().startswith(b"content-length:"):
                    length = int(line.split(b":")[1])
            if length is None:
                continue
            msg = json.loads(out.read(length))
            if "method" in msg and "id" in msg:
                # a request from the server (configuration, registrations): answer with defaults
                items = (msg.get("params") or {}).get("items")
                self.send({"jsonrpc": "2.0", "id": msg["id"], "result": [None] * len(items) if items else None})
            elif "id" in msg:
                slot = self.waiting.pop(msg["id"], None)
                if slot:
                    slot.response = msg
                    slot.done.set()

    def request(self, method, params):
        """Sends a request; returns a function that waits for its result."""
        with self.lock:
            self.next += 1
            rid = self.next
        slot = Slot()
        self.waiting[rid] = slot
        self.send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})

        def wait():
            slot.done.wait(60)
            return slot.response.get("result")

        return wait

    def notify(self, method, params):
        self.send({"jsonrpc": "2.0", "method": method, "params": params})

    def start(self):
        info = self.request(
            "initialize",
            {
                "processId": os.getpid(),
                "rootUri": uri(ROOT),
                "workspaceFolders": [{"uri": uri(ROOT), "name": "root"}],
                "capabilities": {
                    "general": {"positionEncodings": ["utf-16"]},
                    "textDocument": {"typeDefinition": {"linkSupport": True}, "definition": {"linkSupport": True}, "typeHierarchy": {}},
                    "workspace": {"configuration": True, "workspaceFolders": True},
                },
            },
        )()
        self.notify("initialized", {})
        server = (info or {}).get("serverInfo") or {}
        return "%s %s" % (server.get("name", "ty"), (server.get("version") or "").split(" ")[0])

    def show(self, path, text):
        """Makes the server see <text> as the content of <path> (in memory only)."""
        u = uri(path)
        v = self.versions.get(u, 0) + 1
        self.versions[u] = v
        if v == 1:
            self.notify("textDocument/didOpen", {"textDocument": {"uri": u, "languageId": "python", "version": v, "text": text}})
        else:
            self.notify("textDocument/didChange", {"textDocument": {"uri": u, "version": v}, "contentChanges": [{"text": text}]})

    def sync(self, path):
        """The file as it is on disk; returns its text."""
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            text = f.read()
        if self.texts.get(path) != text:
            self.show(path, text)
            self.texts[path] = text
        return text

    def changed(self, path):
        if uri(path) in self.versions:
            if os.path.exists(path):
                self.sync(path)
            return
        kind = 2 if os.path.exists(path) else 3
        self.notify("workspace/didChangeWatchedFiles", {"changes": [{"uri": uri(path), "type": kind}]})


# ---------------------------------------------------------------- declarations


def declared_in(path):
    """(package, module) of a declaration file: the import package and dotted module
    under site-packages (a -stubs package counts as its package), the standard library
    (its sources, lib/python3.X/, or typeshed's stdlib) or typeshed's third-party stubs;
    (None, module) for the project's own files."""
    p = path.replace(os.sep, "/")
    rel = None
    for marker in ("/site-packages/", "/dist-packages/"):
        i = p.rfind(marker)
        if i >= 0:
            rel = p[i + len(marker):]
            break
    if rel is None:
        # the standard library's own sources (a definition goes there rather than to its stub)
        m = re.search(r"/lib/python3\.\d+/", p)
        if m:
            rel = p[m.end():]
    if rel is None:
        i = p.rfind("/typeshed/")
        if i >= 0:
            rest = p[i + len("/typeshed/"):].split("/")
            if "stdlib" in rest:
                rel = "/".join(rest[rest.index("stdlib") + 1:])
            elif "stubs" in rest:
                rel = "/".join(rest[rest.index("stubs") + 2:])
    project = False
    if rel is None:
        real = os.path.realpath(path)
        if not real.startswith(ROOT + "/"):
            return (None, None)
        rel = real[len(ROOT) + 1:]
        if rel.startswith("src/"):
            rel = rel[4:]
        project = True
    segs = [s for s in re.sub(r"\.pyi?$", "", rel).split("/") if s]
    if segs and segs[-1] == "__init__":
        segs.pop()
    if not segs:
        return (None, None)
    segs[0] = re.sub(r"-stubs$", "", segs[0])
    module = ".".join(segs)
    return (None if project else segs[0], module)


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            return f.read()
    except OSError:
        return None


def word_at(path, pos, text=None):
    text = read_text(path) if text is None else text
    if text is None:
        return None
    i = index_of(text, pos)
    m = re.compile(r"[A-Za-z_][A-Za-z0-9_]*").search(text, i)
    while m and m.group(0) in ("class", "def", "type", "async"):
        m = re.compile(r"[A-Za-z_][A-Za-z0-9_]*").search(text, m.end())
    return m.group(0) if m else None


IMPORTS = {}  # file -> (text, [(start, end) index ranges of its import statements])


def in_import(path, text, pos):
    """Whether pos is inside an import statement of the file (Python's own parser)."""
    cached = IMPORTS.get(path)
    if not cached or cached[0] != text:
        spans = []
        try:
            lines = [0]
            for line in text.splitlines(keepends=True):
                lines.append(lines[-1] + len(line))
            for node in ast.walk(ast.parse(text)):
                if isinstance(node, (ast.Import, ast.ImportFrom)):
                    spans.append((lines[node.lineno - 1] + node.col_offset, lines[node.end_lineno - 1] + node.end_col_offset))
        except (SyntaxError, ValueError):
            pass
        cached = IMPORTS[path] = (text, spans)
    i = index_of(text, pos)
    return any(a <= i < b for a, b in cached[1])


class Types:
    def __init__(self, server):
        self.server = server
        self.cache = {}  # declaration location outside the project -> its declarations with supertypes

    def hierarchy(self, loc):
        """The declarations (package, module, name) of the type declared at loc and of its
        supertypes, through the server's type hierarchy."""
        key = (loc["uri"], loc["pos"]["line"], loc["pos"]["character"])
        if key in self.cache:
            return self.cache[key]
        out, seen = set(), set()
        items = self.server.request("textDocument/prepareTypeHierarchy", {"textDocument": {"uri": loc["uri"]}, "position": loc["pos"]})() or []
        if not items:
            name = word_at(path_of(loc["uri"]), loc["pos"])
            pkg, mod = declared_in(path_of(loc["uri"]))
            out.add((pkg, mod, name))
        todo = list(items)
        while todo and len(seen) < 64:
            item = todo.pop()
            k = (item["uri"], item["selectionRange"]["start"]["line"], item["selectionRange"]["start"]["character"])
            if k in seen:
                continue
            seen.add(k)
            pkg, mod = declared_in(path_of(item["uri"]))
            out.add((pkg, mod, item["name"]))
            todo.extend(self.server.request("typeHierarchy/supertypes", {"item": item})() or [])
        if not path_of(loc["uri"]).startswith(ROOT + "/") or "/site-packages/" in loc["uri"]:
            self.cache[key] = out
        return out

    def check(self, path, wanted, named=()):
        """wanted: [(match index, variable, start byte, end byte)] whose type is asked;
        named: the same for the declarations names refer to. Returns {(match index,
        variable): (set of declarations, unknown)}. A type is the one the server infers
        for each expression: the file is shown to the server with each expression bound
        to a fresh name ((__forge_t<i> := (<expr>))), in memory only, and the type
        definition of that name is asked; then the file is shown as it is."""
        text = self.server.sync(path)
        raw = text.encode("utf-8", errors="surrogateescape")
        found = self.declared(path, text, raw, named) if named else {}
        if not wanted:
            return found
        # one fresh name per distinct expression range
        ranges, slot = [], []
        for _, _, s, e in wanted:
            r = (len(raw[:s].decode("utf-8", errors="surrogateescape")), len(raw[:e].decode("utf-8", errors="surrogateescape")))
            if r not in ranges:
                ranges.append(r)
            slot.append(ranges.index(r))
        # inserts: at each start the opening, at each end the closing; at the same offset,
        # closings first (inner first), then openings (outer first)
        events = []
        for n, (s, e) in enumerate(ranges):
            events.append((s, 1, -(e - s), n, "(__forge_t%d := (" % n))
            events.append((e, 0, e - s, n, "))"))
        events.sort()
        out, last, anchors = [], 0, {}
        for off, kind, _, n, piece in events:
            out.append(text[last:off])
            last = off
            if kind == 1:
                anchors[n] = sum(len(x) for x in out) + 1 + 2  # inside the name
            out.append(piece)
        out.append(text[last:])
        overlay = "".join(out)
        self.server.show(path, overlay)
        waits = [
            self.server.request("textDocument/typeDefinition", {"textDocument": {"uri": uri(path)}, "position": position(overlay, anchors[n])})
            for n in range(len(ranges))
        ]
        results = [w() for w in waits]
        self.server.show(path, text)
        per_range = []
        for r in results:
            decls = set()
            for l in (r if isinstance(r, list) else [r] if r else []):
                u = l.get("targetUri") or l.get("uri")
                rg = l.get("targetSelectionRange") or l.get("targetRange") or l.get("range")
                decls |= self.hierarchy({"uri": u, "pos": rg["start"]})
            # Any and Unknown (an unannotated parameter, an unresolved import) say nothing
            unknown = all(d[0] == "typing" and d[2] == "Any" or (d[1] or "").startswith("ty_extensions") for d in decls)
            per_range.append((frozenset(decls), unknown))
        found.update({(w[0], w[1]): per_range[slot[n]] for n, w in enumerate(wanted)})
        return found

    def declared(self, path, text, raw, named):
        """{(match index, variable): (declarations, unknown)} of the names in named: the
        declarations the server's definition of the expression's last name gives (an
        import alias or a re-export resolved; overloads each count), on the file as it
        is. An expression that does not end with a name, a name without a definition and
        one whose definition is an import the server could not resolve are unknown."""
        asked, out = {}, {}
        for n, var, s, e in named:
            expr = raw[s:e].decode("utf-8", errors="surrogateescape")
            m = re.search(r"[A-Za-z_][A-Za-z0-9_]*$", expr)
            if not m or (m.start() > 0 and expr[:m.start()].rstrip()[-1:] not in (".",)):
                out[(n, var)] = (frozenset(), True)
                continue
            at = len(raw[:s].decode("utf-8", errors="surrogateescape")) + m.start()
            if at not in asked:
                asked[at] = self.server.request("textDocument/definition", {"textDocument": {"uri": uri(path)}, "position": position(text, at)})
            out[(n, var)] = at
        answers = {}
        for at, wait in asked.items():
            decls = set()
            for l in (lambda r: r if isinstance(r, list) else [r] if r else [])(wait()):
                f = path_of(l.get("targetUri") or l.get("uri"))
                rg = l.get("targetSelectionRange") or l.get("targetRange") or l.get("range")
                body = text if os.path.realpath(f) == os.path.realpath(path) else read_text(f)
                if body is None:
                    continue
                if in_import(f, body, rg["start"]):
                    continue  # the server stopped at an import it could not resolve
                pkg, mod = declared_in(f)
                whole = l.get("targetRange") or l.get("range")
                if whole["start"] == whole["end"] == {"line": 0, "character": 0}:
                    # a module: declared by its file, with its name
                    decls.add((pkg, mod, (mod or "").rsplit(".", 1)[-1] or None))
                else:
                    decls.add((pkg, mod, word_at(f, rg["start"], body)))
            answers[at] = (frozenset(decls), not decls)
        return {k: answers[v] if isinstance(v, int) else v for k, v in out.items()}


# ---------------------------------------------------------------- constraints


def listed(v):
    return None if v is None else v if isinstance(v, list) else [v]


def satisfies(found, spec):
    """A type spec ({package, module, name, unknown}) holds when one declaration of the
    type (a union member, or a supertype of one) is declared there with that name; a
    type the checker does not know (Any, Unknown) holds only with unknown: match."""
    decls, unknown = found
    if unknown:
        return spec.get("unknown") == "match"
    pkgs, mods, names = listed(spec.get("package")), listed(spec.get("module")), listed(spec.get("name"))
    for pkg, mod, name in decls:
        if pkgs is not None and pkg not in pkgs:
            continue
        if mods is not None and not any(mod == m or (mod or "").startswith(m + ".") for m in mods):
            continue
        if names is not None and name not in names:
            continue
        return True
    return False


def holds(found, cond):
    if "not" in cond:
        return not holds(found, cond["not"])
    specs = cond["type"] if "type" in cond else cond["declared"]
    # several specs: one of them is enough
    return any(satisfies(found, spec) for spec in (specs if isinstance(specs, list) else [specs]))


def asks(cond):
    """What a condition asks of its metavariable: "type" or "declared"."""
    while "not" in cond:
        cond = cond["not"]
    return "declared" if "declared" in cond else "type"


def answer(types, matches):
    """The matches whose forge_where holds."""
    by_file = {}
    for n, m in enumerate(matches):
        where = (m.get("metadata") or {}).get("forge_where") or {}
        single = (m.get("metaVariables") or {}).get("single") or {}
        for var, cond in where.items():
            if var in single:
                b = single[var]["range"]["byteOffset"]
                kinds = by_file.setdefault(m["file"], {"type": [], "declared": []})
                kinds[asks(cond)].append((n, var, b["start"], b["end"]))
    found = {}
    for f, kinds in by_file.items():
        found.update(types.check(os.path.join(ROOT, f), kinds["type"], kinds["declared"]))
    keep = []
    for n, m in enumerate(matches):
        where = (m.get("metadata") or {}).get("forge_where") or {}
        if all((n, var) not in found or holds(found[(n, var)], cond) for var, cond in where.items()):
            keep.append(n)
    return keep


# ---------------------------------------------------------------- the FIFO loop


def reply(d, lines):
    try:
        fd = os.open(os.path.join(d, "reply"), os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return  # nobody waits for it
    os.set_blocking(fd, True)
    os.write(fd, "".join(l + "\n" for l in lines + ["end"]).encode("utf-8", errors="surrogateescape"))
    os.close(fd)


def orphaned(fd):
    """The state directory was dropped (its FIFO is gone or replaced), another daemon took
    it over (its pid file names that one: a start whose starter was killed can race with
    the next start, and both open the same FIFO) or the repository no longer exists:
    nobody reaches this daemon any more."""
    try:
        with open(os.path.join(STATE, "pid")) as f:
            mine = f.read().strip() == str(os.getpid())
        return not mine or os.stat(os.path.join(STATE, "in")).st_ino != os.fstat(fd).st_ino or not os.path.isdir(ROOT)
    except OSError:
        return True


def serve(server, types, fd):
    buf = b""
    last = checked = time.time()
    # non-blocking: a FIFO another daemon also reads (see orphaned) can be readable for
    # select and empty for read
    os.set_blocking(fd, False)
    while True:
        r, _, _ = select.select([fd], [], [], min(IDLE, 10))
        now = time.time()
        # every 10 seconds, whether lines come or not
        if now - checked >= 10 or not r:
            checked = now
            if orphaned(fd):
                log("orphaned, exiting")
                return
        if not r:
            if now - last >= IDLE:
                log("idle, exiting")
                return
            continue
        try:
            data = os.read(fd, 65536)
        except BlockingIOError:
            continue
        last = now
        buf += data
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            line = line.decode("utf-8", errors="surrogateescape")
            if line.startswith("changed\t"):
                server.changed(os.path.join(ROOT, line[8:]))
            elif line == "restart" or line == "stop" or line.startswith("stop\t"):
                # "stop<TAB><dir>": answered in <dir>/reply once the server has exited
                log("asked to", line.split("\t")[0])
                return line[5:] if line.startswith("stop\t") else None
            elif line.startswith("/"):
                question(types, line)


def question(types, d):
    try:
        with open(os.path.join(d, "req"), encoding="utf-8", errors="surrogateescape") as f:
            req = f.read().splitlines()
    except OSError:
        return
    matches, raw, out = [], [], []
    for l in req:
        try:
            matches.append(json.loads(l))
            raw.append(l)
        except ValueError:
            out.append("error\tunreadable match: " + l[:80])
    t = time.time()
    try:
        out.extend(raw[n] for n in answer(types, matches))
    except Exception as e:  # noqa: BLE001 - reported to the hook, which fails visibly
        log("error", repr(e))
        out.append("error\t%s: %s" % (type(e).__name__, e))
    log("answered %d matches in %.1f ms" % (len(matches), (time.time() - t) * 1000))
    reply(d, out)


def started(line):
    """Tells the starter (waiting on <state>/started) how the start went."""
    try:
        fd = os.open(os.path.join(STATE, "started"), os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return
    os.write(fd, (line + "\n").encode())
    os.close(fd)


def main():
    # detach: a session of its own, so ending the hook that started it does not end it
    if os.fork() > 0:
        os._exit(0)
    os.setsid()
    with open(os.path.join(STATE, "pid"), "w") as f:
        f.write("%d\n" % os.getpid())
    fd = os.open(os.path.join(STATE, "in"), os.O_RDWR)
    server = None
    waiting = None
    try:
        server = Server()
        ready = server.start()
        with open(os.path.join(STATE, "ready"), "w") as f:
            f.write(ready + "\n")
        log("started", ready, "for", ROOT)
        started("ready " + ready)
        waiting = serve(server, Types(server), fd)
    except Exception as e:  # noqa: BLE001 - the starter reports it
        log("failed", repr(e))
        started("failed %s: %s" % (type(e).__name__, e))
    finally:
        if not orphaned(fd):
            for name in ("ready", "pid", "in"):
                try:
                    os.unlink(os.path.join(STATE, name))
                except OSError:
                    pass
        if server:
            server.stopping = True
            try:
                server.request("shutdown", None)
                server.notify("exit", None)
            except OSError:
                pass
            server.proc.terminate()
            try:
                server.proc.wait(5)
            except subprocess.TimeoutExpired:
                server.proc.kill()
        if waiting:
            reply(waiting, [])
        # no interpreter finalization: the reader thread may still hold the server's pipe
        os._exit(0)


main()

