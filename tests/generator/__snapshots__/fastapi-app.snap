#!/bin/sh
# Generated by forge. Edits to tests that existed at the start of the turn.
# PreToolUse(Edit|Write): when the edit removes a test, or changes what it checks
# (its assertions or parametrization; setup-only changes and new tests are fine),
# asks: the user sees the ask; in an autonomous run an independent reviewer answers
# it, given the user's request for the turn (saved by turn-start.sh). The tests
# asked about are recorded as pending for this tool call.
# PostToolUse(Edit|Write): the call ran, so it was approved: its pending tests are
# recorded in <turn snapshot>/tests-approved, which the Stop check does not block
# on. The edited test file is recorded in <turn snapshot>/touched, so the Stop
# check still runs it when the edit is later reverted.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
[ -d .forge ] || exit 0
file=$(json_get file_path)
[ -n "$file" ] || exit 0
file=$(rel_path "$file") || exit 0
FORGE_ROOT=$(pwd)
snap=$(turn_dir)
key=$(bash_key) || key=''
IFS='
'

# ---- generated checks
# Project tools used in check commands, resolved through tool().
ruff() { forge_exec_tool ruff "$@"; }
alembic() { forge_exec_tool alembic "$@"; }
pytest() { forge_exec_tool pytest "$@"; }
python() { forge_exec_tool python "$@"; }
# ty is Forge's own, pinned (§15.2).
ty() { forge_ty "$@"; }
FORGE_NCHECKS=29

# 1. git/editorconfig
forge_check_meta_1() {
  c_id='git/editorconfig'; c_stage=lint; c_tools=''
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_1() {
  return 0
}
forge_when_1() { return 1; }
forge_check_run_1() {
forge_editorconfig
}

# 2. git/generated-files
forge_check_meta_2() {
  c_id='git/generated-files'; c_stage=lint; c_tools=''
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_2() {
  return 0
}
forge_when_2() { return 1; }
forge_check_run_2() {
forge_advise forge_generated_edits
}

# 3. git/large-files
forge_check_meta_3() {
  c_id='git/large-files'; c_stage=lint; c_tools=''
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_3() {
  return 0
}
forge_when_3() { return 1; }
forge_check_run_3() {
forge_large_files 1048576
}

# 4. python/config-ratchet
forge_check_meta_4() {
  c_id='python/config-ratchet'; c_stage=lint; c_tools='python'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_4() {
  case $1 in pyproject.toml|*/pyproject.toml|ruff.toml|*/ruff.toml|.ruff.toml|*/.ruff.toml|ty.toml|*/ty.toml) ;; *) return 1 ;; esac
  return 0
}
forge_when_4() { case $1 in pyproject.toml|*/pyproject.toml|ruff.toml|*/ruff.toml|.ruff.toml|*/.ruff.toml|ty.toml|*/ty.toml) return 0 ;; esac; return 1; }
forge_check_run_4() {
