# 7. python/sqlalchemy/alembic/migration-lint
forge_check_meta_7() {
  c_id='python/sqlalchemy/alembic/migration-lint'; c_stage=migration; c_tools='alembic'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1
}
