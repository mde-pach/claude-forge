  return 1
}
forge_when_4() { case $1 in models/*|*/models/*|models.py|*/models.py|alembic/versions/*) return 0 ;; esac; return 1; }
forge_check_run_4() {
alembic check
}

# 5. python/sqlalchemy/alembic/single-head
forge_check_meta_5() {
  c_id='python/sqlalchemy/alembic/single-head'; c_stage=migration; c_tools='alembic'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
