===== .forge/check.sh
#!/bin/sh
# Generated by forge. Do not edit: changes are detected by the integrity check.
# Usage: sh .forge/check.sh [--changed | --since <ref> | --all]
#   --changed      uncommitted changes vs HEAD (pre-commit)
#   --since <ref>  everything since git merge-base <ref> HEAD (CI on a pull request)
#   --all          the whole project (CI)
# The Stop hook runs it with --turn <snapshot>: only what changed during the turn.
# Outside --all, forbid rules and lint findings count only on added lines.
usage() { printf 'usage: sh .forge/check.sh [--changed | --since <ref> | --all]\n' >&2; exit 2; }
mode=${1:---all}
case $mode in
  --changed|--all) [ "$#" -le 1 ] || usage ;;
  --since|--turn) [ "$#" -eq 2 ] && [ -n "$2" ] || usage ;;
  *) usage ;;
esac
FORGE_ARG=${2:-}
cd "$(dirname "$0")/.." || exit 2
FORGE_ROOT=$(pwd)
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-check.XXXXXX") || exit 2
# forge_kill_jobs: stops every process this run started (a check, its timeout watcher),
# so none outlives it (the Stop hook's timeout, a Ctrl-C at commit). A types engine
# detaches into its own session; one this run started is stopped at the end unless a
# session uses it (§15.3).
forge_kill_jobs() {
  for _kj in $(ps -A -o pid= -o ppid= 2>/dev/null | awk -v p="$$" '$2 == p { print $1 }'); do forge_kill_tree "$_kj"; done
}
trap 'forge_types_down; rm -rf "$FORGE_TMP"' EXIT; trap 'forge_kill_jobs; exit 143' HUP INT TERM

@@ templates/scripts/lib.sh @@

# ---- generated checks
# Project tools used in check commands, resolved through tool().
ruff() { forge_exec_tool ruff "$@"; }
alembic() { forge_exec_tool alembic "$@"; }
pytest() { forge_exec_tool pytest "$@"; }
python() { forge_exec_tool python "$@"; }
# ty is Forge's own, pinned (§15.2).
ty() { forge_ty "$@"; }
FORGE_NCHECKS=34

# 1. git/editorconfig
forge_check_meta_1() {
  c_id='git/editorconfig'; c_stage=lint; c_tools=''
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0; c_fmt=0; c_rerun=0; c_warn=0; c_dirs=''
}
forge_scope_1() {
  return 0
}
forge_when_1() { return 1; }
forge_check_run_1() {
forge_editorconfig
}

# 2. git/generated-files
forge_check_meta_2() {
