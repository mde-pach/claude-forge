===== .forge/ast-grep/rule-tests/python-taskgroup-except-star-test.yml
id: python/taskgroup-except-star
valid: []
invalid:
  - |
    import asyncio


    async def fetch(n: int) -> int:
        return n


    async def main() -> None:
        try:
            async with asyncio.TaskGroup() as tg:
                tg.create_task(fetch(1))
                tg.create_task(fetch(2))
        except ValueError:
            pass
  - |
    import anyio


    async def fetch(n: int) -> None:
        pass


    async def main() -> None:
        try:
            async with anyio.create_task_group() as group:
                group.start_soon(fetch, 1)
        except (ValueError, KeyError) as err:
            print(err)
  - |
    import trio


    async def fetch(n: int) -> None:
        pass


    async def main() -> None:
        try:
            async with trio.open_nursery() as nursery:
                nursery.start_soon(fetch, 1)
        except OSError:
            pass

