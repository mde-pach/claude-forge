    from unittest.mock import patch as p


    def test_charge() -> None:
        with p("app.billing.stripe"):
            charge()
  - |
    import unittest.mock as um


    def test_charge() -> None:
        with um.patch.object(Billing, "pay"):
            charge()
  - |
    from unittest import mock as m


    def test_charge() -> None:
        gateway = m.MagicMock()
        charge(gateway)
  - |
    from unittest.mock import create_autospec


    def test_charge() -> None:
        gateway = create_autospec(Gateway)
        charge(gateway)
  - |
    from unittest.mock import patch


    def test_charge() -> None:
        with patch.multiple("app.billing", pay=None, refund=None):
            charge()
  - |
    def test_charge(mocker) -> None:
        spy = mocker.spy(billing, "pay")
        charge()
        assert spy.call_count == 1

