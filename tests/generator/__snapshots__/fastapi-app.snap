  return 1
}
forge_when_7() { return 1; }
forge_check_run_7() {
basedpyright
}

# 8. python/uv/lock-sync
forge_check_meta_8() {
  c_id='python/uv/lock-sync'; c_stage=lint; c_tools='uv'
