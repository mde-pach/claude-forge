}

# 5. typescript/config-ratchet
forge_check_meta_5() {
  c_id='typescript/config-ratchet'; c_stage=lint; c_tools='bun'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0; c_fix=0
}
forge_scope_5() {
  case $1 in biome.json|*/biome.json|biome.jsonc|*/biome.jsonc|tsconfig*.json|*/tsconfig*.json|package.json|*/package.json) ;; *) return 1 ;; esac
