branch=$(git branch --show-current 2>/dev/null)
[ -n "$branch" ] || branch="(detached $(git rev-parse --short HEAD 2>/dev/null))"
git status --porcelain --untracked-files=all 2>/dev/null | sed -e 's/^...//' -e 's/^.* -> //' > "${TMPDIR:-/tmp}/forge-ss.$$"
n=$(awk 'END { print NR }' "${TMPDIR:-/tmp}/forge-ss.$$")
printf 'forge: branch %s, %s changed files\n' "$branch" "$n"
first_lines 10 < "${TMPDIR:-/tmp}/forge-ss.$$" | sed 's/^/  /'
rm -f "${TMPDIR:-/tmp}/forge-ss.$$"
if git rev-parse --verify -q HEAD >/dev/null; then
  printf 'forge: last commits\n'
  git log -5 --format='%h %s' 2>/dev/null | cut -c 1-72 | sed 's/^/  /'
fi
printf 'forge: packs typescript, typescript/astro, typescript/astro/react, typescript/bun\n'

missing=''
for t in $(forge_required_tools); do
  forge_has_tool "$t" || missing="${missing:+$missing, }$t"
done
if ! command -v bunx >/dev/null 2>&1 && ! command -v uvx >/dev/null 2>&1; then
  missing="${missing:+$missing, }bunx or uvx (ast-grep)"
fi
state=.forge/state/missing-tools
if [ -n "$missing" ]; then
  if [ "$missing" != "$(cat "$state" 2>/dev/null)" ]; then
    printf 'forge: missing tools (checks using them are skipped): %s\n' "$missing"
    mkdir -p .forge/state 2>/dev/null && printf '%s\n' "$missing" > "$state"
  fi
else
  rm -f "$state" 2>/dev/null
fi
exit 0

===== .claude/skills/forge-project/scripts/stop.sh
#!/bin/sh
# Generated by forge. Stop hook: runs .forge/check.sh --changed when the working
# tree changed during this turn (snapshot taken by turn-start.sh) and differs
# from the last passing tree; hands over after 3 blocks.
dir=$(cd "$(dirname "$0")" && pwd)
FORGE_INPUT=$(cat)
. "$dir/lib.sh"
repo_root || exit 0
[ -f .forge/check.sh ] || { printf '{"decision":"block","reason":"forge:forge/integrity .forge/check.sh is missing (run forge apply)"}\n'; exit 0; }
mkdir -p .forge/state 2>/dev/null

session=$(session_id)
counter=.forge/state/$session
hash=$(tree_hash)
[ "$hash" = "$(cat .forge/state/last-pass 2>/dev/null)" ] && exit 0
# unchanged since the user's prompt: whatever is dirty is not this turn's work
turn=.forge/state/$session.turn
[ -f "$turn" ] && [ "$hash" = "$(cat "$turn")" ] && exit 0

count=$(cat "$counter" 2>/dev/null)
case $count in ''|*[!0-9]*) count=0 ;; esac
if [ "$count" -ge 3 ]; then
  rm -f "$counter"
  printf '{"systemMessage":"forge: check failed 3 times. Handing over to you."}\n'
  exit 0
fi

out=$(sh .forge/check.sh --changed 2>&1)
if [ $? -eq 0 ]; then
  tree_hash > .forge/state/last-pass
  rm -f "$counter"
  exit 0
fi
printf '%s\n' "$((count + 1))" > "$counter"
reason=$(printf '%s\n' "$out" | first_lines 20 | json_escape)
printf '{"decision":"block","reason":"%s"}\n' "$reason"
exit 0

