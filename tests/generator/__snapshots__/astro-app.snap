id: typescript/ts-expect-error-reason
language: Tsx
severity: error
message: forge:typescript/ts-expect-error-reason Every @ts-expect-error says why, after the directive.
rule:
  kind: comment
  regex: ^(//|/\*)[[:space:]]*@ts-expect-error[[:space:]]*(\*/)?$

