  "$@"
}

# forge_has_tool <name>: system runtimes (uv, bun) via PATH, others via tool().
forge_has_tool() {
  case $1 in
    uv|bun) command -v "$1" >/dev/null 2>&1 ;;
    *) [ -n "$(tool "$1")" ] ;;
  esac
}

# forge_missing_tool: prints the first tool of $c_tools that is absent.
forge_missing_tool() {
  _fm_ifs=$IFS
  IFS=' '
  for _fm_t in $c_tools; do
    if ! forge_has_tool "$_fm_t"; then IFS=$_fm_ifs; printf '%s' "$_fm_t"; return 0; fi
  done
  IFS=$_fm_ifs
  return 1
}

# forge_filter <predicate>: lines of stdin for which <predicate> <line> succeeds.
forge_filter() {
  while read -r _ff_line; do
    [ -n "$_ff_line" ] && "$1" "$_ff_line" && printf '%s\n' "$_ff_line"
  done
  return 0
}

# forge_db_url: DATABASE_URL from the environment, then .env, then alembic.ini.
forge_db_url() {
  if [ -n "${DATABASE_URL:-}" ]; then printf '%s' "$DATABASE_URL"; return 0; fi
  if [ -f .env ]; then
    _fd_url=$(sed -n 's/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}DATABASE_URL[[:space:]]*=[[:space:]]*//p' .env \
      | tail -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/")
    if [ -n "$_fd_url" ]; then printf '%s' "$_fd_url"; return 0; fi
  fi
  if [ -f alembic.ini ]; then
    sed -n 's/^[[:space:]]*sqlalchemy\.url[[:space:]]*=[[:space:]]*//p' alembic.ini | head -n 1 | sed 's/[[:space:]]*$//'
  fi
}

# forge_local_db: succeeds when the configured database is on this machine
# (localhost, 127.0.0.1, ::1, empty host or a Unix socket).
forge_local_db() {
  _fl_url=$(forge_db_url)
  [ -n "$_fl_url" ] || return 1
  case $_fl_url in *host=/*|*host=%2[Ff]*) return 0 ;; esac
  _fl_host=$(printf '%s' "$_fl_url" | sed -e 's|^[A-Za-z][A-Za-z0-9+.-]*://||' -e 's|[/?].*$||' -e 's|^.*@||')
  case $_fl_host in
    \[*) _fl_host=$(printf '%s' "$_fl_host" | sed 's|^\[\([^]]*\)\].*$|\1|') ;;
    *) _fl_host=$(printf '%s' "$_fl_host" | sed 's|:.*$||') ;;
  esac
  case $_fl_host in ''|localhost|127.0.0.1|::1|%2[Ff]*) return 0 ;; esac
  return 1
}

# forge_related_py_tests <files>: changed test files plus tests/**/test_<module>.py
# for each changed module, one per line.
forge_related_py_tests() {
  for _fr_f in "$@"; do
    case $_fr_f in
      *.py) ;;
      *) continue ;;
    esac
    _fr_b=${_fr_f##*/}
    case $_fr_b in
      test_*.py|*_test.py) [ -f "$_fr_f" ] && printf '%s\n' "$_fr_f" ;;
      __init__.py|conftest.py) ;;
      *) [ -d tests ] && find tests -type f -name "test_${_fr_b%.py}.py" 2>/dev/null ;;
    esac
  done | sort -u
}

# forge_kill_tree <pid>: kills a process and its descendants.
forge_kill_tree() {
  for _fk_c in $(ps -A -o pid= -o ppid= 2>/dev/null | awk -v p="$1" '$2 == p { print $1 }'); do
    forge_kill_tree "$_fk_c"
  done
  kill "$1" 2>/dev/null
}

# forge_exec_check <fn> <timeout>: runs <fn> with output in $FORGE_TMP/out.
forge_exec_check() {
  set -f
  if [ -n "$2" ]; then
    "$1" > "$FORGE_TMP/out" 2>&1 &
    _fe_pid=$!
    ( sleep "$2"; printf 'forge: timed out after %ss\n' "$2" >> "$FORGE_TMP/out"; forge_kill_tree "$_fe_pid" ) >/dev/null 2>&1 &
    _fe_watch=$!
    wait "$_fe_pid" 2>/dev/null
    _fe_rc=$?
    forge_kill_tree "$_fe_watch"
  else
    "$1" > "$FORGE_TMP/out" 2>&1 < /dev/null
    _fe_rc=$?
  fi
  set +f
  return "$_fe_rc"
}

# forge_diagnostics <output> [print]: sorts the error diagnostics of a whole-project
# run by the files they name (tsc "path(l,c)", "path:l:c" from basedpyright, ruff,
# biome, "--> path:l:c"; absolute paths under the repository are made relative;
# warning-only lines are ignored). Prints "changed" when one names a file of
# $FORGE_TMP/changed, "other" when they name only other files, "none" when no line
# names a file. With "print", prints the lines that name a changed file instead.
forge_diagnostics() {
  awk -v r1="$(pwd)" -v r2="$(pwd -P)" -v mode="$2" '
    FILENAME == ARGV[1] { ch[$0] = 1; next }
    {
      line = $0
      if (line ~ /[Ww]arning/ && line !~ /[Ee]rror/) next
      sub(/^[[:space:]]*(-->[[:space:]]*)?/, "", line)
      if (!match(line, /^[^[:space:]:(]+([(][0-9]+,[0-9]+[)]|:[0-9]+(:[0-9]+)?)/)) next
      p = substr(line, 1, RLENGTH)
      sub(/([(][0-9]+,[0-9]+[)]|:[0-9]+(:[0-9]+)?)$/, "", p)
      if (index(p, r1 "/") == 1) p = substr(p, length(r1) + 2)
      else if (index(p, r2 "/") == 1) p = substr(p, length(r2) + 2)
      sub(/^\.\//, "", p)
      named = 1
      if (p in ch) { hit = 1; if (mode == "print") print $0 }
    }
    END { if (mode != "print") print (hit ? "changed" : named ? "other" : "none") }' "$FORGE_TMP/changed" "$1"
}

# forge_attribute <stage> <output>: for a failed whole-project typecheck or lint run,
# "other" when its errors are all in unchanged files, else "changed" or "none".
forge_attribute() {
  case $1 in typecheck|lint) forge_diagnostics "$2" ;; *) printf 'none\n' ;; esac
}

# forge_run_check <n>: one check under check.sh ($mode, $FORGE_TMP/changed, $FORGE_TMP/existing).
forge_run_check() {
  forge_check_meta_"$1"
  FORGE_FILES=''
  if [ "$mode" = --changed ]; then
    if [ "$c_when" = 1 ]; then
      [ -n "$(forge_filter "forge_when_$1" < "$FORGE_TMP/changed")" ] || return 0
    fi
    FORGE_FILES=$(forge_filter "forge_scope_$1" < "$FORGE_TMP/existing")
    [ "$c_when" = 1 ] || [ -n "$FORGE_FILES" ] || return 0
  fi
  if _fc_missing=$(forge_missing_tool); then
    printf 'forge:%s skipped: %s not installed\n' "$c_id" "$_fc_missing"
    return 0
  fi
  if [ "$c_localdb" = 1 ] && ! forge_local_db; then
    printf 'forge:%s skipped: no local database\n' "$c_id"
    return 0
  fi
  _fc_fn=forge_check_run_$1
  if [ "$mode" = --changed ] && [ "$c_changed" = 1 ] && [ -n "$FORGE_FILES" ]; then _fc_fn=forge_check_changed_$1; fi
  if forge_exec_check "$_fc_fn" "$c_timeout"; then
    grep '^forge:' "$FORGE_TMP/out"
    return 0
  fi
  # --changed, whole-project run: only errors in changed files count
  if [ "$mode" = --changed ] && [ "$_fc_fn" = "forge_check_run_$1" ]; then
    case $(forge_attribute "$c_stage" "$FORGE_TMP/out") in
      other)
        printf 'forge:%s ok for the changed files (errors remain in unchanged files: sh .forge/check.sh --all)\n' "$c_id"
        return 0 ;;
      changed)
        printf 'forge:%s failed\n' "$c_id"
        forge_diagnostics "$FORGE_TMP/out" print | first_lines 15
        return 1 ;;
    esac
  fi
  printf 'forge:%s failed\n' "$c_id"
  first_lines 15 < "$FORGE_TMP/out"
  return 1
}

# forge_run_stage <stage>: every check of <stage>; fails if one fails.
forge_run_stage() {
  _fs_i=1
  _fs_rc=0
  while [ "$_fs_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fs_i"
    if [ "$c_stage" = "$1" ]; then
      forge_run_check "$_fs_i" || _fs_rc=1
    fi
    _fs_i=$((_fs_i + 1))
  done
  [ "$_fs_rc" -eq 0 ] || fail=1
  return "$_fs_rc"
}

# forge_file_stage <stage> <file>: the {files} form of each in-scope check of
# <stage>, on one file (PostToolUse). Prints failures; absent tools are skipped.
forge_file_stage() {
  _fp_i=1
  _fp_rc=0
  FORGE_FILES=$2
  while [ "$_fp_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fp_i"
    if [ "$c_stage" = "$1" ] && [ "$c_files" = 1 ] && forge_scope_"$_fp_i" "$2" && ! forge_missing_tool >/dev/null; then
      if ! forge_exec_check "forge_check_changed_$_fp_i" "$c_timeout"; then
        printf 'forge:%s\n' "$c_id"
        first_lines 15 < "$FORGE_TMP/out"
        _fp_rc=1
      fi
    fi
    _fp_i=$((_fp_i + 1))
  done
  return "$_fp_rc"
}

# forge_typecheck <file>: the full run of each typecheck check whose scope covers <file>;
# only errors in files of $FORGE_TMP/changed count.
forge_typecheck() {
  _ft_i=1
  _ft_rc=0
  while [ "$_ft_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_ft_i"
    if [ "$c_stage" = typecheck ] && forge_scope_"$_ft_i" "$1" && ! forge_missing_tool >/dev/null; then
      if ! forge_exec_check "forge_check_run_$_ft_i" "$c_timeout"; then
        # only errors in changed files wake Claude
        case $(forge_diagnostics "$FORGE_TMP/out") in
          other) ;;
          changed)
            printf 'forge:%s\n' "$c_id"
            forge_diagnostics "$FORGE_TMP/out" print | first_lines 19
            _ft_rc=1 ;;
          *)
            printf 'forge:%s\n' "$c_id"
            first_lines 19 < "$FORGE_TMP/out"
            _ft_rc=1 ;;
        esac
      fi
    fi
    _ft_i=$((_ft_i + 1))
  done
  return "$_ft_rc"
}

# forge_required_tools: every tool the checks use, one per line.
forge_required_tools() {
  _fq_i=1
  while [ "$_fq_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fq_i"
    printf '%s\n' "$c_tools" | tr ' ' '\n'
    _fq_i=$((_fq_i + 1))
  done | awk 'NF && !seen[$0]++'
}

_tc_any=0
_tc_i=1
while [ "$_tc_i" -le "$FORGE_NCHECKS" ]; do
  forge_check_meta_"$_tc_i"
  if [ "$c_stage" = typecheck ] && forge_scope_"$_tc_i" "$file"; then _tc_any=1; fi
  _tc_i=$((_tc_i + 1))
done
[ "$_tc_any" = 1 ] || exit 0

mkdir -p .forge/state 2>/dev/null || exit 0
lock=.forge/state/typecheck.lock
if ! mkdir "$lock" 2>/dev/null; then
  pid=$(cat "$lock/pid" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then exit 0; fi
  rm -rf "$lock"
  mkdir "$lock" 2>/dev/null || exit 0
fi
printf '%s\n' "$$" > "$lock/pid"
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-tc.XXXXXX") || { rm -rf "$lock"; exit 0; }
trap 'rm -rf "$FORGE_TMP" "$lock"' EXIT HUP INT TERM

# the changed set, as check.sh --changed computes it
git status --porcelain --untracked-files=all 2>/dev/null \
  | sed -e 's/^...//' -e 's/^.* -> //' -e 's/^"\(.*\)"$/\1/' | sort -u > "$FORGE_TMP/changed"
if forge_typecheck "$file" > "$FORGE_TMP/report" 2>&1; then exit 0; fi
first_lines 20 < "$FORGE_TMP/report" >&2
exit 2

===== .forge/.gitignore
state/

===== .forge/ast-grep/sgconfig.yml
# Generated by forge.
ruleDirs: [rules]
testConfigs:
  - testDir: rule-tests
languageGlobs:
  tsx: ["*.ts", "*.mts", "*.cts"]

===== .forge/check.sh
#!/bin/sh
# Generated by forge. Do not edit: changes are detected by the integrity check.
# Usage: sh .forge/check.sh [--changed | --all]
# One entry point for the Stop hook, the pre-commit hook and CI.
mode=${1:---all}
case $mode in --changed|--all) ;; *) printf 'usage: sh .forge/check.sh [--changed | --all]\n' >&2; exit 2 ;; esac
cd "$(dirname "$0")/.." || exit 2
FORGE_ROOT=$(pwd)
IFS='
'
FORGE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/forge-check.XXXXXX") || exit 2
trap 'rm -rf "$FORGE_TMP"' EXIT HUP INT TERM

# Generated by forge. Shared helpers for hook scripts. POSIX sh only.
FORGE_AST_GREP_VERSION="0.45.3"

# json_get <key> [raw]: string value of a top-level or tool_input key from the
# JSON in $FORGE_INPUT. With "raw", the value stays JSON-escaped.
json_get() {
  printf '%s' "$FORGE_INPUT" | awk -v key="$1" -v raw="$2" '
    { buf = buf $0 "\n" }
    END {
      if (!match(buf, "\"" key "\"[[:space:]]*:[[:space:]]*\"")) exit
      s = substr(buf, RSTART + RLENGTH); out = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\"") break
        if (c == "\\") {
          i++; d = substr(s, i, 1)
          if (raw != "") { out = out c d; continue }
          if (d == "n") out = out "\n"
          else if (d == "t") out = out "\t"
          else if (d == "r") out = out ""
          else if (d == "u") {
            # \uXXXX: ASCII decoded, anything else kept escaped (UTF-8 arrives unescaped)
            h = tolower(substr(s, i + 1, 4)); v = 0
            for (k = 1; k <= 4; k++) v = v * 16 + index("0123456789abcdef", substr(h, k, 1)) - 1
            if (v > 0 && v < 128) out = out sprintf("%c", v); else out = out "\\u" h
            i += 4
          }
          else out = out d
        } else out = out c
      }
      printf "%s", out
    }'
}

# json_escape: stdin -> JSON string body (no surrounding quotes).
json_escape() {
  awk 'BEGIN { ORS = "" } {
    gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "")
    gsub(/\033/, "\\u001b")
    if (NR > 1) printf "\\n"
    printf "%s", $0
  }'
}

# tool <name>: prints the command that runs the project's own <name>, or nothing if absent.
tool() {
  if [ -f bun.lock ] || [ -f bun.lockb ]; then
    if [ -x "node_modules/.bin/$1" ] && command -v bun >/dev/null 2>&1; then
      printf 'bun run --bun %s' "$1"
    fi
  elif [ -f uv.lock ]; then
    if [ -x ".venv/bin/$1" ]; then printf '.venv/bin/%s' "$1"; fi
  elif [ -x "node_modules/.bin/$1" ]; then
    printf 'node_modules/.bin/%s' "$1"
  elif [ -x ".venv/bin/$1" ]; then
    printf '.venv/bin/%s' "$1"
  fi
}

# astgrep <args>: pinned ast-grep through bunx (bun repos) or uvx.
# Exit status: 0 no finding, 1 findings, other = could not run.
astgrep() {
  if { [ -f bun.lock ] || [ -f bun.lockb ]; } && command -v bunx >/dev/null 2>&1; then
    bunx -p "@ast-grep/cli@$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
  elif command -v uvx >/dev/null 2>&1; then
    uvx -q --from "ast-grep-cli==$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
    _rc=$?
    if [ "$_rc" -gt 1 ]; then
      uvx -q --offline --from "ast-grep-cli==$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
      _rc=$?
    fi
    return "$_rc"
  elif command -v bunx >/dev/null 2>&1; then
    bunx -p "@ast-grep/cli@$FORGE_AST_GREP_VERSION" ast-grep "$@" 2>/dev/null
  else
    return 127
  fi
}

# first_lines <n>: keep the first n lines of stdin.
first_lines() { awk -v n="$1" 'NR <= n'; }

# repo_root: cd to the git repository containing the hook's cwd.
repo_root() {
  _cwd=$(json_get cwd)
  [ -n "$_cwd" ] && cd "$_cwd" 2>/dev/null || return 1
  _top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  cd "$_top" || return 1
}

# rel_path <path>: <path> relative to the current directory (the repository
# root after repo_root), resolving symlinks; fails when outside it.
rel_path() {
  case $1 in /*) _rp_p=$1 ;; *) _rp_p=$(json_get cwd)/$1 ;; esac
  _rp_d=$(cd "$(dirname "$_rp_p")" 2>/dev/null && pwd -P) || return 1
  _rp_root=$(pwd -P)
  case $_rp_d/ in "$_rp_root"/*) ;; *) return 1 ;; esac
  _rp_rel=${_rp_d#"$_rp_root"}
  _rp_rel=${_rp_rel#/}
  printf '%s' "${_rp_rel:+$_rp_rel/}${_rp_p##*/}"
}

# session_id: the hook input's session_id, safe as a file name ("default" if absent).
session_id() {
  _si=$(json_get session_id | tr -c 'A-Za-z0-9_-' '_')
  printf '%s' "${_si:-default}"
}

# forge_sha256: sha256 of stdin, hex.
forge_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{ print $1 }'
  else openssl dgst -sha256 -r | awk '{ print $1 }'
  fi
}

# tree_hash: hash of git diff HEAD plus the untracked files (names and contents).
tree_hash() {
  {
    if git rev-parse --verify -q HEAD >/dev/null; then git diff HEAD --binary 2>/dev/null; else git diff --cached --binary 2>/dev/null; fi
    git ls-files --others --exclude-standard 2>/dev/null | while IFS= read -r _th_f; do
      printf '%s ' "$_th_f"; git hash-object -- "$_th_f" 2>/dev/null || printf '\n'
    done
  } | forge_sha256
}

# ---- generated checks
# Project tools used in check commands, resolved through tool().
biome() { forge_exec_tool biome "$@"; }
tsc() { forge_exec_tool tsc "$@"; }
astro() { forge_exec_tool astro "$@"; }
FORGE_NCHECKS=4

# 1. typescript/astro/check
forge_check_meta_1() {
  c_id='typescript/astro/check'; c_stage=typecheck; c_tools='astro'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_1() {
  case $1 in *.astro|*/*.astro|*.ts|*/*.ts|*.tsx|*/*.tsx) ;; *) return 1 ;; esac
  return 0
}
forge_when_1() { return 1; }
forge_check_run_1() {
astro check
}

# 2. typescript/bun/lock-sync
forge_check_meta_2() {
  c_id='typescript/bun/lock-sync'; c_stage=lint; c_tools='bun'
  c_when=1; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_2() {
  return 0
}
forge_when_2() { case $1 in package.json) return 0 ;; esac; return 1; }
forge_check_run_2() {
bun install --frozen-lockfile
}

# 3. typescript/format-lint
forge_check_meta_3() {
  c_id='typescript/format-lint'; c_stage=lint; c_tools='biome'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=1; c_files=1
}
forge_scope_3() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}
forge_when_3() { return 1; }
forge_check_run_3() {
biome ci .
}
forge_check_changed_3() {
biome check --write --no-errors-on-unmatched $FORGE_FILES
}

# 4. typescript/typecheck
forge_check_meta_4() {
  c_id='typescript/typecheck'; c_stage=typecheck; c_tools='tsc'
  c_when=0; c_localdb=0; c_timeout=''
  c_changed=0; c_files=0
}
forge_scope_4() {
  case $1 in *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) return 0 ;; esac
  return 1
}
forge_when_4() { return 1; }
forge_check_run_4() {
tsc --noEmit -p tsconfig.json
}
# ---- end of generated checks

# Check engine (static part). Expects: IFS = newline, FORGE_TMP, FORGE_NCHECKS,
# forge_check_meta_<n>, forge_scope_<n>, forge_when_<n>, forge_check_run_<n>,
# forge_check_changed_<n>, plus tool() and first_lines() from lib.sh.

# forge_exec_tool <name> <args>: runs the project's own <name>; 127 when absent.
forge_exec_tool() {
  _fx_cmd=$(tool "$1")
  [ -n "$_fx_cmd" ] || { printf 'forge: %s not installed\n' "$1" >&2; return 127; }
  shift
  _fx_ifs=$IFS
  IFS=' '
  # shellcheck disable=SC2086
  set -- $_fx_cmd "$@"
  IFS=$_fx_ifs
  "$@"
}

# forge_has_tool <name>: system runtimes (uv, bun) via PATH, others via tool().
forge_has_tool() {
  case $1 in
    uv|bun) command -v "$1" >/dev/null 2>&1 ;;
    *) [ -n "$(tool "$1")" ] ;;
  esac
}

# forge_missing_tool: prints the first tool of $c_tools that is absent.
forge_missing_tool() {
  _fm_ifs=$IFS
  IFS=' '
  for _fm_t in $c_tools; do
    if ! forge_has_tool "$_fm_t"; then IFS=$_fm_ifs; printf '%s' "$_fm_t"; return 0; fi
  done
  IFS=$_fm_ifs
  return 1
}

# forge_filter <predicate>: lines of stdin for which <predicate> <line> succeeds.
forge_filter() {
  while read -r _ff_line; do
    [ -n "$_ff_line" ] && "$1" "$_ff_line" && printf '%s\n' "$_ff_line"
  done
  return 0
}

# forge_db_url: DATABASE_URL from the environment, then .env, then alembic.ini.
forge_db_url() {
  if [ -n "${DATABASE_URL:-}" ]; then printf '%s' "$DATABASE_URL"; return 0; fi
  if [ -f .env ]; then
    _fd_url=$(sed -n 's/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}DATABASE_URL[[:space:]]*=[[:space:]]*//p' .env \
      | tail -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/")
    if [ -n "$_fd_url" ]; then printf '%s' "$_fd_url"; return 0; fi
  fi
  if [ -f alembic.ini ]; then
    sed -n 's/^[[:space:]]*sqlalchemy\.url[[:space:]]*=[[:space:]]*//p' alembic.ini | head -n 1 | sed 's/[[:space:]]*$//'
  fi
}

# forge_local_db: succeeds when the configured database is on this machine
# (localhost, 127.0.0.1, ::1, empty host or a Unix socket).
forge_local_db() {
  _fl_url=$(forge_db_url)
  [ -n "$_fl_url" ] || return 1
  case $_fl_url in *host=/*|*host=%2[Ff]*) return 0 ;; esac
  _fl_host=$(printf '%s' "$_fl_url" | sed -e 's|^[A-Za-z][A-Za-z0-9+.-]*://||' -e 's|[/?].*$||' -e 's|^.*@||')
  case $_fl_host in
    \[*) _fl_host=$(printf '%s' "$_fl_host" | sed 's|^\[\([^]]*\)\].*$|\1|') ;;
    *) _fl_host=$(printf '%s' "$_fl_host" | sed 's|:.*$||') ;;
  esac
  case $_fl_host in ''|localhost|127.0.0.1|::1|%2[Ff]*) return 0 ;; esac
  return 1
}

# forge_related_py_tests <files>: changed test files plus tests/**/test_<module>.py
# for each changed module, one per line.
forge_related_py_tests() {
  for _fr_f in "$@"; do
    case $_fr_f in
      *.py) ;;
      *) continue ;;
    esac
    _fr_b=${_fr_f##*/}
    case $_fr_b in
      test_*.py|*_test.py) [ -f "$_fr_f" ] && printf '%s\n' "$_fr_f" ;;
      __init__.py|conftest.py) ;;
      *) [ -d tests ] && find tests -type f -name "test_${_fr_b%.py}.py" 2>/dev/null ;;
    esac
  done | sort -u
}

# forge_kill_tree <pid>: kills a process and its descendants.
forge_kill_tree() {
  for _fk_c in $(ps -A -o pid= -o ppid= 2>/dev/null | awk -v p="$1" '$2 == p { print $1 }'); do
    forge_kill_tree "$_fk_c"
  done
  kill "$1" 2>/dev/null
}

# forge_exec_check <fn> <timeout>: runs <fn> with output in $FORGE_TMP/out.
forge_exec_check() {
  set -f
  if [ -n "$2" ]; then
    "$1" > "$FORGE_TMP/out" 2>&1 &
    _fe_pid=$!
    ( sleep "$2"; printf 'forge: timed out after %ss\n' "$2" >> "$FORGE_TMP/out"; forge_kill_tree "$_fe_pid" ) >/dev/null 2>&1 &
    _fe_watch=$!
    wait "$_fe_pid" 2>/dev/null
    _fe_rc=$?
    forge_kill_tree "$_fe_watch"
  else
    "$1" > "$FORGE_TMP/out" 2>&1 < /dev/null
    _fe_rc=$?
  fi
  set +f
  return "$_fe_rc"
}

# forge_diagnostics <output> [print]: sorts the error diagnostics of a whole-project
# run by the files they name (tsc "path(l,c)", "path:l:c" from basedpyright, ruff,
# biome, "--> path:l:c"; absolute paths under the repository are made relative;
# warning-only lines are ignored). Prints "changed" when one names a file of
# $FORGE_TMP/changed, "other" when they name only other files, "none" when no line
# names a file. With "print", prints the lines that name a changed file instead.
forge_diagnostics() {
  awk -v r1="$(pwd)" -v r2="$(pwd -P)" -v mode="$2" '
    FILENAME == ARGV[1] { ch[$0] = 1; next }
    {
      line = $0
      if (line ~ /[Ww]arning/ && line !~ /[Ee]rror/) next
      sub(/^[[:space:]]*(-->[[:space:]]*)?/, "", line)
      if (!match(line, /^[^[:space:]:(]+([(][0-9]+,[0-9]+[)]|:[0-9]+(:[0-9]+)?)/)) next
      p = substr(line, 1, RLENGTH)
      sub(/([(][0-9]+,[0-9]+[)]|:[0-9]+(:[0-9]+)?)$/, "", p)
      if (index(p, r1 "/") == 1) p = substr(p, length(r1) + 2)
      else if (index(p, r2 "/") == 1) p = substr(p, length(r2) + 2)
      sub(/^\.\//, "", p)
      named = 1
      if (p in ch) { hit = 1; if (mode == "print") print $0 }
    }
    END { if (mode != "print") print (hit ? "changed" : named ? "other" : "none") }' "$FORGE_TMP/changed" "$1"
}

# forge_attribute <stage> <output>: for a failed whole-project typecheck or lint run,
# "other" when its errors are all in unchanged files, else "changed" or "none".
forge_attribute() {
  case $1 in typecheck|lint) forge_diagnostics "$2" ;; *) printf 'none\n' ;; esac
}

# forge_run_check <n>: one check under check.sh ($mode, $FORGE_TMP/changed, $FORGE_TMP/existing).
forge_run_check() {
  forge_check_meta_"$1"
  FORGE_FILES=''
  if [ "$mode" = --changed ]; then
    if [ "$c_when" = 1 ]; then
      [ -n "$(forge_filter "forge_when_$1" < "$FORGE_TMP/changed")" ] || return 0
    fi
    FORGE_FILES=$(forge_filter "forge_scope_$1" < "$FORGE_TMP/existing")
    [ "$c_when" = 1 ] || [ -n "$FORGE_FILES" ] || return 0
  fi
  if _fc_missing=$(forge_missing_tool); then
    printf 'forge:%s skipped: %s not installed\n' "$c_id" "$_fc_missing"
    return 0
  fi
  if [ "$c_localdb" = 1 ] && ! forge_local_db; then
    printf 'forge:%s skipped: no local database\n' "$c_id"
    return 0
  fi
  _fc_fn=forge_check_run_$1
  if [ "$mode" = --changed ] && [ "$c_changed" = 1 ] && [ -n "$FORGE_FILES" ]; then _fc_fn=forge_check_changed_$1; fi
  if forge_exec_check "$_fc_fn" "$c_timeout"; then
    grep '^forge:' "$FORGE_TMP/out"
    return 0
  fi
  # --changed, whole-project run: only errors in changed files count
  if [ "$mode" = --changed ] && [ "$_fc_fn" = "forge_check_run_$1" ]; then
    case $(forge_attribute "$c_stage" "$FORGE_TMP/out") in
      other)
        printf 'forge:%s ok for the changed files (errors remain in unchanged files: sh .forge/check.sh --all)\n' "$c_id"
        return 0 ;;
      changed)
        printf 'forge:%s failed\n' "$c_id"
        forge_diagnostics "$FORGE_TMP/out" print | first_lines 15
        return 1 ;;
    esac
  fi
  printf 'forge:%s failed\n' "$c_id"
  first_lines 15 < "$FORGE_TMP/out"
  return 1
}

# forge_run_stage <stage>: every check of <stage>; fails if one fails.
forge_run_stage() {
  _fs_i=1
  _fs_rc=0
  while [ "$_fs_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fs_i"
    if [ "$c_stage" = "$1" ]; then
      forge_run_check "$_fs_i" || _fs_rc=1
    fi
    _fs_i=$((_fs_i + 1))
  done
  [ "$_fs_rc" -eq 0 ] || fail=1
  return "$_fs_rc"
}

# forge_file_stage <stage> <file>: the {files} form of each in-scope check of
# <stage>, on one file (PostToolUse). Prints failures; absent tools are skipped.
forge_file_stage() {
  _fp_i=1
  _fp_rc=0
  FORGE_FILES=$2
  while [ "$_fp_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fp_i"
    if [ "$c_stage" = "$1" ] && [ "$c_files" = 1 ] && forge_scope_"$_fp_i" "$2" && ! forge_missing_tool >/dev/null; then
      if ! forge_exec_check "forge_check_changed_$_fp_i" "$c_timeout"; then
        printf 'forge:%s\n' "$c_id"
        first_lines 15 < "$FORGE_TMP/out"
        _fp_rc=1
      fi
    fi
    _fp_i=$((_fp_i + 1))
  done
  return "$_fp_rc"
}

# forge_typecheck <file>: the full run of each typecheck check whose scope covers <file>;
# only errors in files of $FORGE_TMP/changed count.
forge_typecheck() {
  _ft_i=1
  _ft_rc=0
  while [ "$_ft_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_ft_i"
    if [ "$c_stage" = typecheck ] && forge_scope_"$_ft_i" "$1" && ! forge_missing_tool >/dev/null; then
      if ! forge_exec_check "forge_check_run_$_ft_i" "$c_timeout"; then
        # only errors in changed files wake Claude
        case $(forge_diagnostics "$FORGE_TMP/out") in
          other) ;;
          changed)
            printf 'forge:%s\n' "$c_id"
            forge_diagnostics "$FORGE_TMP/out" print | first_lines 19
            _ft_rc=1 ;;
          *)
            printf 'forge:%s\n' "$c_id"
            first_lines 19 < "$FORGE_TMP/out"
            _ft_rc=1 ;;
        esac
      fi
    fi
    _ft_i=$((_ft_i + 1))
  done
  return "$_ft_rc"
}

# forge_required_tools: every tool the checks use, one per line.
forge_required_tools() {
  _fq_i=1
  while [ "$_fq_i" -le "$FORGE_NCHECKS" ]; do
    forge_check_meta_"$_fq_i"
    printf '%s\n' "$c_tools" | tr ' ' '\n'
    _fq_i=$((_fq_i + 1))
  done | awk 'NF && !seen[$0]++'
}

FORGE_FORBID=''
FORGE_NO_INCREASE=''
FORGE_NO_DECREASE=''


# Changed files (staged, unstaged, untracked), one per line; renames give the new path.
git status --porcelain --untracked-files=all 2>/dev/null \
  | sed -e 's/^...//' -e 's/^.* -> //' -e 's/^"\(.*\)"$/\1/' | sort -u > "$FORGE_TMP/changed"
: > "$FORGE_TMP/existing"
while read -r f; do [ -f "$f" ] && printf '%s\n' "$f" >> "$FORGE_TMP/existing"; done < "$FORGE_TMP/changed"
if [ "$mode" = --all ]; then
  git ls-files --cached --others --exclude-standard 2>/dev/null | sort -u > "$FORGE_TMP/scope"
  : > "$FORGE_TMP/scope.tmp"
  while read -r f; do [ -f "$f" ] && printf '%s\n' "$f" >> "$FORGE_TMP/scope.tmp"; done < "$FORGE_TMP/scope"
  mv "$FORGE_TMP/scope.tmp" "$FORGE_TMP/scope"
else
  cp "$FORGE_TMP/existing" "$FORGE_TMP/scope"
fi

fail=0
report() { printf 'forge:%s %s\n' "$1" "$2"; fail=1; }

# 1. Integrity: owned files match .forge/forge.lock.json.
forge_integrity() {
  lock=.forge/forge.lock.json
  [ -f "$lock" ] || { report forge/integrity "$lock is missing"; return; }
  awk '/^  "files": \{/ { f = 1; next } f && /^  \}/ { exit }
       f { line = $0; sub(/^[[:space:]]*"/, "", line); split(line, a, "\": \""); h = a[2]; sub(/".*/, "", h); print a[1] "\t" h }' "$lock" \
    > "$FORGE_TMP/owned"
  while IFS='	' read -r path hash; do
    [ -n "$path" ] || continue
    case $path in .forge/*|.claude/*) ;; *) continue ;; esac
    if [ ! -f "$path" ]; then report forge/integrity "$path is missing (run forge apply)"
    elif [ "$(forge_sha256 < "$path")" != "$hash" ]; then report forge/integrity "$path was modified (run forge diff)"
    fi
  done < "$FORGE_TMP/owned"
  { find .forge .claude/skills/forge-project -type f 2>/dev/null; find .claude/rules -name 'forge-*.md' -type f 2>/dev/null; } \
    | sed 's|^\./||' | while read -r path; do
      case $path in .forge/state/*|.forge/rules/*|.forge/forge.lock.json) continue ;; esac
      grep -q "^$path	" "$FORGE_TMP/owned" || printf 'forge:forge/integrity %s is not a forge file (remove it or run forge apply)\n' "$path"
    done > "$FORGE_TMP/extra"
  if [ -s "$FORGE_TMP/extra" ]; then cat "$FORGE_TMP/extra"; fail=1; fi
}

# 2. Applied migrations are never modified or deleted.
forge_applied_migrations() {
  git rev-parse --verify -q HEAD >/dev/null || return
  git diff --name-only --diff-filter=MD HEAD -- alembic/versions prisma/migrations 2>/dev/null > "$FORGE_TMP/mig"
  while read -r f; do
    case $f in prisma/migrations/migration_lock.toml) continue ;; esac
    report forge/applied-migration "$f exists at HEAD and was modified or deleted; write a new migration instead"
  done < "$FORGE_TMP/mig"
}

# 3. Tests: no deleted test files; ast-grep counts compared with HEAD.
forge_tests_integrity() {
  git rev-parse --verify -q HEAD >/dev/null || return
  git diff --name-only --diff-filter=D HEAD 2>/dev/null > "$FORGE_TMP/deleted"
  while read -r f; do
    case $f in
      test_*.py|*/test_*.py|*_test.py|*/conftest.py|conftest.py|tests/*|*.test.*|*.spec.*|*/__tests__/*|e2e/*)
        report forge/deleted-test "$f was deleted" ;;
    esac
  done < "$FORGE_TMP/deleted"
  ids=$FORGE_NO_INCREASE
  [ -n "$FORGE_NO_DECREASE" ] && ids="${ids:+$ids|}$FORGE_NO_DECREASE"
  [ -n "$ids" ] && [ -s "$FORGE_TMP/existing" ] || return
  mkdir -p "$FORGE_TMP/head"
  : > "$FORGE_TMP/athead"
  while read -r f; do
    git cat-file -e "HEAD:$f" 2>/dev/null || continue
    mkdir -p "$FORGE_TMP/head/$(dirname "$f")"
    git show "HEAD:$f" > "$FORGE_TMP/head/$f" 2>/dev/null && printf '%s\n' "$f" >> "$FORGE_TMP/athead"
  done < "$FORGE_TMP/existing"
  forge_counts "$FORGE_ROOT" "$ids" "$FORGE_TMP/existing" > "$FORGE_TMP/now" || return
  if [ -s "$FORGE_TMP/athead" ]; then
    forge_counts "$FORGE_TMP/head" "$ids" "$FORGE_TMP/athead" > "$FORGE_TMP/then" || return
  else
    : > "$FORGE_TMP/then"
  fi
  awk -F '\t' -v inc="$FORGE_NO_INCREASE" -v dec="$FORGE_NO_DECREASE" '
    BEGIN { n = split(inc, a, "|"); for (i = 1; i <= n; i++) if (a[i] != "") mi[a[i]] = 1
            n = split(dec, b, "|"); for (i = 1; i <= n; i++) if (b[i] != "") md[b[i]] = 1 }
    FILENAME == ARGV[1] { then[$1 "\t" $2] = $3; keys[$1 "\t" $2] = 1; next }
    { now[$1 "\t" $2] = $3; keys[$1 "\t" $2] = 1 }
    END {
      for (k in keys) {
        split(k, p, "\t"); t = then[k] + 0; w = now[k] + 0
        if ((p[1] in mi) && w > t) printf "forge:%s %s: %d -> %d\n", p[1], p[2], t, w
        if ((p[1] in md) && w < t) printf "forge:%s %s: %d -> %d\n", p[1], p[2], t, w
      }
    }' "$FORGE_TMP/then" "$FORGE_TMP/now" | sort > "$FORGE_TMP/countfail"
  if [ -s "$FORGE_TMP/countfail" ]; then cat "$FORGE_TMP/countfail"; fail=1; fi
}

# forge_counts <dir> <id-regex> <file-list>: "rule<TAB>file<TAB>count" lines.
forge_counts() {
  set -f
  # shellcheck disable=SC2046
  ( cd "$1" && astgrep scan -c "$FORGE_ROOT/.forge/ast-grep/sgconfig.yml" --filter "^($2)\$" --json=stream $(cat "$3") ) > "$FORGE_TMP/json"
  rc=$?
  set +f
  if [ "$rc" -gt 1 ]; then printf 'forge:forge/ast-grep skipped: ast-grep unavailable\n'; return 1; fi
  grep -oE '"(file|ruleId)":"[^"]*"' "$FORGE_TMP/json" \
    | awk -F '"' '$2 == "file" { f = $4 } $2 == "ruleId" { c[$4 "\t" f]++ } END { for (k in c) print k "\t" c[k] }'
}

# 4. ast-grep forbid rules.
forge_forbid() {
  [ -n "$FORGE_FORBID" ] && [ -s "$FORGE_TMP/scope" ] || return
  set -f
  # shellcheck disable=SC2046
  astgrep scan -c .forge/ast-grep/sgconfig.yml --filter "^($FORGE_FORBID)\$" --report-style short $(cat "$FORGE_TMP/scope") > "$FORGE_TMP/forbid"
  rc=$?
  set +f
  if [ "$rc" -gt 1 ]; then printf 'forge:forge/ast-grep skipped: ast-grep unavailable\n'; return; fi
  grep -E '^[^[:space:]]+:[0-9]+:[0-9]+: ' "$FORGE_TMP/forbid" \
    | sed -E 's/^([^[:space:]]+:[0-9]+:[0-9]+): [a-z]+\[[^]]*\]: forge:([^[:space:]]+) (.*)$/forge:\2 \1 \3/' > "$FORGE_TMP/forbid.out"
  if [ -s "$FORGE_TMP/forbid.out" ]; then cat "$FORGE_TMP/forbid.out"; fail=1; fi
}

forge_step() { [ "$fail" -eq 0 ] || exit 1; "$@"; }

forge_step forge_integrity
forge_step forge_applied_migrations
forge_step forge_tests_integrity
forge_step forge_forbid
forge_step forge_run_stage format
forge_step forge_run_stage lint
forge_step forge_run_stage typecheck
forge_step forge_run_stage migration
forge_step forge_run_stage test
exit "$fail"

