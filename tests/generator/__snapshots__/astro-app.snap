# Generated by forge from typescript/no-double-assertion (mode: forbid).
id: typescript/no-double-assertion
language: Tsx
severity: error
message: forge:typescript/no-double-assertion No double type assertions (x as unknown as T). Parse with a schema or narrow with a type guard.
rule:
  any:
    - pattern: $X as unknown as $T
    - pattern: $X as any as $T

===== .forge/ast-grep/rules/typescript/no-ssrf.yml
# Generated by forge from typescript/no-ssrf (mode: advise).
id: typescript/no-ssrf
language: Tsx
severity: warning
message: forge:typescript/no-ssrf Server code does not fetch (fetch, axios, got, ky, ofetch) a URL taken from the request (searchParams, the body, form data, a Server Action argument) unless an allow-list helper (isAllowedUrl, assertSafeUrl, validateUrl, ...) or an ALLOWED_HOSTS-style set is used in the same function.
rule:
  kind: call_expression
  all:
    - has:
        field: function
        regex: ^(fetch|axios|got|ky|ofetch|\$fetch|(axios|got|ky|ofetch)\.(get|post|put|patch|delete|head|request))$
    - has:
        field: arguments
        has:
          nthChild: 1
          matches: tainted
  not:
    inside:
      stopBy: end
      any:
        - kind: function_declaration
        - kind: arrow_function
        - kind: function_expression
        - kind: method_definition
      has:
        stopBy: end
        any:
          - kind: call_expression
            has:
              field: function
              regex: (?i)(allowed|safe|validate|check|assert)_?(url|host|domain|origin)
          - kind: identifier
            regex: (?i)^(allowed|allow_?list|whitelist|trusted)_?(hosts?|domains?|urls?|origins?)$
utils:
  source:
    any:
      - kind: call_expression
        has:
          field: function
          kind: member_expression
          all:
            - has:
                field: property
                regex: ^get(All)?$
            - has:
                field: object
                regex: (^|\.)(searchParams|formData)$
      - kind: call_expression
        has:
          field: function
          kind: member_expression
          all:
            - has:
                field: property
                regex: ^(json|formData)$
            - has:
                field: object
                regex: ^(req|request)$
      - kind: member_expression
        has:
          field: object
          regex: ^(req|request)\.(query|body|params)$
  has-source:
    any:
      - matches: source
      - has:
          stopBy: end
          matches: source
  bound:
    inside:
      stopBy: end
      any:
        - any:
            - kind: function_declaration
            - kind: arrow_function
            - kind: function_expression
            - kind: method_definition
          has:
            stopBy: end
            kind: variable_declarator
            any:
              - all:
                  - has:
                      field: name
                      kind: identifier
                      pattern: $U
                  - has:
                      field: value
                      matches: has-source
              - all:
                  - has:
                      field: name
                      kind: object_pattern
                      has:
                        stopBy: end
                        kind: shorthand_property_identifier_pattern
                        pattern: $U
                  - has:
                      field: value
                      matches: has-source
        - kind: export_statement
          inside:
            kind: program
            has:
              kind: expression_statement
              regex: ^["']use server["'];?$
          has:
            kind: function_declaration
            has:
              field: parameters
              has:
                any:
                  - kind: required_parameter
                  - kind: optional_parameter
                has:
                  field: pattern
                  pattern: $U
  fixed-host:
    any:
      - regex: ^["'`]https?://[A-Za-z0-9.-]+
      - regex: ^`\$\{(process\.)?env\.
      - kind: binary_expression
        has:
          field: left
          stopBy:
            not:
              kind: binary_expression
          regex: ^(["'`]https?://[A-Za-z0-9.-]+|(process\.)?env\.)
  tainted:
    not:
      matches: fixed-host
    any:
      - all:
          - kind: identifier
            pattern: $U
          - matches: bound
      - all:
          - any:
              - kind: non_null_expression
              - kind: as_expression
              - kind: parenthesized_expression
          - has:
              kind: identifier
              pattern: $U
          - matches: bound
      - all:
          - kind: member_expression
            has:
              field: object
              kind: identifier
              pattern: $U
          - matches: bound
      - all:
          - kind: new_expression
            has:
              field: arguments
              has:
                kind: identifier
                pattern: $U
          - matches: bound
      - matches: has-source

===== .forge/ast-grep/rules/typescript/no-stub.yml
# Generated by forge from typescript/no-stub (mode: forbid).
id: typescript/no-stub
language: Tsx
severity: error
message: forge:typescript/no-stub No stub left behind. A throw of "Not implemented" (or "TODO", "unimplemented"), or a named function or method with an empty body, is a stub; overload signatures, interfaces and constructors with parameter properties are not.
ignores:
  - "**/*.d.ts"
rule:
  any:
    - kind: throw_statement
      has:
        stopBy: end
        kind: string_fragment
        regex: (?i)^(not (yet )?implemented|unimplemented|todo)\b
    - all:
        - any:
            - kind: function_declaration
            - kind: method_definition
        - not:
            has:
              field: name
              regex: ^constructor$
        - has:
            field: body
            kind: statement_block
            regex: ^\{\s*((//[^\n]*|/\*(?s:.)*?\*/)\s*)*\}$

===== .forge/ast-grep/rules/typescript/no-swallowed-catch.yml
# Generated by forge from typescript/no-swallowed-catch (mode: forbid).
id: typescript/no-swallowed-catch
language: Tsx
severity: error
message: forge:typescript/no-swallowed-catch A catch block rethrows or uses the error it caught; .catch(() => {}) is not allowed either. Handle the error, log it, or let it propagate.
rule:
  any:
    - kind: catch_clause
      not:
        has:
          field: body
          has:
            stopBy: end
            kind: throw_statement
      any:
        - all:
            - kind: catch_clause
            - not:
                has:
                  field: parameter
                  regex: .
        - all:
            - has:
                field: parameter
                pattern: $ERR
            - not:
                has:
                  field: body
                  has:
                    stopBy: end
                    pattern: $ERR
    - pattern: $P.catch(() => {})
    - pattern: $P.catch(() => undefined)
    - pattern: $P.catch(() => null)

