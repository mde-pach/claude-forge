{
  "tool": "pytest",
  "install": {
    "pypi": "pytest",
    "with": [
      "pytest-testmon==2.2.0"
    ]
  },
  "versions": [
    "7.0.0",
    "7.4.4",
    "8.0.0",
    "9.0.0",
    "9.2.0"
  ],
  "files": {
    "test_ok.py": "def test_ok():\n    assert 1 + 1 == 2\n",
    "test_bad.py": "def test_ok():\n    assert True\n\n\ndef test_bad():\n    assert 1 + 1 == 3\n"
  },
  "calls": [
    {
      "call": "test",
      "exit": [
        1
      ],
      "out": "FAILED test_bad.py::test_bad"
    },
    {
      "call": "test-files test_ok.py",
      "exit": [
        0
      ],
      "out": "1 passed"
    },
    {
      "call": "test-files test_bad.py",
      "exit": [
        1
      ],
      "out": "1 failed, 1 passed"
    },
    {
      "call": "test-changed",
      "exit": [
        1
      ],
      "out": "FAILED test_bad.py::test_bad"
    }
  ],
  "usageProbe": "test --definitely-not-an-option"
}
