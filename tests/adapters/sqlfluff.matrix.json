{
  "tool": "sqlfluff",
  "install": {
    "pypi": "sqlfluff",
    "with": [],
    "withFor": {
      "2.3.5": [
        "click==8.1.7"
      ]
    }
  },
  "versions": [
    "1.2.1",
    "1.3.0",
    "2.3.5",
    "3.0.0",
    "3.0.1",
    "4.4.0"
  ],
  "files": {
    ".sqlfluff": "[sqlfluff]\ndialect = ansi\n",
    "clean.sql": "SELECT a FROM t\n",
    "bad.sql": "SELECT a,b FROM t\n",
    "bad2.sql": "SELECT a,b FROM t\n"
  },
  "calls": [
    {
      "call": "lint clean.sql",
      "exit": [
        0
      ]
    },
    {
      "call": "lint bad.sql",
      "exit": [
        1
      ],
      "out": "^::(warning|notice) title=SQLFluff,file=bad.sql,line=1,col=10"
    },
    {
      "call": "lint bad.sql bad2.sql",
      "exit": [
        1
      ],
      "out": "file=bad2.sql"
    },
    {
      "call": "lint .",
      "exit": [
        1
      ],
      "out": "file=bad.sql"
    }
  ],
  "usageProbe": "lint clean.sql --definitely-not-an-option"
}
