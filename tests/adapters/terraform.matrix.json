{
  "tool": "terraform",
  "install": {
    "urls": {
      "darwin-arm64": "https://releases.hashicorp.com/terraform/{version}/terraform_{version}_darwin_arm64.zip",
      "linux-amd64": "https://releases.hashicorp.com/terraform/{version}/terraform_{version}_linux_amd64.zip"
    },
    "member": "terraform"
  },
  "versions": [
    "1.0.2",
    "1.2.9",
    "1.3.0",
    "1.17.0"
  ],
  "files": {
    "main.tf": "output \"o\" {\n  value = var.missing\n}\n",
    "sub/x.tf": "locals {\n a=1\n}\n",
    "sub/y.tf": "locals {\n b=1\n}\n"
  },
  "calls": [
    {
      "call": "format-check",
      "exit": [
        3
      ],
      "out": "sub/x.tf"
    },
    {
      "call": "validate",
      "exit": [
        1
      ],
      "out": "Reference to undeclared input variable"
    },
    {
      "call": "format sub/x.tf sub/y.tf",
      "exit": [
        0
      ],
      "out": "sub/y.tf"
    },
    {
      "call": "format-check",
      "exit": [
        0
      ],
      "from": "1.3.0"
    }
  ],
  "usageProbe": "format-check -definitely-not-an-option",
  "untestedVersions": {
    "1.0.0": "terraform 1.0.0 and 1.0.1 have no darwin-arm64 release: verified from 1.0.2"
  }
}
