{
  "tool": "editorconfig-checker",
  "install": {
    "pinned": true
  },
  "versions": [
    "4.0.2"
  ],
  "files": {
    ".editorconfig": "root = true\n[*]\nindent_style = space\nindent_size = 2\ntrim_trailing_whitespace = true\ninsert_final_newline = true\n",
    "ec.json": "{}\n",
    "ok.yaml": "a:\n  b: 1\n",
    "bad.yaml": "a:\n\tb: 1   \n"
  },
  "calls": [
    {
      "call": "lint ec.json ok.yaml",
      "exit": [
        0
      ]
    },
    {
      "call": "lint ec.json bad.yaml",
      "exit": [
        1
      ],
      "out": "^bad\\.yaml:2:0: error: trailing whitespace"
    }
  ],
  "usageProbe": "lint ec.json -definitely-not-an-option ok.yaml"
}
