{
  "tool": "docker",
  "install": {
    "urls": {
      "darwin-arm64": "https://github.com/docker/compose/releases/download/v{version}/docker-compose-darwin-aarch64",
      "linux-amd64": "https://github.com/docker/compose/releases/download/v{version}/docker-compose-linux-x86_64"
    },
    "dest": "cli-plugins/docker-compose"
  },
  "versions": [
    "2.24.6",
    "2.24.7",
    "2.34.0",
    "2.35.0",
    "5.6.1"
  ],
  "files": {
    "compose.yaml": "services:\n  web:\n    image: \"nginx:${TAG}\"\n    env_file: .env\n    notakey: 1\n"
  },
  "calls": [
    {
      "call": "validate",
      "exit": [
        1
      ],
      "out": "^validating .*compose.yaml: services\\.web"
    }
  ],
  "usageProbe": "validate --definitely-not-an-option",
  "env": {
    "DOCKER_CONFIG": "{install}"
  },
  "needs": [
    "docker"
  ]
}
