{
  "tool": "tofu",
  "install": {
    "urls": {
      "darwin-arm64": "https://github.com/opentofu/opentofu/releases/download/v{version}/tofu_{version}_darwin_arm64.zip",
      "linux-amd64": "https://github.com/opentofu/opentofu/releases/download/v{version}/tofu_{version}_linux_amd64.zip"
    },
    "member": "tofu"
  },
  "versions": [
    "1.6.0",
    "1.10.0",
    "1.13.2"
  ],
  "files": {
    "main.tf": "output \"o\" {\n  value = var.missing\n}\n",
    "marker.tofu": "",
    "sub/x.tf": "locals {\n a=1\n}\n",
    "sub/y.tf": "locals {\n b=1\n}\n"
  },
  "calls": [
    {
      "call": "format-check",
      "exit": [
        3
      ],
      "out": "sub/x.tf"
    },
    {
      "call": "validate",
      "exit": [
        1
      ],
      "out": "Reference to undeclared input variable"
    },
    {
      "call": "format sub/x.tf sub/y.tf",
      "exit": [
        0
      ],
      "out": "sub/y.tf"
    },
    {
      "call": "format-check",
      "exit": [
        0
      ]
    }
  ],
  "usageProbe": "format-check -definitely-not-an-option"
}
