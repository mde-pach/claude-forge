{
  "tool": "bun",
  "install": {
    "urls": {
      "darwin-arm64": "https://github.com/oven-sh/bun/releases/download/bun-v{version}/bun-darwin-aarch64.zip",
      "linux-amd64": "https://github.com/oven-sh/bun/releases/download/bun-v{version}/bun-linux-x64.zip"
    },
    "member": {
      "darwin-arm64": "bun-darwin-aarch64/bun",
      "linux-amd64": "bun-linux-x64/bun"
    }
  },
  "versions": [
    "1.0.0",
    "1.0.15",
    "1.0.16",
    "1.4.4"
  ],
  "files": {
    "package.json": "{\"name\":\"shop\",\"version\":\"1.0.0\",\"private\":true,\"dependencies\":{\"is-number\":\"7.0.0\"}}\n",
    "a.test.ts": "import { test, expect } from \"bun:test\";\ntest(\"ok\", () => { expect(1).toBe(1); });\n",
    "b.test.ts": "import { test, expect } from \"bun:test\";\ntest(\"bad\", () => { expect(1).toBe(2); });\n"
  },
  "calls": [
    {
      "before": "install",
      "call": "lock-check",
      "exit": [
        0
      ]
    },
    {
      "call": "test-files ./a.test.ts",
      "exit": [
        0
      ],
      "out": "1 pass"
    },
    {
      "call": "test-files ./b.test.ts",
      "exit": [
        1
      ],
      "out": "Expected: 2"
    },
    {
      "write": {
        "package.json": "{\"name\":\"shop\",\"version\":\"1.0.0\",\"private\":true,\"dependencies\":{\"is-number\":\"7.0.0\",\"is-odd\":\"3.0.1\"}}\n"
      },
      "call": "lock-check",
      "exit": [
        1
      ],
      "out": "lockfile had changes, but lockfile is frozen"
    }
  ],
  "usageProbe": "lock-check --definitely-not-an-option",
  "usageFrom": "1.4.4"
}
