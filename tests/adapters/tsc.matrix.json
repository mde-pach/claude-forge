  },
  "versions": [
    "4.0.2",
    "5.0.4",
    "5.9.3",
    "6.0.3",
    "7.0.2"
  ],
  "files": {
    "tsconfig.json": "{\"compilerOptions\": {\"strict\": true, \"noEmit\": true}, \"include\": [\"src\"]}",
    "src/total.ts": "export const total: number = \"12\";\n",
    "tsconfig.ok.json": "{\"compilerOptions\": {\"strict\": true, \"noEmit\": true}, \"files\": [\"ok.ts\"]}",
    "ok.ts": "export const total: number = 12;\n"
  },
  "calls": [
    {
