{
  "name": "@maximedepachtere/forge",
  "version": "0.5.0",
  "description": "Generates a standalone Claude Code setup from rule packs.",
  "type": "module",
  "bin": {
    "forge": "dist/forge.js"
  },
  "files": [
    "dist",
    "packs",
    "templates",
    "schemas"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=dist/forge.js && bun scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "bun run build && bun test --timeout 300000 ./tests/spec/*.test.ts",
    "test:packs": "bun scripts/test-packs.ts",
    "test:report": "bun run build && mkdir -p test-results && bun test --timeout 300000 --reporter=junit --reporter-outfile=test-results/$(node -p process.platform).xml ./tests/spec/*.test.ts",
    "docs:dev": "bun --bun astro dev --root docs",
    "docs:build": "bun --bun astro build --root docs",
    "docs:preview": "bun --bun astro preview --root docs"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.0",
    "@astrojs/starlight": "0.42.6",
    "@types/bun": "1.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/semver": "7.7.1",
    "ajv": "8.17.1",
    "astro": "7.4.1",
    "jsonc-parser": "3.3.1",
    "marked": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.7.2",
    "smol-toml": "1.4.2",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  }
}
