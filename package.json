{
  "name": "@maximedepachtere/forge",
  "version": "0.5.0",
  "description": "Generates a standalone Claude Code setup from rule packs.",
  "type": "module",
  "bin": { "forge": "dist/forge.js" },
  "files": ["dist", "packs", "templates", "schemas"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=dist/forge.js && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test tests"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/semver": "7.7.1",
    "ajv": "8.17.1",
    "jsonc-parser": "3.3.1",
    "semver": "7.7.2",
    "smol-toml": "1.4.2",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  }
}
