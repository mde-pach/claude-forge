diff --git a/packages/zod/src/v4/mini/tests/record.test.ts b/packages/zod/src/v4/mini/tests/record.test.ts
new file mode 100644
index 0000000..8515dbb
--- /dev/null
+++ b/packages/zod/src/v4/mini/tests/record.test.ts
@@ -0,0 +1,10 @@
+import { expect, test } from "vitest";
+import * as z from "zod/mini";
+
+test("key schema producing __proto__ drops the entry", () => {
+  const schema = z.record(z.string().check(z.toLowerCase()), z.object({ a: z.string() }));
+  const out: any = schema.parse(JSON.parse('{"__PROTO__":{"a":"evil"},"KEY":{"a":"x"}}'));
+  expect(Object.getPrototypeOf(out)).toBe(Object.prototype);
+  expect(out.a).toBeUndefined();
+  expect(out).toEqual({ key: { a: "x" } });
+});
