diff --git a/packages/zod/src/v4/classic/tests/record.test.ts b/packages/zod/src/v4/classic/tests/record.test.ts
index dede62a..255df9b 100644
--- a/packages/zod/src/v4/classic/tests/record.test.ts
+++ b/packages/zod/src/v4/classic/tests/record.test.ts
@@ -734,3 +734,26 @@ test("__proto__ in a finite key set becomes an own property", () => {
 
   expect(({} as any).a).toBeUndefined();
 });
+
+test("key schema producing __proto__ drops the entry", async () => {
+  const v = z.object({ a: z.string() });
+  const va = v.refine(async () => true);
+  const cases: [z.ZodType<any, any>, string][] = [
+    [z.string().toLowerCase(), "__PROTO__"],
+    [z.string().trim(), " __proto__ "],
+    [z.string().normalize("NFKC"), "＿＿ｐｒｏｔｏ＿＿"],
+    [z.string().transform((k) => k.replace("x", "")), "__protox__"],
+  ];
+  for (const [k, raw] of cases) {
+    const data = JSON.parse(JSON.stringify({ [raw]: { a: "evil" }, Ok: { a: "fine" } }));
+    for (const value of [v, va]) {
+      const schema = z.record(k, value);
+      for (const out of [await schema.parseAsync(data), ...(value === v ? [schema.parse(data)] : [])] as any[]) {
+        expect(Object.getPrototypeOf(out)).toBe(Object.prototype);
+        expect(out.a).toBeUndefined();
+        expect(Object.keys(out)).not.toContain("__proto__");
+      }
+    }
+  }
+  expect(z.record(z.string().toLowerCase(), v).parse({ KEY: { a: "x" } })).toEqual({ key: { a: "x" } });
+});
