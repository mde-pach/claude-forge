@@ -3677,3 +3677,43 @@ describe("organization additionalFields with returned: false", async () => {
 		expect(dbOrg?.secretField).toBe("updated-secret");
 	});
 });
+
+describe("cancelPendingInvitationsOnReInvite", async () => {
+	const { customFetchImpl, signInWithTestUser } = await getTestInstance({
+		plugins: [
+			organization({
+				cancelPendingInvitationsOnReInvite: true,
+				async sendInvitationEmail() {},
+			}),
+		],
+	});
+	const client = createAuthClient({
+		plugins: [organizationClient()],
+		baseURL: "http://localhost:3000/api/auth",
+		fetchOptions: { customFetchImpl },
+	});
+	const { headers } = await signInWithTestUser();
+
+	it("should cancel the old invitation and create a new one", async () => {
+		const org = await client.organization.create(
+			{ name: "test", slug: "test" },
+			{ headers },
+		);
+		const body = {
+			organizationId: org.data?.id as string,
+			email: "reinvite@test.com",
+			role: "member" as const,
+		};
+		const first = await client.organization.inviteMember(body, { headers });
+		const second = await client.organization.inviteMember(body, { headers });
+		expect(second.error).toBeNull();
+		expect(second.data?.status).toBe("pending");
+		expect(second.data?.id).not.toBe(first.data?.id);
+
+		const list = await client.organization.listInvitations({
+			fetchOptions: { headers },
+		});
+		expect(list.data?.filter((i) => i.status === "pending").length).toBe(1);
+		expect(list.data?.filter((i) => i.status === "canceled").length).toBe(1);
+	});
+});
