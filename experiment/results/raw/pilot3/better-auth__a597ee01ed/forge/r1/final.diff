@@ -3677,3 +3677,62 @@ describe("organization additionalFields with returned: false", async () => {
 		expect(dbOrg?.secretField).toBe("updated-secret");
 	});
 });
+
+describe("cancelPendingInvitationsOnReInvite", async () => {
+	for (const enabled of [true, false]) {
+		describe(`enabled: ${enabled}`, async () => {
+			const { customFetchImpl, signInWithTestUser } = await getTestInstance({
+				plugins: [
+					organization({
+						cancelPendingInvitationsOnReInvite: enabled,
+					}),
+				],
+			});
+			const client = createAuthClient({
+				plugins: [organizationClient()],
+				baseURL: "http://localhost:3000/api/auth",
+				fetchOptions: { customFetchImpl },
+			});
+			const { headers } = await signInWithTestUser();
+			const org = await client.organization.create(
+				{ name: "test", slug: "test" },
+				{ headers },
+			);
+			const invitePayload = {
+				organizationId: org.data?.id as string,
+				email: "reinvite@test.com",
+				role: "member" as const,
+			};
+
+			it("should handle re-inviting without resend", async () => {
+				const first = await client.organization.inviteMember(invitePayload, {
+					headers,
+				});
+				expect(first.data?.status).toBe("pending");
+				const second = await client.organization.inviteMember(invitePayload, {
+					headers,
+				});
+				if (!enabled) {
+					expect(second.error?.message).toBe(
+						ORGANIZATION_ERROR_CODES
+							.USER_IS_ALREADY_INVITED_TO_THIS_ORGANIZATION.message,
+					);
+					return;
+				}
+				expect(second.error).toBeNull();
+				expect(second.data?.status).toBe("pending");
+				expect(second.data?.id).not.toBe(first.data?.id);
+				const list = await client.organization.listInvitations({
+					fetchOptions: { headers },
+				});
+				const forEmail = list.data?.filter(
+					(i) => i.email === invitePayload.email,
+				);
+				expect(forEmail?.filter((i) => i.status === "pending")).toHaveLength(1);
+				expect(forEmail?.filter((i) => i.status === "canceled")).toHaveLength(
+					1,
+				);
+			});
+		});
+	}
+});
