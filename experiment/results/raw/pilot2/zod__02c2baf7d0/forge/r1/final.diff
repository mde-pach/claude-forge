--- a/packages/zod/src/v4/classic/schemas.ts
+++ b/packages/zod/src/v4/classic/schemas.ts
@@ -2642,9 +2642,28 @@ export function json(params?: string | core.$ZodCustomParams): ZodJSONSchema {
 
 // preprocess
 
+export interface ZodPreprocess<B extends core.SomeType = core.$ZodType>
+  extends _ZodType<core.$ZodPreprocessInternals<B>>,
+    core.$ZodPreprocess<B> {
+  "~standard": ZodStandardSchemaWithJSON<this>;
+  in: ZodTransform;
+  out: B;
+}
+export const ZodPreprocess: core.$constructor<ZodPreprocess> = /*@__PURE__*/ core.$constructor(
+  "ZodPreprocess",
+  (inst, def) => {
+    ZodPipe.init(inst, def);
+    core.$ZodPreprocess.init(inst, def);
+  }
+);
+
 export function preprocess<A, U extends core.SomeType, B = unknown>(
   fn: (arg: B, ctx: core.$RefinementCtx) => A,
   schema: U
-): ZodPipe<ZodTransform<A, B>, U> {
-  return pipe(transform(fn as any), schema as any) as any;
+): ZodPreprocess<U> {
+  return new ZodPreprocess({
+    type: "pipe",
+    in: transform(fn as any) as any,
+    out: schema as any,
+  }) as any;
 }
diff --git a/packages/zod/src/v4/classic/tests/preprocess.test.ts b/packages/zod/src/v4/classic/tests/preprocess.test.ts
index f6d406a..66fd6b3 100644
--- a/packages/zod/src/v4/classic/tests/preprocess.test.ts
+++ b/packages/zod/src/v4/classic/tests/preprocess.test.ts
@@ -280,3 +280,39 @@ test("perform transform with non-fatal issues", () => {
     ]]
   `);
 });
+
+test("preprocess defers optionality to inner schema", () => {
+  const f = (v: unknown) => v;
+  const outer = z.object({ x: z.preprocess(f, z.number()).optional() });
+  const inner = z.object({ x: z.preprocess(f, z.number().optional()) });
+  expect(outer.parse({})).toEqual({});
+  expect(inner.parse({})).toEqual({});
+  expect(inner.parse({ x: 1 })).toEqual({ x: 1 });
+
+  const p = z.preprocess(f, z.string().optional());
+  expect(p._zod.optin).toBe("optional");
+  expect(p._zod.optout).toBe("optional");
+  expect(p._zod.values).toBeUndefined();
+  expect(p instanceof z.ZodPipe && p instanceof z.ZodPreprocess).toBe(true);
+  expectTypeOf(p._zod.optin).toEqualTypeOf<"optional">();
+  expectTypeOf(z.preprocess(f, z.string())._zod.optin).toEqualTypeOf<"optional" | undefined>();
+  expectTypeOf(z.preprocess(f, z.string())).toExtend<z.ZodPipe<z.core.$ZodTransform, z.ZodString>>();
+  expectTypeOf<z.input<typeof p>>().toEqualTypeOf<unknown>();
+});
+
+test("preprocess record key runs on every key", () => {
+  const r = z.record(
+    z.preprocess((v) => String(v).toLowerCase(), z.enum(["a", "b"])),
+    z.string()
+  );
+  expect(r.parse({ A: "x", B: "y" })).toEqual({ a: "x", b: "y" });
+});
+
+test("codec output examples are stripped from input JSON schema", () => {
+  const c = z.codec(z.string(), z.number(), { decode: Number, encode: String }).meta({ examples: [42] });
+  expect(z.toJSONSchema(c, { io: "input" })).toEqual({
+    $schema: "https://json-schema.org/draft/2020-12/schema",
+    type: "string",
+  });
+  expect(z.toJSONSchema(c, { io: "output" })).toMatchObject({ type: "number", examples: [42] });
+});
diff --git a/packages/zod/src/v4/core/schemas.ts b/packages/zod/src/v4/core/schemas.ts
index 9523a5c..172103f 100644
--- a/packages/zod/src/v4/core/schemas.ts
+++ b/packages/zod/src/v4/core/schemas.ts
@@ -4033,6 +4033,33 @@ function handlePipeResult(left: ParsePayload, next: $ZodType, ctx: ParseContextI
   return next._zod.run({ value: left.value, issues: left.issues }, ctx);
 }
 
+export interface $ZodPreprocessDef<B extends SomeType = $ZodType> extends $ZodPipeDef<$ZodTransform, B> {}
+
+export interface $ZodPreprocessInternals<B extends SomeType = $ZodType>
+  extends $ZodTypeInternals<core.output<B>, unknown> {
+  def: $ZodPreprocessDef<B>;
+  isst: never;
+  values: undefined;
+  optin: B["_zod"]["optin"];
+  optout: B["_zod"]["optout"];
+  propValues: undefined;
+}
+
+export interface $ZodPreprocess<B extends SomeType = $ZodType> extends $ZodType {
+  _zod: $ZodPreprocessInternals<B>;
+}
+
+export const $ZodPreprocess: core.$constructor<$ZodPreprocess> = /*@__PURE__*/ core.$constructor(
+  "$ZodPreprocess",
+  (inst, def) => {
+    $ZodPipe.init(inst, def);
+    util.defineLazy(inst._zod, "values", () => undefined);
+    util.defineLazy(inst._zod, "propValues", () => undefined);
+    util.defineLazy(inst._zod, "optin", () => def.out._zod.optin);
+    util.defineLazy(inst._zod, "optout", () => def.out._zod.optout);
+  }
+);
+
