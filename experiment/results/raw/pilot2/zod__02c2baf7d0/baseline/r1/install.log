$ set -e
W=/tmp/pnpm-store
for d in /cache/pnpm/v*; do
  [ -d "$d" ] || continue
  v=$(basename "$d"); mkdir -p "$W/$v"
  for e in "$d"/*; do
    n=$(basename "$e")
    if [ "$n" = files ]; then ln -sfn "$e" "$W/$v/files"; else cp -a "$e" "$W/$v/"; fi
  done
done
HUSKY=0 pnpm install --frozen-lockfile --offline --store-dir "$W" --package-import-method copy
find .git/hooks -type f ! -name '*.sample' -delete
git config --unset core.hooksPath || true
# fumadocs-mdx output of the packages/docs postinstall is not deterministic (parity
# fingerprint); docs are neither built nor tested here.
rm -rf packages/docs/.source

