$ set -e
W=/tmp/pnpm-store
for d in /cache/pnpm/v*; do
  [ -d "$d" ] || continue
  v=$(basename "$d"); mkdir -p "$W/$v"
  for e in "$d"/*; do
    n=$(basename "$e")
    if [ "$n" = files ]; then ln -sfn "$e" "$W/$v/files"; else cp -a "$e" "$W/$v/"; fi
  done
done
pnpm install --frozen-lockfile --offline --ignore-scripts --store-dir "$W" --package-import-method copy
(cd packages/test && pnpm run build)
(cd packages/inngest && pnpm run pb:version)

