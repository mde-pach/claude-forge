+const sandboxPollIntervalMs = 1_000;
+const sleep = (ms: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/**
+ * Poll Get until the sandbox is RUNNING, fails, or the deadline passes.
+ * Never re-sends Create.
+ */
+const waitForRunning = async (
+  transport: SandboxRestTransport,
+  initial: SandboxRef,
+  timeoutMs: number,
+  action: "create" | "waitUntilRunning",
+): Promise<SandboxRef> => {
+  const deadline = Date.now() + timeoutMs;
+  let current = initial;
+  for (;;) {
+    if (current.status === "RUNNING") {
+      return current;
+    }
+    if (current.status !== "PENDING" && current.status !== "STARTING") {
+      throw new SandboxError({
+        action,
+        code: "sandbox_start_failed",
+        message: `Sandbox entered ${current.status} before reaching RUNNING`,
+        sandboxId: current.id,
+        retryable: false,
+        details: [
+          {
+            status: current.status,
+            ...(current.error !== undefined && { error: current.error }),
+          },
+        ],
+      });
+    }
+    const remaining = deadline - Date.now();
+    if (remaining <= 0) {
+      throw new SandboxError({
+        action,
+        code: "sandbox_start_timed_out",
+        message: `Sandbox did not reach RUNNING within ${timeoutMs} milliseconds`,
+        sandboxId: current.id,
+        retryable: false,
+        details: [{ status: current.status, timeoutMs }],
+      });
+    }
+    await sleep(Math.min(sandboxPollIntervalMs, remaining));
+    try {
+      const { envelope } = await transport.json(
+        "get",
+        "GET",
+        `/v2/sandboxes/${encodeURIComponent(current.id)}`,
+        { statuses: [200], sandboxId: current.id },
+      );
+      current = sandboxRefFromResource(envelope?.data);
+    } catch (error) {
+      if (error instanceof SandboxError && error.retryable) {
+        continue;
+      }
+      throw error;
+    }
+  }
+};
