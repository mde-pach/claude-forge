+def test_multi_modal_content_narrows_binary_image():
+    image = BinaryContent(data=b'\x89PNG', media_type='image/png')
+    audio = BinaryContent(data=b'\x00\x01', media_type='audio/mpeg')
+    msgs = [
+        ModelRequest(
+            parts=[
+                UserPromptPart(content=[image, audio]),
+                ToolReturnPart(tool_name='t', content=image, tool_call_id='c'),
+            ]
+        )
+    ]
+    for loaded in (
+        ModelMessagesTypeAdapter.validate_json(ModelMessagesTypeAdapter.dump_json(msgs)),
+        ModelMessagesTypeAdapter.validate_python(ModelMessagesTypeAdapter.dump_python(msgs, mode='json')),
+    ):
+        user, tool = loaded[0].parts
+        assert isinstance(user, UserPromptPart) and isinstance(tool, ToolReturnPart)
+        img, aud = user.content
+        assert type(img) is BinaryImage
+        assert img.data == image.data and img.identifier == image.identifier
+        assert type(aud) is BinaryContent
+        assert type(tool.content) is BinaryImage
