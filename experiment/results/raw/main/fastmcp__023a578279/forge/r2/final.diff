diff --git a/tests/server/test_dependencies.py b/tests/server/test_dependencies.py
index 8555551..bafaeb3 100644
--- a/tests/server/test_dependencies.py
+++ b/tests/server/test_dependencies.py
@@ -1193,3 +1193,35 @@ class TestSharedDependencies:
                 in result.messages[0].content.text
             )
             assert call_count == 1
+
+
+async def test_shared_dependency_with_task_enabled_component():
+    """Shared() resolves once per server even when the Docket path is active."""
+    from fastmcp import Client, FastMCP
+    from fastmcp.dependencies import Shared
+
+    calls = 0
+
+    def get_config() -> dict[str, str]:
+        nonlocal calls
+        calls += 1
+        return {"key": "value"}
+
+    mcp = FastMCP("task-capable-server")
+
+    @mcp.tool(task=True)
+    async def background_tool(x: int) -> int:
+        return x
+
+    @mcp.tool()
+    async def normal_tool(config: dict[str, str] = Shared(get_config)) -> str:
+        return config["key"]
+
+    async with Client(mcp) as client:
+        for _ in range(2):
+            result = await client.call_tool("normal_tool", {})
+            content = result.content[0]
+            assert isinstance(content, TextContent)
+            assert content.text == "value"
+
+    assert calls == 1
