diff --git a/packages/zod/src/v4/classic/tests/to-json-schema.test.ts b/packages/zod/src/v4/classic/tests/to-json-schema.test.ts
index 132ad8e..f3e4845 100644
--- a/packages/zod/src/v4/classic/tests/to-json-schema.test.ts
+++ b/packages/zod/src/v4/classic/tests/to-json-schema.test.ts
@@ -3188,3 +3188,50 @@ test("partialRecord does not require finite keys", () => {
   expect(result.propertyNames).toEqual({ type: "string", enum: ["__proto__", "b"] });
   expect(result.additionalProperties).toEqual({ type: "string" });
 });
+
+describe("override handles unrepresentable types", () => {
+  const override = (ctx: any) => {
+    if (ctx.zodSchema._zod.def.type === "date") {
+      ctx.jsonSchema.type = "string";
+      ctx.jsonSchema.format = "date-time";
+    }
+  };
+  const date = { type: "string", format: "date-time" };
+
+  test("handled nodes do not throw; others still do", () => {
+    expect(z.toJSONSchema(z.object({ when: z.date() }), { override }).properties).toEqual({ when: date });
+    expect(() => z.toJSONSchema(z.object({ when: z.date(), id: z.bigint() }), { override })).toThrow(
+      "BigInt cannot be represented in JSON Schema"
+    );
+  });
+
+  test("annotations do not count as handling", () => {
+    const describe = (ctx: any) => {
+      ctx.jsonSchema.description = "y";
+    };
+    expect(() => z.toJSONSchema(z.date(), { override: describe })).toThrow("Date cannot be represented");
+    expect(() => z.toJSONSchema(z.date().describe("x"), { override: () => {} })).toThrow("Date cannot be represented");
+  });
+
+  test("wrapped, cloned, reused, and openapi-3.0", () => {
+    expect(z.toJSONSchema(z.date().describe("x").optional(), { override })).toMatchObject({
+      ...date,
+      description: "x",
+    });
+    const d = z.date().meta({ id: "D" });
+    const result = z.toJSONSchema(z.object({ a: d, b: d }), { override, target: "openapi-3.0" });
+    expect(result.definitions).toEqual({ D: date });
+  });
+
+  test("value-level errors still throw", () => {
+    expect(() =>
+      z.toJSONSchema(
+        z.string().catch(() => {
+          throw new Error("x");
+        }),
+        { override }
+      )
+    ).toThrow("Dynamic catch values are not supported in JSON Schema");
+    expect(() => z.toJSONSchema(z.literal([undefined, "a"]))).toThrow("Literal `undefined` cannot be represented");
+  });
+});
