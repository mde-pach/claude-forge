diff --git a/tests/test_exceptions_mcp_error.py b/tests/test_exceptions_mcp_error.py
new file mode 100644
index 0000000..3240799
--- /dev/null
+++ b/tests/test_exceptions_mcp_error.py
@@ -0,0 +1,23 @@
+from mcp import MCPError
+from mcp_types import INTERNAL_ERROR, INVALID_PARAMS
+
+from fastmcp.exceptions import (
+    DisabledError,
+    NotFoundError,
+    ToolError,
+    ValidationError,
+    to_mcp_error,
+)
+
+
+def test_to_mcp_error_mapping():
+    for exc in (NotFoundError("a"), DisabledError("a"), ValidationError("a")):
+        assert to_mcp_error(exc).error.code == INVALID_PARAMS
+    err = to_mcp_error(ToolError("boom"))
+    assert err.error.code == INTERNAL_ERROR
+    assert err.error.message == "boom"
+
+
+def test_to_mcp_error_passthrough():
+    err = MCPError(code=-32000, message="x")
+    assert to_mcp_error(err) is err
