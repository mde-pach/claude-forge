 from fastmcp.exceptions import ToolError as _ToolError
 from fastmcp.telemetry import extract_trace_context, get_tracer
 
+SEAM_SPAN_MARKER = "fastmcp.span.seam"
+
+# The dispatcher-level SERVER span that the next `server_span` should enrich
+# instead of opening a second span for the same request.
+_seam_span: ContextVar[Span | None] = ContextVar("fastmcp_seam_span", default=None)
+
+
+def record_span_exception(span: Span, exc: BaseException) -> None:
+    """Record an exception on a span and mark it as an error."""
+    if span.is_recording():
+        error_type = (
+            "tool_error" if isinstance(exc, _ToolError) else type(exc).__qualname__
+        )
+        span.set_attribute("error.type", error_type)
+        span.record_exception(exc)
+        span.set_status(Status(StatusCode.ERROR, str(exc)))
+
+
+def _has_error_status(span: Span) -> bool:
+    status = getattr(span, "status", None)
+    return status is not None and status.status_code == StatusCode.ERROR
+
+
+@contextmanager
+def seam_span(
+    method: str, server_name: str, parent_context: Context | None = None
+) -> Generator[Span, None, None]:
+    """Create the single SERVER span for an inbound request at the dispatcher.
+
+    `server_span` enriches this span (name and component attributes) rather than
+    creating a second one when the request reaches a tool, resource or prompt.
+    """
+    tracer = get_tracer()
+    with tracer.start_as_current_span(
+        method,
+        context=parent_context
+        if parent_context is not None
+        else _get_parent_trace_context(),
+        kind=SpanKind.SERVER,
+    ) as span:
+        if span.is_recording():
+            span.set_attributes(
+                {
+                    SEAM_SPAN_MARKER: True,
+                    "mcp.method.name": method,
+                    "fastmcp.server.name": server_name,
+                    **get_auth_span_attributes(),
+                    **get_session_span_attributes(),
+                }
+            )
+        token = _seam_span.set(span)
+        try:
+            yield span
+        except Exception as e:
+            if not _has_error_status(span):
+                record_span_exception(span, e)
+            raise
+        finally:
+            _seam_span.reset(token)
+
 
 def get_auth_span_attributes() -> dict[str, str]:
     """Get auth attributes for the current request, if authenticated."""
