+class FastMCPTelemetryMiddleware:
+    """Opens the single SERVER span for every inbound request.
+
+    Replaces the SDK's own OpenTelemetry middleware so a request never produces
+    two SERVER spans. For tool, resource and prompt calls, `server_span` enriches
+    this span with component attributes and the rich name.
+    """
+
+    def __init__(self, fastmcp: FastMCP):
+        self._ref: weakref.ref[FastMCP] = weakref.ref(fastmcp)
+
+    async def __call__(
+        self, ctx: ServerRequestContext, call_next: CallNext
+    ) -> HandlerResult:
+        from fastmcp.server.telemetry import seam_span
+        from fastmcp.telemetry import extract_trace_context
+
+        # Notifications carry no request id and produce no SERVER span.
+        if ctx.request_id is None:
+            return await call_next(ctx)
+
+        fastmcp = self._ref()
+        server_name = fastmcp.name if fastmcp is not None else ""
+        parent = extract_trace_context(ctx.meta) if ctx.meta else None
+        with seam_span(ctx.method, server_name, parent_context=parent):
+            return await call_next(ctx)
+
+
