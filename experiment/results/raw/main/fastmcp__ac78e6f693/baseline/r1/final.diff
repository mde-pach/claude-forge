+        # Swap the SDK's OpenTelemetryMiddleware for FastMCP's, which owns the
+        # one SERVER span per request, and keep it outermost.
+        self.middleware[:] = [
+            m for m in self.middleware if not isinstance(m, OpenTelemetryMiddleware)
+        ]
+        self.middleware.insert(
+            0,
+            cast(
