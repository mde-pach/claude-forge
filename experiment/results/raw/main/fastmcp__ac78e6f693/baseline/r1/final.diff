+
+def to_mcp_error(exc: Exception, *, default_code: int = INTERNAL_ERROR) -> MCPError:
+    """Map an exception to the `MCPError` carrying its wire error code.
+
+    `NotFoundError`, `DisabledError` and `ValidationError` map to
+    `INVALID_PARAMS`; everything else maps to `default_code`. An `MCPError` is
+    returned unchanged.
+    """
+    if isinstance(exc, MCPError):
+        return exc
+    if isinstance(exc, NotFoundError | DisabledError | ValidationError):
+        code = INVALID_PARAMS
+    else:
+        code = default_code
+    return MCPError(code=code, message=str(exc))
