+def _convert_media_part(part: dict[str, Any], url_value: Any, modality: Literal['image', 'document']) -> MessagePart:
+    url = _url_of(url_value)
+    if url:
+        return UriPart(type='uri', uri=url, modality=modality)
+    if part.get('file_data'):
+        return BlobPart(type='blob', content=part['file_data'], modality=modality)
+    file_id = part.get('file_id')
+    if isinstance(file_id, str):
+        return FilePart(type='file', file_id=file_id, modality=modality)
+    return part
