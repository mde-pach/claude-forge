+def _url_of(value: Any) -> str | None:
+    """Extract a URL from a string or a `{'url': ...}` dict."""
+    if isinstance(value, dict):
+        value = cast('dict[str, Any]', value).get('url')
+    return value if isinstance(value, str) and value else None
+
