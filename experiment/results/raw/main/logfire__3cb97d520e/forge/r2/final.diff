+def _media_url(part: dict[str, Any], key: str) -> str | None:
+    """Get a URL from `part[key]`, which may be a string or a dict with a string `url`."""
+    value = part.get(key)
+    if isinstance(value, dict):
+        value = cast('dict[str, Any]', value).get('url')
+    return value if isinstance(value, str) and value else None
+
+
+def _convert_media_part(part: dict[str, Any], url_key: str, modality: Literal['image', 'document']) -> MessagePart:
+    url = _media_url(part, url_key)
+    if url:
+        return UriPart(type='uri', uri=url, modality=modality)
+    if part.get('file_data'):
+        return BlobPart(type='blob', content=part['file_data'], modality=modality)
+    file_id = part.get('file_id')
+    if isinstance(file_id, str):
+        return FilePart(type='file', file_id=file_id, modality=modality)
+    return part
+
