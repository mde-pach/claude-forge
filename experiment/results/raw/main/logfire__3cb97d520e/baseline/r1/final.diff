+def _content_item_event_value(item: Any) -> Any:
+    """Return the event content for a message content part, or `_NO_VALUE` if unrecognised."""
+    if not isinstance(item, dict):
+        return _NO_VALUE
+    item = cast('dict[str, Any]', item)
+    typ = item.get('type')
+    if typ in ('input_text', 'output_text'):
+        return item['text'] if 'text' in item else _NO_VALUE
+    if typ in ('image_url', 'input_image'):
+        url = _url_value(item.get('image_url'))
+        if url:
+            return url
+        if item.get('file_data') is not None:
+            return '[file_data]'
+        if item.get('file_id') is not None:
+            return item['file_id']
+        return _NO_VALUE
+    if typ == 'input_file':
+        url = _url_value(item.get('file_url'))
+        if url:
+            return url
+        if item.get('file_id') is not None:
+            return item['file_id']
