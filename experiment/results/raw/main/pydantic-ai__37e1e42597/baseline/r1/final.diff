+def _index_of_request(messages: list[_messages.ModelMessage], request: _messages.ModelRequest) -> int | None:
+    for index, message in enumerate(messages):
+        if message is request:
+            return index
+    for index in range(len(messages) - 1, -1, -1):
+        if _is_same_request(messages[index], request):
+            return index
+    return None
+
+
+def _find_rebuilt_request(
+    input_messages: list[_messages.ModelMessage],
+    output_messages: list[_messages.ModelMessage],
+    resumed_request: _messages.ModelRequest,
+) -> _messages.ModelRequest | None:
+    """Find the stand-in for `resumed_request` in processed messages when it was rebuilt (and so can't be matched directly).
+
+    Returns `None` if the request is still present unchanged, or if no rebuilt version can be identified
+    (e.g. because it was removed).
+    """
+    if _index_of_request(output_messages, resumed_request) is not None:
+        return None
+    resumed_index = _index_of_request(input_messages, resumed_request)
+    if resumed_index is None:
+        others, after = input_messages, input_messages
+    else:
+        others = input_messages[:resumed_index] + input_messages[resumed_index + 1 :]
+        after = input_messages[resumed_index + 1 :]
+
+    def matches(a: _messages.ModelMessage, b: _messages.ModelMessage) -> bool:
+        return a is b or a == b
+
+    for index in range(len(output_messages) - 1, -1, -1):
+        candidate = output_messages[index]
+        # A rebuilt request is a new request that doesn't correspond to any other input message...
+        if not isinstance(candidate, _messages.ModelRequest) or any(matches(candidate, o) for o in others):
+            continue
+        # ...and everything after it must be (a subsequence of) what followed the resumed request.
+        position = 0
+        for tail_message in output_messages[index + 1 :]:
+            while position < len(after) and not matches(after[position], tail_message):
+                position += 1
+            if position == len(after):
+                break
+            position += 1
+        else:
+            return candidate
+    return None
+
+
 def _is_same_request(message: _messages.ModelMessage, request: _messages.ModelRequest) -> bool:
     if not isinstance(message, _messages.ModelRequest):
         return False
