+def _track_resumed_request(
+    input_messages: list[_messages.ModelMessage],
+    output_messages: list[_messages.ModelMessage],
+    resumed_request: _messages.ModelRequest,
+) -> _messages.ModelRequest | None:
+    """Find the object in `output_messages` that represents `resumed_request` after history processing.
+
+    Matches by identity, then by value. Failing that, the request was rebuilt: it's the last new `ModelRequest`
+    that precedes the first surviving message that followed it in the input. Returns `None` if it was removed.
+    """
+    for message in output_messages:
+        if message is resumed_request:
+            return message
+    for message in reversed(output_messages):
+        if _is_same_request(message, resumed_request) and isinstance(message, _messages.ModelRequest):
+            return message
+
+    input_ids = {id(m) for m in input_messages}
+    start = next((i for i, m in enumerate(input_messages) if m is resumed_request), None)
+    after = input_messages[start + 1 :] if start is not None else []
+    region_end = next(
+        (i for i, m in enumerate(output_messages) if any(m is a or m == a for a in after)),
+        len(output_messages),
+    )
+    for message in reversed(output_messages[:region_end]):
+        if isinstance(message, _messages.ModelRequest) and id(message) not in input_ids:
+            return message
+    return None
+
+
 def _is_same_request(message: _messages.ModelMessage, request: _messages.ModelRequest) -> bool:
     if not isinstance(message, _messages.ModelRequest):
         return False
