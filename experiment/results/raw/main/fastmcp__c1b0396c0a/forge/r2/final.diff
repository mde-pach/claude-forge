+class TestIPv6TransitionAddresses:
+    """IPv6 transition encodings must not smuggle in blocked IPv4 targets."""
+
+    @pytest.mark.parametrize(
+        "ip",
+        [
+            "64:ff9b:1::a9fe:a9fe",
+            "64:ff9b:1:a9fe:a9:fe00::",
+            "::ffff:0:7f00:1",
+            "::0a00:1",
+            "::6440:1",
+            "2002:a9fe:a9fe::1",
+            "2606:4700::5efe:192.168.1.1",
+            "2606:4700::200:5efe:169.254.169.254",
+        ],
+    )
+    def test_blocked_embedded_ipv4(self, ip: str):
+        assert is_ip_allowed(ip) is False
+
+    @pytest.mark.parametrize(
+        "ip",
+        [
+            "64:ff9b::0808:0808",
+            "::ffff:0:0808:0808",
+            "::0808:0808",
+            "2606:4700::5efe:8.8.8.8",
+        ],
+    )
+    def test_public_embedded_ipv4_allowed(self, ip: str):
+        assert is_ip_allowed(ip) is True
+
+    async def test_validate_url_blocks_transition_address(self):
+        with pytest.raises(SSRFError, match="blocked IP"):
+            await validate_url("https://[64:ff9b:1::a9fe:a9fe]/path")
+
+
 class TestValidateURL:
