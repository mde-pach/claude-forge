+def _matches_registered_uri(requested: str, registered: str) -> bool:
+    """Check a requested redirect URI against one registered URI.
+
+    Matches exactly, or, for loopback registrations, with any port.
+    """
+    if requested == registered:
+        return True
+
+    try:
+        req = urlparse(requested)
+        reg = urlparse(registered)
+        req_host = (req.hostname or "").lower()
+        reg_host = (reg.hostname or "").lower()
+    except ValueError:
+        return False
+
+    if reg_host not in _LOOPBACK_HOSTS or req_host != reg_host:
+        return False
+    # Userinfo is never allowed in a loopback match
+    if "@" in req.netloc or "@" in reg.netloc:
+        return False
+
+    return (
+        req.scheme == reg.scheme
+        and (req.path or "/") == (reg.path or "/")
+        and req.params == reg.params
+        and req.query == reg.query
+        and req.fragment == reg.fragment
+    )
+
