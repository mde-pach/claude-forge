+    def test_default_restricts_to_registered_uris(self):
+        """With no patterns, DCR clients are limited to registered URIs (loopback ports may vary)."""
+        client = ProxyDCRClient(
+            client_id="test",
+            client_secret="secret",
+            redirect_uris=[AnyUrl("http://localhost:3000/callback")],
+        )
+
+        for ok in (
+            "http://localhost:3000/callback",
+            "http://localhost:8080/callback",
+            "http://LOCALHOST:9/callback",
+        ):
+            assert client.validate_redirect_uri(AnyUrl(ok)) == AnyUrl(ok)
+
+        for bad in (
+            "http://localhost:8080/other",
+            "http://127.0.0.1:3000/callback",
+            "http://example.com/callback",
+            "https://localhost:3000/callback",
+            "http://user@localhost:8080/callback",
+            "http://localhost:8080/callback?x=1",
+        ):
+            with pytest.raises(InvalidRedirectUriError, match="not registered"):
+                client.validate_redirect_uri(AnyUrl(bad))
+
+    def test_loopback_empty_path_treated_as_root(self):
+        client = ProxyDCRClient(
+            client_id="test",
+            client_secret="secret",
+            redirect_uris=[AnyUrl("http://localhost:3000")],
+        )
+        uri = AnyUrl("http://localhost:8080/")
+        assert client.validate_redirect_uri(uri) == uri
+
+    def test_non_loopback_requires_exact_match(self):
+        client = ProxyDCRClient(
+            client_id="test",
+            client_secret="secret",
+            redirect_uris=[AnyUrl("https://client.example.com/oauth/callback")],
+        )
+        exact = AnyUrl("https://client.example.com/oauth/callback")
+        assert client.validate_redirect_uri(exact) == exact
+        for bad in (
+            "https://client.example.com:8443/oauth/callback",
+            "https://evil.example.com/oauth/callback",
+        ):
+            with pytest.raises(InvalidRedirectUriError):
+                client.validate_redirect_uri(AnyUrl(bad))
+
+    def test_no_registered_uris_accepts_nothing(self):
+        client = ProxyDCRClient(
+            client_id="test", client_secret="secret", redirect_uris=None
+        )
+        with pytest.raises(InvalidRedirectUriError):
+            client.validate_redirect_uri(AnyUrl("http://localhost:3000"))
+
+    def test_allow_unregistered_redirect_uris(self):
+        client = ProxyDCRClient(
+            client_id="test",
+            client_secret="secret",
+            redirect_uris=[AnyUrl("http://localhost")],
+            allow_unregistered_redirect_uris=True,
+        )
+        uri = AnyUrl("http://example.com/anything")
+        assert client.validate_redirect_uri(uri) == uri
+        assert "allow_unregistered_redirect_uris" not in client.model_dump()
+
