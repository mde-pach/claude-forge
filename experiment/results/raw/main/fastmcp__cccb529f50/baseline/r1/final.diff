+_LOOPBACK_HOSTS: Final[frozenset[str]] = frozenset({"localhost", "127.0.0.1", "::1"})
+
+
+def _loopback_match(registered: str, requested: str) -> bool:
+    """True if URIs are identical except for the port of a loopback host."""
+    try:
+        reg = urlparse(registered)
+        req = urlparse(requested)
+        reg_host = (reg.hostname or "").lower()
+        req_host = (req.hostname or "").lower()
+        # Accessing .port validates the port component
+        reg.port, req.port  # noqa: B018
+    except ValueError:
+        return False
+    if reg_host not in _LOOPBACK_HOSTS or reg_host != req_host:
+        return False
+    if reg.username is not None or reg.password is not None:
+        return False
+    if req.username is not None or req.password is not None:
+        return False
+    return (
+        reg.scheme.lower() == req.scheme.lower()
+        and (reg.path or "/") == (req.path or "/")
+        and reg.params == req.params
+        and reg.query == req.query
+        and reg.fragment == req.fragment
+    )
+
