+@pytest.mark.parametrize(
+    'model_name,expected_block',
+    [
+        ('us.amazon.nova-micro-v1:0', {'text': '[]'}),
+        ('mistral.mistral-7b-instruct-v0:2', {'json': []}),
+    ],
+)
+async def test_empty_list_tool_return_has_fallback_content(
+    bedrock_provider: BedrockProvider, model_name: str, expected_block: dict[str, Any]
+):
+    """Unit test: the Converse API rejects empty `toolResult.content`, and a VCR recording can't show the request shape."""
+    model = BedrockConverseModel(model_name, provider=bedrock_provider)
+    req = [ModelRequest(parts=[ToolReturnPart(tool_name='lookup', content=[], tool_call_id='id1')])]
+
+    map_messages = getattr(model, '_map_messages')
+    _, bedrock_messages = await map_messages(req, ModelRequestParameters(), None)
+
+    assert bedrock_messages == [
+        {
+            'role': 'user',
+            'content': [{'toolResult': {'toolUseId': 'id1', 'content': [expected_block], 'status': 'success'}}],
+        }
+    ]
+
+
