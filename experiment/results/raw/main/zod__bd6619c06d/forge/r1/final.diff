diff --git a/packages/zod/src/v4/classic/tests/to-json-schema.test.ts b/packages/zod/src/v4/classic/tests/to-json-schema.test.ts
index 61ac74c..80e8ca7 100644
--- a/packages/zod/src/v4/classic/tests/to-json-schema.test.ts
+++ b/packages/zod/src/v4/classic/tests/to-json-schema.test.ts
@@ -3351,3 +3351,81 @@ describe("override runs before the unrepresentable error", () => {
     await expect(validateOpenAPI30Schema(jsonSchema)).resolves.toBe(true);
   });
 });
+
+describe("unrepresentable handler", () => {
+  const dateHandler: z.core.UnrepresentableHandler = ({ zodSchema }) =>
+    zodSchema._zod.def.type === "date" ? { type: "string", format: "date-time" } : "throw";
+
+  test("selective handling, context and override ordering", () => {
+    const calls: unknown[] = [];
+    const schema = z.object({ when: z.date() });
+    const out = z.toJSONSchema(schema, {
+      unrepresentable: (ctx) => {
+        calls.push([ctx.path, ctx.message]);
+        return dateHandler(ctx);
+      },
+      override: ({ jsonSchema }) => {
+        if (jsonSchema.format) jsonSchema.nullable = true;
+      },
+    });
+    expect(calls).toEqual([[["properties", "when"], "Date cannot be represented in JSON Schema"]]);
+    expect(out.properties!.when).toEqual({ type: "string", format: "date-time", nullable: true });
+    expect(() => z.toJSONSchema(z.object({ id: z.bigint(), d: z.date() }), { unrepresentable: dateHandler })).toThrow(
+      "BigInt cannot be represented in JSON Schema"
+    );
+  });
+
+  test("throw/undefined/any returns, and handler errors", () => {
+    expect(() => z.toJSONSchema(z.map(z.string(), z.string()), { unrepresentable: () => undefined })).toThrow(
+      "Map cannot be represented in JSON Schema"
+    );
+    expect(z.toJSONSchema(z.set(z.string()), { unrepresentable: () => "any" })).toMatchObject({});
+    expect(() =>
+      z.toJSONSchema(z.symbol(), {
+        unrepresentable: () => {
+          throw new Error("boom");
+        },
+      })
+    ).toThrow("boom");
+    expect(() =>
+      z.toJSONSchema(z.date(), {
+        unrepresentable: () => "throw",
+        override: ({ jsonSchema }) => {
+          jsonSchema.type = "string";
+        },
+      })
+    ).toThrow("Date cannot be represented in JSON Schema");
+  });
+
+  test("literals", () => {
+    const messages: string[] = [];
+    const lit = z.literal([undefined, 1n, 2]);
+    const any = z.toJSONSchema(lit, {
+      unrepresentable: ({ message }) => {
+        messages.push(message);
+        return "any";
+      },
+    });
+    expect(messages).toEqual([
+      "Literal `undefined` cannot be represented in JSON Schema",
+      "BigInt literals cannot be represented in JSON Schema",
+    ]);
+    expect(any).toMatchObject({ type: "number", enum: [1, 2] });
+    expect(z.toJSONSchema(lit, { unrepresentable: () => ({ type: "string" }) })).toEqual({
+      $schema: "https://json-schema.org/draft/2020-12/schema",
+      type: "string",
+    });
+  });
+
+  test("dynamic catch merges and survives $defs", () => {
+    const s = z.string().catch(() => {
+      throw new Error("dynamic");
+    });
+    const out = z.toJSONSchema(z.object({ a: s, b: s }), {
+      reused: "ref",
+      unrepresentable: () => ({ default: "fallback" }),
+    });
+    expect(out.$defs).toBeDefined();
+    expect(Object.values(out.$defs!)[0]).toEqual({ type: "string", default: "fallback" });
+  });
+});
