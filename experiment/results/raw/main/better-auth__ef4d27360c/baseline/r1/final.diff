diff --git a/packages/better-auth/src/utils/request.test.ts b/packages/better-auth/src/utils/request.test.ts
new file mode 100644
index 0000000..30932a2
--- /dev/null
+++ b/packages/better-auth/src/utils/request.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from "vitest";
+import { safeCloneRequest } from "./request";
+
+describe("safeCloneRequest", () => {
+	it("returns undefined without a request", () => {
+		expect(safeCloneRequest(undefined)).toBeUndefined();
+	});
+
+	it("falls back to a bodyless request when clone throws", async () => {
+		const req = new Request("http://localhost/a", {
+			method: "POST",
+			headers: { "x-test": "1" },
+			body: "hello",
+		});
+		req.clone = () => {
+			throw new TypeError("nope");
+		};
+		const copy = safeCloneRequest(req)!;
+		expect(copy).not.toBe(req);
+		expect(copy.url).toBe(req.url);
+		expect(copy.method).toBe("POST");
+		expect(copy.headers.get("x-test")).toBe("1");
+		expect(await copy.text()).toBe("");
+	});
+});
diff --git a/packages/better-auth/src/utils/request.ts b/packages/better-auth/src/utils/request.ts
new file mode 100644
index 0000000..56de015
--- /dev/null
+++ b/packages/better-auth/src/utils/request.ts
@@ -0,0 +1,45 @@
+/**
+ * Clone a request without ever throwing. If `clone()` fails (e.g. the body is
+ * disturbed or locked), a bodyless copy of the request is returned instead.
+ */
+export function safeCloneRequest(request?: Request): Request | undefined {
+	if (!request) {
+		return undefined;
+	}
+	try {
+		return request.clone();
+	} catch {
+		const init: RequestInit = {
+			method: request.method,
+			headers: new Headers(request.headers),
+		};
+		const optional = [
+			"cache",
+			"credentials",
+			"integrity",
+			"keepalive",
+			"mode",
+			"redirect",
+			"referrer",
+			"referrerPolicy",
+			"signal",
+		] as const;
+		for (const key of optional) {
+			try {
+				const value = request[key];
+				if (value !== undefined) {
+					(init as Record<string, unknown>)[key] = value;
+				}
+			} catch {}
+		}
+		try {
+			return new Request(request.url, init);
+		} catch {
+			// some runtimes reject certain options; retry with the essentials
+			return new Request(request.url, {
+				method: request.method,
+				headers: new Headers(request.headers),
+			});
+		}
+	}
+}
