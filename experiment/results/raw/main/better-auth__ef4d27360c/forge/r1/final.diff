diff --git a/packages/better-auth/src/utils/request.test.ts b/packages/better-auth/src/utils/request.test.ts
new file mode 100644
index 0000000..f1b0931
--- /dev/null
+++ b/packages/better-auth/src/utils/request.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+import { safeCloneRequest } from "./request";
+
+describe("safeCloneRequest", () => {
+	it("returns undefined without a request", () => {
+		expect(safeCloneRequest(undefined)).toBeUndefined();
+	});
+
+	it("returns the clone when cloning succeeds", () => {
+		const req = new Request("http://localhost/x", {
+			method: "POST",
+			body: "a",
+		});
+		const cloned = safeCloneRequest(req);
+		expect(cloned).not.toBe(req);
+		return expect(cloned?.text()).resolves.toBe("a");
+	});
+
+	it("falls back to a bodyless request when clone throws", async () => {
+		const req = new Request("http://localhost/x?y=1", {
+			method: "POST",
+			headers: { "x-test": "1" },
+			body: "a",
+		});
+		// Consuming the body makes the native `clone()` throw.
+		await req.text();
+		expect(() => req.clone()).toThrow();
+		const fallback = safeCloneRequest(req);
+		expect(fallback).not.toBe(req);
+		expect(fallback?.url).toBe(req.url);
+		expect(fallback?.method).toBe("POST");
+		expect(fallback?.headers.get("x-test")).toBe("1");
+		expect(await fallback?.text()).toBe("");
+	});
+});
diff --git a/packages/better-auth/src/utils/request.ts b/packages/better-auth/src/utils/request.ts
new file mode 100644
index 0000000..7a9f342
--- /dev/null
+++ b/packages/better-auth/src/utils/request.ts
@@ -0,0 +1,39 @@
+import { logger } from "@better-auth/core/env";
+
+/**
+ * Clone a request so it can be handed to user callbacks without consuming the
+ * original. If `clone()` throws (e.g. the body is disturbed or locked), a new
+ * bodyless request carrying the same metadata is returned instead.
+ */
+export function safeCloneRequest(request?: Request): Request | undefined {
+	if (!request) {
+		return undefined;
+	}
+	try {
+		return request.clone();
+	} catch (error) {
+		logger.debug("Failed to clone request, using a bodyless copy", error);
+		const init: RequestInit = {
+			method: request.method,
+			headers: new Headers(request.headers),
+		};
+		const optional = [
+			"cache",
+			"credentials",
+			"integrity",
+			"keepalive",
+			"mode",
+			"redirect",
+			"referrer",
+			"referrerPolicy",
+			"signal",
+		] as const;
+		for (const key of optional) {
+			const value = request[key];
+			if (value !== undefined) {
+				(init as Record<string, unknown>)[key] = value;
+			}
+		}
+		return new Request(request.url, init);
+	}
+}
