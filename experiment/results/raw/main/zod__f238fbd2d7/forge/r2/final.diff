diff --git a/packages/zod/src/v4/classic/tests/regexes.test.ts b/packages/zod/src/v4/classic/tests/regexes.test.ts
new file mode 100644
index 0000000..56efcb2
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/regexes.test.ts
@@ -0,0 +1,35 @@
+import { check } from "recheck";
+import { expect, test } from "vitest";
+import * as z from "zod/v4";
+
+const { regexes } = z.core;
+
+const candidates: [string, RegExp][] = [];
+for (const [name, value] of Object.entries(regexes)) {
+  if (value instanceof RegExp) candidates.push([name, value]);
+}
+candidates.push(["emoji()", regexes.emoji()], ["mac()", regexes.mac()], ["mac('-')", regexes.mac("-")]);
+candidates.push(["uuid()", regexes.uuid()]);
+for (let v = 1; v <= 8; v++) candidates.push([`uuid(${v})`, regexes.uuid(v)]);
+candidates.push(["string()", regexes.string()], ["string(min,max)", regexes.string({ minimum: 2, maximum: 5 })]);
+for (const precision of [null, -1, 0, 3, 6]) {
+  candidates.push([`time(${precision})`, regexes.time({ precision })]);
+  for (const local of [true, false])
+    for (const offset of [true, false])
+      candidates.push([`datetime(${precision},${local},${offset})`, regexes.datetime({ precision, local, offset })]);
+}
+
+test.each(candidates)("%s is free of super-linear backtracking", async (_, re) => {
+  const result = await check(re.source, re.flags);
+  expect(result.status).not.toBe("vulnerable");
+});
+
+test("emoji regex shape and speed", () => {
+  expect(regexes.emoji().source).toBe("^[\\p{Extended_Pictographic}\\p{Emoji_Component}]+$");
+  expect(regexes.emoji().flags).toBe("u");
+  z.emoji().parse("🦰🦱🦲🦳");
+  const input = `${"🦰".repeat(26)} `;
+  const start = performance.now();
+  expect(z.emoji().safeParse(input).success).toBe(false);
+  expect(performance.now() - start).toBeLessThan(100);
+});
