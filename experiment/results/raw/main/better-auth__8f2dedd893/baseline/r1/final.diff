+
+describe("mcp-client 401 CORS headers", () => {
+	const client = createMcpAuthClient({
+		authURL: "https://auth.example.com/api/auth",
+		fetch: async () => new Response("no", { status: 401 }),
+	});
+
+	it("exposes WWW-Authenticate on handler 401s", async () => {
+		const handler = client.handler(() => new Response("ok"));
+		const res = await handler(new Request("https://mcp.example.com/mcp"));
+		expect(res.status).toBe(401);
+		expect(res.headers.get("WWW-Authenticate")).toContain("resource_metadata");
+		expect(res.headers.get("Access-Control-Allow-Origin")).toBe(
+			"https://auth.example.com",
+		);
+		expect(res.headers.get("Access-Control-Expose-Headers")).toBe(
+			"WWW-Authenticate",
+		);
+		const bad = await handler(
+			new Request("https://mcp.example.com/mcp", {
+				headers: { Authorization: "Bearer bad" },
+			}),
+		);
+		expect(bad.headers.get("Access-Control-Expose-Headers")).toBe(
+			"WWW-Authenticate",
+		);
+	});
+
+	it("appends to existing expose headers on node responses", async () => {
+		const headers: Record<string, string> = {
+			"Access-Control-Expose-Headers": "set-auth-token",
+		};
+		const res = {
+			set: (n: string, v: string) => {
+				headers[n] = v;
+			},
+			getHeader: (n: string) => headers[n],
+			status: () => ({ json: () => {} }),
+		};
+		await client.middleware()({ headers: {} }, res, () => {});
+		expect(headers["Access-Control-Expose-Headers"]).toBe(
+			"set-auth-token, WWW-Authenticate",
+		);
+		expect(headers["Access-Control-Allow-Origin"]).toBe(
+			"https://auth.example.com",
+		);
+	});
+});
