@@ -427,5 +427,47 @@ describe("mcp-client", async () => {
 			expect(nextCalled).toBe(false);
 			expect(mockRes._status).toBe(401);
 		});
+
+		it("should expose WWW-Authenticate with CORS headers on 401s", async () => {
+			const client = createMcpAuthClient({
+				authURL: "https://auth.example.com/api/auth",
+				fetch: customFetchImpl as typeof fetch,
+			});
+			const res = await client.handler(() => new Response("ok"))(
+				new Request("https://mcp.example.com/mcp"),
+			);
+			expect(res.status).toBe(401);
+			expect(res.headers.get("WWW-Authenticate")).toContain("Bearer");
+			expect(res.headers.get("Access-Control-Allow-Origin")).toBe(
+				"https://auth.example.com",
+			);
+			expect(res.headers.get("Access-Control-Expose-Headers")).toBe(
+				"WWW-Authenticate",
+			);
+		});
+
+		it("should append to existing expose headers in node middleware", async () => {
+			const client = createMcpAuthClient({
+				authURL: "https://auth.example.com/api/auth",
+				fetch: customFetchImpl as typeof fetch,
+			});
+			const headers: Record<string, string> = {
+				"Access-Control-Expose-Headers": "set-auth-token",
+			};
+			const res = {
+				get: (k: string) => headers[k],
+				set: (k: string, v: string) => {
+					headers[k] = v;
+				},
+				status: () => ({ json: () => {} }),
+			};
+			await client.middleware()({ headers: {} }, res, () => {});
+			expect(headers["Access-Control-Expose-Headers"]).toBe(
+				"set-auth-token, WWW-Authenticate",
+			);
+			expect(headers["Access-Control-Allow-Origin"]).toBe(
+				"https://auth.example.com",
+			);
+		});
 	});
