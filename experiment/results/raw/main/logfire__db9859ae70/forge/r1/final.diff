     def _add_task(self, data: bytes, url: str, kwargs: dict[str, Any]):
@@ -114,6 +116,19 @@ class OTLPExporterHttpSession(Session):
         super().close()
 
 
+class SuppressedConnectionError(Exception):
+    """Raised instead of requests.exceptions.ConnectionError once the payload has been queued for retrying.
+
+    OTEL retries ConnectionError itself, which would lead to duplicate exports, so it must not see the original.
+    This is deliberately not a requests exception.
+    """
+
+
+def _reraise_unless_connection_error(exc: requests.exceptions.RequestException) -> None:
+    if isinstance(exc, requests.exceptions.ConnectionError):
+        raise SuppressedConnectionError(str(exc)) from exc
+
+
 def raise_for_retryable_status(response: requests.Response):
     # These are status codes that OTEL should retry.
     # We want to do the retrying ourselves, so we raise an exception instead of returning.
@@ -294,7 +309,7 @@ class QuietSpanExporter(WrapperSpanExporter):
