@@ -63,6 +63,10 @@ class BodySizeCheckingOTLPSpanExporter(OTLPSpanExporter):
         return super()._export(serialized_data, *args, **kwargs)
 
 
+class SuppressedConnectionError(Exception):
+    """Raised instead of a requests ConnectionError so that OTEL doesn't retry; the DiskRetryer handles it."""
+
+
 class OTLPExporterHttpSession(Session):
     """A requests.Session subclass that defers failed requests to a DiskRetryer."""
 
@@ -70,7 +74,7 @@ class OTLPExporterHttpSession(Session):
         start_time = time.time()
         try:
             return self._post(url, data, **kwargs)
-        except requests.exceptions.RequestException:
+        except requests.exceptions.RequestException as e:
             # Wait a little before trying again normally, before resorting to disk retrying.
             # This has several advantages:
             #  - Writing to disk might be impossible.
@@ -82,14 +86,21 @@ class OTLPExporterHttpSession(Session):
             end_time = time.time()
             if end_time - start_time > 10:  # pragma: no cover
                 self._add_task(data, url, kwargs)
-                raise
+                raise self._maybe_suppress(e)
 
             time.sleep(1)
             try:
                 return self._post(url, data, **kwargs)
-            except requests.exceptions.RequestException:
+            except requests.exceptions.RequestException as e2:
                 self._add_task(data, url, kwargs)
-                raise
+                raise self._maybe_suppress(e2)
+
+    @staticmethod
+    def _maybe_suppress(e: requests.exceptions.RequestException) -> BaseException:
+        # OTEL retries ConnectionError itself, which would duplicate the DiskRetryer's work.
+        if isinstance(e, requests.exceptions.ConnectionError):
+            return SuppressedConnectionError(str(e))
+        return e
 
     def _add_task(self, data: bytes, url: str, kwargs: dict[str, Any]):
         # No threads in Emscripten, we can't add a task to try later
@@ -294,7 +305,7 @@ class QuietSpanExporter(WrapperSpanExporter):
     def export(self, spans: Sequence[ReadableSpan]) -> SpanExportResult:
         try:
             return super().export(spans)
-        except requests.exceptions.RequestException:
+        except (requests.exceptions.RequestException, SuppressedConnectionError):
             # Rely on OTLPExporterHttpSession/DiskRetryer to log this kind of error periodically.
             return SpanExportResult.FAILURE
 
@@ -305,6 +316,6 @@ class QuietLogExporter(WrapperLogExporter):
     def export(self, batch: Sequence[ReadableLogRecord]):
         try:
             return super().export(batch)
-        except requests.exceptions.RequestException:
+        except (requests.exceptions.RequestException, SuppressedConnectionError):
             # Rely on OTLPExporterHttpSession/DiskRetryer to log this kind of error periodically.
