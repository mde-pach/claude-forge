diff --git a/packages/treeshake/treeshake.test.ts b/packages/treeshake/treeshake.test.ts
new file mode 100644
index 0000000..be2e126
--- /dev/null
+++ b/packages/treeshake/treeshake.test.ts
@@ -0,0 +1,60 @@
+import { existsSync, readdirSync, statSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { nodeResolve } from "@rollup/plugin-node-resolve";
+import { rollup } from "rollup";
+import { expect, test } from "vitest";
+
+const zodDir = resolve(dirname(fileURLToPath(import.meta.url)), "../zod");
+const entry = join(zodDir, "v4/index.js");
+
+function newestMtime(dir: string): number {
+  let newest = 0;
+  for (const e of readdirSync(dir, { withFileTypes: true })) {
+    const p = join(dir, e.name);
+    if (e.isDirectory()) newest = Math.max(newest, newestMtime(p));
+    else if (/\.ts$/.test(e.name) && !e.name.endsWith(".d.ts")) newest = Math.max(newest, statSync(p).mtimeMs);
+  }
+  return newest;
+}
+
+function assertFreshBuild() {
+  if (!existsSync(entry)) throw new Error(`Built entry missing: ${entry}. Run \`pnpm build\` first.`);
+  if (statSync(entry).mtimeMs < newestMtime(join(zodDir, "src")))
+    throw new Error(`Built entry ${entry} is older than sources. Run \`pnpm build\` first.`);
+}
+
+async function bundleAndRun(body: string): Promise<string> {
+  assertFreshBuild();
+  const bundle = await rollup({
+    input: "entry",
+    plugins: [
+      {
+        name: "virtual-entry",
+        resolveId: (id) => (id === "entry" ? id : null),
+        load: (id) => (id === "entry" ? `import * as z from ${JSON.stringify(entry)};\n${body}` : null),
+      },
+      nodeResolve(),
+    ],
+    treeshake: { preset: "smallest", annotations: true },
+  });
+  const { output } = await bundle.generate({ format: "esm" });
+  await bundle.close();
+  const code = output[0].code.replace(/export\s*\{[^}]*\};?\s*$/, "");
+  const fn = new Function(`${code}\nreturn __result;`);
+  return fn();
+}
+
+test("default English locale survives tree-shaking", async () => {
+  const msg = await bundleAndRun(
+    `const __result = z.enum(["km", "mi"]).safeParse("feet").error.issues[0].message;\nexport { __result };`
+  );
+  expect(msg).toBe('Invalid option: expected one of "km"|"mi"');
+});
+
+test("explicit locale survives tree-shaking", async () => {
+  const msg = await bundleAndRun(
+    `z.config(z.locales.fr());\nconst __result = z.enum(["km", "mi"]).safeParse("feet").error.issues[0].message;\nexport { __result };`
+  );
+  expect(msg).toBe('Option invalide : une valeur parmi "km"|"mi" attendue');
+});
