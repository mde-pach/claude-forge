diff --git a/packages/treeshake/locale.test.ts b/packages/treeshake/locale.test.ts
new file mode 100644
index 0000000..3044412
--- /dev/null
+++ b/packages/treeshake/locale.test.ts
@@ -0,0 +1,56 @@
+import { existsSync, readdirSync, statSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { nodeResolve } from "@rollup/plugin-node-resolve";
+import { rollup } from "rollup";
+import { expect, test } from "vitest";
+
+const zodDir = join(dirname(fileURLToPath(import.meta.url)), "../zod");
+const entry = join(zodDir, "v4/index.js");
+
+function newest(dir: string): number {
+  let t = 0;
+  for (const f of readdirSync(dir, { withFileTypes: true })) {
+    const p = join(dir, f.name);
+    t = Math.max(t, f.isDirectory() ? newest(p) : statSync(p).mtimeMs);
+  }
+  return t;
+}
+
+async function run(code: string): Promise<string> {
+  const bundle = await rollup({
+    input: "entry",
+    treeshake: { preset: "smallest", annotations: true },
+    plugins: [
+      {
+        name: "virtual",
+        resolveId: (id) => (id === "entry" ? id : null),
+        load: (id) => (id === "entry" ? code : null),
+      },
+      nodeResolve(),
+    ],
+  });
+  const { output } = await bundle.generate({ format: "esm" });
+  const src = output[0].code;
+  return (await import(`data:text/javascript;base64,${Buffer.from(src).toString("base64")}`)).default;
+}
+
+test("built entry exists and is fresh", () => {
+  expect(existsSync(entry), `${entry} missing; run \`pnpm build\``).toBe(true);
+  expect(statSync(entry).mtimeMs, "build older than src; run `pnpm build`").toBeGreaterThanOrEqual(
+    newest(join(zodDir, "src")) - 1000
+  );
+});
+
+test("english default survives tree-shaking", async () => {
+  const code = `import * as z from "${entry}";
+export default z.enum(["km","mi"]).safeParse("feet").error.issues[0].message;`;
+  expect(await run(code)).toBe('Invalid option: expected one of "km"|"mi"');
+});
+
+test("explicit locale wins", async () => {
+  const code = `import * as z from "${entry}";
+z.config(z.locales.fr());
+export default z.enum(["km","mi"]).safeParse("feet").error.issues[0].message;`;
+  expect(await run(code)).toBe('Option invalide : une valeur parmi "km"|"mi" attendue');
+});
