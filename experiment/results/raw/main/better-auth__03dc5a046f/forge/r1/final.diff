new file mode 100644
index 0000000..eb0c686
--- /dev/null
+++ b/packages/core/src/db/adapter/get-default-model-name.test.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from "vitest";
+import { getAuthTables } from "../get-tables";
+import { initGetDefaultModelName } from "./get-default-model-name";
+
+describe("initGetDefaultModelName", () => {
+	const collision = {
+		user: { modelName: "account" },
+		account: { modelName: "identity" },
+	};
+
+	it("resolves default schema", () => {
+		const get = initGetDefaultModelName({
+			schema: getAuthTables({}),
+			usePlural: false,
+		});
+		expect(get("user")).toBe("user");
+		expect(get("account")).toBe("account");
+		expect(get("session")).toBe("session");
+	});
+
+	it("handles plural", () => {
+		const get = initGetDefaultModelName({
+			schema: getAuthTables({}),
+			usePlural: true,
+		});
+		expect(get("users")).toBe("user");
+		expect(get("accounts")).toBe("account");
+	});
+
+	it("prefers modelName over schema key on collision", () => {
+		const get = initGetDefaultModelName({
+			schema: getAuthTables(collision),
+			usePlural: false,
+		});
+		expect(get("account")).toBe("user");
+		expect(get("identity")).toBe("account");
+		expect(get("user")).toBe("user");
+		expect(get("session")).toBe("session");
+		expect(get("verification")).toBe("verification");
+	});
+
+	it("throws for unknown models", () => {
+		const get = initGetDefaultModelName({
+			schema: getAuthTables({}),
+			usePlural: false,
+		});
+		expect(() => get("does_not_exist")).toThrow(
+			'Model "does_not_exist" not found in schema',
+		);
+	});
+
+	it("keeps user references canonical", () => {
+		const tables = getAuthTables(collision);
+		for (const t of ["session", "account"]) {
+			const ref = tables[t]!.fields.userId!.references!;
+			expect(ref.model).toBe("user");
+			expect(tables[ref.model]!.modelName).toBe("account");
+		}
+	});
+});
