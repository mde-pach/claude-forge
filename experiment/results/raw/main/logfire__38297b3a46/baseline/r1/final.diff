+def break_cycles(obj: Any, ancestors: frozenset[int] = frozenset()) -> Any:
+    """Replace dicts/lists/tuples that are their own ancestors with their repr."""
+    if not isinstance(obj, (dict, list, tuple)):
+        return obj
+    if id(obj) in ancestors:
+        return f'<circular reference to {type(obj).__name__} id={id(obj)}>'
+    ancestors = ancestors | {id(obj)}
+    if isinstance(obj, dict):
+        return {k: break_cycles(v, ancestors) for k, v in obj.items()}  # pyright: ignore
+    return [break_cycles(v, ancestors) for v in obj]  # pyright: ignore
 
 
