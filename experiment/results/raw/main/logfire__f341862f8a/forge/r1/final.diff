+    def _log_refresh_failure(self, exc: Exception) -> None:
+        """Log a failed fetch, as a warning if it is likely transient and a config is already cached."""
+        self._consecutive_refresh_failures += 1
+        message = 'Error retrieving variables'
+        if (
+            self._last_fetched_at is not None
+            and self._consecutive_refresh_failures < _CONSECUTIVE_FAILURES_BEFORE_ERROR
+            and _is_transient(exc)
+        ):
