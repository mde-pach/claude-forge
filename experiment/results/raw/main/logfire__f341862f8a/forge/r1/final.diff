+    def test_transient_failure_after_success_warns_then_errors(self) -> None:
+        from logfire.variables import remote
+
+        request_mocker = requests_mock_module.Mocker()
+        request_mocker.get('http://localhost:8000/v1/variables/', json={'variables': {}})
+        with request_mocker:
+            provider = LogfireRemoteVariableProvider(
+                base_url=REMOTE_BASE_URL,
+                token=REMOTE_TOKEN,
+                options=VariablesOptions(block_before_first_resolve=False, polling_interval=timedelta(seconds=60)),
+            )
+            try:
+                provider.refresh(force=True)
+                assert provider._consecutive_refresh_failures == 0
+                request_mocker.get('http://localhost:8000/v1/variables/', status_code=503)
+                for i in range(1, remote._CONSECUTIVE_FAILURES_BEFORE_ERROR):
+                    with pytest.warns(RuntimeWarning, match='Error retrieving variables: UnexpectedResponse'):
+                        provider.refresh(force=True)
+                    assert provider._consecutive_refresh_failures == i
+                with warnings.catch_warnings(record=True) as caught:
+                    warnings.simplefilter('always')
+                    provider.refresh(force=True)
+                # The error path includes the exception's own message, not the `ExcType:` prefix.
+                assert [str(w.message).startswith('Error retrieving variables: Unexpected') for w in caught] == [True]
+                # Non-transient statuses error immediately.
+                request_mocker.get('http://localhost:8000/v1/variables/', json={'variables': {}})
+                provider.refresh(force=True)
+                assert provider._consecutive_refresh_failures == 0
+                request_mocker.get('http://localhost:8000/v1/variables/', status_code=403)
+                with warnings.catch_warnings(record=True) as caught:
+                    warnings.simplefilter('always')
+                    provider.refresh(force=True)
+                # The error path includes the exception's own message, not the `ExcType:` prefix.
+                assert [str(w.message).startswith('Error retrieving variables: Unexpected') for w in caught] == [True]
+            finally:
+                provider.shutdown()
+
