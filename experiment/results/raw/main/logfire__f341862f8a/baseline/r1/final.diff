+_CONSECUTIVE_FAILURES_BEFORE_ERROR = 5
+"""Number of consecutive refresh failures (with a cached config) after which failures are logged as errors."""
+
+
+class _UninstrumentedSession(Session):
+    """A `requests` session whose requests never produce spans, even if the user instruments `requests`."""
+
+    def request(self, *args: Any, **kwargs: Any):
+        with suppress_instrumentation():
+            return super().request(*args, **kwargs)
+
+
+def _is_transient_error(exc: Exception) -> bool:
+    if isinstance(exc, UnexpectedResponse):
+        status = exc.response.status_code
+        return status >= 500 or status in (408, 429)
+    return isinstance(exc, RequestException)
+
 
