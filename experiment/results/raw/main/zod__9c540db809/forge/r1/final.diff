diff --git a/packages/zod/src/v4/classic/tests/record.test.ts b/packages/zod/src/v4/classic/tests/record.test.ts
index dede62a..f5574b6 100644
--- a/packages/zod/src/v4/classic/tests/record.test.ts
+++ b/packages/zod/src/v4/classic/tests/record.test.ts
@@ -734,3 +734,27 @@ test("__proto__ in a finite key set becomes an own property", () => {
 
   expect(({} as any).a).toBeUndefined();
 });
+
+test("key schema output of __proto__ is dropped", async () => {
+  const v = z.object({ a: z.string() });
+  const av = v.refine(async () => true);
+  const cases: [z.ZodType<any, any>, string][] = [
+    [z.string().toLowerCase(), "__PROTO__"],
+    [z.string().trim(), " __proto__ "],
+    [z.string().normalize("NFKC"), "＿＿ｐｒｏｔｏ＿＿"],
+    [z.string().transform((k) => k.replace("x", "")), "__protox__"],
+  ];
+  for (const [keySchema, key] of cases) {
+    const data = JSON.parse(JSON.stringify({ [key]: { a: "evil" }, KEY: { a: "ok" } }));
+    for (const value of [v, av]) {
+      const schema = z.record(keySchema, value);
+      for (const parsed of [await schema.parseAsync(data), ...(value === v ? [schema.parse(data)] : [])] as any[]) {
+        expect(Object.getPrototypeOf(parsed)).toBe(Object.prototype);
+        expect(parsed.a).toBeUndefined();
+        expect(Object.keys(parsed)).not.toContain("__proto__");
+      }
+    }
+  }
+  const ok: any = z.record(z.string().toLowerCase(), v).parse({ KEY: { a: "x" } });
+  expect(Object.keys(ok)).toEqual(["key"]);
+});
