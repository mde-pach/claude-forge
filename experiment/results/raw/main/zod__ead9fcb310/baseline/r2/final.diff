diff --git a/packages/zod/src/v4/classic/tests/object.test.ts b/packages/zod/src/v4/classic/tests/object.test.ts
index 3b8abfa..09f01ac 100644
--- a/packages/zod/src/v4/classic/tests/object.test.ts
+++ b/packages/zod/src/v4/classic/tests/object.test.ts
@@ -715,3 +715,41 @@ describe("__proto__ in object catchall paths", () => {
     expect(result.success).toBe(true);
   });
 });
+
+test("declared __proto__ key is an own data property", async () => {
+  const shape = Object.fromEntries([
+    ["__proto__", z.union([z.string(), z.object({ isAdmin: z.boolean() })])],
+    ["name", z.string()],
+  ]);
+  const schema = z.object(shape);
+  const input = JSON.parse('{"__proto__":{"isAdmin":true},"name":"alice"}');
+  const inputs = [input, JSON.parse('{"__proto__":"hello","name":"alice"}')];
+  for (const inp of inputs) {
+    for (const r of [
+      schema.parse(inp),
+      schema.parse(inp, { jitless: true }),
+      await schema.parseAsync(inp),
+    ] as any[]) {
+      expect(Object.getPrototypeOf(r)).toBe(Object.prototype);
+      expect(r.isAdmin).toBeUndefined();
+      expect(Object.keys(r)).toEqual(["__proto__", "name"]);
+      expect(Object.getOwnPropertyDescriptor(r, "__proto__")).toEqual({
+        value: inp["__proto__"],
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+  }
+  expect(schema.safeParse(JSON.parse('{"__proto__":1,"name":"a"}')).success).toBe(false);
+});
+
+test("declared __proto__ key in finite record", async () => {
+  const schema = z.record(z.enum(["__proto__", "b"]), z.number());
+  const inp = JSON.parse('{"__proto__":1,"b":2}');
+  for (const r of [schema.parse(inp), await schema.parseAsync(inp)]) {
+    expect(Object.getPrototypeOf(r)).toBe(Object.prototype);
+    expect(Object.keys(r)).toEqual(["__proto__", "b"]);
+    expect(Object.getOwnPropertyDescriptor(r, "__proto__")?.value).toBe(1);
+  }
+});
