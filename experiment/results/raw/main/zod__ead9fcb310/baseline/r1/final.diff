index 0000000..9759a6c
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/proto-key.test.ts
@@ -0,0 +1,32 @@
+import { expect, test } from "vitest";
+import * as z from "zod/v4";
+
+const input = '{"__proto__":{"isAdmin":true},"name":"alice"}';
+const check = (out: any) => {
+  expect(Object.getPrototypeOf(out)).toBe(Object.prototype);
+  expect(out.isAdmin).toBeUndefined();
+  expect(Object.keys(out)).toEqual(["__proto__", "name"]);
+  expect(Object.getOwnPropertyDescriptor(out, "__proto__")).toEqual({
+    value: { isAdmin: true },
+    enumerable: true,
+    writable: true,
+    configurable: true,
+  });
+};
+
+test("declared __proto__ object key", async () => {
+  const schema = z.object(Object.fromEntries([["__proto__", z.object({ isAdmin: z.boolean() })], ["name", z.string()]]));
+  check(schema.parse(JSON.parse(input)));
+  check(schema.parse(JSON.parse(input), { jitless: true }));
+  check(await schema.parseAsync(JSON.parse(input)));
+  expect(Object.keys(z.object(Object.fromEntries([["__proto__", z.string()]])).parse(JSON.parse('{"__proto__":"hi"}')))).toEqual(["__proto__"]);
+  expect(schema.safeParse(JSON.parse('{"__proto__":1,"name":"a"}')).success).toBe(false);
+});
+
+test("declared __proto__ record key", async () => {
+  const schema = z.record(z.enum(["__proto__", "name"]), z.any());
+  const data = JSON.parse(input);
+  check(schema.parse(data));
+  check(await schema.parseAsync(data));
+  expect(Object.keys(z.record(z.string(), z.any()).parse(data))).toEqual(["name"]);
+});
