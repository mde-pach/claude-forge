diff --git a/packages/zod/src/v4/classic/tests/object.test.ts b/packages/zod/src/v4/classic/tests/object.test.ts
index 3b8abfa..32efd53 100644
--- a/packages/zod/src/v4/classic/tests/object.test.ts
+++ b/packages/zod/src/v4/classic/tests/object.test.ts
@@ -715,3 +715,37 @@ describe("__proto__ in object catchall paths", () => {
     expect(result.success).toBe(true);
   });
 });
+
+test("declared __proto__ key is an own data property", async () => {
+  const input = JSON.parse('{"__proto__":{"isAdmin":true},"name":"alice"}');
+  const shape = Object.fromEntries([
+    ["__proto__", z.object({ isAdmin: z.boolean() })],
+    ["name", z.string()],
+  ]);
+  const schema = z.object(shape);
+  for (const parsed of [schema.parse(input), schema.parse(input, { jitless: true }), await schema.parseAsync(input)]) {
+    expect(Object.getPrototypeOf(parsed)).toBe(Object.prototype);
+    expect(Object.keys(parsed)).toEqual(["__proto__", "name"]);
+    expect((parsed as any).isAdmin).toBeUndefined();
+    expect(Object.getOwnPropertyDescriptor(parsed, "__proto__")).toEqual({
+      value: { isAdmin: true },
+      enumerable: true,
+      writable: true,
+      configurable: true,
+    });
+  }
+  const prim = z.object(Object.fromEntries([["__proto__", z.string()]]));
+  expect(Object.getOwnPropertyDescriptor(prim.parse(JSON.parse('{"__proto__":"hi"}')), "__proto__")?.value).toBe("hi");
+  expect(prim.safeParse(JSON.parse('{"__proto__":1}')).success).toBe(false);
+  expect(({} as any).isAdmin).toBeUndefined();
+});
+
+test("record with finite __proto__ key", async () => {
+  const schema = z.record(z.enum(["__proto__", "b"]), z.number());
+  const input = JSON.parse('{"__proto__":1,"b":2}');
+  for (const parsed of [schema.parse(input), await schema.parseAsync(input)]) {
+    expect(Object.getPrototypeOf(parsed)).toBe(Object.prototype);
+    expect(Object.keys(parsed)).toEqual(["__proto__", "b"]);
+    expect(Object.getOwnPropertyDescriptor(parsed, "__proto__")?.value).toBe(1);
+  }
+});
