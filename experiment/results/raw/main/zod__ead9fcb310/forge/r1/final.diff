--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/proto-key.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, test } from "vitest";
+import * as z from "zod/v4";
+
+const shape = () =>
+  Object.fromEntries([
+    ["__proto__", z.any()],
+    ["name", z.string()],
+  ]) as any;
+const json = '{"__proto__":{"isAdmin":true},"name":"alice"}';
+
+function check(r: any) {
+  expect(Object.getPrototypeOf(r)).toBe(Object.prototype);
+  expect(r.isAdmin).toBeUndefined();
+  expect(Object.keys(r)).toEqual(["__proto__", "name"]);
+  expect(Object.getOwnPropertyDescriptor(r, "__proto__")).toEqual({
+    value: { isAdmin: true },
+    enumerable: true,
+    writable: true,
+    configurable: true,
+  });
+}
+
+describe("declared __proto__ keys", () => {
+  for (const jitless of [false, true]) {
+    test(`object jitless=${jitless}`, async () => {
+      const schema = z.object(shape());
+      check(schema.parse(JSON.parse(json), { jitless }));
+      check(await schema.parseAsync(JSON.parse(json), { jitless }));
+      const p = z.object(Object.fromEntries([["__proto__", z.string()]]) as any);
+      expect(Object.keys(p.parse(JSON.parse('{"__proto__":"hello"}'), { jitless }))).toEqual(["__proto__"]);
+      expect(p.safeParse(JSON.parse('{"__proto__":1}'), { jitless }).success).toBe(false);
+    });
+  }
+
+  test("record finite keys", async () => {
+    const schema = z.record(z.enum(["__proto__", "name"]), z.any());
+    const input = JSON.parse(json);
+    check(schema.parse(input));
+    check(await schema.parseAsync(input));
+  });
+
+  test("undeclared stays dropped", () => {
+    expect(Object.keys(z.looseObject({ name: z.string() }).parse(JSON.parse(json)))).toEqual(["name"]);
+    expect(Object.keys(z.record(z.string(), z.any()).parse(JSON.parse(json)))).toEqual(["name"]);
+  });
+});
