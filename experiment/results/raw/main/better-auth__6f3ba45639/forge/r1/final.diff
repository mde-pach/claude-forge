diff --git a/packages/cli/src/utils/sveltekit-virtual-modules.ts b/packages/cli/src/utils/sveltekit-virtual-modules.ts
index a315950..52e9288 100644
--- a/packages/cli/src/utils/sveltekit-virtual-modules.ts
+++ b/packages/cli/src/utils/sveltekit-virtual-modules.ts
@@ -245,3 +245,28 @@ const reserved = new Set([
 	"implements",
 	"instanceof",
 ]);
+
+/**
+ * SvelteKit's explicit environment variable modules. Their export names are
+ * whatever the project declares in `src/env.ts`, so they cannot be enumerated
+ * ahead of time; the import statement itself supplies them (see the Babel
+ * plugin in `get-config.ts`). No prefix filtering applies in this mode.
+ */
+export const EXPLICIT_ENV_MODULES = new Set([
+	"$app/env/private",
+	"$app/env/public",
+]);
+
+/**
+ * Builds a data-URI module exporting each requested name as its current
+ * `process.env` value (`undefined` when unset).
+ */
+export function createExplicitEnvStub(names: string[]): string {
+	const body = [...new Set(names)]
+		.map(
+			(name, i) =>
+				`const v${i} = process.env[${JSON.stringify(name)}];\nexport { v${i} as ${JSON.stringify(name)} };`,
+		)
+		.join("\n");
+	return `data:text/javascript;charset=utf-8,${encodeURIComponent(`${body}\nexport {};\n`)}`;
+}
