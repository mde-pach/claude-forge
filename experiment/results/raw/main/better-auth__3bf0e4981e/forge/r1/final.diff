 });
+
+describe("organization delete hooks", async () => {
+	type HookArgs = [
+		{ organization: { id: string }; user: unknown },
+		GenericEndpointContext | undefined,
+	];
+	const before: HookArgs[] = [];
+	const after: HookArgs[] = [];
+	const { auth, signInWithTestUser } = await getTestInstance({
+		plugins: [
+			organization({
+				organizationHooks: {
+					beforeDeleteOrganization: async (data, ctx) => {
+						before.push([data, ctx]);
+					},
+					afterDeleteOrganization: async (data, ctx) => {
+						after.push([data, ctx]);
+					},
+				},
+			}),
+		],
+	});
+
+	it("should pass the endpoint context to delete hooks", async () => {
+		const { headers } = await signInWithTestUser();
+		const org = await auth.api.createOrganization({
+			body: { name: "hook-org", slug: "hook-org" },
+			headers,
+		});
+		const res = await auth.handler(
+			new Request("http://localhost:3000/api/auth/organization/delete", {
+				method: "POST",
+				headers: {
+					...Object.fromEntries(headers),
+					"content-type": "application/json",
+				},
+				body: JSON.stringify({ organizationId: org?.id }),
+			}),
+		);
+		expect(res.status).toBe(200);
+		for (const hook of [before, after]) {
+			expect(hook).toHaveLength(1);
+			const [data, ctx] = hook[0] ?? [];
+			expect(data?.organization.id).toBe(org?.id);
+			expect(data?.user).toBeDefined();
+			expect(ctx).toBeDefined();
+			expect(ctx?.request).toBeDefined();
+		}
+	});
+});
