 		expect(teamMemberCount).toBe(1);
 	});
 });
+
+describe("organization delete hooks context", async () => {
+	const received: Record<string, unknown> = {};
+	const { auth, signInWithTestUser } = await getTestInstance({
+		plugins: [
+			organization({
+				organizationHooks: {
+					beforeDeleteOrganization: async (data, ctx) => {
+						received.before = { data, ctx };
+					},
+					afterDeleteOrganization: async (data, ctx) => {
+						received.after = { data, ctx };
+					},
+				},
+			}),
+		],
+	});
+	const { headers } = await signInWithTestUser();
+
+	it("should pass endpoint context to delete hooks", async () => {
+		const org = await auth.api.createOrganization({
+			body: { name: "Del Org", slug: "del-org-ctx" },
+			headers,
+		});
+		const res = await auth.handler(
+			new Request("http://localhost:3000/api/auth/organization/delete", {
+				method: "POST",
+				headers: {
+					...Object.fromEntries(headers),
+					"content-type": "application/json",
+				},
+				body: JSON.stringify({ organizationId: org?.id }),
+			}),
+		);
+		expect(res.status).toBe(200);
+		for (const key of ["before", "after"]) {
+			const { data, ctx } = received[key] as {
+				data: { organization: { id: string } };
+				ctx?: { request?: Request };
+			};
+			expect(data.organization.id).toBe(org?.id);
+			expect(ctx).toBeDefined();
+			expect(ctx?.request).toBeDefined();
+		}
+	});
+});
