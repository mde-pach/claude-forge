--- /dev/null
+++ b/packages/better-auth/src/plugins/last-login-method/before-store-cookie.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it, vi } from "vitest";
+import { getTestInstance } from "../../test-utils/test-instance";
+import { lastLoginMethod } from ".";
+
+const cookieName = "better-auth.last_used_login_method";
+
+async function signIn(
+	beforeStoreCookie: Parameters<
+		typeof lastLoginMethod
+	>[0] extends infer O
+		? NonNullable<O> extends { beforeStoreCookie?: infer F }
+			? F
+			: never
+		: never,
+) {
+	const { client, testUser } = await getTestInstance({
+		plugins: [lastLoginMethod({ beforeStoreCookie })],
+	});
+	let setCookie = "";
+	await client.signIn.email(
+		{ email: testUser.email, password: testUser.password },
+		{
+			onResponse(c) {
+				setCookie = c.response.headers.get("set-cookie") || "";
+			},
+		},
+	);
+	return setCookie;
+}
+
+describe("lastLoginMethod beforeStoreCookie", () => {
+	it("sets cookie when hook returns truthy", async () => {
+		const hook = vi.fn(async () => true);
+		const c = await signIn(hook);
+		expect(c).toContain(`${cookieName}=email`);
+		const last = hook.mock.calls.at(-1)!;
+		expect(last[0].path).toBe("/sign-in/email");
+		expect(last[1]).toBe("email");
+	});
+
+	it("skips cookie when hook returns falsy", async () => {
+		expect(await signIn(() => false)).not.toContain(cookieName);
+		expect(await signIn(async () => 0 as unknown as boolean)).not.toContain(
+			cookieName,
+		);
+	});
+
+	it("skips cookie when hook throws or rejects", async () => {
+		const c1 = await signIn(() => {
+			throw new Error("x");
+		});
+		expect(c1).toContain("better-auth.session_token");
+		expect(c1).not.toContain(cookieName);
+		expect(await signIn(async () => Promise.reject(new Error("x")))).not.toContain(
+			cookieName,
+		);
+	});
+});
