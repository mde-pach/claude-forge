+
+describe("last-login-method beforeStoreCookie", () => {
+	const signIn = async (
+		beforeStoreCookie: (ctx: any, method: string) => any,
+	) => {
+		const { client } = await getTestInstance({
+			plugins: [lastLoginMethod({ beforeStoreCookie })],
+		});
+		let header = "";
+		await client.signUp.email(
+			{ email: "a@test.com", password: "password123", name: "a" },
+			{
+				onSuccess(context) {
+					header = context.response.headers.get("set-cookie") || "";
+				},
+			},
+		);
+		return header;
+	};
+
+	it("sets the cookie when the hook returns true", async () => {
+		const fn = vi.fn(async () => true);
+		const header = await signIn(fn);
+		expect(header).toContain("better-auth.last_used_login_method=email");
+		expect(fn.mock.calls[0]![0].path).toBe("/sign-up/email");
+		expect(fn.mock.calls[0]![1]).toBe("email");
+	});
+
+	it("skips the cookie when the hook returns falsy", async () => {
+		const header = await signIn(() => 0);
+		expect(header).toContain("session_token");
+		expect(header).not.toContain("last_used_login_method");
+	});
+
+	it("skips the cookie when the hook throws", async () => {
+		const header = await signIn(() => {
+			throw new Error("boom");
+		});
+		expect(header).toContain("session_token");
+		expect(header).not.toContain("last_used_login_method");
+	});
+});
