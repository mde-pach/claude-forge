+describe("lastLoginMethod beforeStoreCookie", async () => {
+	const run = async (
+		beforeStoreCookie: LastLoginMethodOptions["beforeStoreCookie"],
+		cookieName?: string,
+	) => {
+		const { client, testUser } = await getTestInstance({
+			plugins: [
+				lastLoginMethod({
+					beforeStoreCookie,
+					...(cookieName ? { cookieName } : {}),
+				}),
+			],
+		});
+		let setCookie = "";
+		const res = await client.signIn.email(
+			{ email: testUser.email, password: testUser.password },
+			{
+				onSuccess(context) {
+					setCookie = context.response.headers.get("set-cookie") || "";
+				},
+			},
+		);
+		return {
+			res,
+			setCookie,
+			name: cookieName ?? "better-auth.last_used_login_method",
+		};
+	};
+
+	it("sets the cookie when the hook resolves truthy", async () => {
+		const calls: { path: string | undefined; method: string }[] = [];
+		const { setCookie, name } = await run(async (ctx, method) => {
+			calls.push({ path: ctx.path, method });
+			return true;
+		});
+		expect(setCookie).toContain(`${name}=email`);
+		expect(calls.at(-1)).toEqual({ path: "/sign-in/email", method: "email" });
+	});
+
+	it.each([
+		false,
+		0,
+	])("skips the cookie when the hook returns %s", async (v) => {
+		const { res, setCookie, name } = await run(() => v as never);
+		expect(res.data?.token).toBeTruthy();
+		expect(setCookie).not.toContain(name);
+	});
+
+	it("skips the cookie when the hook throws or rejects", async () => {
+		for (const hook of [
+			() => {
+				throw new Error("boom");
+			},
+			async () => {
+				throw new Error("boom");
+			},
+		]) {
+			const { res, setCookie, name } = await run(hook, "custom_cookie");
+			expect(res.data?.token).toBeTruthy();
+			expect(setCookie).not.toContain(name);
+		}
+	});
+});
