 {\n\t\tconst { res, setCookie, name } = await run(() => v);\n\t\texpect(res.data?.token).toBeTruthy();\n\t\texpect(setCookie).not.toContain(name);\n\t});\n\n\tit(\"skips the cookie when the hook throws or rejects\", async () => {\n\t\tfor (const hook of [\n\t\t\t() => {\n\t\t\t\tthrow new Error(\"boom\");\n\t\t\t},\n\t\t\tasync () => {\n\t\t\t\tthrow new Error(\"boom\");\n\t\t\t},\n\t\t]) {\n\t\t\tconst { res, setCookie, name } = await run(hook, \"custom_cookie\");\n\t\t\texpect(res.data?.token).toBeTruthy();\n\t\t\texpect(setCookie).not.toContain(name);\n\t\t}\n\t});\n});\n'''\nopen(p,'w').write(s)\nE\ngrep -n \"vi\\b\" packages/better-auth/src/plugins/last-login-method/last-login-method.test.ts | head -3\ncd packages/better-auth && npx vitest run src/plugins/last-login-method 2>&1 | tail -30; npx biome format --write src/plugins/last-login-method >/dev/null 2>&1; npx tsc --noEmit -p . 2>&1 | grep last-login | head","timeout":400000,"dangerouslyDisableSandbox":true}	The command only edits a docs file and a test file in the repo and runs local vitest, biome format and tsc on the last-login-method plugin, with no secrets, network, publishing or destructive effects.
