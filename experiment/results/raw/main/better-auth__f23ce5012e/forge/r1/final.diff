--- /dev/null
+++ b/packages/better-auth/src/plugins/last-login-method/before-store-cookie.test.ts
@@ -0,0 +1,67 @@
+import type { GenericEndpointContext } from "@better-auth/core";
+import { describe, expect, it } from "vitest";
+import { getTestInstance } from "../../test-utils/test-instance";
+import { lastLoginMethod } from ".";
+import { lastLoginMethodClient } from "./client";
+
+const COOKIE = "better-auth.last_used_login_method";
+
+async function signIn(
+	beforeStoreCookie: Parameters<typeof lastLoginMethod>[0] extends infer O
+		? O extends { beforeStoreCookie?: infer F }
+			? F
+			: never
+		: never,
+) {
+	const { client, testUser } = await getTestInstance(
+		{ plugins: [lastLoginMethod({ beforeStoreCookie })] },
+		{ clientOptions: { plugins: [lastLoginMethodClient()] } },
+	);
+	let setCookie = "";
+	const res = await client.signIn.email(
+		{ email: testUser.email, password: testUser.password },
+		{
+			onSuccess(context) {
+				setCookie = context.response.headers.get("set-cookie") || "";
+			},
+		},
+	);
+	return { res, setCookie };
+}
+
+describe("lastLoginMethod beforeStoreCookie", () => {
+	it("sets the cookie when the hook returns true", async () => {
+		const calls: [GenericEndpointContext, string][] = [];
+		const hook = async (ctx: GenericEndpointContext, method: string) => {
+			calls.push([ctx, method]);
+			return true;
+		};
+		const { setCookie } = await signIn(hook);
+		expect(setCookie).toContain(COOKIE);
+		const last = calls.at(-1);
+		expect(last?.[0].path).toBe("/sign-in/email");
+		expect(last?.[1]).toBe("email");
+	});
+
+	it("skips the cookie when the hook returns false", async () => {
+		const { res, setCookie } = await signIn(() => false);
+		expect(res.data?.token).toBeTruthy();
+		expect(setCookie).not.toContain(COOKIE);
+	});
+
+	it("skips the cookie and still authenticates when the hook throws", async () => {
+		const { res, setCookie } = await signIn(() => {
+			throw new Error("boom");
+		});
+		expect(res.data?.token).toBeTruthy();
+		expect(setCookie).not.toContain(COOKIE);
+	});
+
+	it("skips the cookie when the hook rejects", async () => {
+		const { res, setCookie } = await signIn(async () => {
+			throw new Error("boom");
+		});
+		expect(res.data?.token).toBeTruthy();
+		expect(setCookie).not.toContain(COOKIE);
+	});
+});
