diff --git a/tests/server/auth/test_unsafe_redirect_schemes.py b/tests/server/auth/test_unsafe_redirect_schemes.py
new file mode 100644
index 0000000..1894f27
--- /dev/null
+++ b/tests/server/auth/test_unsafe_redirect_schemes.py
@@ -0,0 +1,69 @@
+import pytest
+from mcp.server.auth.provider import RegistrationError
+from mcp.shared.auth import InvalidRedirectUriError, OAuthClientInformationFull
+from pydantic import AnyUrl
+
+from fastmcp.server.auth.oauth_proxy.models import ProxyDCRClient
+from fastmcp.server.auth.redirect_validation import (
+    UNSAFE_REDIRECT_URI_SCHEMES,
+    matches_allowed_pattern,
+    validate_redirect_uri,
+)
+
+UNSAFE = [
+    "javascript:alert(1)//",
+    "JaVaScRiPt:alert(1)",
+    "data:text/html,hi",
+    "file:///etc/passwd",
+    "vbscript:msgbox(1)",
+]
+
+
+def test_unsafe_scheme_set():
+    assert UNSAFE_REDIRECT_URI_SCHEMES == {"javascript", "data", "file", "vbscript"}
+
+
+@pytest.mark.parametrize("uri", UNSAFE)
+@pytest.mark.parametrize(
+    "patterns", [None, [], ["javascript:*", "data:*", "file:///*", "vbscript:*", "*"]]
+)
+def test_unsafe_rejected(uri, patterns):
+    assert validate_redirect_uri(uri, patterns) is False
+
+
+def test_matches_allowed_pattern_rejects_unsafe():
+    assert not matches_allowed_pattern("javascript:alert(1)", "javascript:*")
+
+
+@pytest.mark.parametrize(
+    "uri",
+    [
+        "http://localhost:3000",
+        "https://app.example.com",
+        "cursor://anysphere.cursor-mcp/oauth/callback",
+    ],
+)
+def test_ordinary_allowed_by_default(uri):
+    assert validate_redirect_uri(uri, None)
+    assert validate_redirect_uri(None, None)
+
+
+def test_proxy_client_rejects_registered_unsafe():
+    uri = AnyUrl("javascript:alert(1)//")
+    client = ProxyDCRClient(client_id="c", redirect_uris=[uri])
+    with pytest.raises(InvalidRedirectUriError):
+        client.validate_redirect_uri(uri)
+
+
+async def test_register_client_rejects_unsafe():
+    from fastmcp.server.auth.providers.github import GitHubProvider
+
+    provider = GitHubProvider(
+        client_id="x", client_secret="y", base_url="http://localhost:8000"
+    )
+    bad = OAuthClientInformationFull(
+        client_id="c", redirect_uris=[AnyUrl("javascript:alert(1)//")]
+    )
+    with pytest.raises(RegistrationError) as exc:
+        await provider.register_client(bad)
+    assert exc.value.error == "invalid_redirect_uri"
