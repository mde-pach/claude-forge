diff --git a/tests/server/auth/test_unsafe_redirect_schemes.py b/tests/server/auth/test_unsafe_redirect_schemes.py
new file mode 100644
index 0000000..fdcf784
--- /dev/null
+++ b/tests/server/auth/test_unsafe_redirect_schemes.py
@@ -0,0 +1,40 @@
+import pytest
+
+from fastmcp.server.auth.redirect_validation import (
+    UNSAFE_REDIRECT_URI_SCHEMES,
+    matches_allowed_pattern,
+    validate_redirect_uri,
+)
+
+
+def test_unsafe_scheme_set():
+    assert {"javascript", "data", "file", "vbscript"} == UNSAFE_REDIRECT_URI_SCHEMES
+
+
+@pytest.mark.parametrize(
+    "uri,patterns",
+    [
+        ("javascript:alert(1)//", None),
+        ("JaVaScRiPt:alert(1)", None),
+        ("javascript:alert(1)", ["javascript:*"]),
+        ("data:text/html,x", ["data:*"]),
+        ("file:///etc/passwd", ["file:///*"]),
+        ("vbscript:x", ["vbscript:*"]),
+    ],
+)
+def test_unsafe_schemes_rejected(uri, patterns):
+    assert not validate_redirect_uri(uri, patterns)
+    for p in patterns or []:
+        assert not matches_allowed_pattern(uri, p)
+
+
+@pytest.mark.parametrize(
+    "uri",
+    [
+        "http://localhost:3000",
+        "https://app.example.com",
+        "cursor://anysphere.cursor-mcp/oauth/callback",
+    ],
+)
+def test_safe_uris_allowed_by_default(uri):
+    assert validate_redirect_uri(uri, None)
