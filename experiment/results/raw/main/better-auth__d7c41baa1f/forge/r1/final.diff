+describe("electronInitOAuthProxy set-cookie forwarding", () => {
+	const { auth } = testUtils();
+
+	it("forwards each cookie as its own Set-Cookie header in order", async () => {
+		const inner = new Headers();
+		inner.append("set-cookie", "first.cookie=one; Path=/; HttpOnly");
+		inner.append("set-cookie", "second.cookie=two; Path=/; HttpOnly");
+		const originalFetch = globalThis.fetch;
+		globalThis.fetch = async () =>
+			new Response(
+				JSON.stringify({ url: "https://idp.test/auth", redirect: true }),
+				{ headers: inner },
+			);
+		try {
+			const res = await auth.api.electronInitOAuthProxy({
+				query: {
+					provider: "github",
+					state: "s",
+					code_challenge: "c",
+					code_challenge_method: "S256",
+				},
+				asResponse: true,
+			});
+			expect(res.status).toBe(302);
+			expect(res.headers.get("location")).toBe("https://idp.test/auth");
+			const cookies = res.headers.getSetCookie();
+			expect(cookies).toHaveLength(2);
+			expect(cookies[0]).toMatch(/^first\.cookie=one/);
+			expect(cookies[1]).toMatch(/^second\.cookie=two/);
+		} finally {
+			globalThis.fetch = originalFetch;
+		}
+	});
+});
