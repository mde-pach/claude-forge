+import { afterEach, describe, expect, it, vi } from "vitest";
+import { betterAuth } from "better-auth";
+import { electron } from "../src/index";
+
+describe("electron init-oauth-proxy", () => {
+	afterEach(() => {
+		vi.unstubAllGlobals();
+	});
+
+	it("forwards each Set-Cookie header separately", async () => {
+		const auth = betterAuth({
+			baseURL: "http://localhost:3000",
+			secret: "test-secret-test-secret-test-secret",
+			socialProviders: {
+				github: { clientId: "id", clientSecret: "secret" },
+			},
+			plugins: [electron()],
+		});
+		const inner = new Headers({ "content-type": "application/json" });
+		inner.append("set-cookie", "first.cookie=one; Path=/; HttpOnly");
+		inner.append("set-cookie", "second.cookie=two; Path=/; HttpOnly");
+		vi.stubGlobal(
+			"fetch",
+			vi.fn(
+				async () =>
+					new Response(
+						JSON.stringify({ url: "https://example.com/auth", redirect: true }),
+						{ status: 200, headers: inner },
+					),
+			),
+		);
+		const res = await auth.api.electronInitOAuthProxy({
+			query: {
+				provider: "github",
+				state: "s",
+				code_challenge: "c",
+				code_challenge_method: "S256",
+			},
+			asResponse: true,
+		});
+		expect(res.status).toBe(302);
+		expect(res.headers.get("location")).toBe("https://example.com/auth");
+		const cookies = res.headers.getSetCookie();
+		expect(cookies).toHaveLength(2);
+		expect(cookies[0]).toMatch(/^first\.cookie=one/);
+		expect(cookies[1]).toMatch(/^second\.cookie=two/);
+	});
+});
