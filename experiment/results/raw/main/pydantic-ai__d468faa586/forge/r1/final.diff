diff --git a/pydantic_ai_slim/pydantic_ai/messages.py b/pydantic_ai_slim/pydantic_ai/messages.py
index 21155ec..1f3b11c 100644
--- a/pydantic_ai_slim/pydantic_ai/messages.py
+++ b/pydantic_ai_slim/pydantic_ai/messages.py
@@ -1069,6 +1069,27 @@ tool_return_ta: pydantic.TypeAdapter[Any] = pydantic.TypeAdapter(
     Any, config=pydantic.ConfigDict(defer_build=True, ser_json_bytes='base64', val_json_bytes='base64')
 )
 
+
+def _decode_dumped_binary_content(value: Any, info: pydantic.ValidationInfo) -> Any:
+    """Decode the base64 `data` of a JSON-mode-dumped `BinaryContent` dict when validating from Python.
+
+    `dump_python(mode='json')` base64-encodes `BinaryContent.data`, which `validate_python` would otherwise
+    re-encode as UTF-8 bytes instead of decoding. (`validate_json` already decodes via `val_json_bytes`.)
+    Dicts that aren't a recognizable dumped `BinaryContent` are passed through untouched.
+    """
+    if info.mode != 'python' or not isinstance(value, dict):
+        return value
+    value = cast('dict[Any, Any]', value)
+    data = value.get('data')
+    kind = value.get('kind')
+    if isinstance(kind, str) and kind == 'binary' and isinstance(data, str) and 'media_type' in value:
+        try:
+            return {**value, 'data': base64.b64decode(data, validate=True)}
+        except ValueError:  # binascii.Error is a ValueError
+            pass
+    return value
+
+
 if TYPE_CHECKING:
     # Simpler type for static analysis - recursive TypeAliasType with Any produces spurious Unknown types
     ToolReturnContent: TypeAlias = MultiModalContent | Sequence[Any] | Mapping[str, Any] | Any
@@ -1077,7 +1098,13 @@ else:
     # BinaryContent/FileUrl objects nested inside dicts/lists during deserialization
     ToolReturnContent = TypeAliasType(
         'ToolReturnContent',
-        MultiModalContent | Sequence['ToolReturnContent'] | Mapping[str, 'ToolReturnContent'] | Any,
+        Annotated[
+            Annotated[MultiModalContent, pydantic.BeforeValidator(_decode_dumped_binary_content)]
+            | Sequence['ToolReturnContent']
+            | Mapping[str, 'ToolReturnContent']
+            | Any,
+            pydantic.Field(union_mode='left_to_right'),
+        ],
     )
 
 
