@@ -1,4 +1,6 @@
 import sys
+import warnings
+from collections.abc import Sequence
 from datetime import datetime, timezone
 from pathlib import Path
 from typing import Any, cast, get_args
@@ -1649,3 +1651,46 @@ def test_retry_prompt_tool_call_keeps_input_for_nested_errors():
     response = part.model_response()
     assert '"input": 42' in response
     assert '"name"' in response
+
+
+def _tool_return_content(messages: Sequence[ModelMessage]) -> Any:
+    part = cast(ModelRequest, messages[0]).parts[0]
+    assert isinstance(part, ToolReturnPart)
+    return part.content
+
+
+@pytest.mark.parametrize(
+    'content',
+    [
+        BinaryContent(data=b'\xff\x00abc', media_type='audio/mpeg'),
+        ['hello', BinaryContent(data=b'\xff\x00', media_type='image/png')],
+        {'caption': 'x', 'attachment': BinaryContent(data=b'\xff', media_type='text/plain')},
+        {'kind': 'binary', 'label': 'foo'},
+        {'kind': 'binary', 'media_type': 'text/plain', 'text': 'hello'},
+        {'kind': 'uploaded-file', 'file_id': 'abc', 'status': 'ready'},
+        {'kind': 'image-url', 'media_type': 'image/png', 'note': 'x'},
+    ],
+)
+def test_tool_return_content_python_roundtrip(content: Any):
+    messages: list[ModelMessage] = [
+        ModelRequest(parts=[ToolReturnPart(tool_name='t', content=content, tool_call_id='1')])
+    ]
+    with warnings.catch_warnings():
+        warnings.simplefilter('error')
+        dumped = ModelMessagesTypeAdapter.dump_python(messages, mode='json')
+        from_python = ModelMessagesTypeAdapter.validate_python(dumped)
+        from_json = ModelMessagesTypeAdapter.validate_json(ModelMessagesTypeAdapter.dump_json(messages))
+    assert _tool_return_content(from_python) == content
+    assert _tool_return_content(from_json) == content
+
+
+@pytest.mark.parametrize('kind', [['a'], {'a': 1}, bytearray(b'a')])
+def test_tool_return_content_malformed_kind(kind: Any):
+    for content in ({'kind': kind, 'url': 'x'}, [{'kind': kind, 'url': 'x'}]):
+        data = [
+            {
+                'kind': 'request',
+                'parts': [{'part_kind': 'tool-return', 'tool_name': 't', 'content': content, 'tool_call_id': '1'}],
+            }
+        ]
+        assert _tool_return_content(ModelMessagesTypeAdapter.validate_python(data)) == content
