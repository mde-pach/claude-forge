diff --git a/pydantic_ai_slim/pydantic_ai/messages.py b/pydantic_ai_slim/pydantic_ai/messages.py
index 21155ec..212d5d7 100644
--- a/pydantic_ai_slim/pydantic_ai/messages.py
+++ b/pydantic_ai_slim/pydantic_ai/messages.py
@@ -1069,6 +1069,35 @@ tool_return_ta: pydantic.TypeAdapter[Any] = pydantic.TypeAdapter(
     Any, config=pydantic.ConfigDict(defer_build=True, ser_json_bytes='base64', val_json_bytes='base64')
 )
 
+_MULTI_MODAL_KINDS = frozenset({'image-url', 'audio-url', 'video-url', 'document-url', 'binary', 'uploaded-file'})
+_MULTI_MODAL_TYPE_FIELDS = ('url', 'media_type', 'file_id')
+
+
+_multi_modal_ta: pydantic.TypeAdapter[MultiModalContent] = pydantic.TypeAdapter(
+    MultiModalContent, config=pydantic.ConfigDict(defer_build=True)
+)
+
+
+def _validate_tool_return_content(value: Any, handler: pydantic.ValidatorFunctionWrapHandler) -> Any:
+    """Rehydrate multi-modal content dumped with `dump_python(mode='json')`, leaving lookalike dicts untouched.
+
+    The union alone can't rehydrate these from Python input, where `bytes` are base64 strings
+    (`val_json_bytes` only applies to JSON input) and the dicts are otherwise plain mappings.
+    """
+    if isinstance(value, dict):
+        mapping = cast('dict[str, Any]', value)
+        kind = mapping.get('kind')
+        if isinstance(kind, str) and kind in _MULTI_MODAL_KINDS and any(f in mapping for f in _MULTI_MODAL_TYPE_FIELDS):
+            data = mapping.get('data')
+            try:
+                if kind == 'binary' and isinstance(data, str):
+                    mapping = {**mapping, 'data': base64.b64decode(data, validate=True)}
+                return _multi_modal_ta.validate_python(mapping)
+            except (ValueError, pydantic.ValidationError):
+                pass
+    return handler(value)
+
+
 if TYPE_CHECKING:
     # Simpler type for static analysis - recursive TypeAliasType with Any produces spurious Unknown types
     ToolReturnContent: TypeAlias = MultiModalContent | Sequence[Any] | Mapping[str, Any] | Any
@@ -1077,7 +1106,10 @@ else:
     # BinaryContent/FileUrl objects nested inside dicts/lists during deserialization
     ToolReturnContent = TypeAliasType(
         'ToolReturnContent',
-        MultiModalContent | Sequence['ToolReturnContent'] | Mapping[str, 'ToolReturnContent'] | Any,
+        Annotated[
+            MultiModalContent | Sequence['ToolReturnContent'] | Mapping[str, 'ToolReturnContent'] | Any,
+            pydantic.WrapValidator(_validate_tool_return_content),
+        ],
     )
 
 
