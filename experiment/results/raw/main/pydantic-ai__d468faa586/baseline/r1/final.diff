     response = part.model_response()
     assert '"input": 42' in response
     assert '"name"' in response
+
+
+@pytest.mark.parametrize(
+    'content',
+    [
+        BinaryContent(b'abc', media_type='audio/mpeg'),
+        ['hello', BinaryContent(b'abc', media_type='image/png')],
+        {'caption': 'x', 'attachment': ImageUrl('https://example.com/a.png')},
+        {'kind': 'binary', 'label': 'foo'},
+        {'kind': 'binary', 'media_type': 'text/plain', 'text': 'hello'},
+        {'kind': 'uploaded-file', 'file_id': 'abc', 'status': 'ready'},
+        {'kind': 'image-url', 'media_type': 'image/png', 'note': 'x'},
+    ],
+)
+def test_tool_return_multi_modal_roundtrip(content: Any):
+    messages: list[ModelMessage] = [ModelRequest(parts=[ToolReturnPart('t', content, 'id')])]
+    with warnings.catch_warnings():
+        warnings.simplefilter('error')
+        dumped = ModelMessagesTypeAdapter.dump_python(messages, mode='json')
+        from_python = ModelMessagesTypeAdapter.validate_python(dumped)
+        from_json = ModelMessagesTypeAdapter.validate_json(ModelMessagesTypeAdapter.dump_json(messages))
+    assert from_python == messages
+    assert from_json == messages
+
+
+@pytest.mark.parametrize('kind', [['a'], {'a': 1}, bytearray(b'x')])
+def test_tool_return_malformed_kind(kind: Any):
+    data = [{'kind': 'request', 'parts': [{'part_kind': 'tool-return', 'tool_name': 't', 'content': [{'kind': kind}]}]}]
+    part = ModelMessagesTypeAdapter.validate_python(data)[0].parts[0]
+    assert isinstance(part, ToolReturnPart)
+    assert part.content == [{'kind': kind}]
