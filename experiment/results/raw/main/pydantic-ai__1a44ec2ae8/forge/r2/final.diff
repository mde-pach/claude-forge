@@ -5368,3 +5368,47 @@ async def test_interrupt_resume_roundtrip_executes_approved_tool() -> None:
 
 
 # endregion
+
+
+def test_dump_messages_preserves_request_part_order():
+    messages: list[ModelMessage] = [
+        ModelResponse(parts=[ToolCallPart('my_tool', {}, tool_call_id='call_1')]),
+        ModelRequest(
+            parts=[
+                UserPromptPart('Before the tool return.'),
+                ToolReturnPart('my_tool', 'suggested', tool_call_id='call_1'),
+                UserPromptPart('After the tool return.'),
+            ]
+        ),
+    ]
+    dumped = AGUIAdapter.dump_messages(messages)
+    assert [type(m).__name__ for m in dumped] == snapshot(
+        ['AssistantMessage', 'UserMessage', 'ToolMessage', 'UserMessage']
+    )
+    assert [getattr(m, 'content', None) for m in dumped[1:]] == [
+        'Before the tool return.',
+        'suggested',
+        'After the tool return.',
+    ]
+    assert getattr(dumped[2], 'tool_call_id') == 'call_1'
+
+
+def test_dump_messages_preserves_order_around_uploaded_file():
+    messages: list[ModelMessage] = [
+        ModelRequest(
+            parts=[
+                UserPromptPart(
+                    [
+                        'Before the file.',
+                        UploadedFile(file_id='file-abc123', provider_name='anthropic'),
+                        'After the file.',
+                    ]
+                )
+            ]
+        )
+    ]
+    dumped = AGUIAdapter.dump_messages(messages, preserve_file_data=True)
+    assert [type(m).__name__ for m in dumped] == ['UserMessage', 'ActivityMessage', 'UserMessage']
+    assert getattr(dumped[0], 'content') == 'Before the file.'
+    assert getattr(dumped[1], 'content')['file_id'] == 'file-abc123'
+    assert getattr(dumped[2], 'content') == 'After the file.'
