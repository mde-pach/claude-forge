+def _uploaded_file_activity(item: UploadedFile) -> ActivityMessage:
+    """Build the `ActivityMessage` carrying an `UploadedFile`.
+
+    AG-UI has no native uploaded-file message type. We repurpose ActivityMessage with a
+    reserved `pydantic_ai_*` activity_type for round-trip fidelity. See UploadedFileActivityContent.
+    """
+    content: dict[str, Any] = {
+        'file_id': item.file_id,
+        'provider_name': item.provider_name,
+        'media_type': item.media_type,
+        'identifier': item.identifier,
+    }
+    if item.vendor_metadata is not None:
+        content['vendor_metadata'] = item.vendor_metadata
+    return ActivityMessage(id=_new_message_id(), activity_type=UPLOADED_FILE_ACTIVITY_TYPE, content=content)
+
+
