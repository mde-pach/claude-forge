diff --git a/packages/zod/src/v4/core/tests/proto-json-schema.test.ts b/packages/zod/src/v4/core/tests/proto-json-schema.test.ts
new file mode 100644
index 0000000..43c8edb
--- /dev/null
+++ b/packages/zod/src/v4/core/tests/proto-json-schema.test.ts
@@ -0,0 +1,11 @@
+import { test, expect } from "vitest";
+import * as z from "zod/v4";
+test("p", () => {
+  const j = z.toJSONSchema(z.object({ ["__proto__"]: z.literal("admin"), role: z.string() }), { io: "input" });
+  expect(Object.prototype.hasOwnProperty.call(j.properties!, "__proto__")).toBe(true);
+  const s = z.fromJSONSchema(JSON.parse('{"type":"object","properties":{"role":{"type":"string"},"__proto__":{"const":"admin"}},"required":["role","__proto__"]}'));
+  expect(s.safeParse(JSON.parse('{"role":"x","__proto__":"wrong"}')).success).toBe(false);
+  expect(s.safeParse(JSON.parse('{"role":"x","__proto__":"admin"}')).success).toBe(true);
+  const r = z.registry<{id:string}>(); r.add(z.string(), {id:"__proto__"});
+  expect(Object.prototype.hasOwnProperty.call(z.toJSONSchema(r).schemas, "__proto__")).toBe(true);
+});
