+/**
+ * If `error` is a `MODULE_NOT_FOUND` for a relative specifier that points at
+ * `outputPath`, returns true. Bare specifiers never match.
+ */
+function isMissingOutputImport(
+	error: unknown,
+	outputPath: string,
+	fallbackImporter: string,
+): boolean {
+	if (typeof error !== "object" || error === null) return false;
+	const { code, message, requireStack } = error as {
+		code?: unknown;
+		message?: unknown;
+		requireStack?: unknown;
+	};
+	if (code !== "MODULE_NOT_FOUND" || typeof message !== "string") return false;
+	const specifier = /Cannot find module '([^']+)'/.exec(message)?.[1];
+	if (!specifier || !/^\.\.?\//.test(specifier)) return false;
+	let importer = fallbackImporter;
+	if (Array.isArray(requireStack) && typeof requireStack[0] === "string") {
+		importer = requireStack[0];
+	} else {
+		const fromStack = /Require stack:\s*\n-\s*(.+)/.exec(message)?.[1]?.trim();
+		if (fromStack) importer = fromStack;
+	}
+	const target = path.resolve(path.dirname(importer), specifier);
+	return stripSourceExtension(target) === stripSourceExtension(outputPath);
+}
