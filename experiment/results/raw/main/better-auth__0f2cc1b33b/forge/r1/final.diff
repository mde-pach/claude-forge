+const stripSourceExtension = (p: string) => {
+	const ext = path.extname(p);
+	return SOURCE_EXTENSIONS_SET.has(ext) ? p.slice(0, -ext.length) : p;
+};
+
+/**
+ * Whether `error` is a `MODULE_NOT_FOUND`
+ * for a `./` or `../` import that resolves (from an importing file) to exactly
+ * `outputPath`, ignoring source extensions.
+ */
+function isMissingOutputImport(
+	error: unknown,
+	outputPath: string,
+	fallbackImporters: string[],
+): boolean {
+	if (typeof error !== "object" || error === null) return false;
+	const { code, message, requireStack } = error as {
+		code?: unknown;
+		message?: unknown;
+		requireStack?: unknown;
+	};
+	if (code !== "MODULE_NOT_FOUND" || typeof message !== "string") return false;
+	const specifier = /Cannot find module '([^']+)'/.exec(message)?.[1];
+	if (!specifier || !/^\.\.?\//.test(specifier)) return false;
+	const importers = [
+		...(Array.isArray(requireStack)
+			? requireStack.filter((f): f is string => typeof f === "string")
+			: []),
+		...fallbackImporters,
+	];
+	const target = stripSourceExtension(outputPath);
+	return importers.some(
+		(importer) =>
+			stripSourceExtension(path.resolve(path.dirname(importer), specifier)) ===
+			target,
+	);
+}
