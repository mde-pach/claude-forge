--- /dev/null
+++ b/packages/cli/src/utils/get-config-output.test.ts
@@ -0,0 +1,65 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { getConfig } from "./get-config";
+
+describe("getConfig outputPath recovery", () => {
+	let dir: string;
+	beforeEach(() => {
+		dir = fs.mkdtempSync(path.join(os.tmpdir(), "ba-output-"));
+	});
+	afterEach(() => {
+		fs.rmSync(dir, { recursive: true, force: true });
+	});
+
+	const write = (name: string, content: string) => {
+		const p = path.join(dir, name);
+		fs.mkdirSync(path.dirname(p), { recursive: true });
+		fs.writeFileSync(p, content);
+	};
+
+	it("creates an empty placeholder when the config imports the output file", async () => {
+		write(
+			"auth.ts",
+			`import schema from "./schema";\nexport const auth = { options: { schema } };\n`,
+		);
+		const config = await getConfig({
+			cwd: dir,
+			outputPath: "schema.ts",
+			shouldThrowOnError: true,
+		});
+		expect(config).toBeTruthy();
+		expect(fs.readFileSync(path.join(dir, "schema.ts"), "utf-8")).toBe("");
+	});
+
+	it("does not create a placeholder for unrelated missing imports", async () => {
+		write(
+			"auth.ts",
+			`import x from "./other";\nexport const auth = { options: { x } };\n`,
+		);
+		await expect(
+			getConfig({
+				cwd: dir,
+				outputPath: "schema.ts",
+				shouldThrowOnError: true,
+			}),
+		).rejects.toThrow(/Cannot find module '\.\/other'/);
+		expect(fs.existsSync(path.join(dir, "schema.ts"))).toBe(false);
+	});
+
+	it("does not create a placeholder for bare specifiers", async () => {
+		write(
+			"auth.ts",
+			`import x from "schema";\nexport const auth = { options: { x } };\n`,
+		);
+		await expect(
+			getConfig({
+				cwd: dir,
+				outputPath: "schema.ts",
+				shouldThrowOnError: true,
+			}),
+		).rejects.toThrow();
+		expect(fs.existsSync(path.join(dir, "schema.ts"))).toBe(false);
+	});
+});
