+++ b/packages/core/src/db/test/get-default-model-name-key-precedence.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { initGetDefaultModelName } from "../adapter/get-default-model-name";
+import { getAuthTables } from "../get-tables";
+
+describe("initGetDefaultModelName schema key precedence", () => {
+	const getDefaultModelName = initGetDefaultModelName({
+		schema: getAuthTables({
+			user: { modelName: "account" },
+			account: { modelName: "identity" },
+		}),
+		usePlural: false,
+	});
+
+	it("prefers an exact schema-key match over another table's modelName", () => {
+		expect(getDefaultModelName("account")).toBe("account");
+	});
+
+	it("falls back to modelName when no schema key matches", () => {
+		expect(getDefaultModelName("identity")).toBe("account");
+	});
+});
