$ set -e
W=/tmp/pnpm-store
for d in /cache/pnpm/v*; do
  [ -d "$d" ] || continue
  v=$(basename "$d"); mkdir -p "$W/$v"
  for e in "$d"/*; do
    n=$(basename "$e")
    if [ "$n" = files ]; then ln -sfn "$e" "$W/$v/files"; else cp -a "$e" "$W/$v/"; fi
  done
done
pnpm install --frozen-lockfile --offline --store-dir "$W" --package-import-method copy
find .git/hooks -type f ! -name '*.sample' -delete
git config --unset core.hooksPath || true
turbo run build --filter='./packages/*' --output-logs=errors-only
rm -rf .turbo packages/*/.turbo
# Non-deterministic by-products (would break the parity fingerprint): fumadocs-mdx output of
# the docs postinstall (docs are not built or tested here), turbo's telemetry id, and the
# Prisma checkpoint-client signature.
rm -rf docs/.source "$HOME/.config/turborepo" "$HOME/.cache/checkpoint-nodejs"

