diff --git a/tests/server/test_cache_hints.py b/tests/server/test_cache_hints.py
new file mode 100644
index 0000000..279e269
--- /dev/null
+++ b/tests/server/test_cache_hints.py
@@ -0,0 +1,64 @@
+import pytest
+from mcp_types.methods import CACHEABLE_METHODS
+
+from fastmcp import Client, FastMCP
+from fastmcp.server.caching import build_cache_hints
+
+
+def test_build_cache_hints_none():
+    assert build_cache_hints(None, None) is None
+
+
+def test_build_cache_hints_default_scope():
+    hints = build_cache_hints(60, None)
+    assert hints is not None
+    assert set(hints) == set(CACHEABLE_METHODS)
+    assert all(h.ttl_ms == 60000 and h.scope == "private" for h in hints.values())
+
+
+@pytest.mark.parametrize("ttl", [0, -1])
+def test_non_positive_ttl(ttl: int):
+    with pytest.raises(ValueError, match="cache_ttl must be a positive integer"):
+        FastMCP("x", cache_ttl=ttl)
+
+
+def test_scope_without_ttl():
+    with pytest.raises(ValueError, match="cache_scope requires cache_ttl"):
+        FastMCP("x", cache_scope="public")
+
+
+async def test_hints_on_wire():
+    mcp = FastMCP("x", cache_ttl=60, cache_scope="public")
+    async with Client(mcp, mode="2026-07-28") as client:
+        result = await client.session.list_tools()
+        assert result.ttl_ms == 60000
+        assert result.cache_scope == "public"
+
+
+async def test_no_hint_when_unset():
+    mcp = FastMCP("x")
+    async with Client(mcp, mode="2026-07-28") as client:
+        result = await client.session.list_tools()
+        assert not result.ttl_ms
+
+
+async def test_client_cache_serves_second_list(monkeypatch: pytest.MonkeyPatch):
+    mcp = FastMCP("x", cache_ttl=60)
+    calls = 0
+
+    @mcp.tool
+    def hello() -> str:
+        return "hi"
+
+    async with Client(mcp, mode="2026-07-28", cache=True) as client:
+        original = client.session.list_tools
+
+        async def counting(*a, **kw):
+            nonlocal calls
+            calls += 1
+            return await original(*a, **kw)
+
+        monkeypatch.setattr(client.session, "list_tools", counting)
+        await client.list_tools()
+        await client.list_tools()
+    assert calls == 1
