+test("preprocess narrows input from annotated argument", () => {
+  const pre = z.preprocess((v: string | null | undefined) => v?.trim() ?? "", z.string());
+  expectTypeOf<z.input<typeof pre>>().toEqualTypeOf<string | null | undefined>();
+  expectTypeOf<z.output<typeof pre>>().toEqualTypeOf<string>();
+  const obj = z.object({ a: z.preprocess((v: string | number) => String(v), z.string()) });
+  expectTypeOf<z.input<typeof obj>>().toEqualTypeOf<{ a: string | number }>();
+  const num = z.preprocess((v: string) => v.length, z.number());
+  const _a: z.ZodPreprocess<z.ZodNumber> = num;
+  const _b: z.core.$ZodPreprocess = num;
+  expectTypeOf<z.input<ReturnType<typeof z.preprocess<number, z.ZodString>>>>().toEqualTypeOf<unknown>();
+});
