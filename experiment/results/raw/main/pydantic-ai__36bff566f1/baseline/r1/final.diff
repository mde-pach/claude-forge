+
+
+async def test_instrumented_model_lone_surrogate_in_tool_definitions(capfire: CaptureLogfire):
+    import json
+
+    from pydantic_ai.tools import ToolDefinition
+
+    description = 'get the weather before\udce4after'
+    params = ModelRequestParameters(function_tools=[ToolDefinition(name='weather', description=description)])
+    model = InstrumentedModel(MyModel(), InstrumentationSettings())
+    await model.request([ModelRequest(parts=[UserPromptPart('hi')])], None, params)
+
+    attrs = capfire.exporter.exported_spans_as_dict()[0]['attributes']
+    assert json.loads(attrs['gen_ai.tool.definitions'])[0]['description'] == description
+    assert json.loads(attrs['model_request_parameters'])['function_tools'][0]['name'] == 'weather'
