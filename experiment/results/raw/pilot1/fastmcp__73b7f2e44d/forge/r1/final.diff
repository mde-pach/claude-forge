diff --git a/tests/server/test_fastmcp_error_log_level.py b/tests/server/test_fastmcp_error_log_level.py
new file mode 100644
index 0000000..37e5521
--- /dev/null
+++ b/tests/server/test_fastmcp_error_log_level.py
@@ -0,0 +1,67 @@
+import logging
+
+import pytest
+
+from fastmcp import Client, FastMCP
+from fastmcp.exceptions import FastMCPError, PromptError, ResourceError, ToolError
+
+
+def test_log_level_defaults_to_error():
+    assert FastMCPError("x").log_level == logging.ERROR
+    assert ToolError("x", log_level=logging.WARNING).log_level == logging.WARNING
+
+
+async def test_custom_log_level_used_for_tool(caplog: pytest.LogCaptureFixture):
+    mcp = FastMCP()
+
+    @mcp.tool
+    def boom() -> str:
+        raise ToolError("Missing", log_level=logging.WARNING)
+
+    with caplog.at_level(logging.DEBUG):
+        async with Client(mcp) as client:
+            result = await client.call_tool("boom", {}, raise_on_error=False)
+
+    assert result.is_error
+    records = [r for r in caplog.records if "Error calling tool" in r.getMessage()]
+    assert records and all(r.levelno == logging.WARNING for r in records)
+
+
+async def test_custom_log_level_used_for_resource_and_prompt(
+    caplog: pytest.LogCaptureFixture,
+):
+    mcp = FastMCP()
+
+    @mcp.resource("res://a")
+    def res() -> str:
+        raise ResourceError("gone", log_level=logging.INFO)
+
+    @mcp.prompt
+    def pr() -> str:
+        raise PromptError("nope", log_level=logging.WARNING)
+
+    with caplog.at_level(logging.DEBUG):
+        async with Client(mcp) as client:
+            with pytest.raises(Exception, match="gone"):
+                await client.read_resource("res://a")
+            with pytest.raises(Exception, match="nope"):
+                await client.get_prompt("pr")
+
+    by_msg = {r.getMessage(): r.levelno for r in caplog.records}
+    assert by_msg["Error reading resource 'res://a'"] == logging.INFO
+    assert by_msg["Error rendering prompt 'pr'"] == logging.WARNING
+
+
+async def test_prompt_conversion_error_not_wrapped():
+    from fastmcp.prompts import Prompt
+
+    def typed_prompt(numbers: list[int]) -> str:
+        return f"Got {len(numbers)} numbers"
+
+    prompt = Prompt.from_function(typed_prompt)
+    with pytest.raises(PromptError) as exc_info:
+        await prompt.render(arguments={"numbers": "not valid json"})
+
+    assert "Could not convert argument 'numbers'" in str(exc_info.value)
+    assert "list[int]" in str(exc_info.value)
+    assert "Error rendering prompt" not in str(exc_info.value)
