diff --git a/packages/better-auth/src/utils/request.ts b/packages/better-auth/src/utils/request.ts
new file mode 100644
index 00000000..71184198
--- /dev/null
+++ b/packages/better-auth/src/utils/request.ts
@@ -0,0 +1,23 @@
+export function safeCloneRequest(request?: Request): Request | undefined {
+	if (!request) {
+		return undefined;
+	}
+
+	try {
+		return request.clone();
+	} catch {
+		return new Request(request.url, {
+			cache: request.cache,
+			credentials: request.credentials,
+			headers: request.headers,
+			integrity: request.integrity,
+			keepalive: request.keepalive,
+			method: request.method,
+			mode: request.mode,
+			redirect: request.redirect,
+			referrer: request.referrer,
+			referrerPolicy: request.referrerPolicy,
+			signal: request.signal,
+		});
+	}
+}
