{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space" },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error", "noTsIgnore": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
