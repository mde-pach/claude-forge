{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge:project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forge"
  ],
  "properties": {
    "forge": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
          }
        }
      }
    },
    "disable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
