{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge:project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forge"
  ],
  "properties": {
    "forge": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
          }
        }
      }
    },
    "disable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "add": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "set": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "untyped-packages": {
          "enum": [
            "any",
            "source"
          ]
        }
      }
    },
    "accept": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "change",
          "reason"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
          },
          "change": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
