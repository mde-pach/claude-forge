{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "forge": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "packs": {
      "$ref": "#/$defs/PackChanges"
    },
    "disable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Disable"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RoleChange"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "python": {
      "$ref": "#/$defs/PythonConfig"
    },
    "accept": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Accept"
      }
    }
  },
  "required": [
    "forge"
  ],
  "title": "project",
  "description": "forge.yaml (`ProjectConfig`).",
  "$id": "forge:project",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PackChanges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
          }
        }
      }
    },
    "Disable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "reason"
      ]
    },
    "RoleChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "set": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "minProperties": 1
    },
    "PythonConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "untyped-packages": {
          "type": "string",
          "description": "\"any\" or \"source\".",
          "enum": [
            "any",
            "source"
          ]
        }
      }
    },
    "Accept": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
        },
        "change": {
          "type": "string",
          "pattern": "^[^\\n]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rule",
        "change",
        "reason"
      ]
    }
  }
}
