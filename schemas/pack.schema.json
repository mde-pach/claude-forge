{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge:pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "user",
        "project"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
      },
      "uniqueItems": true
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deps_any": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ecosystem",
              "name"
            ],
            "properties": {
              "ecosystem": {
                "enum": [
                  "pypi",
                  "npm"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "level": {
        "const": "user"
      }
    }
  },
  "then": {
    "not": {
      "required": [
        "detect"
      ]
    }
  }
}
