{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge:rule",
  "$defs": {
    "where": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "object",
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "package"
                  ]
                },
                {
                  "required": [
                    "module"
                  ]
                }
              ],
              "properties": {
                "package": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "module": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "name": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                      }
                    }
                  ]
                },
                "unknown": {
                  "enum": [
                    "match",
                    "no-match"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/where"
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "scope",
    "enforce"
  ],
  "if": {
    "required": [
      "review"
    ]
  },
  "then": {
    "properties": {
      "enforce": {
        "contains": {
          "anyOf": [
            {
              "properties": {
                "target": {
                  "const": "guard"
                },
                "decision": {
                  "const": "ask"
                }
              },
              "required": [
                "decision"
              ]
            },
            {
              "properties": {
                "target": {
                  "const": "check"
                },
                "run": {
                  "pattern": "^\\s*forge_test_edits\\s*$"
                }
              },
              "required": [
                "run"
              ]
            }
          ]
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\t]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "enum": [
            "python",
            "typescript",
            "tsx",
            "yaml",
            "any"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "enforce": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "enum": [
              "tool",
              "ast-grep",
              "permission",
              "guard",
              "sandbox",
              "check",
              "grep"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "target": {
                  "const": "tool"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "tool",
                "expects",
                "snippet"
              ],
              "properties": {
                "target": true,
                "tool": {
                  "enum": [
                    "biome",
                    "ruff",
                    "ty",
                    "tsc"
                  ]
                },
                "expects": {
                  "type": "string",
                  "minLength": 1
                },
                "snippet": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "ast-grep"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "mode",
                "rule"
              ],
              "properties": {
                "target": true,
                "mode": {
                  "enum": [
                    "forbid",
                    "no-increase",
                    "no-decrease",
                    "advise"
                  ]
                },
                "rule": {
                  "type": "object",
                  "minProperties": 1
                },
                "constraints": {
                  "type": "object"
                },
                "utils": {
                  "type": "object"
                },
                "where": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/where"
                  }
                }
              },
              "if": {
                "required": [
                  "where"
                ]
              },
              "then": {
                "properties": {
                  "mode": {
                    "enum": [
                      "forbid",
                      "advise"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "grep"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "mode",
                "pattern"
              ],
              "properties": {
                "target": true,
                "mode": {
                  "enum": [
                    "forbid",
                    "no-increase",
                    "no-decrease"
                  ]
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\t\\n]+$"
                },
                "ignore_case": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "permission"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "decision",
                "rule"
              ],
              "properties": {
                "target": true,
                "decision": {
                  "enum": [
                    "deny",
                    "ask"
                  ]
                },
                "rule": {
                  "type": "string",
                  "pattern": "^[A-Za-z]+(\\(.+\\))?$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "guard"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "decision",
                "pattern"
              ],
              "properties": {
                "target": true,
                "decision": {
                  "enum": [
                    "deny",
                    "ask"
                  ]
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\t\\n]+$"
                },
                "check": {
                  "enum": [
                    "ephemeral-exec"
                  ]
                }
              },
              "if": {
                "required": [
                  "check"
                ]
              },
              "then": {
                "properties": {
                  "decision": {
                    "const": "ask"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "sandbox"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "path",
                "value"
              ],
              "properties": {
                "target": true,
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
                },
                "value": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "check"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "stage",
                "run"
              ],
              "properties": {
                "target": true,
                "stage": {
                  "enum": [
                    "format",
                    "lint",
                    "typecheck",
                    "migration",
                    "test"
                  ]
                },
                "run": {
                  "type": "string",
                  "minLength": 1
                },
                "changed_run": {
                  "type": "string",
                  "minLength": 1
                },
                "fix_run": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\{files\\}"
                },
                "format_stdin": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\{file\\}"
                },
                "rerun": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\{files\\}"
                },
                "when_changed": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "requires_local_db": {
                  "type": "boolean"
                },
                "fail_on_warnings": {
                  "const": true
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "rerun"
                    ]
                  },
                  "then": {
                    "properties": {
                      "stage": {
                        "const": "test"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "format_stdin"
                    ]
                  },
                  "then": {
                    "properties": {
                      "stage": {
                        "enum": [
                          "format",
                          "lint"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  },
                  "head": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  }
                }
              }
            ]
          }
        },
        "no_match": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  },
                  "head": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  }
                }
              }
            ]
          }
        },
        "deps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ecosystem",
              "name",
              "version"
            ],
            "properties": {
              "ecosystem": {
                "enum": [
                  "pypi",
                  "npm"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9][0-9A-Za-z.+-]*$"
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\t]+$"
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deps"
      ],
      "properties": {
        "deps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ecosystem",
              "name",
              "version"
            ],
            "properties": {
              "ecosystem": {
                "enum": [
                  "pypi",
                  "npm"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "deprecated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replaced_by"
      ],
      "properties": {
        "replaced_by": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
        }
      }
    }
  }
}
