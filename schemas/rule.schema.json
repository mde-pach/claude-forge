{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge:rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "scope",
    "enforce"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\t]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "enum": [
            "python",
            "typescript",
            "tsx",
            "any"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "enforce": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "enum": [
              "tool",
              "ast-grep",
              "permission",
              "guard",
              "sandbox",
              "check"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "target": {
                  "const": "tool"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "tool",
                "expects",
                "snippet"
              ],
              "properties": {
                "target": true,
                "tool": {
                  "enum": [
                    "biome",
                    "ruff",
                    "basedpyright",
                    "tsc"
                  ]
                },
                "expects": {
                  "type": "string",
                  "minLength": 1
                },
                "snippet": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "ast-grep"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "mode",
                "rule"
              ],
              "properties": {
                "target": true,
                "mode": {
                  "enum": [
                    "forbid",
                    "no-increase",
                    "no-decrease"
                  ]
                },
                "rule": {
                  "type": "object",
                  "minProperties": 1
                },
                "constraints": {
                  "type": "object"
                },
                "utils": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "permission"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "decision",
                "rule"
              ],
              "properties": {
                "target": true,
                "decision": {
                  "enum": [
                    "deny",
                    "ask"
                  ]
                },
                "rule": {
                  "type": "string",
                  "pattern": "^[A-Za-z]+(\\(.+\\))?$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "guard"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "decision",
                "pattern"
              ],
              "properties": {
                "target": true,
                "decision": {
                  "enum": [
                    "deny",
                    "ask"
                  ]
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\t\\n]+$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "sandbox"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "path",
                "value"
              ],
              "properties": {
                "target": true,
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
                },
                "value": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "check"
                }
              }
            },
            "then": {
              "additionalProperties": false,
              "required": [
                "stage",
                "run"
              ],
              "properties": {
                "target": true,
                "stage": {
                  "enum": [
                    "format",
                    "lint",
                    "typecheck",
                    "migration",
                    "test"
                  ]
                },
                "run": {
                  "type": "string",
                  "minLength": 1
                },
                "changed_run": {
                  "type": "string",
                  "minLength": 1
                },
                "when_changed": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "requires_local_db": {
                  "type": "boolean"
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                }
              }
            }
          }
        ]
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  },
                  "head": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  }
                }
              }
            ]
          }
        },
        "no_match": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  },
                  "head": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).*[^/]$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "deprecated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replaced_by"
      ],
      "properties": {
        "replaced_by": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"
        }
      }
    }
  }
}
