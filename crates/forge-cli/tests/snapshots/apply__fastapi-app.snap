[roles]
alembic-migrations = ["alembic/versions/**"]
build-artifacts = ["**/node_modules/**", "**/__pycache__/**", "**/*.pyc", "**/.next/**", "**/.nuxt/**", "**/.svelte-kit/**", "**/.turbo/**", "**/.coverage", "**/.DS_Store"]
django-migrations = ["**/migrations/[0-9]*.py"]
dockerfile = ["**/Dockerfile", "**/Dockerfile.*", "**/*.Dockerfile", "**/Containerfile", "!**/*.dockerignore"]
env-files = ["**/.env", "**/.env.*", "!**/.env.example", "!**/.env.sample", "!**/.env.template", "!**/.env.dist"]
env-template = ["**/.env.example", "**/.env.sample", "**/.env.template", "**/.env.dist"]
gunicorn-config = ["**/gunicorn.conf.py"]
procfile = ["Procfile", "Procfile.*"]
python-tests = ["**/test_*.py", "**/*_test.py", "**/conftest.py"]

[tools]
actionlint = "1.7.12"
ast-grep = "0.45.3"
bun = "1.4.3"
condor = "0.2.0"
editorconfig-checker = "4.0.2"
gitleaks = "8.30.1"
hadolint = "2.15.1"
kube-linter = "0.8.3"
kubeconform = "0.8.0"
lockfile-lint = "5.1.0"
oasdiff = "1.33.0"
osv-scanner = "2.7.0"
python = "3.12"
redocly = "2.62.1"
spectral = "6.17.0"
squawk = "2.70.0"
tflint = "0.64.0"
tflint-ruleset-aws = "0.49.0"
tflint-ruleset-azurerm = "0.32.0"
tflint-ruleset-google = "0.40.0"
trivy = "0.75.0"
ty = "0.0.86"
uv = "0.13.1"
zizmor = "1.30.1"

