=== .git/hooks/pre-commit
#!/bin/sh
# Generated by forge. Remove with forge remove.
command -v claude-forge >/dev/null 2>&1 || { [ -n "$CLAUDECODE" ] || echo "forge: claude-forge is not installed, so this commit is not checked" >&2; exit 0; }
exec claude-forge check --changed
