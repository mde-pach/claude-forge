[[settings]]
file = ".claude/settings.json"
path = "hooks.SessionStart"
json = '''{"matcher":"startup|resume|clear|compact","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || { printf \"{\\\"systemMessage\\\":\\\"Forge is not installed, so this project\\047s checks are off. Install it with: curl -LsSf https://github.com/mde-pach/claude-forge/releases/latest/download/install.sh | sh\\\"}\\n\"; exit 0; }; exec claude-forge hook session-start'","timeout":10}]}'''

[[settings]]
file = ".claude/settings.json"
path = "hooks.UserPromptSubmit"
json = """{"hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook user-prompt-submit'","timeout":10}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.PreToolUse"
json = """{"matcher":"Bash","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook pre-tool-use'","timeout":180,"onFailure":"block"}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.PreToolUse"
json = """{"matcher":"Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|mcp__serena__.*","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook pre-tool-use'","timeout":180}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.PostToolUse"
json = """{"matcher":"Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__serena__.*","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook post-tool-use'","timeout":60},{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook post-tool-use-typecheck'","timeout":300,"asyncRewake":true}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.PostToolUseFailure"
json = """{"matcher":"Bash","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook post-tool-use-failure'","timeout":60},{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook post-tool-use-typecheck'","timeout":300,"asyncRewake":true}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.PostToolBatch"
json = """{"hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook post-tool-batch'","timeout":30}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.Stop"
json = """{"hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook stop'","timeout":600}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.PermissionRequest"
json = """{"hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook permission-request'","timeout":180}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.SessionEnd"
json = """{"hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook session-end'","timeout":10}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.PreToolUse"
json = """{"matcher":"*","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook agents'","timeout":30}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.PostToolUse"
json = """{"matcher":"Agent|Task","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook agents'","timeout":30}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.SubagentStart"
json = """{"matcher":"quality-reviewer","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook agents'","timeout":30}]}"""

[[settings]]
file = ".claude/settings.json"
path = "hooks.SubagentStop"
json = """{"matcher":"quality-reviewer","hooks":[{"type":"command","command":"sh -c 'command -v claude-forge >/dev/null 2>&1 || exit 0; exec claude-forge hook agents'","timeout":30}]}"""

[[settings]]
file = ".claude/settings.json"
path = "permissions.allow"
value = "Bash(claude-forge use *)"

[[settings]]
file = ".mcp.json"
path = "mcpServers.serena"
json = '{"command":"sh","args":["-c","command -v claude-forge >/dev/null 2>&1 && exec claude-forge mcp serena; exec uvx --python 3.12 --from serena-agent==2.1.0 serena start-mcp-server --project-from-cwd --context claude-code --agent-interface tools --enable-web-dashboard false --open-web-dashboard false --enable-gui-log-window false --log-level WARNING"],"alwaysLoad":true}'

[[settings]]
file = ".claude/settings.json"
path = "enabledMcpjsonServers"
value = "serena"

[[settings]]
file = ".claude/settings.json"
path = "permissions.allow"
value = "mcp__serena"
=== .git/hooks/pre-commit
#!/bin/sh
# Generated by forge. Remove with forge remove.
[ -z "$CLAUDECODE" ] || exit 0
command -v claude-forge >/dev/null 2>&1 || { echo "forge: claude-forge is not installed, so this commit is not checked" >&2; exit 0; }
exec claude-forge check --changed
