---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { packs, packUrl, ruleAnchor } from "../../lib/data";
import { enforcedBy } from "../../lib/lifecycle";

const all = [...packs().values()];
---

<StarlightPage frontmatter={{ title: "All rules", description: "Every rule Forge ships, with how it is enforced." }}>
  <table>
    <thead><tr><th>Rule</th><th>Description</th><th>Enforced by</th></tr></thead>
    <tbody>
      {
        all.flatMap((p) =>
          p.rules.map((x) => (
            <tr>
              <td><a href={`${packUrl(p.id)}#${ruleAnchor(x.id)}`}><code>{x.id}</code></a></td>
              <td>{x.description}</td>
              <td>{enforcedBy(x).join(", ")}</td>
            </tr>
          )),
        )
      }
    </tbody>
  </table>
</StarlightPage>
