---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import PackTree, { type TreeNode } from "../../components/PackTree";
import { leaf, packs, packUrl, results, ruleStatus } from "../../lib/data";

const all = packs();
const r = results();
const node = (id: string): TreeNode => {
  const p = all.get(id)!;
  return {
    id,
    name: leaf(id),
    description: p.description,
    level: p.level,
    href: packUrl(id),
    rules: p.rules.map((x) => ({ id: x.id, status: ruleStatus(r, x.id) })),
    children: p.children.map(node),
  };
};
const roots = [...all.values()].filter((p) => !p.parent).sort((a, b) => (a.level === b.level ? a.id.localeCompare(b.id) : a.level === "project" ? -1 : 1));
const ruleCount = [...all.values()].reduce((n, p) => n + p.rules.length, 0);
---

<StarlightPage frontmatter={{ title: "Pack tree", description: "Every pack Forge ships, as a tree: language first, then package, then sub-package." }}>
  <p>
    Forge ships <strong>{all.size} packs</strong> with <strong>{ruleCount} rules</strong>. Packs form a tree: language
    first, then package, then sub-package. A child pack is active only when its parent is, so the same package can carry
    different rules under different parents — React under Next.js is about Server and Client Components, React under
    Astro is about islands. The status next to each pack is the CI result of its rules' examples.
  </p>
  <PackTree client:load roots={roots.map((p) => node(p.id))} />
</StarlightPage>
