---
import { readdirSync, statSync } from "node:fs";
import { join, relative } from "node:path";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import LifecycleSchema from "../../components/LifecycleSchema.astro";
import RuleCard from "../../components/RuleCard.astro";
import { detectChips, leaf, lineage, markdown, packs, packUrl, REPO_URL, ROOT, ruleAnchor, whenChips } from "../../lib/data";
import { contextEvents, ruleLifecycle } from "../../lib/lifecycle";

export function getStaticPaths() {
  return [...packs().keys()].map((id) => ({ params: { id } }));
}

const all = packs();
const pack = all.get(Astro.params.id!)!;
const chain = lineage(all, pack.id);
const context = pack.context ?? [];
// the pack's context and every rule's events, for the schema
const schemaEvents = [
  ...contextEvents(pack).map((event) => ({ event, who: "context" })),
  ...pack.rules.flatMap((rule) => ruleLifecycle(rule).map((event) => ({ event, who: leaf(rule.id) }))),
];
const detect = pack.level === "user" ? [] : detectChips(pack.detect);
const initDir = pack.initDir ? join(ROOT, "packs", pack.initDir) : undefined;
const initFiles = (dir: string): string[] =>
  readdirSync(dir).flatMap((f) => (statSync(join(dir, f)).isDirectory() ? initFiles(join(dir, f)) : [relative(initDir!, join(dir, f))]));
const contextFile = `.claude/rules/forge-${pack.id.replaceAll("/", "-")}.md`;
const headings = [
  { depth: 2, slug: "what-it-does", text: "What it does" },
  ...(context.length ? [{ depth: 2, slug: "context", text: "Context" }] : []),
  ...pack.rules.map((x) => ({ depth: 2, slug: ruleAnchor(x.id), text: leaf(x.id) })),
];
---

<StarlightPage frontmatter={{ title: pack.id, description: pack.description, editUrl: `${REPO_URL}/edit/main/packs/${pack.dir}/pack.yaml` }} headings={headings}>
  <nav class="forge-crumbs" aria-label="Pack tree">
    {chain.map((p, i) => <>{i > 0 && <span aria-hidden="true">›</span>}<a href={packUrl(p.id)} aria-current={p.id === pack.id ? "page" : undefined}>{leaf(p.id)}</a></>)}
  </nav>
  <p class="forge-rule-desc">{pack.description}</p>

  <dl class="forge-props">
    <div>
      <dt>Level</dt>
      <dd><span class="forge-chip">{pack.level === "user" ? "user (~/.claude)" : "project"}</span></dd>
    </div>
    <div>
      <dt>Active when</dt>
      <dd>
        {pack.level === "user" && <span class="forge-chip">forge apply --user</span>}
        {pack.parent && <a class="forge-chip forge-chip--link" href={packUrl(pack.parent)}>{pack.parent} active</a>}
        {pack.parent && detect.length > 0 && <span class="forge-and">and any of</span>}
        {!pack.parent && detect.length > 1 && <span class="forge-and">any of</span>}
        {detect.map((d) => <span class="forge-chip forge-chip--in">{d}</span>)}
        {pack.level === "project" && !detect.length && <span class="forge-chip">added in forge.yaml</span>}
      </dd>
    </div>
    {
      pack.children.length > 0 && (
        <div>
          <dt>Sub-packs</dt>
          <dd>{pack.children.map((c) => <a class="forge-chip forge-chip--link" href={packUrl(c)}>{leaf(c)}</a>)}</dd>
        </div>
      )
    }
    {
      pack.requires.length > 0 && (
        <div>
          <dt>Requires</dt>
          <dd>{pack.requires.map((c) => <a class="forge-chip forge-chip--link" href={packUrl(c)}>{c}</a>)}</dd>
        </div>
      )
    }
    <div>
      <dt>Source</dt>
      <dd><a href={`${REPO_URL}/tree/main/packs/${pack.dir}`}><code>packs/{pack.dir}/</code></a></dd>
    </div>
  </dl>

  <h2 id="what-it-does">What it does</h2>
  {
    schemaEvents.length ? (
      <LifecycleSchema variant="pack" events={schemaEvents} />
    ) : (
      <p>This pack has no rules or context of its own; its sub-packs do the work.</p>
    )
  }
  <p class="forge-meta">Claude Code's lifecycle, with the Forge pieces this pack uses lit up; each badge counts the rules acting there (hover a piece for the list). Each rule's section below shows the same schema for that rule alone.</p>
  {initDir && <p><code>forge init</code> also creates these files when missing: {initFiles(initDir).map((f, i) => <>{i > 0 && ", "}<code>{f}</code></>)}.</p>}

  {
    context.length > 0 && (
      <>
        <h2 id="context">Context</h2>
        <p>Written to <code>{contextFile}</code>, which Claude reads; an item with a condition is written only where it holds. Context informs Claude; it never enforces anything.</p>
        {context.map((c) => (
          <div class="forge-context">
            {c.when && (
              <p class="forge-meta">
                Only {whenChips(c.when).map((w) => <span class="forge-chip forge-chip--in">{w}</span>)}
              </p>
            )}
            <Fragment set:html={markdown(c.text)} />
          </div>
        ))}
      </>
    )
  }

  {pack.rules.map((rule) => <RuleCard rule={rule} />)}
</StarlightPage>
