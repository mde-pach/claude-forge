---
import { readdirSync, statSync } from "node:fs";
import { join, relative } from "node:path";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { EFFECT_LABEL } from "../../components/Lifecycle";
import RuleCard from "../../components/RuleCard.astro";
import TestList from "../../components/TestList.astro";
import { leaf, lineage, markdown, packs, packTests, packUrl, REPO_URL, results, ruleAnchor, spec } from "../../lib/data";
import { ruleLifecycle, STEPS, type Effect, type StepId } from "../../lib/lifecycle";

export function getStaticPaths() {
  return [...packs().keys()].map((id) => ({ params: { id } }));
}

const all = packs();
const pack = all.get(Astro.params.id!)!;
const r = results();
const sections = spec();
const chain = lineage(all, pack.id);
const tests = packTests(sections, pack);
// rows: the pack's context, then each rule with its strongest effect per step
const ORDER: Effect[] = ["blocks", "asks", "wakes", "feedback", "fixes", "audits", "informs"];
const rows: { label: string; href?: string; cells: Partial<Record<StepId, Effect>> }[] = [
  ...(pack.context !== undefined ? [{ label: "context", href: "#context", cells: { session: "informs" as Effect } }] : []),
  ...pack.rules.map((rule) => {
    const cells: Partial<Record<StepId, Effect>> = {};
    for (const e of ruleLifecycle(rule)) {
      const cur = cells[e.step];
      if (e.effect !== "inactive" && (!cur || ORDER.indexOf(e.effect) < ORDER.indexOf(cur))) cells[e.step] = e.effect;
    }
    return { label: leaf(rule.id), href: `#${ruleAnchor(rule.id)}`, cells };
  }),
];
const detect =
  pack.level === "user"
    ? []
    : [...(pack.detect?.files_any ?? []).map((f) => `file ${f}`), ...(pack.detect?.deps_any ?? []).map((d) => `${d.ecosystem} ${d.name}${d.version ? ` ${d.version}` : ""}`)];
const initFiles = (dir: string): string[] =>
  readdirSync(dir).flatMap((f) => (statSync(join(dir, f)).isDirectory() ? initFiles(join(dir, f)) : [relative(pack.initDir!, join(dir, f))]));
const contextFile = `.claude/rules/forge-${pack.id.replaceAll("/", "-")}.md`;
// only the steps this pack takes part in
const cols = STEPS.filter((x) => rows.some((row) => row.cells[x.id]));
const headings = [
  { depth: 2, slug: "what-it-does", text: "What it does" },
  ...(pack.context !== undefined ? [{ depth: 2, slug: "context", text: "Context" }] : []),
  ...(tests.length ? [{ depth: 2, slug: "specification", text: "Specification" }] : []),
  ...pack.rules.map((x) => ({ depth: 2, slug: ruleAnchor(x.id), text: leaf(x.id) })),
];
---

<StarlightPage frontmatter={{ title: pack.id, description: pack.description, editUrl: `${REPO_URL}/edit/main/packs/${pack.id}/pack.yaml` }} headings={headings}>
  <nav class="forge-crumbs" aria-label="Pack tree">
    {chain.map((p, i) => <>{i > 0 && <span aria-hidden="true">›</span>}<a href={packUrl(p.id)} aria-current={p.id === pack.id ? "page" : undefined}>{leaf(p.id)}</a></>)}
  </nav>
  <p class="forge-rule-desc">{pack.description}</p>

  <dl class="forge-props">
    <div>
      <dt>Level</dt>
      <dd><span class="forge-chip">{pack.level === "user" ? "user (~/.claude)" : "project"}</span></dd>
    </div>
    <div>
      <dt>Active when</dt>
      <dd>
        {pack.level === "user" && <span class="forge-chip">forge apply --user</span>}
        {pack.parent && <a class="forge-chip forge-chip--link" href={packUrl(pack.parent)}>{pack.parent} active</a>}
        {pack.parent && detect.length > 0 && <span class="forge-and">and any of</span>}
        {detect.map((d) => <span class="forge-chip forge-chip--in">{d}</span>)}
        {pack.level === "project" && !detect.length && <span class="forge-chip">added in forge.yaml</span>}
      </dd>
    </div>
    {
      pack.children.length > 0 && (
        <div>
          <dt>Sub-packs</dt>
          <dd>{pack.children.map((c) => <a class="forge-chip forge-chip--link" href={packUrl(c)}>{leaf(c)}</a>)}</dd>
        </div>
      )
    }
    {
      pack.requires.length > 0 && (
        <div>
          <dt>Requires</dt>
          <dd>{pack.requires.map((c) => <a class="forge-chip forge-chip--link" href={packUrl(c)}>{c}</a>)}</dd>
        </div>
      )
    }
    <div>
      <dt>Source</dt>
      <dd><a href={`${REPO_URL}/tree/main/packs/${pack.id}`}><code>packs/{pack.id}/</code></a></dd>
    </div>
  </dl>

  <h2 id="what-it-does">What it does</h2>
  {
    rows.length ? (
      <div class="forge-matrix-wrap">
        <table class="forge-matrix">
          <thead>
            <tr>
              <th />
              {cols.map((x) => <th scope="col">{x.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row">{row.href ? <a href={row.href}>{row.label}</a> : row.label}</th>
                {cols.map((x) => {
                  const e = row.cells[x.id];
                  return e ? <td data-effect={e} title={EFFECT_LABEL[e]}>{EFFECT_LABEL[e]}</td> : <td />;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p>This pack has no rules or context of its own; its sub-packs do the work.</p>
    )
  }
  <p class="forge-meta">Each rule's section below explains what it does at each step.</p>
  {pack.initDir && <p><code>forge init</code> also creates these files when missing: {initFiles(pack.initDir).map((f, i) => <>{i > 0 && ", "}<code>{f}</code></>)}.</p>}

  {
    pack.context !== undefined && (
      <>
        <h2 id="context">Context</h2>
        <p>Written verbatim to <code>{contextFile}</code>. Context informs Claude; it never enforces anything.</p>
        <div class="forge-context" set:html={markdown(pack.context)} />
      </>
    )
  }

  {
    tests.length > 0 && (
      <>
        <h2 id="specification">Specification</h2>
        <TestList tests={tests} results={r} />
      </>
    )
  }

  {pack.rules.map((rule) => <RuleCard rule={rule} results={r} sections={sections} />)}
</StarlightPage>
