---
import { Code } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Spec from "../../components/Spec.astro";
import { url } from "../../lib/data";
import { USAGE } from "../../../../src/usage";
---

<StarlightPage frontmatter={{ title: "CLI", description: "forge --help, and where each command is described." }}>
  <p>The output of <code>forge --help</code>, taken from the CLI's own source. Until the package is published, <code>forge</code> means <code>node dist/forge.js</code> in a built clone (see <a href={url("guide/getting-started/#get-the-cli")}>Getting started</a>); after that, <code>bunx @maximedepachtere/forge</code> or <code>npx @maximedepachtere/forge</code>.</p>
  <Code code={USAGE} lang="txt" />
  <ul>
    <li><code>init</code>: <a href={url("guide/getting-started/#a-new-project")}>Getting started</a></li>
    <li><code>apply</code>, <code>--user</code>, <code>--local</code>, <code>--dry-run</code>, <code>--yes</code>, <code>--force</code>: <a href={url("lifecycle/apply/")}>forge apply</a>, <a href={url("guide/user-level/")}>User level</a></li>
    <li><code>status</code>, <code>explain</code>, <code>diff</code>, <code>remove</code>: <a href={url("lifecycle/maintenance/")}>Status, diff and remove</a></li>
    <li><code>test</code>: <a href={url("contributing/writing-packs/#examples-are-tests")}>Writing packs</a></li>
  </ul>
  <h2 id="usage-errors">Usage errors</h2>
  <Spec file="03-cli" describe="usage errors exit 2" />
</StarlightPage>
