---
// Places tests from tests/spec in a docs page, selected by file plus one of: describe
// (a top-level describe title), test (an exact test title), top (top-level tests only),
// or nothing (the whole file).
// Every test must be placed somewhere (checked by tests/spec/99-internals).
import SpecNodes from "./SpecNodes.astro";
import { markdown, results, spec } from "../lib/data";
import { selectNodes } from "../lib/spec";

interface Props {
  file: string;
  describe?: string;
  test?: string;
  top?: boolean;
  depth?: number;
}
const { file, describe, test, top, depth = 3 } = Astro.props;
const section = spec().find((s) => s.slug === file);
if (!section) throw new Error(`<Spec file="${file}">: no tests/spec/${file}.test.ts`);
const selected = selectNodes(section, { describe, test, top });
if (!selected.length) throw new Error(`<Spec file="${file}" describe="${describe ?? ""}" test="${test ?? ""}">: selects no test`);
// a placed describe sits under the page's own heading: show its comment and tests, not its title
const group = describe !== undefined && selected[0]!.kind === "describe" ? selected[0] : undefined;
const nodes = group?.kind === "describe" ? group.children : selected;
---

<div class="forge-spec">
  {group?.kind === "describe" && group.comment && <div set:html={markdown(group.comment)} />}
  <SpecNodes nodes={nodes} file={section.file} results={results()} depth={depth} />
</div>
