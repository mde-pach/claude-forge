---
// Claude Code's lifecycle with the Forge pieces a rule or pack uses lit up.
// Events this page does not involve are grouped into sections that open and
// close in place (<details>, no client JavaScript).
import type { LifecycleEvent } from "../lib/lifecycle";
import { HOOK_EVENTS, LANES, litPieces, schemaHtml } from "../lib/schema";

interface Props {
  /** Events to light up, with who they belong to (a rule id, or "context"). */
  events: { event: LifecycleEvent; who: string }[];
  /** "rule" and "pack" pages show only what they involve; "overview" shows every Forge piece. */
  variant: "rule" | "pack" | "overview";
}
const { events, variant } = Astro.props;
const { html, retry } = schemaHtml({ lit: litPieces(events), counts: variant === "pack", showAllPieces: variant === "overview" });
---

<figure class="forge-schema not-content" data-variant={variant}>
  <Fragment set:html={html} />
  <figcaption class="forge-schema-legend">
    {
      (["loop", "retry", "turn"] as const).map((l) => (
        <span class={l === "retry" && retry ? "forge-lane-on" : undefined}>
          <b class="forge-lane-key">{LANES[l].key}</b>
          {LANES[l].text}
          {l === "retry" && retry ? " (Forge: at most 3 times)" : ""}
        </span>
      ))
    }
    <span class="forge-schema-note">All {HOOK_EVENTS.length} Claude Code hook events are listed; open a <b>+</b> line to see the ones folded there.</span>
  </figcaption>
</figure>
