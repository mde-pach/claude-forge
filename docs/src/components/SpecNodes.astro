---
// Renders tests/spec nodes: describes as headings, tests with their CI results and code.
import { Code } from "@astrojs/starlight/components";
import StatusBadge from "./StatusBadge";
import { inline, markdown, REPO_URL } from "../lib/data";
import { resultsFor, summarize, type Results, type SpecNode } from "../lib/spec";

interface Props {
  nodes: SpecNode[];
  file: string;
  results: Results;
  /** Heading level of top-level describes: 2 → h2. */
  depth?: number;
  /** Keep only matching cases of parameterised tests (e.g. one rule of the per-rule test). */
  instance?: string;
}
const { nodes, file, results, depth = 2, instance } = Astro.props;
const H = (`h${Math.min(depth, 5)}`) as "h2";
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

{
  nodes.map((n) =>
    n.kind === "describe" ? (
      <section>
        <H id={`${slugify(n.title)}-${n.line}`}>
          <Fragment set:html={inline(cap(n.title))} />
        </H>
        {n.condition && (
          <p class="forge-group-condition">
            Runs when <code>{n.condition}</code>.
          </p>
        )}
        {n.table && (
          <p class="forge-group-condition">
            Repeated for each of <code>{n.table.length > 120 ? n.table.slice(0, 117) + "…" : n.table}</code>.
          </p>
        )}
        {n.comment && <div set:html={markdown(n.comment)} />}
        <Astro.self nodes={n.children} file={file} results={results} depth={depth + 1} instance={instance} />
      </section>
    ) : (
      (() => {
        const rs = resultsFor(results, file, n.line).filter((r) => !instance || r.name.startsWith(instance));
        const status = summarize(rs);
        const platforms = [...new Set(rs.map((r) => r.platform))].join(", ");
        const names = [...new Set(rs.map((r) => r.name))];
        const instances = (n.table && !instance) || names.length > 1;
        const failures = rs.filter((r) => r.status === "failed");
        return (
          <article class="forge-test" id={`L${n.line}`} data-status={status}>
            <header>
              <p>
                <Fragment set:html={inline(instance && n.title.includes("%s") ? n.title.replace("%s", `\`${instance.replace(/: $/, "")}\``) : n.title)} />
              </p>
              <StatusBadge status={status} detail={platforms || undefined} />
            </header>
            {n.condition && (
              <p class="forge-group-condition">
                Runs when <code>{n.condition}</code>.
              </p>
            )}
            {n.comment && <div class="forge-comment" set:html={markdown(n.comment)} />}
            {instances && names.length > 0 && (
              <ul class="forge-instances">
                {names.map((name) => {
                  const own = rs.filter((r) => r.name === name);
                  return (
                    <li>
                      <StatusBadge status={summarize(own)} />
                      <code>{name}</code>
                    </li>
                  );
                })}
              </ul>
            )}
            {failures.map((f) => (
              <pre class="forge-failure">
                {f.platform}: {f.name}
                {"\n"}
                {f.message}
              </pre>
            ))}
            <details>
              <summary>
                Test code · <a href={`${REPO_URL}/blob/main/${file}#L${n.line}`}>{file}:{n.line}</a>
              </summary>
              {n.table && !instance && <Code code={n.table} lang="ts" title="for each of" />}
              <Code code={n.code} lang="ts" />
            </details>
          </article>
        );
      })()
    ),
  )
}
